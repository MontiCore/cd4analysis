import java.lang.String;

classdiagram ManagementV2 {
  abstract class Employee {
    String name;
  }
  class Professor extends Employee{
    int salary;
  }
  class Lecture{
    int courseID;
  }
  association Professor (lecturer) -> (holds) Lecture [1..*];
}
