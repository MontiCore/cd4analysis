
classdiagram DeLijn {

class Bus {
    int busNumber;
}

class Trajectory {
    String destination;
    String startPoint;
    String approvalStatus; // e.g., APPROVED, REFUSED, PENDING, CHANGEREQUESTED
    Boolean isOperational;
    Boolean isSuspended;
    Boolean isCancelled;
    List<String> routePoints; // Points that define the trajectory
}

class Line {
    String name;
    String category; // Used for MENSO ticket pricing
    List<Trajectory> trajectories;
}

enum MensoDiscount {
    NONE,
    FIVE_PERCENT,
    TEN_PERCENT,
    FIFTEEN_PERCENT,
    TWENTY_PERCENT;
}

class MensoCard {
    String cardNumber;
    String holderName;
    List<Trip> trips;
}

class Trip {
    Date timestamp;
    Line line;
    MensoDiscount appliedDiscount; // Discount applied on this trip
}

class Customer {
    String name;
    String homeAddress;
    String officeAddress;
    String workingHours;
    MensoCard mensoCard;
    List<Invoice> invoices;
}

class Invoice {
    Date issueDate;
    Double amount;
    Boolean isPaid;
    MensoDiscount totalDiscount; // Discount applied on total amount
}

// Associations
association [1..*] Bus -> (assignedTo) Trajectory [*];
association [*] Trajectory (groupedIn) -> Line [1];
association [*] Customer -> (uses) MensoCard [1];
association [*] Trip -> (onLine) Line [1];
association [1] Customer -> (receives) Invoice [*];
association [1] Invoice -> (generatedFrom) Trip [*];

}
