
// Class Diagram in CD4A format

classdiagram location_management_system {

class Location {
    String address;
    List<Driver> drivers;
    List<Vehicle> vehicles;
}

class Driver {
    String firstName;
    String lastName;
    Optional<Order> currentOrder; // Drivers can carry out at most one order at a time
}

class Vehicle {
    String vehicleNumber;
    Optional<Driver> assignedDriver; // Vehicles can be assigned up to one driver
}

class Truck extends Vehicle {
    int weight;
}

class Car extends Vehicle {
    int numberOfSeats;
}

class Van extends Vehicle { }

class Order {
    Location origin;
    Location destination;
    List<Driver> assignedDrivers; // At least one driver is required
    Date executionDate;
}

// Associations
association manages [1] Location -> (contains) Driver [*];
association manages [1] Location -> (contains) Vehicle [*];
association [1] Driver (executes) -> Order [0..1];
association drives [1] Driver -> Vehicle [0..1];
association originates [1] Order -> Location [1];
association completes [1] Order -> Location [1];

}
