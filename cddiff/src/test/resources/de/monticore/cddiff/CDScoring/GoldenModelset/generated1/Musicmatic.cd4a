
classdiagram Musicmatic {

class Song {
    String title;
    int year;
    int length;
    String genre;
}

class Artist {
    String name;
    String dateOfBirth;
    String website;
}

class User {
    String id;
    String name;
    String address;
}

class RegularUser extends User {}

class BusinessUser extends User {
    String vatNumber;
}

class Single extends Song {}

class Hit extends Song {
    int trackNumber;
}

class Album {
    // Album information goes here
}

association [1] Song -> Artist [1];
association [*] RegularUser -> Single [0..*];
association [*] User <-> Album [0..*];
association [0..*] Album <-> Hit [0..*];

}
