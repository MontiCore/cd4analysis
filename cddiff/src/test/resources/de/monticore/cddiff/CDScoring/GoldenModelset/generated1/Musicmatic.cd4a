
// CD4A class diagram for Musicmatic

classdiagram musicmatic {

    class Song {
        String title;
        int year;
        int length; // in seconds
        String genre;
        Artist artist;
    }

    class Artist {
        String name; // unique identifier
        Date dateOfBirth;
        String websiteURL;
    }

    class User {
        String id; // unique identifier
        String name;
        String address;
    }

    class RegularUser extends User {
        void buyMusic(Song song);
    }

    class BusinessUser extends User {
        String vatNumber;
        void uploadSong(Song song);
    }

    class Single extends Song {
        // additional details if necessary
    }

    class Hit extends Song {
        int trackNumber; // position in an album
    }

    class Album {
        List<Hit> hits; // no singles allowed
        void addHit(Hit hit);
    }

    // Associations
    association [1] Song -> Artist [1]; // Each song has exactly one artist.
    association [*] Album -> Hit [*]; // An album can have multiple hits.
    association [*] RegularUser -> Song [*]; // Regular users can buy multiple songs.
    association [1] BusinessUser <-> Song [1]; // Business users upload individual songs.
}
