
// CD4A Class Diagram for the DestroyBlock application

classdiagram destroyblock {

    class User {
        String username; // unique username
        String password; // shared password for player and admin
        boolean isAdmin; // true if user is an admin, false if player
    }

    class Game {
        String name; // unique game name
        HallOfFame hallOfFame; // associated hall of fame
        List<Block> blocks; // set of game blocks
        List<Level> levels; // list of game levels
        int minSpeed; // minimum speed of the ball
        int speedIncreaseFactor; // speed increase factor for ball
        int maxPaddleLength; // maximum length of paddle
        int minPaddleLength; // minimum length of paddle
        void publish(); // publish the game
    }

    class Block {
        String color; // color of the block
        int points; // points awarded for hitting the block
    }

    class Level {
        int levelNumber; // starting from Level 1
        boolean isRandom; // defines if the level arrangement is random
        List<Block> startingArrangement; // starting arrangement of blocks
        void defineStartingArrangement(List<Block> blocks); // define the arrangement
    }

    class HallOfFame {
        List<ScoreEntry> entries; // list of score entries for players
        void display(); // display hall of fame
    }

    class ScoreEntry {
        User player; // the player scoring the entry
        int score; // score of the player
    }

    class PlayArea {
        Ball ball; // the ball in the play area
        Paddle paddle; // the player's paddle
        void startGame(Game game); // start the game in play area
        void update(); // update the play area state
    }

    class Ball {
        int speed; // speed of the ball
        Direction direction; // current direction of the ball
        void bounce(); // bounce logic for the ball
    }

    class Paddle {
        int length; // current length of the paddle
        void moveLeft(); // move paddle left
        void moveRight(); // move paddle right
    }

    enum Direction {
        UP,
        DOWN,
        LEFT,
        RIGHT;
    }

    association [1] User -> Game [0..1]; // A user can be player for one game or admin for another
    association [1] Game -> User [1]; // Only one admin per game
    association [1] Game -> HallOfFame [1]; // Each game has a hall of fame
    association [1..*] Game <-> Block [*]; // A game has multiple blocks
    association [1..*] Game <-> Level [*]; // A game has several levels
    association [1] PlayArea -> Ball [1]; // Play area has one ball
    association [1] PlayArea -> Paddle [1]; // Play area has one paddle
}
