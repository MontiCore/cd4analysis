
// CD4A Class Diagram for Alpha Insurance

classdiagram AlphaInsurance {

class Customer {
    String name;
    String contactDetails;
    String address;
}

class Broker {
    String name;
    String employeeId;
}

class InsurancePolicy {
    String policyType;
    double price;
    String frequency;
}

class Contract {
    Date signingDate;
    String status;
}

class Claim {
    Date claimDate;
    String description;
}

class ClaimCase {
    Date caseOpenedDate;
    String status;
}

class Estimator {
    String name;
    String areaOfExpertise;
}

class CompensationDecision {
    double amount;
    String eligibleCosts;
}

class Payment {
    Date paymentDate;
    double amount;
}


// Associations
association [1] Customer <-> Broker [0..1];
association [1] Customer <-> InsurancePolicy [0..*];
association [1] Customer <-> Contract [0..*];
association [1] Customer <-> Claim [0..*];
association [1] Claim <-> ClaimCase [0..*];
association [1] ClaimCase <-> Estimator [0..*];
association [1] ClaimCase <-> CompensationDecision [0..1];
association [1] CompensationDecision <-> Payment [0..1];

}
