
classdiagram insurance {

    class Customer {
        String name;
        String contactInfo;
        void requestInsurance(List<InsurancePolicy> policies);
        void submitClaim(Claim claim);
    }

    class Broker {
        String name;
        void assessProfile(Customer customer);
        void sendFileForAnalysis(Customer customer);
    }

    class InsurancePolicy {
        String type;
        double price;
        Frequency invoicingFrequency; // Monthly or Yearly
    }

    class Contract {
        Customer customer;
        Broker broker;
        InsurancePolicy policy;
        String status; // Signed, Pending, etc.
        void signContract();
    }

    class Claim {
        Customer customer;
        List<ClaimCase> claimCases;
        void submitClaim();
    }

    class ClaimCase {
        Claim claim;
        List<EstimatorReport> reports;
        boolean isApproved;
        void assessClaim();
    }

    class Estimator {
        String expertise;
        void issueReport(ClaimCase claimCase);
    }

    class EstimatorReport {
        ClaimCase claimCase;
        String reportDetails;
        Date issueDate;
    }

    class CompensationDecision {
        ClaimCase claimCase;
        double amount;
        void registerDecision();
        void payCompensation();
    }

    enum Frequency {
        MONTHLY,
        YEARLY;
    }

    association [1] Broker -> Customer [1];
    association [1] Customer -> Contract [*];
    association [*] Customer -> Claim [*];
    association [1] Claim -> ClaimCase [*];
    association [*] ClaimCase -> EstimatorReport [*];
    association [1] Estimator -> EstimatorReport [*];
    association [1] ClaimCase -> CompensationDecision [1];
}
