
classdiagram webPortal {

    class WebPortal {
        String versionNumber;
        String url;
        List<Building> catalog;
    }

    class Building {
        String uniqueID;
        String name;
        EnergyClass energyClass; // Enum type
        String address;
        int yearOfConstruction;
        User owner;
        List<Entry> additionalEntries;
        List<Image> images;
        Image profilePhoto;
    }

    // Enum representing energy classes
    enum EnergyClass {
        A, B, C, D;
    }

    class User {
        String userName; // unique
        String email; // valid email
        String password;
        List<Building> buildings;
        // Special user type
        String idCardNumber; // for Administrators
    }

    class Entry {
        String name;
        Object value; // can be string or float
        String unit; // optional, for floating point entries
        boolean publicVisibility; // indicates if entry is released publicly
    }

    class Image {
        String fileName;
    }

    association [1] WebPortal -> (catalog) Building [*];
    association [1] Building -> (owner) User [1];
    association [*] User -> (buildings) Building [*];
    association [*] Building -> (additionalEntries) Entry [*];
    association [*] Building -> (images) Image [*];
}
