
classdiagram LabTracker {

class Doctor {
    int practitionerNumber;
    String fullName;
    String address;
    String phoneNumber;
    Image signature; // Digital signature
}

class Patient {
    String healthNumber; // Alphanumeric
    String firstName;
    String lastName;
    Date dateOfBirth;
    String address;
    String phoneNumber;
}

class Requisition {
    Date validFrom;
    RepetitionPattern repetition;
    List<Test> tests; // Tests must belong to the same group
    Optional<int> repeatCount; // Specifies number of repetitions
}

enum TestGroup {
    BLOOD,
    ULTRASOUND,
    XRAY,
    URINE,
    STOOL;
}

class Test {
    String testName;
    TestGroup testGroup;
    Duration duration; // Duration specified by lab network
}

enum RepetitionPattern {
    WEEKLY,
    MONTHLY,
    HALF_YEARLY,
    YEARLY;
}

class TestResult {
    boolean isPositive; // Negative or Positive
    String report; // Accompanying report
}

class Lab {
    String name;
    String registrationNumber;
    String address;
    BusinessHours hours;
    double changeCancellationFee; // Fee for cancellations within 24 hours
}

class BusinessHours {
    Time startTime;
    Time endTime; // No breaks
}

class Appointment {
    String confirmationNumber;
    Date appointmentDate;
    Time startTime;
    Time endTime;
    Lab lab; // Associated lab for the appointment
}

// Associations
association [1] Doctor -> (issued) Requisition [*];
association [1] Patient -> (has) Requisition [*];
association [*] Patient -> Appointment [*];
association [1..*] Requisition -> (contains) Test [*];
association [0..1] Test -> TestResult [1];
association [1] Lab -> (hosts) Appointment [*];
association [1..*] Lab -> BusinessHours [1];

// Constraints
constraint "A Doctor cannot prescribe a test for themselves, but can prescribe tests to another Doctor.";
constraint "A Requisition can only contain Tests belonging to the same TestGroup.";
constraint "For Requisitions with repeated tests, only one appointment can be made at a time.";
constraint "Blood Tests and Tests requiring sample drop-off are walk-in only and cannot have appointments.";

}
