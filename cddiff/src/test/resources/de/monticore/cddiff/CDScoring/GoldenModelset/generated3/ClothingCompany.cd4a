
// Class Diagram for Clothing Management Application
classdiagram ClothingManagement {

class Product {
    String uniqueName;
    String description;
    double netPrice;
}

class Manufacturer {
    String name;
    String country;
}

class Country {
    String name;
    double vatRate;
    String currency;
    double conversionRateToEuro;
}

class Representative {
    String firstName;
    String lastName;
    String socialSecurityNumber;
    String phoneNumber;
    String emailAddress;
}

class Customer {
    String name;
    String address;
    String phoneNumber;
    String emailAddress;
}

class Order {
    String orderId;
    int quantity;
    Date orderDate;
    Date deliveryDate;
}

association [1] Product -- (manufacturedBy) Manufacturer [1];
association [1] Manufacturer -- (availableIn) Country [*];
association [1] Representative -- (responsibleFor) Country [1];
association [1] Representative -- (places) Order [*];
association [1] Order -- (product) Product [1];
association [1] Customer -- (orders) Order [*];

}
