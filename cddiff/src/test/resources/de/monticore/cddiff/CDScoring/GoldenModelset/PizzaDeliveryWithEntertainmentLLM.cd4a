
classdiagram pizzaDeliveryApp {

class User {
    String userId; // Unique identifier for all users
    String name;
    String address;
    Date birthdate;
}

class BusinessOwner extends User {
    Optional<String> linkedInAccount;
}

class PizzaRestaurant {
    String zipCode;
    String address;
    String phone;
    Optional<String> website;
    String openingHours;
}

class Pizza {
    String name; // e.g., margarita, quattro stagioni
    String crustType; // e.g., classic Italian crust
    double price;
}

class HungryCustomer extends User {
    String deliveryAddress; // Address specific to delivery
}

class Order {
    String orderId; // Unique identifier for each order
    DateTime orderPlaced; // Date and time the order was placed
    Optional<DateTime> latestDeliveryTime;
    int numberOfPeople; // How many people the order is for
}

class EntertainmentOrder extends Order {
    String entertainmentType; // e.g., singing, magic tricks
    Duration duration; // Time entertainer stays (e.g., HH:MM)
}

class Entertainer extends User {
    String stageName; 
    String shortBio;
    double pricePer30Minutes;
}

class Availability {
    String day; // e.g., Monday, Tuesday
}

// Associations
association [1..*] BusinessOwner -> (owns) PizzaRestaurant [*];
association [1..*] PizzaRestaurant -> (offers) Pizza [*];
association [1..*] HungryCustomer -> (places) Order [*];
association [1..*] Order -> (contains) Pizza [*];
association [1] EntertainmentOrder -> (fulfilledBy) Entertainer [1];
association [*] Entertainer -> (availableAt) PizzaRestaurant [*];
association [*] Entertainer -> (availability) Availability [*];

}
