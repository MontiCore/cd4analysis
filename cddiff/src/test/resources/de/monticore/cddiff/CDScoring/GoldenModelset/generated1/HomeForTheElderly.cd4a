
// CD4A Class Diagram for Home for the Elderly

classdiagram homeElderly {

    class Home {
        List<Department> departments;
    }

    class Department {
        List<Room> rooms;
    }

    class Room {
        List<Bed> beds;
    }

    class Bed {
        Category category;
        Inhabitant inhabitant; // A bed can only have one inhabitant at a time.
    }

    enum Category {
        RH, // Rest Home
        RNH, // Rest & Nursing Home
        SF; // Service Flat
    }

    class Inhabitant {
        List<Stay> stays; // An inhabitant can have multiple stays at a time.
        void register(); // The registration process.
        void assessNeeds(); // Assessment for type of stay.
    }

    class Stay {
        Category category;
        Date intakeDate;
        boolean isProposalAccepted;
        boolean isProposalInvalidated; 
        void reassess(); // Re-assessment of abilities.
        void startStay(); // Start stay on intake date.
    }

    class Proposal {
        Inhabitant inhabitant;
        Category category;
        Date registrationDate;
        void acceptProposal(); // Accept the proposal for stay.
        void refuseProposal(); // Refuse the proposal.
    }

    class Invoice {
        float outstandingAmount;
        boolean isPaid;
        void registerPayment(float amount); // Registering payment.
        void modifyInvoice(); // Modify the invoice if needed.
    }

    association [*] Home -> (departments) Department [*];
    association [*] Department -> (rooms) Room [*];
    association [*] Room -> (beds) Bed [*];
    association [*] Inhabitant -> (stays) Stay [*];
    association [1] Bed -> Inhabitant [1]; // A bed is assigned to one inhabitant.
    association [1] Stay -> Category [1];
    association [*] Inhabitant -> Proposal [*]; // Inhabitants can have proposals.
}

