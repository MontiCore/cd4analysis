
// CD4A Model for Home for the Elderly

classdiagram HomeForElderly {

class Inhabitant {
    int id;
    String name;
}

class Bed {
    String category;
}

class Room {
    int roomNumber;
}

class Department {
    int departmentNumber;
}

class Stay {
    Date intakeDate;
    String typeOfStay;
    boolean isActive;
}

class Registration {
    Date registrationDate;
}

class Assessment {
    boolean needsHelpEating;
    boolean needsHelpDressing;
    boolean needsHelpPersonalCare;
}

class Proposal {
    boolean isAccepted;
    Date proposalDate;
}

class Invoice {
    double outstandingAmount;
    String status;
}

class PaymentEvent {
    double amountPaid;
    boolean isRefund;
}

enum StayType {
    RH,
    RNH,
    SF;
}

association [*] Department <-> Room [*];
association [*] Room <-> Bed [*];
association [1] Inhabitant <-> Bed [1];
association [1] Inhabitant <-> Registration [1];
association [1] Inhabitant <-> Assessment [1];
association [1] Inhabitant <-> Stay [*];
association [*] Stay <-> Proposal [1];
association [*] Stay <-> Invoice [*];
association [*] Invoice <-> PaymentEvent [*];
}
