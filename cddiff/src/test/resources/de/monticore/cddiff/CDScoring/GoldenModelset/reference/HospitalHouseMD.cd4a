association [1] Patient <-> Diagnosis [0..*];
association [1] Doctor <-> Diagnosis [0..*];
association [1] Illness <-> Diagnosis [0..*];
association [1] Diagnosis <-> AppliedTreatment [0..*];
association [1] Illness <-> Treatment [0..*];
