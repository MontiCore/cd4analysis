
classdiagram louvreMuseum {

    class Museum {
        List<Location> locations;
    }

    class Location {
        String name;
        List<Exhibition> exhibitions;
    }

    class Exhibition {
        String title;
        Date openingDate;
        Employee coordinator;
        List<ExhibitionItem> desiredItems;
    }

    class ExhibitionItem {
        String description;
        List<Piece> potentialPieces;
    }

    class Piece {
        String name;
        Collector collector;
    }

    class Employee {
        String name;
        Employee coach; // A senior employee for coaching
    }

    class Collector {
        String name;
        List<Piece> pieces; // Pieces owned by the collector
    }

    association [*] Museum -> (locations) Location [*];
    association [*] Location -> (exhibitions) Exhibition [*];
    association [*] Exhibition -> (desiredItems) ExhibitionItem [*];
    association [*] ExhibitionItem -> (potentialPieces) Piece [*];
    association [*] Employee -> (coachedBy) Employee [0..1]; // Coaching relationship
    association [*] Collector -> (pieces) Piece [*];
}
