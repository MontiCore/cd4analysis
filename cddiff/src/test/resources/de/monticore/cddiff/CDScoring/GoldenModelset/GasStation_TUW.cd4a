
classdiagram gasStationChain {

class GasStation {
    String stationId;
    String address;
    List<FuelPump> fuelPumps;
    List<DailyPrice> dailyPrices;
}

class FuelPump {
    int pumpNumber;
    boolean isSelfService;
    List<Fuel> offeredFuels;
}

class Fuel {
    String name;
    float octaneRating;
}

class DailyPrice {
    Date date;
    Fuel fuel;
    GasStation gasStation;
    float pricePerLiter;
}

class FuelPurchase {
    String purchaseId;
    FuelPump fuelPump;
    DailyPrice dailyPrice;
    float litersDispensed;
}

// Associations
association [1] GasStation -> (has) FuelPump [0..12];
association [1] FuelPump -> (offers) Fuel [*];
association [1] GasStation -> (archives) DailyPrice [*];
association [1] FuelPump -> (records) FuelPurchase [0..*];
association [1] DailyPrice -> (appliesTo) Fuel [1];
association [1] DailyPrice -> (at) GasStation [1];
association [1] FuelPurchase -> (madeAt) FuelPump [1];
association [1] FuelPurchase -> (basedOn) DailyPrice [1];
}
