
classdiagram ResearchProjectManagement {

    class University {}

    class Department {}

    class ResearchGroup {
        String name;
    }

    class Researcher {
        String name;
    }

    class Project {}

    class WorkPackage {
        ResearchGroup wpLeader;
    }

    association [*] University -- Department [*];
    association [*] Department -- ResearchGroup [*];
    association [1] ResearchGroup <-> Researcher [*];
    association [*] ResearchGroup -> WorkPackage [*];
    association [*] Researcher -> WorkPackage [*];

}
