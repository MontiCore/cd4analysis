classdiagram Menso {

class BusLine {
    String destination;
}

class PriceCategory {
    double price;
}

class Trajectory {
    String status;
}

class Bus {}

class BusOnTrajectory {}

class Trip {}

class MensoTicket {}

class MensoTrip {
    DateTime tripDateTime;
}

class InvoiceLine {}

class Invoice {
    double total;
    double discount;
}

class Customer {
    String name;
    String homeAddress;
    String officeAddress;
    String workingHours;
}

association [0..*] BusLine <-> PriceCategory [0..1];
association [1] BusLine <-> Trajectory [0..*];
association [1] Trajectory <-> BusOnTrajectory [0..*];
association [1] Bus <-> BusOnTrajectory [0..*];
association [1] BusOnTrajectory <-> Trip [0..*];
association [1] MensoTicket <-> MensoTrip [0..*];
association [1] BusOnTrajectory <-> MensoTrip [0..*];
association [1] MensoTrip <-> InvoiceLine [0..1];
association [1] Invoice <-> InvoiceLine [0..*];
association [1] Customer <-> MensoTicket [0..*];
association [1] MensoTicket <-> Invoice [0..*];

}
