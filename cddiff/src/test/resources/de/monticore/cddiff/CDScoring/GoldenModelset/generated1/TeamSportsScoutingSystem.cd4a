
classdiagram teamSportsScoutingSystem {

    class Employee {
        String name;
    }

    class HeadCoach extends Employee {
        void identifyPlayerProfile(String position);
        void evaluateShortList();
    }

    class Director extends Employee {
        void makeOffer(Player player);
    }

    class Scout extends Employee {
        void notePlayer(Player player);
        void submitScoutingReport(Player player, String pros, String cons, Recommendation recommendation);
    }

    class Player {
        String name;
        String position; // e.g., GK for goalkeeper, LB for left back
        List<Attribute> attributes; // player attributes identified by name and value
    }

    class Attribute {
        String name;
        String value;
    }

    class ScoutingAssignment {
        Player player;
        List<Scout> scouts;
        void evaluateScoutingResults();
    }

    class ScoutingReport {
        String pros;
        String cons;
        Recommendation recommendation;
    }

    enum Recommendation {
        KEY_PLAYER,
        FIRST_TEAM_PLAYER,
        RESERVE_TEAM_PLAYER,
        PROSPECTIVE_PLAYER,
        NOT_A_GOOD_SIGNING;
    }

    association [*] HeadCoach -> (designatedProfiles) Player [*]; // Designated target profiles
    association [*] Scout -> (longList) Player [*]; // Players noted on the long list
    association [1] HeadScout -> (shortList) Player [*]; // Players on the short list
    association [*] ScoutingAssignment -> (evaluatedBy) Scout [*]; // Scouts assigned to evaluate players
    association [1] ScoutingAssignment -> Player [1]; // Each assignment relates to one player
}
