
classdiagram TeamSportsScoutingSystem {
    class Employee {
        String name;
    }
    
    class HeadCoach extends Employee {
        void identifyPlayerProfile();
    }
    
    class Director extends Employee {
        void makeOffer();
    }
    
    class Scout extends Employee {
        void notePlayer();
        void submitScoutingReport();
    }
    
    class PlayerProfile {
        String targetPosition;
        Attribute[] attributes;
    }
    
    class Attribute {
        String name;
        String value;
    }
    
    class LongList {
        PlayerProfile[] playerProfiles;
    }
    
    class ScoutingAssignment {
        void evaluateLongList();
        void investigatePlayer();
    }
    
    class ScoutingReport {
        String pros;
        String cons;
        String recommendation; // e.g., key player, first team player, etc.
    }

    class ShortList {
        PlayerProfile[] playerProfiles;
    }

    association [*] Employee -> (assigned) ScoutingAssignment [*];
    association [1] HeadCoach -> (identified) PlayerProfile [*];
    association [*] Scout -> (noted) PlayerProfile [*];
    association [1] Scout -> (submitted) ScoutingReport [*];
    association [1] ScoutingAssignment -> (evaluates) LongList [1];
    association [1] ScoutingAssignment -> (investigates) PlayerProfile [1];
    association [1] HeadScout -> (decides) ShortList [1];
    association [1] Director -> (makes) Offer [1];
}
