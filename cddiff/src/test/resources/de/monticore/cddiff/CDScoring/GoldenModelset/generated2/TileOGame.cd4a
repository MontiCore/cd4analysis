
classdiagram tileo {

    class Color {
        // The LLM did not generate this class, adding it to avoid errors
    }

    class Game {
        Board board;
        Player[] players; // Up to 4 players
        int currentPlayerIndex;
        void startGame();
        void nextTurn();
        void rollDie();
        void movePiece(Player player, Tile tile);
        void endGame(Player winner);
    }

    class Board {
        Tile[][] tiles; // 2D array of tiles
        ConnectionPiece[] spareConnectionPieces;
        Tile hiddenTile;
        void setHiddenTile(Tile tile);
        void setStartingPositions(Player[] players);
        void addActionTile(Tile tile, int duration);
    }

    class Tile {
        Color color; // Color of the tile
        Tile[] connectedTiles; // Up to 4 connected tiles (left, right, top, bottom)
        boolean isActionTile;
        boolean isVisited;
        void changeColor();
        void connectTile(Tile tile, String direction); // direction: left, right, top, bottom
    }

    class Player {
        String name;
        Color pieceColor; // Color of the player's piece
        Tile currentTile;
        void rollDie();
        void moveToTile(Tile tile);
    }

    class ActionCard {
        ActionType actionType;
        void execute(Player player, Game game);
    }

    class Designer {
        void defineGame(Board board);
        void defineActionDeck(ActionCard[] actionCards);
    }

    enum ActionType {
        EXTRA_TURN,
        CONNECT_TILES,
        REMOVE_CONNECTION,
        MOVE_TO_TILE,
        LOSE_TURN;
    }

    association [1] Game -> (players) Player [2..4];
    association [1] Board -> (tiles) Tile [*];
    association [1] Designer -> Board [*];
    association [1] Board -> ActionCard [32]; // A deck of 32 action cards
    association [1] Tile -> Tile [0..4]; // Each tile can connect to at most 4 tiles
}
