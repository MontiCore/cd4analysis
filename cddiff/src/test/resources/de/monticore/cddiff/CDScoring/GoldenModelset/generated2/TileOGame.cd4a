
classdiagram TileO {

    class Game {
        BoardGame boardGame;
        Player[] players;
        Player currentPlayer;
        void rollDie();
        void movePiece();
    }

    class BoardGame {
        Tile[][] tiles;
        ActionTile actionTile;
        Tile hiddenTile;
        void connectTiles(Tile tileA, Tile tileB);
    }

    class Tile {
        String color; // values can be "white" or "black"
        boolean isConnected; // 0: right, 1: left, 2: top, 3: bottom
    }

    class ActionTile extends Tile {
        int turnsActive;
    }

    class ConnectionPiece {}

    class Player {
        String color;
        PlayingPiece piece;
        void takeTurn();
    }

    class PlayingPiece {
        String color;
        void move();
    }

    class ActionCard {
        String actionType; // can be "extraTurn", "connectTiles", "removeConnection", "moveToTile", "loseTurn";
    }

    class Designer {
        void defineGame();
        void defineBoard();
        void defineHiddenTile(Tile tile);
        void defineStartingPositions();
        void defineActionCards(ActionCard[] actionCards);
    }

    class Die {}

    association [1] Game -> (boardGame) BoardGame [1];
    association [2..4] Game -> (players) Player [1];
    association [1] Player -> (piece) PlayingPiece [1];
    association [1] BoardGame -> (tiles) Tile [*];
    association [1] BoardGame -> (hiddenTile) Tile [1];
    association [1] BoardGame -> (actionTile) ActionTile [1];
    association [*] Designer -> (actionCards) ActionCard [32];
}
