
classdiagram FilmSetSystem {

    // Basic entities
    class Employee {
        String name;
        String socialSecurityNumber;
    }

    class CreativeEmployee extends Employee {
        boolean hasOscar;
    }

    class Director extends CreativeEmployee {
        Optional<String> assistantName;
    }

    class Actor extends CreativeEmployee {
        String educationCompleted;
    }

    class Technician extends Employee {
        String fieldOfActivity;
    }

    class FilmSet {
        String location;
    }

    class Film {
        String title;
        int yearOfRelease;
        FilmGenre genre;
    }

    enum FilmGenre {
        THRILLER,
        ACTION,
        HORROR,
        COMEDY;
    }

    class Screenwriter {
        String name;
        Optional<String> mostSuccessfulFilm;
    }

    class Screenplay {
        String title;
        int version;
        String date;
        int numberOfScenes;
        String plot;
        ScreenplaySourceType sourceType; // Indicates if based on novel or concept
    }

    enum ScreenplaySourceType {
        NOVEL,
        CONCEPT;
    }

    class Novel {
        String title;
        String author;
    }

    // Associations
    association [1] Actor -> (preparesFor) Screenplay [1];
    association [1] Director -> (realizes) Screenplay [1];
    association [1..*] FilmSet -> Film [*];
    association [*] Film -> (shotOn) FilmSet [*];
    association [1] Screenplay -> (writtenFor) Film [1];
    association [1] Screenplay -> Screenwriter [1];
    association [1] Screenplay -> (basedOn) Novel [0..1]; // Optional: Only required if sourceType is "NOVEL".
}
