
// Class Diagram for LabTracker software
classdiagram labtracker {

    class Doctor {
        String practitionerNumber;
        String signature; // digital signature as an image
        String fullName;
        String address;
        String phoneNumber;
        Date requisitionValidityDate;
        // Cannot prescribe tests for themselves
        void prescribeTest(Patient patient, Requisition requisition);
    }

    class Patient {
        String healthNumber; // alpha-numeric
        String firstName;
        String lastName;
        Date dateOfBirth;
        String address;
        String phoneNumber;
        void bookAppointment(Requisition requisition, Lab lab);
        void viewTestResults();
    }

    class Requisition {
        Doctor doctor;
        Patient patient;
        List<Test> tests; // tests can be combined if they belong to the same group
        void addTest(Test test);
        void indicateRepetition(int numberOfTimes, Interval interval);
        // Viewing results
        List<Result> viewResults();
    }

    class Test {
        String name;
        Duration duration; // defined by the lab network
        boolean isAppointmentRequired; // true for those needing an appointment
        boolean isWalkInOnly; // true for tests that are walk-in only
    }

    class Lab {
        String name;
        String registrationNumber;
        String address;
        List<BusinessHours> businessHours;
        Fee cancellationFee; // determined by the lab
        void acceptAppointment(Appointment appointment);
        // Labs are always open and offer all tests
    }

    class Appointment {
        String confirmationNumber;
        Date date;
        Time startTime;
        Time endTime;
        Lab lab;
        void changeAppointment();
        void cancelAppointment();
    }

    enum Interval {
        WEEKLY,
        MONTHLY,
        HALF_YEARLY,
        YEARLY;
    }
    
    association [1] Doctor -> (prescribes) Requisition [*]; // A doctor can prescribe multiple requisitions
    association [1] Patient -> (books) Appointment [*]; // A patient can book multiple appointments
    association [1] Requisition -> (contains) Test [*]; // A requisition can contain multiple tests
    association [1] Lab -> (offers) Test [*]; // Each lab offers all tests
}
