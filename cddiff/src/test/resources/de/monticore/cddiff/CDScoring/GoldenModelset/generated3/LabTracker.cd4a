
classdiagram LabTracker {

class Doctor {
    int practitionerNumber;
    String fullName;
    String address;
    String phoneNumber;
    Image signature;
    Date validFrom;
}

class Patient {
    String healthNumber;
    String firstName;
    String lastName;
    Date dateOfBirth;
    String address;
    String phoneNumber;
}

class Requisition {
    Doctor doctor;
    Patient patient;
    TestGroup testGroup;
    Repetition repetition;
}

class TestGroup {
    Test[] tests;
}

class Test {
    String name;
    Duration duration;
    boolean requiresAppointment;
    boolean isWalkInOnly;
    boolean requiresSampleDropOff;
    Result result;
}

class Appointment {
    Patient patient;
    Lab lab;
    Date appointmentDate;
    Time startTime;
    Time endTime;
    String confirmationNumber;
}

class Lab {
    String address;
    String registrationNumber;
    BusinessHours businessHours;
    Fee cancellationFee;
}

class Result {
    String status;
    Report report;
}

class Report {
    String details;
}

class Repetition {
    int numberOfRepetitions;
    Interval interval;
}

enum Interval {
    Weekly,
    Monthly,
    HalfYearly,
    Yearly;
}

class Duration {
    int durationInMinutes;
}

class BusinessHours {
    Time startTime;
    Time endTime;
}

association [1] Doctor -> Requisition [*];
association [1] Patient -> Requisition [*];
association [1] Requisition -> TestGroup [1];
association [1] TestGroup -> Test [*];
association [1] Test -> Result [0..1];
association [1] Test -> Appointment [0..1];
association [1] Appointment -> Lab [1];
association [1] Lab -> BusinessHours [1];
association [1] Lab -> Fee [1];
}
