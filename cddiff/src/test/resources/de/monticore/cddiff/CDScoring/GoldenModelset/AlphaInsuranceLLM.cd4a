
classdiagram AlphaInsurance {

class Customer {
    String customerId;
    String fullName;
    String emailAddress;
    List<String> phoneNumbers;
    List<InsurancePolicy> policies;
}

class Broker {
    String brokerId;
    String fullName;
    String emailAddress;
    String phoneNumber;
    List<Customer> assignedCustomers;
}

class InsurancePolicy {
    String policyId;
    String policyType; // e.g., life, health, car, etc.
    Optional<String> description;
    double price;
    String paymentCycle; // monthly or yearly
}

class Contract {
    String contractId;
    Date signingDate;
    InsurancePolicy insurancePolicy;
    Customer customer;
    Broker broker;
}

class Claim {
    String claimId;
    Date claimDate;
    Optional<String> description;
    List<ClaimCase> cases;
}

class ClaimCase {
    String caseId;
    String type; // e.g., material damage, physical damage
    Optional<String> description;
    List<EstimatorReport> reports;
    boolean isApproved;
    double compensationAmount;
}

class Estimator {
    String estimatorId;
    String fullName;
    String areaOfExpertise;
}

class EstimatorReport {
    String reportId;
    Date reportDate;
    Estimator estimator;
    ClaimCase claimCase;
    Optional<String> findings;
}

// Associations
association [1] Broker -> (assignedTo) Customer [*];
association [1] Customer -> (hasPurchased) InsurancePolicy [*];
association [1] Contract -> Customer [1];
association [1] Contract -> Broker [1];
association [1] Contract -> InsurancePolicy [1];
association [1] Customer -> (hasFiled) Claim [*];
association [1] Claim -> ClaimCase [*];
association [1..*] ClaimCase -> EstimatorReport [*];
association [1] EstimatorReport -> Estimator [1];

}
