
classdiagram transportCompany {

class Person {
    String name;
    String socialSecurityNumber;
}

class Employee extends Person {
}

class Driver extends Employee {
}

class Planner extends Employee {
    String username;
    String password;
}

class AdministrativeStaff extends Employee {
    String username;
    String password;
    String fieldOfActivity;
}

class Customer {
    String name;
    String billingAddress;
}

class Vehicle {
    String licensePlateNumber;
    int mileage;
    VehicleType type;
}

enum VehicleType {
    REFRIGERATED_TRUCK,
    SMALL_VAN,
    LOADING_PLATFORM,
    BOX_TRUCK;
}

class RepairShop {
    String name;
    String address;
}

class Repair {
    RepairShop repairShop;
    Employee responsibleEmployee;
    int durationInHours;
    double cost;
}

class Order {
    String comment;
    String pickUpAddress;
    String deliveryAddress;
    Timestamp startTime;
    Timestamp endTime;
    Planner assignedPlanner;
    Driver responsibleDriver;
    Vehicle assignedVehicle;
    Customer client;
}

class PartnerCompany {
    String name;
    String address;
}

// Associations
association handledBy [1] Planner -> Order [*];
association fulfills [*] Driver -> Order [*];
association requires [1] Order -> Vehicle [1];
association [1] Order -> (placedBy) Customer [1..*];
association [0..1] Order -> (placedVia) PartnerCompany [0..1];
association assignedTo [1] Driver -> Vehicle [*];
association [*] Repair -> RepairShop [1];
association [*] Repair -> (responsibleEmployee) Employee [1];
association [1..*] Vehicle -> Repair [*];

}
