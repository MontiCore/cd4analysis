
classdiagram SmartHomeAutomationSystem {

class SmartHome {
    String physicalAddress;
}

class Room {
    String name;
}

class Device {
    String deviceId;
}

class Sensor extends Device {
    double value;
    Date timestamp;
}

class Actuator extends Device {
    String command;
    Date timestamp;
    String status; // e.g. requested, completed, failed
}

class ActivityLog {
}

class AutomationRule {
    String precondition; // Boolean expression
    String action; // sequence of control commands
    boolean isActive;
    Date triggerTimestamp;
}

association [1] SmartHome <-> Room [0..*];
association [1] Room <-> Sensor [0..*];
association [1] Room <-> Actuator [0..*];
association [1] SmartHome <-> ActivityLog [0..*];
association [1] SmartHome <-> AutomationRule [0..*];

}
