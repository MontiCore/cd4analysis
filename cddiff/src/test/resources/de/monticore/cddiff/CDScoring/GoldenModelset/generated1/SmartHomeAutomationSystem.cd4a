
// Class diagram for Smart Home Automation System (SHAS)

classdiagram shas {

    class SmartHome {
        String address;
        List<Room> rooms;
    }

    class Room {
        String name;
        List<SensorDevice> sensorDevices;
        List<ActuatorDevice> actuatorDevices;
    }

    abstract class Device {
        String deviceId; // unique identifier
    }

    class SensorDevice extends Device {
        List<SensorReading> readings;
        void activate();
        void deactivate();
    }

    class ActuatorDevice extends Device {
        List<ControlCommand> commands;
        void activate();
        void deactivate();
    }

    class SensorReading {
        double value;
        Date timestamp;
    }

    class ControlCommand {
        String commandType; // e.g., lockDoor, turnOnHeating
        Date timestamp;
        String status; // e.g., requested, completed, failed
    }
    
    class ActivityLog {
        List<SensorReading> sensorReadings;
        List<ControlCommand> controlCommands;
    }

    class AutomationRule {
        String precondition; // Boolean expression
        List<ControlCommand> action;
        boolean isActive;
        void activate();
        void deactivate();
        void edit();
    }

    association [*] SmartHome -> (contains) Room [*];
    association [*] Room -> (has) SensorDevice [*];
    association [*] Room -> (has) ActuatorDevice [*];
    association [*] SensorDevice -> (records) SensorReading [*];
    association [*] ActuatorDevice -> (executes) ControlCommand [*];
    association [*] SmartHome -> (logs) ActivityLog [1];
    association [*] SmartHome -> (manages) AutomationRule [*];
}
