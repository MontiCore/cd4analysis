
classdiagram Musicmatic {

class Song {
    String title;
    int year;
    double length;
    String genre;
}

class Artist {
    String name; // Unique identifier
    Date dateOfBirth;
    String url; // URL to additional artist info
}

// Associations for Songs and Artists
association belongsTo [1] Song -> Artist [1];

class User {
    String id; // Unique identifier
    String name;
    String address;
}

class RegularUser extends User {
    List<Album> albumsOwned; // Albums purchased by the regular user
    List<Song> singlesOwned; // Singles purchased by the regular user
}

class BusinessUser extends User {
    String vatNumber;
    List<Song> songsUploaded; // Songs uploaded by the business user
}

abstract class Single {
    boolean isAvailableForPurchase;
}

class Hit extends Song {
    boolean isPartOfAlbum;
}

class Album {
    String name;
    List<Hit> songs;
    List<int> trackNumbers; // Track number positions
}

// Associations for User roles
association [1..*] BusinessUser (uploads) -> Single [*];
association [1..*] RegularUser (purchases) -> Album [*];
association [1] RegularUser (purchasesSingle) -> Single [*];
association [*] Album -> (suggestedTo) RegularUser [*]; // Suggestion links between users

}
