/* (c) Musicmatic Class Diagram */

classdiagram MusicmaticLLM {

  // ------------------- Core Domain -------------------

  class Song {
    String title;
    int year;
    double length;
    String genre;
  }

  class Artist {
    String name;
    Date dateOfBirth;
    String url;
  }

  association [1] Song -> (artist) Artist [1];
  // Each song belongs to exactly one artist.

  // ------------------- Users -------------------

  class User {
    int id;
    String name;
    String address;
  }

  class RegularUser extends User {}

  class BusinessUser extends User {
    String vatNumber;
  }

  // Note: A user can act both as RegularUser and BusinessUser.
  // This dual role is difficult to represent in CD4A directly,
  // but we document it here for clarity.

  // ------------------- Song Types -------------------

  class Single extends Song {}
  class Hit extends Song {}

  // Business Users upload Songs
  association [1] BusinessUser -> (uploads) Song [*];

  // Regular Users buy Singles
  association [1] RegularUser -> (purchases) Single [*];

  // ------------------- Albums -------------------

  class Album {
    String name;
  }

  // Album consists of multiple Hits
  association [1] Album -> (tracks) Hit [*];

  // Regular Users can create Albums
  association [1] RegularUser -> (creates) Album [*];

  // ------------------- Suggestions -------------------

  // An Album of a RegularUser can be suggested to other RegularUsers
  association [*] RegularUser -> (suggestedAlbums) Album [*];
}
