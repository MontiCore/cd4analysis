
classdiagram HospitalHouseMD {

enum PriorityScore {
    HIGH,
    LOW;
}

enum TreatmentStage {
    STAGE_1,
    STAGE_2,
    STAGE_3;
}

class Patient {
    String name;
    int age;
    boolean consentGiven;
}

class Doctor {
    String name;
    String specialization;
    boolean isHeadDoctor;
}

class Illness {
    String name;
    PriorityScore priority;
}

class Diagnosis {
    Illness illness;
    Doctor approvedBy; // Reference to the head doctor who approves the diagnosis
    List<Treatment> treatments;
}

class Treatment {
    String name;
    TreatmentStage stage;
    boolean isStage3FollowupNeeded;
}

class Nurse {
    String name;
}

// Associations
association [*] Patient -> (assignedTo) Doctor [1..*];
association [*] Doctor -> (makes) Diagnosis [*];
association [1] Diagnosis -> Treatment [*];
association [*] Patient -> (receivesDiagnosisFor) Diagnosis [*];
association [*] Illness -> (hasTreatmentOptions) Treatment [*];
association [*] Nurse -> (followsUpOn) Treatment [0..*];

}
