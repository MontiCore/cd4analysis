
classdiagram HelpingHandsStore {

    class HelpingHandsStore {
        Location location;
        PickupService pickupService;
    }

    class Location {
        String city;
    }

    class Resident {
        String name;
        String streetAddress;
        String phoneNumber;
        String emailAddress;  // Optional
        String itemDescription;
    }

    class PickupService {
        void schedulePickup(Resident resident);
        void determinePickupRoute(Vehicle vehicle);
    }

    class Vehicle {
        String vehicleId;
        float storageSpace;
    }

    class VolunteerDriver {
        String name;
        List<DayOfWeek> availableDays;
        void indicateAvailability();
    }

    class H2SEmployee {
        void examineArticle(Article article);
        void assignCategory(Article article, Category category);
        void notifyClients();
    }

    class Article {
        String description;
        RFIDTag rfidTag;
        Category category;
    }

    class RFIDTag {
        String id;
    }

    class Category {
        String name;  // e.g., baby clothing, women’s winter boots, etc.
    }

    enum DayOfWeek {
        Monday,
        Tuesday,
        Wednesday,
        Thursday,
        Friday;
    }

    association [1] HelpingHandsStore -> (location) Location [*];
    association [*] HelpingHandsStore -> (pickupService) PickupService [1];
    association [*] PickupService -> (scheduledPickup) Resident [*];
    association [1] PickupService -> (vehicle) Vehicle [*];
    association [1] Vehicle -> (driver) VolunteerDriver [*];
    association [*] H2SEmployee -> (examine) Article [*];
    association [1] Article -> (tag) RFIDTag [0..1];
    association [1] Article -> (category) Category [1];

}
