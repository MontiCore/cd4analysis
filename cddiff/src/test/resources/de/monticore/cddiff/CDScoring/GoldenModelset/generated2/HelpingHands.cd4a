
// Class Diagram for Helping Hands Store (H2S)
classdiagram h2s {

    class H2S {
        String name;
        List<Location> locations; // Different operating cities
    }

    class Location {
        String cityName;
        List<PickupRequest> pickupRequests;
        List<VolunteerDriver> volunteerDrivers;
        DistributionCenter distributionCenter;
    }

    class PickupRequest {
        String residentName;
        String streetAddress;
        String phoneNumber;
        String emailAddress; // Optional
        String description;
        Time pickupTime; // Scheduled time for pickup
    }

    class VolunteerDriver {
        String name;
        List<Day> availableDays;
        List<PickupRequest> assignedRequests;
        void indicateAvailability(); // Method for indicating available days
    }

    class Fleet {
        List<Vehicle> vehicles; // Group of pickup vehicles
        void determinePickupRoute(); // Method to plan routes based on availability
    }

    class Vehicle {
        String licensePlate;
        double storageSpace; // Available storage space of the vehicle
    }

    class DistributionCenter {
        List<Article> receivedArticles;
        void examineQuality(Article article); // Method to check quality
    }

    class Article {
        String description;
        String rfidTag; // RFID tag for the article
        Category category; // Article category
    }

    enum Category {
        BABY_CLOTHING,
        WOMENS_WINTER_BOOTS,
        FRIDGE,
        MICROWAVE;
        // ... other categories up to 134
    }

    class Client {
        String name;
        List<Category> requestedCategories; // Categories of articles needed
        void requestArticles(); // Method for requesting articles
    }

    association [*] H2S -> (locations) Location [*];
    association [*] Location -> (pickupRequests) PickupRequest [*];
    association [*] Location -> (volunteerDrivers) VolunteerDriver [*];
    association [1] Location -> (distributionCenter) DistributionCenter [1];
    association [*] DistributionCenter -> (receivedArticles) Article [*];
    association [*] Article -> (category) Category [1];
    association [*] Client -> (requestedCategories) Category [*];
}
