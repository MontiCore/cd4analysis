
classdiagram GameAreaModel {

class GameArea {
    String name;
}

class GameElement {
    protected long x;
    private long y;
}

class Shape extends GameElement {}

class Object extends GameElement {}

class Opponent extends GameElement {
    protected int lives;
    
    void kill();
}

class Boss extends Opponent {}

association [1..*] GameElement -> (contains) GameArea [1];
association [1] Opponent <-> (is) GameArea [1];

association [*] Shape <-> Shape [*];

}
