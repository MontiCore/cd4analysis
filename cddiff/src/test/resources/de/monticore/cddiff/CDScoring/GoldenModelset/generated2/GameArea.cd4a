
classdiagram gameArea {

    class GameArea {
        String name;
        GameElement boss;
    }

    abstract class GameElement {
        protected long x;
        private long y;
    }

    class Shape extends GameElement {
    }

    class Object extends GameElement {
        // class body, could have specific attributes/methods
    }

    class Opponent extends GameElement {
        protected int lives;
        void kill();
    }

    class Enemy extends Opponent {
        // class body, could have specific attributes/methods
    }

    association [1..*] GameElement -> (elements) GamePiece [1..2];
    association [0..*] Shape -> (connectedShapes) Shape [0..*];
}
