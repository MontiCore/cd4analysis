
// Class diagram for research project management in a university
classdiagram researchProjectManagement {

    class University {
        // Holds multiple departments
    }
    
    class Department {
        // Holds multiple research groups
    }
    
    class ResearchGroup {
        String name; // Name of the research group
        // Holds researchers and Work Packages
    }

    class Researcher {
        String name; // Name of the researcher
        ResearchGroup researchGroup; // Research group of the researcher
    }

    class Project {
        // Holds multiple Work Packages
    }

    class WorkPackage {
        ResearchGroup wpLeader; // The research group leading the Work Package
        List<Researcher> teamMembers; // Assigned researchers to the Work Package
    }

    // Association establishing the relationship between classes
    association [*] University -> (departments) Department [*];
    association [*] Department -> (researchGroups) ResearchGroup [*];
    association [1] ResearchGroup <-> Researcher [*]; // Each researcher belongs to exactly one research group
    association [1] ResearchGroup -> (wpLeadership) WorkPackage [*]; // Research Group leads Work Packages
    association [*] WorkPackage -> (teamMembers) Researcher [*]; // Researcher can be assigned to any Work Package
}
