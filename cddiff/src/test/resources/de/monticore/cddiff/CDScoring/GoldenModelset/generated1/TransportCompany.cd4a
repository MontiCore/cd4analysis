
classdiagram TransportCompany {

abstract class Employee {
    String name;
    int ssn;
}

class Driver extends Employee {
    // Additional driver specific attributes can be added here
}

class Planner extends Employee {
    String username;
    String password;
}

class AdministrativeStaff extends Employee {
    String fieldOfActivity;
}

class Customer {
    String name;
    String billingAddress;
}

abstract class Vehicle {
    String licensePlateNumber;
    int mileage;
}

class RefrigeratedTruck extends Vehicle {
    // Specific attributes for refrigerated trucks can be added here
}

class SmallVan extends Vehicle {
    // Specific attributes for small vans can be added here
}

class LoadingPlatform extends Vehicle {
    // Specific attributes for loading platforms can be added here
}

class BoxTruck extends Vehicle {
    // Specific attributes for box trucks can be added here
}

class RepairShop {
    String name;
    String address;
}

class Repair {
    RepairShop repairShop;
    Employee employee;
    int duration;
    double cost;
}

class Order {
    String packageSize;
    String comment;
    Date startTime;
    Date endTime;
    Customer customer;
    Address pickupAddress;
    Address deliveryAddress;
}

association [*] Planner <-> (assigns) Order [*];
association [*] Driver <-> (completes) Order [*];
association [*] Vehicle <-> (assignedTo) Order [*];
association [*] Customer <-> (places) Order [*];
association [1] AdministrativeStaff <-> (takesOrder) Order [0..1];
association [*] PartnerCompany <-> (places) Order [0..1];
association [1] PartnerCompany <-> (name) String [0..1];
association [1] PartnerCompany <-> (address) String [0..1];

}
