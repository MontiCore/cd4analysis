
// Class diagram for a transport company management system

classdiagram transportCompany {

    class Employee {
        String name;
        String socialSecurityNumber;
    }

    class Planner extends Employee {
        String username;
        String password;
    }

    class AdministrativeStaff extends Employee {
        String username;
        String password;
        String fieldOfActivity;
    }

    class Customer {
        String name;
        String billingAddress;
    }

    abstract class Vehicle {
        String licensePlateNumber;
        int mileage;
    }

    class RefrigeratedTruck extends Vehicle {}
    class SmallVan extends Vehicle {}
    class LoadingPlatform extends Vehicle {}
    class BoxTruck extends Vehicle {}

    class RepairShop {
        String name;
        String address;
        Employee employee;
        int duration; // duration of repair
        double cost; // cost of repair
    }

    class Order {
        Customer customer;
        Vehicle vehicle;
        Planner planner;
        String comment;
        Date startTime;
        Date endTime;
        String pickupAddress;
        String deliveryAddress;
        PartnerCompany partnerCompany; // optional, if the order is through a partner
    }

    class PartnerCompany {
        String name;
        String address;
    }

    association [*] Employee -> (assignedTo) Order [*];
    association [*] Planner -> (assigns) Order [*];
    association [1] Order -> (vehicle) Vehicle [1];
    association [1] Order -> (customer) Customer [1];
    association [*] Order -> (processedBy) AdministrativeStaff [0..*];
    association [1] RepairShop -> (forVehicle) Vehicle [1];
}
