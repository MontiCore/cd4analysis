
classdiagram ehome2020 {

    class Apartment {
        String address;
        List<Room> rooms;
        List<Inhabitant> inhabitants;
        String emailAddress; // for alerts
    }

    class Room {
        String description;
        List<Sensor> sensors;
    }

    class Sensor {
        String vendorId; // Unique identifier
        String description; // e.g. "temperature radiator living room"
        Unit unit; // e.g. CELSIUS, WATT
        float lastValue; // The last measured value
        List<MeasuredValue> measuredValues; // history of values
        Room room; // assigned to one room
    }

    class TemperatureSensor extends Sensor {
        float minValue; // Minimum valid value
        float maxValue; // Maximum valid value
    }

    class PowerSensor extends Sensor {
        float counterReading; // Total power consumption
    }

    class MeasuredValue {
        float value; // Measured value
        Timestamp timestamp; // Time of measurement
    }

    class SensorController {
        List<Sensor> sensors; // Connected sensors
        void querySensorValues(); // Method to query sensor values
        void setThreshold(Sensor sensor, float threshold); // Set threshold for sensors
    }

    class Inhabitant {
        String username;
        String password;
        boolean isAdmin; // Administrative rights

        void logIn(String username, String password); // Method to log in
    }

    class EMonitor {
        void checkThresholds(); // Method to check sensor thresholds
    }

    enum Unit {
        CELSIUS,
        WATT;
    }

    association [*] Apartment -> (rooms) Room [2..*];
    association [*] Apartment -> (inhabitants) Inhabitant [2..*];
    association [*] Room -> (sensors) Sensor [*];
    association [1] SensorController -> (sensors) Sensor [*];
    association [*] Sensor -> (measuredValues) MeasuredValue [*];
    association [1] Sensor -> (room) Room [1];
}
