
classdiagram EHome2020 {

enum SensorUnit {
    CELSIUS,
    WATT;
}

class User {
    String username;
    String password;
}

class Apartment {
    String address;
}

class Room {
    String description;
}

class Sensor {
    String vendorId;
    String description;
    SensorUnit unit;
}

class TemperatureSensor extends Sensor {
    float minValue;
    float maxValue;
}

class PowerSensor extends Sensor {
    float totalPowerConsumption;
}

class SensorController {
    Apartment apartment;
}

class SensorValue {
    Date timestamp;
    float value;
}

class Threshold {
    float value;
}

class EMonitor {
    void checkThresholds();
}

association [1] Apartment -- Room [2..*];
association [1] Apartment -- User [0..*];
association [1] SensorController -- (sensors) Sensor [*];
association [1] Sensor -- (lastValue) SensorValue [1];
association [1] Sensor -- (threshold) Threshold [0..1];
association [1] Room -- Sensor [1];
association [1] User -- (administrativeRights) User [0..1];
association [1] User -- (configured) Sensor [0..*];
association [1] EMonitor -- Sensor [*];
}
