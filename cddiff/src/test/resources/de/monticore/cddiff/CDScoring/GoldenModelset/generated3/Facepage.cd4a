
// CD4A class diagram for Facepage social network

classdiagram Facepage {

class User {
    String ID;
    String name;
    String email;
    String dateOfBirth;
}

class Account {
    String accountNumber;
}

class BusinessAccount extends Account {
    String companyName;
    double monthlyFee;
}

class PersonalAccount extends Account {}

class Page {
    String pageName;
    int numberOfVisits;
}

class AdvertisementPage extends Page {
    double bounceRate;
    double clickThroughRate;
    double conversionRate;
}

association [1] User <-> Account [1];
association [1] Account <-> Page [*];
association [1] Page <-> PersonalAccount [0..*];

}
