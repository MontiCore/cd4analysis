
// Class Diagram for Facepage Social Network
classdiagram facepage {

    class User {
        String ID; // unique user identifier
        String name;
        String email;
        Date dateOfBirth;
    }

    class Account {
        String accountNumber; // unique account identifier
        AccountType type; // specifies business or personal account
        void createPage(Page page);
        void deletePage(Page page);
    }

    enum AccountType {
        PERSONAL,
        BUSINESS;
    }

    class PersonalAccount extends Account {
        void sendFriendRequest(User user);
        void receiveFriendRequest(User user);
        void grantPrivileges(Page page, User user);
    }

    class BusinessAccount extends Account {
        String companyName;
        double monthlyFee; // charged for business accounts
    }

    class Page {
        String pageName; // unique per account
        int numberOfVisits; // logged visits
        Account admin; // administrated by exactly one account
    }

    class AdvertisementPage extends Page {
        double bounceRate; // percentage of visitors that leave immediately
        double clickThroughRate; // percentage of visitors that click a banner
        double conversionRate; // percentage of visitors that achieve the intended goal
    }

    association [1] User -> Account [0..1]; // a user can have at most one account
    association [1] Account -> (administers) Page [*]; // accounts can administer multiple pages
    association [1] BusinessAccount -> Page [*]; // business accounts can create multiple advertisement pages
    association [1] Page <-> PersonalAccount [0..*]; // personal accounts can have privileges on other personal pages
}
