
// Class diagram for the social network Facepage
classdiagram Facepage {

class User {
    String id; // Unique ID for each user
    String name;
    String email;
    Date dateOfBirth;
}

class Account {
    String accountNumber; // Unique account number generated by the system
}

class BusinessAccount extends Account {
    String companyName; // Company name for business accounts
    float monthlyFee;
}

class PersonalAccount extends Account {
    // Personal account specific attributes (if any)
}

class Page {
    String pageName; // Unique name for each page
    int visitCount; // Number of visits logged for the page
}

class AdvertisementPage extends Page {
    float bounceRate; // Percentage of visitors that leave immediately
    float clickThroughRate; // Percentage of visitors that click on a banner
    float conversionRate; // Percentage of visitors completing a transaction
}

association [1] User -> Account [0..1]; // A user can have one account
association [1] Account -> Page [*]; // An account can create multiple pages
association [1] Account -> (administers) Page [1]; // Each page must be administered by exactly one account
association [0..*] PersonalAccount <-> PersonalAccount [0..*]; // Personal accounts can grant privileges to other personal accounts
association [0..*] BusinessAccount -> AdvertisementPage [0..*]; // Business accounts can create advertisement pages
association [1] Page -> Account [1]; // Each page is administered by exactly one account

}
