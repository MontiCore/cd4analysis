
classdiagram HBMS {

class Traveller {
 String name;
 String billingInformation;
 String companyName;
 String address;
 TravelPreferences travelPreferences;
 CreditCardInfo creditCardInfo;
}

class TravelPreferences {
 boolean breakfastIncluded;
 boolean freeWifi;
 boolean frontDesk247;
}

class AccommodationSearch {
 String city;
 Date arrivalDate;
 Date departureDate;
 int numberOfRooms;
 RoomType roomType;
 int minHotelRating;
 float maxCostPerNight;
 TravelPreferences optionalTravelPreferences;
}

class Hotel {
 String address;
 String city;
 HotelChain hotelChain;
}

class RoomType {
 String type; // e.g. single, double, twin
}

class Booking {
 String bookingId;
 float price;
 String cityArea;
 int hotelRating;
 TravelPreferences keyPreferences;
 BookingStatus status;
 Date cancellationDeadline;
}

class CreditCardInfo {
 String cardNumber;
 Date expiryDate;
}

class HotelChain {
 String name;
}

class SpecialOffer {
 String offerDetails;
}

enum BookingStatus {
 PRE_PAID,
 PAID_AT_HOTEL;
}

association [0..*] Traveller <-> Booking [0..*];
association [0..*] Hotel <-> AccommodationSearch [0..*];
association [0..*] Hotel <-> Booking [0..*];
association [0..*] Booking <-> SpecialOffer [0..*];
association [0..*] Traveller <-> TravelPreferences [0..1];

}
