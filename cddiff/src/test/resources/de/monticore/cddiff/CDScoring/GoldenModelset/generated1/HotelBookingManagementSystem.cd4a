
classdiagram hmbs {

    class Traveller {
        String name;
        BillingInformation billingInfo; // containing company name and address
        List<TravelPreference> travelPreferences; // optional
        List<Booking> pastBookings;

        void register(String name, BillingInformation billingInfo);
        void searchAccommodation(String city, Date arrivalDate, Date departureDate, int numberOfRooms, RoomType roomType, int minRating, double budget, List<TravelPreference> additionalPreferences);
        void finalizeBooking(CreditCardInfo cardInfo);
        void cancelBooking(Booking booking);
        void receiveOffers(List<SpecialOffer> offers);
    }

    class BillingInformation {
        String companyName;
        String address;
    }

    enum TravelPreference {
        BREAKFAST_INCLUDED,
        FREE_WIFI,
        FRONT_DESK_24_7;
        // other preferences
    }

    class AccommodationSearch {
        String city;
        Date arrivalDate;
        Date departureDate;
        int numberOfRooms;
        RoomType roomType;
        int minRating;
        double budget;
        List<TravelPreference> additionalPreferences;

        List<HotelOffer> availableOffers;
    }

    class Booking {
        String bookingID;
        double price;
        String cityArea;
        int hotelRating;
        List<TravelPreference> keyPreferences;
        boolean isPrePaid;
        Date cancellationDeadline;

        void confirm();
        void cancel();
    }

    class Hotel {
        String name;
        Address address;
        HotelChain hotelChain; // optional

        List<RoomType> availableRoomTypes;

        void announceRoomAvailability(RoomType roomType, Date startDate, Date endDate);
        void informFullBooking(RoomType roomType);
    }

    class Address {
        String street;
        String city;
        String postalCode;
    }

    class HotelChain {
        String name;
        List<Hotel> hotels; // list of hotels under this chain
    }

    enum RoomType {
        SINGLE,
        DOUBLE,
        TWIN;
        // other types
    }

    class SpecialOffer {
        String offerDetails; // details of the offer
        double price;
    }

    class CreditCardInfo {
        String cardNumber;
        String expiryDate;
        String cvv;
    }

    association [1] Traveller -- Booking [*];
    association [1] Hotel -- RoomType [*];
    association [*] Hotel <-> HotelChain [0..1]; // optional association
    association [*] Booking -- TravelPreference [*]; // optional preferences
    association [*] Hotel <-> SpecialOffer [*]; // hotels provide offers
}
