
classdiagram OilCompany {

class GasStation {
    String name;
    String location;
    List<Pump> pumps;
}

class Pump {
    String id;
    String gasolineType;
    double capacity;
    double currentLevel;
    double reorderLevel;
    double criticalLevel;
    boolean isBlocked;
}

class Customer {
    String name;
    String customerId;
    String state; // NORMAL, SUSPENDED
    List<RefuelTurn> refuelTurns;
    RefuelCard refuelCard; // Optional
}

class RefuelCard {
    String cardId;
    String status; // ACTIVE, BLOCKED
    List<Invoice> invoices;
}

class Invoice {
    String invoiceId;
    double totalAmount;
    Date issuedDate;
    List<RefuelTurn> refuelTurns;
    String paymentStatus; // PAID, UNPAID
    double discountApplied;
}

class RefuelTurn {
    String id;
    Date refuelDate;
    double amount;
    double pricePerLiter;
    Pump pumpUsed;
}

class DailyReport {
    Date reportDate;
    List<PumpReorderInfo> reorderInfo;
}

class PumpReorderInfo {
    Pump pump;
    double currentLevel;
    double quantityToOrder;
}

// Associations
association [1..*] OilCompany -> GasStation [0..*];
association [*] GasStation -> Pump [1..*];
association [*] Customer -> RefuelTurn [0..*];
association [1] Customer (owner) -> RefuelCard [0..1];
association [1..*] RefuelCard -> Invoice [0..*];
association [0..1] RefuelTurn -> Pump [1];
association [1] DailyReport -> PumpReorderInfo [*];
association [1] PumpReorderInfo (appliesTo) -> Pump [1];

// Comments
// 1. A Pump can only be used for refueling when it is not blocked.
// 2. Customer state changes based on payment behavior (e.g., NORMAL, SUSPENDED).
// 3. Invoice contains refuel turns for the given month only.
}
