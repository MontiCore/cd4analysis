
classdiagram HelpingHandsStore {

    class HelpingHandsStore {
        String name;
        List<Location> locations;
        List<PickupVehicle> vehicles;
    }

    class Location {
        String city;
        List<PickupRequest> pickupRequests;
        DistributionCenter distributionCenter;
    }

    class PickupRequest {
        String residentName;
        String streetAddress;
        String phoneNumber;
        String emailAddress;
        String itemDescription;
        Date pickupDate;
        Time pickupTime;
    }

    class PickupVehicle {
        String vehicleId;
        StorageSpace storageSpace;
        VolunteerDriver driver;
    }

    class StorageSpace {
        float capacity;
    }

    class VolunteerDriver {
        String name;
        List<Availability> availability;
    }

    class Availability {
        DayOfWeek day;
    }

    class DistributionCenter {
        List<SecondHandArticle> articles;
        void examineArticle(SecondHandArticle article);
    }

    class SecondHandArticle {
        String description;
        RFIDDevice rfid;
        String category;
    }

    class RFIDDevice {
        String rfidId;
    }

    class FoodBank {
        void receiveFood(FoodItem item);
    }

    class FoodItem {
        String description;
    }

    association [1] HelpingHandsStore -> (location) Location [*];
    association [*] Location -> (pickupRequest) PickupRequest [*];
    association [*] HelpingHandsStore -> (vehicle) PickupVehicle [*];
    association [1] PickupVehicle -> (driver) VolunteerDriver [1];
    association [1] DistributionCenter -> (article) SecondHandArticle [*];
}
