
classdiagram helpingHandsStore {

    class HelpingHandsStore {
        List<CityLocation> cityLocations;
        void schedulePickup(PickupRequest request);
    }

    class CityLocation {
        String name;
        List<PickupVehicle> vehicles;
        List<VolunteerDriver> volunteerDrivers;
        DistributionCenter distributionCenter;
    }

    class PickupVehicle {
        String vehicleID;
        double maxStorageCapacity; // in cubic meters
        void determinePickupRoute();
    }

    class VolunteerDriver {
        String name;
        String phoneNumber;
        List<DayOfWeek> availableDays;
        void indicateAvailability();
    }

    class PickupRequest {
        String residentName;
        String streetAddress;
        String phoneNumber;
        String emailAddress; // optional
        String itemDescription;
        Date pickupDate; // solicitud para recoger el artículo
        Time pickupTime; // horario entre 8:00 y 14:00
    }

    class DistributionCenter {
        void examineArticless(List<SecondHandArticle> articles);
    }

    class SecondHandArticle {
        String description;
        RFID rfidTag;
        String category;
    }

    class RFID {
        String id;
    }

    class DeliveryService {
        void arrangeDelivery(Client client, SecondHandArticle article, String deliveryAddress);
    }

    class Client {
        String clientName;
        List<String> neededCategories;
        void indicateNeededCategories();
    }

    class Resident {
        // The LLM did  not add this class, adding it to avoid errors
    }

    association [*] HelpingHandsStore -> (location) CityLocation [*];
    association [*] CityLocation -> (vehicles) PickupVehicle [*];
    association [*] CityLocation -> (drivers) VolunteerDriver [*];
    association [1] CityLocation -> (distributionCenter) DistributionCenter [1];
    association [*] VolunteerDriver <-> (drives) PickupVehicle [*];
    association [1] PickupRequest -> (pickups) Resident [1];
}
