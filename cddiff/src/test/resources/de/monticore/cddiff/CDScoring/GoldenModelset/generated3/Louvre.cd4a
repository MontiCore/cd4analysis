
// CD4A class diagram for the Louvre Museum management system

classdiagram louvre {

    class Museum {
        List<Location> locations;
        List<Exhibition> exhibitions;
    }

    class Location {
        String name;
        List<Exhibition> exhibitions;
    }

    class Exhibition {
        String title;
        Employee coordinator;
        List<ExhibitionItem> desiredItems;
    }

    class ExhibitionItem {
        String description;
        List<Piece> requestedPieces;
    }

    class Piece {
        String name;
        Collector collector;
    }

    class Employee {
        String name;
        Employee coach; // senior employee
    }

    class Collector {
        String name;
        List<Piece> pieces;
    }

    association [*] Museum -> (locations) Location [*];
    association [*] Location -> (exhibitions) Exhibition [*];
    association [*] Exhibition -> (desiredItems) ExhibitionItem [*];
    association [*] ExhibitionItem -> (requestedPieces) Piece [*];
    association [*] Employee <-> (coach) Employee [0..1]; // coaching relationship
    association [*] Collector -> (pieces) Piece [*];
}
