classdiagram WebPortalSystem {

class WebPortal {
    String versionNumber;
    String urlAddress;
    BuildingCatalog catalog;
}

class BuildingCatalog {
    List<Building> buildings;
}

class Building {
    String buildingId;
    String name;
    EnergyClass energyClass; // Enum for energy classifications
    String address;
    int yearOfConstruction;
    ProfilePhoto profileImage; // Association to Image used as a profile photo
    List<Image> images;        // Association for multiple building images
    User owner;                // Association to User class
    List<AdditionalEntry> additionalEntries;
    List<Comment> comments;    // Association to Comments related to the building
}

class Image {
    String fileName;
}

class AdditionalEntry {
    String name;
    EntryType type; // Enum EntryType (textual or numeric)
    Optional<String> unit; // Unit applicable for numeric entry
    Optional<Boolean> isPublic; // Whether visible to everyone
}

enum EntryType {
    TEXTUAL,
    NUMERIC;
}

class EnergyClass {
    String EClass; // A, B, C, or D
}

class User {
    String username;
    String email;
    String password;
    Boolean isActivated; // Indicates activation status after registration
    List<Building> ownedBuildings; // Buildings owned by the user
    List<Comment> comments;        // Comments made by the user
}

class Visitor {
    User userAccount; // Visitors may register as Users
    List<Building> searchResults; // Buildings searched by visitors
}

class Administrator extends User {
    String idCardNumber;
}

class Comment {
    String content;
    User author;       // Association to User class
}

// Associations
association [1] WebPortal -> (hasCatalog) BuildingCatalog [1];
association [*] BuildingCatalog -> Building [*];
association [1] Building -> (ownedBy) User [1]; // Each building has exactly one owner
association [*] Building -> (hasImage) Image [*];
association [1] Building -> ProfilePhoto [1];  // Profile photo of the building
association [*] Building -> AdditionalEntry [*];
association [*] User -> (ownedBuildings) Building [*];
association [*] Building -> Comment [*];
association [*] User (postedBy) -> Comment [*];
association [1] Visitor -> (userAccount) User [0..1]; // Visitor may register as a user
association [0..1] Visitor -> (searchesFor) Building [*];
association [1] Administrator -> User [*]; // Administrator manages user accounts and comments
}
