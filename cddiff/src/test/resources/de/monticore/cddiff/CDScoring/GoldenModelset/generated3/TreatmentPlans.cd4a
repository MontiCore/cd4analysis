
// Class diagram representing the hospital examination and treatment system
classdiagram hospital {

    class Hospital {
        String name;
        List<ExaminationType> allowedExaminations;
        void applyForPermission(ExaminationType examinationType);
    }

    enum ExaminationType {
        CARDIOLOGIC_TEST,
        ECHOGRAPHY,
        RADIOLOGY,
        SCANNER;
    }

    class Examination {
        ExaminationType type;
        String description;
        // Each examination is of one type
    }

    class TreatmentPlan {
        ProblemType problem;
        List<ExaminationType> advisedExaminations;
    }

    enum ProblemType {
        PROBLEM_A,
        PROBLEM_B;
        // Add other types as necessary
    }

    class Doctor {
        String name;
        Hospital hospital;
        Treatment createTreatment(ProblemType problem, Patient patient);
    }

    class Patient {
        String name;
    }

    class Treatment {
        List<Examination> actualExaminations;
        List<MedicalAction> additionalActions;
        void addExamination(Examination examination);
        void addAction(MedicalAction action);
    }

    class MedicalAction {
        String description;
    }

    // Associations
    association [*] Hospital -> (allowedExaminations) ExaminationType [*]; // Hospitals with allowed examinations
    association [*] TreatmentPlan -> (advisedExaminations) ExaminationType [*]; // Treatment plans with advised examinations
    association [1] Doctor -> Hospital [1]; // Each doctor belongs to one hospital
    association [1] TreatmentPlan -> (problem) ProblemType [1]; // Treatment plan for a specific problem
    association [1] Treatment -> (patient) Patient [1]; // Each treatment relates to one patient
    association [*] Treatment -> (actualExaminations) Examination [*]; // Treatments can have multiple examinations
}
