
classdiagram kinepolis {

class Cinema {
    String name;
    String location;
    List<Theatre> theatres;
}

class Theatre {
    int theatreNumber;
    int seatingCapacity;
    List<Show> shows;
}

class MovieCopy {
    String copyId;
    Movie movie;
    Cinema currentLocation;
}

class Movie {
    String title;
    int duration; // minutes
    String genre;
}

class Show {
    DateTime startTime;
    DateTime endTime;
    Theatre theatre;
    MovieCopy movieCopy;
    List<SeatReservation> reservations;
    boolean isPublished;
}

class Seat {
    int seatNumber;
    Theatre theatre;
}

class SeatReservation {
    Seat reservedSeat;
    Customer customer;
    Show show;
    boolean isCancelled;
}

class Customer {
    String name;
    String email;
    CreditCard creditCard;
}

class CreditCard {
    String cardNumber;
    String cardHolderName;
    String expirationDate;
}

class Ticket {
    Seat assignedSeat;
    Show show;
    boolean isOnlineReservation; // true if reserved online, false if purchased at entrance
}

// Enumerations
enum CancellationStatus {
    ACCEPTED,
    DECLINED,
    EXPIRED;
}

// Associations
association [1..*] Cinema -> Theatre [*];
association [1] Movie -> MovieCopy [*];
association [1..*] MovieCopy -> Cinema [1];
association showsMovie [*] Theatre -> Show [*];
association [1] Show -> MovieCopy [1];
association [1] Theatre -> Seat [*];
association [*] Show -> SeatReservation [*];
association [1] SeatReservation -> Customer [1];
association [1] Ticket -> Show [1];
association [1] Ticket -> Seat [1];
association [0..1] SeatReservation -> (replacementOffer) Show [0..1]; // Linked to alternative shows with the same movie

// Notes:
// - Credit cards are only charged after the cancellation period ends.
// - Tickets purchased at the entrance are anonymous and non-refundable.
// - Shows can be cancelled if there are no reservations.
}
