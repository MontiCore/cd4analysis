
classdiagram gasStationChain {

    class GasStation {
        String id; // unique identifier for the gas station
        String address; // address of the gas station
        List<FuelPump> fuelPumps; // List of fuel pumps at the gas station
        List<DailyPrice> dailyPrices; // List of daily fuel prices
    }

    class FuelPump {
        int number; // identifier for the fuel pump
        boolean isSelfService; // whether the pump is self-service
        List<Fuel> offeredFuels; // list of fuels offered at this pump
    }

    class Fuel {
        String name; // unique identifier for the fuel
        float octaneRating; // octane rating of the fuel
    }

    class DailyPrice {
        String date; // date of the daily price
        Fuel fuel; // fuel to which this daily price applies
        GasStation gasStation; // gas station this daily price is related to
        float pricePerLiter; // price per liter for the fuel
    }

    class FuelPurchase {
        String id; // unique identifier for the fuel purchase
        FuelPump fuelPump; // fuel pump where the purchase occurred
        DailyPrice dailyPrice; // daily price that applies to the purchase
        float litersDispensed; // number of liters of fuel dispensed
    }

    association [*] GasStation -> (pumps) FuelPump [1..12];
    association [*] GasStation -> (dailyPrices) DailyPrice [*];
    association [1] FuelPump -> (offeredFuels) Fuel [*];
    association [*] DailyPrice -> (fuels) Fuel [1];
    association [*] DailyPrice -> (gasStation) GasStation [1];
    association [*] FuelPurchase -> (fuelPump) FuelPump [1];
    association [*] FuelPurchase -> (dailyPrice) DailyPrice [1];
}
