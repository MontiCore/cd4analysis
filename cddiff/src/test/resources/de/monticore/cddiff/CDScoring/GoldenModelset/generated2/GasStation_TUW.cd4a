
classdiagram GasStationManagementSystem {

class GasStation {
    String id;
    String address;
}

class FuelPump {
    int number;
    boolean isSelfService;
}

class Fuel {
    String name;
    double octaneRating;
}

class DailyPrice {
    Date date;
    double pricePerLiter;
}

class FuelPurchase {
    String id;
    int litersDispensed;
}

association [1] GasStation <-> FuelPump [0..12];
association [1] FuelPump <-> Fuel [0..*];
association [1] GasStation <-> DailyPrice [0..*];
association [1] DailyPrice <-> Fuel [1];
association [1] FuelPurchase <-> FuelPump [1];
association [1] FuelPurchase <-> DailyPrice [1];

}
