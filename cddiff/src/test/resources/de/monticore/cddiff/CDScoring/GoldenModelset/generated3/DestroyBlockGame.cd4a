
// Class Diagram for DestroyBlock Application
classdiagram destroyBlock {

    class User {
        String username; // unique username
        String password; // shared for player and admin
        boolean isAdmin; // true if user is an admin
    }

    class Game {
        String gameName; // unique game name
        HallOfFame hallOfFame; // associated hall of fame
        List<Block> blocks; // set of blocks defined by admin
        List<Level> levels; // levels defined by admin
        int minSpeed; // minimum speed of the ball
        int speedIncrementFactor; // speed increase factor
        int maxLength; // maximum length of the paddle
        int minLength; // minimum length of the paddle
        boolean isPublished; // true if the game is published
    }

    class Block {
        String color; // color of the block
        int points; // points between 1 and 1000
    }

    class Level {
        int levelNumber; // 1 to 99
        List<Block> startingArrangement; // arrangement of blocks
        boolean isRandom; // true if the level is random
        int numBlocks; // number of blocks to show
    }

    class Ball {
        int speed; // speed of the ball
        String direction; // current direction of the ball
    }

    class Paddle {
        int length; // length of the paddle
        int position; // position of the paddle
    }

    class Player {
        int lives; // number of lives (3)
        int score; // current score
        Game currentGame; // game being played
        void movePaddle(String direction); // move paddle left or right
        void pauseGame(); // pause the game
        void resumeGame(); // resume paused game
    }

    class HallOfFame {
        List<PlayerScore> scores; // high scores of players
    }

    class PlayerScore {
        Player player; // reference to the player
        int score; // score of the player
    }

    // Associations
    association [1] Game -> (admin) User [1]; // one admin per game
    association [1] Game -> Level [*]; // game has multiple levels
    association [1] Game -> Block [*]; // game has multiple blocks
    association [*] User -> (admin) Game [1]; // user can be admin for one game
    association [*] User -> (player) Game [*]; // user can be player for many games
}
