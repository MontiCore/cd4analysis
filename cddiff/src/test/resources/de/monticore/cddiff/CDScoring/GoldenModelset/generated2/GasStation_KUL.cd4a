
// CD4A Class Diagram for Oil Company Gas Station System
classdiagram oilCompany {

    class GasStation {
        List<Pump> pumps;
        void generateDailyReport();
    }

    class Pump {
        GasolineType gasolineType;
        double currentLevel;
        double reorderLevel;
        double criticalLevel;
        boolean isBlocked;

        void startRefueling(Customer customer);
        void stopRefueling();
        void refill(double quantity);
    }

    enum GasolineType {
        REGULAR,
        PREMIUM,
        DIESEL;
    }

    class Customer {
        String name;
        String customerId;
        RefuelCard refuelCard;
        List<Invoice> invoices;

        void payInvoice(Invoice invoice);
        void requestRefuelCard();
        void suspend();
        void reactivate();
    }

    class RefuelCard {
        boolean isActive;

        void blockCard();
        void unblockCard();
    }

    class Invoice {
        List<RefuelTurn> refuelTurns;
        double totalAmount;
        double discount;
        boolean isPaid;

        void sendInvoice();
        void remindPayment();
    }

    class RefuelTurn {
        double amount;
        String date;

        // Only appears on the invoice of the month of the refuel turn
    }

    association [*] GasStation -> (pumps) Pump [*]; // A gas station has multiple pumps
    association [*] Customer -> (invoices) Invoice [*]; // A customer can have multiple invoices
    association [1] RefuelCard <-> Customer [1]; // Each refuel card is assigned to one customer
    association [*] Invoice -> (refuelTurns) RefuelTurn [*]; // An invoice contains multiple refuel turns
}
