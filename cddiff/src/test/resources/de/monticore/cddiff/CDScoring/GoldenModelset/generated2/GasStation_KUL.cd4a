
classdiagram OilCompany {

class Customer {
    int customerId;
    String name;
    String refuelCardStatus; // e.g., "active", "blocked"

    int getCustomerId();
    void setCustomerId(int newCustomerId);
    void receiveInvoice();
    void payInvoice();
    void suspendCustomer();
    void reactivateCustomer();
}

class GasStation {
    int stationId;
    String location;

    int getStationId();
    void setStationId(int newStationId);
    void produceDailyReport();
}

class Pump {
    int pumpId;
    String gasolineType;
    float currentLevel;
    float reorderLevel;
    float criticalLevel;

    int getPumpId();
    void setPumpId(int newPumpId);
    void initiateRefilling();
    void blockPump();
    void releasePump();
}

class Invoice {
    int invoiceId;
    DateTime issueDate;
    float totalAmount;

    int getInvoiceId();
    void setInvoiceId(int newInvoiceId);
    void applyDiscount();
}

class Payment {
    int paymentId;
    float amount;

    int getPaymentId();
    void setPaymentId(int newPaymentId);
}

class RefuelTurn {
    int refuelTurnId;
    DateTime refuelDate;
    float amount;

    int getRefuelTurnId();
    void setRefuelTurnId(int newRefuelTurnId);
}

association [1] GasStation -- (has) Pump [*];
association [1] Customer -- (owns) RefuelTurn [*];
association [1] Customer -- (receives) Invoice [*];
association [*] Invoice <-> Payment [1];
association [*] Invoice <-> RefuelTurn [1];
}
