
classdiagram ClothingManagementSystem {

class Product {
    String uniqueName;
    String description;
    double netPrice;
}

class Country {
    String name;
    double vatRate;
    String currency;
    double conversionRateToEuro;
}

class Representative {
    String firstName;
    String lastName;
    String socialSecurityNumber;
    String telephoneNumber;
    String emailAddress;
}

class Customer {
    String name;
    String address;
    String telephoneNumber;
    String emailAddress;
}

class Order {
    String orderId;
    int orderQuantity;
    Date orderDate;
    Date desiredDeliveryDate;
}

association [1] Product -> (manufacturedBy) Company [1];
association [1] Product -> (availableIn) Country [*];
association [1] Representative -- (responsibleCountry) Country [1];
association [1] Representative -- (orders) Order [*];
association [1] Customer -- (orders) Order [*];
association [1] Order -> (containsProduct) Product [1];

}
