
// CD4A Class Diagram for Clothing Management Application
classdiagram clothingManagement {

    class Product {
        String uniqueName;
        String description;
        double netPrice;
        Manufacturer manufacturer;
        Country country;
        double calculateGrossPrice();
    }

    class Manufacturer {
        String name;
    }

    class Country {
        String name;
        double vatRate;
        String currency;
        double conversionRateToEuro;
        boolean isProductAvailable(Product product);
    }

    class Representative {
        String firstName;
        String lastName;
        String socialSecurityNumber;
        String phoneNumber;
        String emailAddress;
        Country country;
    }

    class Customer {
        String name;
        String address;
        String phoneNumber;
        String emailAddress;
        List<Country> countries;
    }

    class Order {
        String orderId;
        Product product;
        int orderQuantity;
        Date orderDate;
        Date deliveryDate;
        Representative representative;
    }

    association [1] Representative -> (responsibleFor) Country [1];
    association [1] Product -> (manufacturedIn) Manufacturer [1];
    association [1] Product -> (availableIn) Country [*];
    association [1] Customer -> (resellingIn) Country [*];
    association [1] Order -> (placedBy) Representative [1];
    association [1] Order -> (refersTo) Product [1];
}
