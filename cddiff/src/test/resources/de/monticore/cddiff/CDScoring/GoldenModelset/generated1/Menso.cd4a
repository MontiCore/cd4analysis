
// CD4A Class Diagram for "De Lijn" bus company

classdiagram delijn {

    class BusCompany {
        String name; // e.g., "De Lijn"
        List<Trajectory> trajectories;
        List<Bus> buses;
        void requestApproval(Trajectory trajectory);
        void includeTrajectory(Trajectory trajectory);
        void cancelTrajectory(Trajectory trajectory);
    }

    class Trajectory {
        String name;
        boolean isApproved;
        boolean isOperational;
        boolean isSuspended;
        void requestApproval();
        void changeRotation();
        void cancel();
    }

    class Bus {
        String lineNumber;
        void assignToTrajectory(Trajectory trajectory);
    }

    class Line {
        String lineNumber;
        List<Trajectory> overlappingTrajectories;
    }

    class MENSO {
        String customerId;
        String personalData; // e.g., home address, office address, working hours
        void registerTrip(Date date, Time time, Line line);
        void invoiceCustomer();
        float calculateDiscount(float totalAmount);
    }

    class Trip {
        Date date;
        Time time;
        Line line;
    }

    association [*] BusCompany -> (trajectories) Trajectory [*]; // A BusCompany has multiple Trajectories
    association [*] BusCompany -> (buses) Bus [*]; // A BusCompany has multiple Buses
    association [*] Line -> (overlappingTrajectories) Trajectory [*]; // A Line includes multiple overlapping Trajectories
    association [*] MENSO -> (trips) Trip [*]; // MENSO records multiple Trips
}
