
classdiagram DeLijnBusCompany {

class Bus {
    int lineNumber;
}

class Trajectory {
    String status; // e.g., Pending, Approved, Suspended, Cancelled
}

class Line {
    String description;
}

class ApprovalProcess {
    int attemptCount;
}

class MENSO {
    String customerID;
    int validDuration; // one year
    float price;
    float discount; // up to 20%
}

class Trip {
    Date dateTime;
    String line;
}

class Customer {
    String homeAddress;
    String officeAddress;
    String workingHours;
}

association [1] Bus <-> Trajectory [0..*];
association [1] Trajectory <-> ApprovalProcess [0..*];
association [1] Line <-> Trajectory [0..*];
association [1] MENSO <-> Trip [0..*];
association [1] Customer <-> MENSO [0..*];

}
