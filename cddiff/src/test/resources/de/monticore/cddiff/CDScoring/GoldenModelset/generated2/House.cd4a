
// CD4A Model for House Structure

classdiagram house {

    class House {
        String address;
        Material buildingMaterial; // Enum for wood, brick, concrete
        Basement basement;
        List<Company> servicedBy;
    }

    enum Material {
        WOOD,
        BRICK,
        CONCRETE;
    }

    class Basement {
        String size;
        String name;
        // For earth basement
        Integer humidityLevel; // Applicable only for EarthBasement
    }

    class EarthBasement extends Basement {
        // Additional properties can be added here if needed
    }

    class ConcreteBasement extends Basement {
        // Additional properties can be added here if needed
    }

    class SemiDetachedHouse extends House {
        Boolean hasOwnGarden;
        Integer numberOfWindows;
        Carport carport; // References either Carport or Garage
        Garage garage; // References either Carport or Garage
    }

    class Carport {
        Boolean isDoubleCarport;
        Boolean hasFlatRoof;
    }

    class Garage {
        Boolean hasAutomaticDoor;
    }

    class Company {
        String name;
        String address;
        List<JobLog> jobLogs; // Recording jobs performed
    }

    class JobLog {
        Integer numberOfHours;
        Double agreedPrice;
    }

    // Associations
    association [*] House -> (servicedBy) Company [*];
    association [0..1] House -> (basement) Basement [0..1];
    association [1] SemiDetachedHouse -> (carport) Carport [0..1];
    association [1] SemiDetachedHouse -> (garage) Garage [0..1];
}
