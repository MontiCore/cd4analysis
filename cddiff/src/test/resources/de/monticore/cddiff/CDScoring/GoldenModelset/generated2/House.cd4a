
classdiagram HouseSystem {

enum BasementType {
    Earth,
    Concrete;
}

class Address {
    String street;
    String city;
    String postalCode;
}

class House {
    Address address;
    String buildingMaterial;
    Basement basement; // Optional
}

class Basement {
    String name;
    int size; // Size of the basement
}

class EarthBasement extends Basement {
    int humidityLevel;
}

class ConcreteBasement extends Basement {}

class SemiDetachedHouse extends House {
    boolean hasGarden;
    int numberOfWindows;
    Carport carport; // Either carport or garage
    Garage garage;
}

class Carport {
    boolean isDouble;
    boolean hasFlatRoof;
}

class Garage {
    boolean hasAutomaticDoor;
}

class Company {
    String name;
    Address address;
}

class JobLog {
    int hours;
    double agreedPrice;
}

association [*] House <-> Company [*];

association [0..1] House <-> Basement [0..1];

association [*] SemiDetachedHouse <-> JobLog [*];
association [*] Carport <-> JobLog [*];
association [*] Garage <-> JobLog [*];

}
