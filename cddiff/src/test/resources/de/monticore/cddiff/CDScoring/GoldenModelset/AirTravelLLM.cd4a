
classdiagram AirTravelSystem {

class Aircraft {
    String name;
    String type;
    int yearOfManufacture;
    Optional<String> nextInspectionDate;
}

class PassengerAircraft extends Aircraft {
    int numberOfSeats;
}

class SeatCategory {
    String designation;
    boolean offersEntertainmentProgram;
    int numberOfSeats;
}

// Associations for Seat Categories
association [1..*] PassengerAircraft -> SeatCategory [*];

// Associations between Aircraft and Airline
association [0..1] Aircraft -> Airline [*];

// Associations for Aircraft and Airports
association [1] Aircraft (homeAirport) -> Airport [0..1];

class Flight {
    String flightNumber;
    String date;
}

// Associations between Aircraft and Flight
association uses [1] Aircraft -> Flight [*];

// Associations for Flight and Airports
association [1] Flight (departureAirport) -> Airport [1];
association [1] Flight (destinationAirport) -> Airport [1];

class Passenger {
    String name;
    String passportNumber;
}

// Associations between Passenger and Flight
association [1..*] Passenger -> (participatesIn) Flight [*];

class Ticket {
    String ticketNumber;
    double price;
    boolean upgradeDesired;
}

// Associations for Ticket and Passenger
association [1] Passenger -> (has) Ticket [*];

// Associations for Ticket and SeatCategory
association [1] Ticket -> SeatCategory [1];

class Airline {
    String name;
}

class FlightAttendant {
    String name;
    String dateOfEmployment;
    boolean isChiefSteward;
}

class Pilot {
    String name;
    String dateOfEmployment;
    String license;
}

// Associations between Airline, FlightAttendants, and Pilots
association employsFlightCrew [*] Airline -> (flightAttendants) FlightAttendant [*];
association employsFlightCrew [*] Airline -> (pilots) Pilot [*];

// Associations between Flight, Pilots, and FlightAttendants
association [1] Flight (captain) -> Pilot [1];
association [1..2] Flight (coPilot) -> Pilot [1..2];
association [1..*] Flight -> (flightCrew) FlightAttendant [*];

class Airport {
    String name;
    String address;
    int numberOfRunways;
}

}

