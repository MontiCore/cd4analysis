
// CD4A Class Diagram for Fitness company "Conan"
classdiagram conanFitness {

    class Address {
        String street;
        String city;
        String zipCode;
    }

    class Center {
        String uniqueName; // unique name for the center
        Address address;
        List<Room> rooms;
    }

    class Room {
        int number; // unique number for the room within a center
        int maxCapacity;
    }

    class Person {
        String firstName;
        String familyName;
        Date birthDate;
    }

    class Trainer extends Person {
        String diploma;
    }

    class Session {
        Date date;
        Time startHour;
    }

    class IndividualSession extends Session {
        // No additional attributes
    }

    class GroupSession extends Session {
        String type; // e.g., aerobics, bodystyling
        Trainer trainer; // Requires exactly one trainer
    }

    association [1..*] Center -> (rooms) Room [*]; // A center has one or more rooms
    association [*] Center -> (sessions) Session [*]; // A center can have multiple sessions
    association [1..*] Room -> (sessions) Session [*]; // A room can host multiple sessions
    association [*] Person -> (participates) IndividualSession [*]; // A person can register for individual sessions
    association [*] Person -> (registers) GroupSession [*]; // A person can register for group sessions
    association [1] Trainer <-> GroupSession [1]; // A trainer supervises exactly one group session, but can be participant in others
}
