
classdiagram FitnessCompany {

class Address {
    String street;
    String city;
    String zipCode;
}

class Room {
    int number;
    int maxCapacity;
}

class Center {
    String name;
    Address address;
}

class Person {
    String firstName;
    String familyName;
    Date birthDate;
}

class Trainer extends Person {
    String diploma;
}

class Session {
    Date date;
    String startingHour;
}

class GroupSession extends Session {
    String type;
}

class IndividualSession extends Session {}

association [1] Center <-> Room [*];
association [1] Room <-> (hosts) Session [*];
association [*] Person <-> (participatesIn) Session [*];
association [1] Trainer <-> (supervises) GroupSession [*];
association [1] GroupSession <-> (requires) Trainer [1];
association [1] IndividualSession <-> (heldIn) Room [1];
}
