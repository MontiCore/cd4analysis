
// CD4A model for a cruise booking system
classdiagram CruiseBookingSystem {

class Provider {
    String name;
    String location;
}

class Cruise {
    int cruiseNumber;
    String name;
    Date startDate;
    Date endDate;
}

class Employee {
    String name;
    String socialSecurityNumber;
}

class Guest {
    String name;
    boolean isVIP; // true if VIP, false otherwise
}

class Ship {
    String name;
    int numberOfDecks;
    double length; // in meters
    int numberOfPassengers;
}

class TravelAgency {
    String name;
    String address;
}

class Booking {
    int bookingNumber; // unique identifier
    Date bookingDate;
}

class DestinationArea {
    String name;
    String seaName; // name of the sea
}

class Show {
    String title;
    int duration; // in minutes
}

class Ticket {
    // Ticket does not need specific attributes; its association is sufficient
}

association [*] Provider <-> Cruise [*];
association [*] Cruise -- (requires) Employee [*];
association [*] Cruise -- (attends) Guest [*];
association [*] Cruise <-> Ship [*];
association [1] TravelAgency <-> Booking [*];
association [1] Booking -> Cruise [1];
association [1] Cruise -> DestinationArea [1];
association [*] Cruise -- (offers) Show [*];
association [*] Ticket <-> Cruise [1];
association [1] Guest <-> Ticket [*];

}
