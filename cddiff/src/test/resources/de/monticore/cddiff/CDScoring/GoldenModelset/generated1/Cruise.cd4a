
// CD4A model for cruise management system
classdiagram cruiseManagement {

    class Provider {
        String name;
        String location;
    }

    class Cruise {
        String number;
        String name;
        Date startDate;
        Date endDate;
    }

    class Employee {
        String name;
        String socialSecurityNumber;
    }

    class Guest {
        String name;
        boolean isVIP;
    }

    class Ship {
        String name;
        int numberOfDecks;
        double length;
        int numberOfPassengers;
    }

    class TravelAgency {
        String name;
        String address;
    }

    class Booking {
        String bookingNumber;
        Date bookingDate;
    }

    class DestinationArea {
        String name;
        String seaName;
    }

    class Show {
        String title;
        Duration duration;
    }

    class Ticket {
        String ticketId;
    }

    // Associations
    association [1] Cruise -> (provider) Provider [1];
    association [*] Cruise -> (employees) Employee [*];
    association [*] Cruise -> (guests) Guest [*];
    association [*] Guest -> (cruises) Cruise [*];
    association [*] Cruise -> (ships) Ship [*];
    association [1] Cruise -> (destination) DestinationArea [1];
    association [*] Cruise -> (shows) Show [*];
    association [1] Booking -> (cruise) Cruise [1];
    association [1] Booking -> (travelAgency) TravelAgency [1];
    association [*] Ticket -> (cruise) Cruise [1];
    association [*] Guest -> (tickets) Ticket [*];
}
