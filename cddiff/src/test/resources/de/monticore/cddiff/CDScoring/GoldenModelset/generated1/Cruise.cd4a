classdiagram CruiseBooking {

class Provider {
    String name;
    String location;
}

class Cruise {
    String number;
    String name;
    Date startDate;
    Date endDate;
}

class Employee {
    String name;
    String socialSecurityNumber;
}

class Guest {
    String name;
    boolean isVIP;
}

class Ship {
    String name;
    int numberOfDecks;
    double length;
    int numberOfPassengers;
}

class TravelAgency {
    String name;
    String address;
}

class Booking {
    String bookingNumber;
    Date bookingDate;
}

class DestinationArea {
    String name;
    String seaName;
}

class Show {
    String title;
    Duration duration;
}

class Ticket {}

association [1] Provider <-> Cruise [0..*];
association [1..*] Cruise <-> Employee [1..*];
association [1..*] Cruise <-> Guest [0..*];
association [1] Cruise <-> Ship [0..*];
association [1] Booking <-> TravelAgency [1];
association [1] Booking <-> Cruise [1];
association [1] Cruise <-> DestinationArea [1];
association [1..*] Cruise <-> Show [0..*];
association [1] Cruise <-> Ticket [0..*];
association [0..*] Guest <-> Ticket [0..*];

}
