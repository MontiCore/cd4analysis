
classdiagram HospitalManagement {

class Hospital {
    String name;
    List<String> permissions; // List of allowed examination types
}

class Doctor {
    String name;
    String specialty;
    Hospital affiliatedHospital; // Association to the hospital
}

class Patient {
    String name;
    int age;
    String medicalRecordId;
}

enum ExaminationType {
    CARDIOLOGIC_TEST,
    ECHOGRAPHY,
    RADIOLOGY,
    SCANNER,
    NMR;
}

class Examination {
    ExaminationType type;
    Hospital performingHospital;
}

class Problem {
    String description;
}

class TreatmentPlan {
    List<ExaminationType> advisedExaminations;
    Problem relatedProblem; // Association to the problem
}

class ActualTreatment {
    Problem diagnosedProblem; // Association to the diagnosed problem
    Doctor responsibleDoctor; // Association to the doctor prescribing the treatment
    List<Examination> examinationsPerformed;
    List<String> additionalMedicalActions; // Actions not part of the treatment plan
}

// Associations
association affiliated [1] Doctor -> Hospital [1];
association visits [1] Patient -> Hospital [1..*];
association diagnosed [1] Doctor -> Problem [*];
association definesTreatmentPlan [1] Problem -> TreatmentPlan [1..*];
association prescribes [1] Doctor -> ActualTreatment [*];
association advises [1..*] TreatmentPlan -> (advisedFor) ExaminationType [*];
association performs [1..*] ActualTreatment -> Examination [*];
association [1] Examination -> Hospital [1];
}
