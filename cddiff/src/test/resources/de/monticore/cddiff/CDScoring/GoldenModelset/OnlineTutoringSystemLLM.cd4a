
classdiagram OTS {

class Person {
    String name;
    String email;
}

class Student extends Person {
    // Registered students
    PaymentMethod paymentMethod; // E.g., "CreditCard", "WireTransfer"
}

class Tutor extends Person {
    String bankAccount;
    List<SubjectExpertise> subjects; // E.g., mathematics, science, literature
    List<HourlyRate> hourlyRates; // Subject-specific pricing
    WeeklySchedule weeklyAvailability; // E.g., Thursdays 10:00-11:30
}

// Represents expertise level in a subject
class SubjectExpertise {
    String subject;
    String level; // E.g., primary school, high school, university
}

// Mapping between subject and hourly rate
class HourlyRate {
    String subject;
    float pricePerHour;
}

// Weekly scheduling details
class WeeklySchedule {
    List<TimeSlot> timeSlots; // E.g., Thursdays from 10:00 to 11:30
}

// Represents a tutoring request and session
class TutoringSession {
    TargetDateTime requestedTime; // Requested and confirmed tutoring time
    float price;
    boolean canceledByTutor;
    boolean canceledByStudent;
    boolean isConfirmed;
    PaymentDetails paymentDetails; // Payment information
}

// Represents payment details for tutoring sessions
class PaymentDetails {
    PaymentMethod method;
    float calculatedPrice; // E.g., 75% refund rule applied for late cancellation
}

// Enum for payment methods
enum PaymentMethod {
    CREDIT_CARD,
    WIRE_TRANSFER;
}

// Enum for awards
class MonthlyAward {
    String subject;
    Tutor awardedTutor; // Tutor-of-the-month
}

// Associations and Relationships
association [*] Student -> (requestsTutoring) Tutor [*];
association [*] Tutor -> (offersTutoringIn) SubjectExpertise [*];
association [*] TutoringSession -> (scheduledFor) WeeklySchedule [1];
association [*] Student -> TutoringSession [*];
association [1] Tutor -> TutoringSession [*];
association [*] MonthlyAward -> Tutor [1];

}
