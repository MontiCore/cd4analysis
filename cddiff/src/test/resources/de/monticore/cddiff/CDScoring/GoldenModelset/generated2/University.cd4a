
classdiagram University {

class Faculty {
    String name;
}

class Institute {
    String name;
    String address;
}

class Employee {
    String socialSecurityNumber;
    String name;
    String emailAddress;
}

class ResearchAssistant extends Employee {
    String fieldOfResearch;
}

class Project {
    String name;
    Date startDate;
    Date endDate;
}

class Lecturer extends ResearchAssistant {}

class Course {
    int id;
    String name;
    int weeklyDuration;
}

class Dean extends Employee {}


association [1] Faculty <-> Institute [*];
association [1] Faculty -> Dean [1];
association [1..*] ResearchAssistant <-> Institute [*];
association [*] ResearchAssistant <-> Project [*];
association [*] Lecturer <-> Course [*];

}
