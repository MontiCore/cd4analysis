
// Class Diagram for a University System
classdiagram university {

    class University {
        List<Faculty> faculties;
        int totalEmployees;
    }

    class Faculty {
        String name;
        Dean dean; // a Faculty is headed by a Dean
        List<Institute> institutes;
    }

    class Institute {
        String name;
        String address;
    }

    class Employee {
        String socialSecurityNumber;
        String name;
        String emailAddress;
    }

    class ResearchStaff extends Employee {
        // no specific attributes for ResearchStaff
    }

    class AdministrativeStaff extends Employee {
        // no specific attributes for AdministrativeStaff
    }

    class ResearchAssistant extends ResearchStaff {
        String fieldOfResearch;
        List<Project> projects; // RAs can be involved in multiple projects
        List<Course> courses; // RAs can teach courses (lecturers)
    }

    class Project {
        String name;
        Date startDate;
        Date endDate;
        int hoursAssigned;
    }

    class Course {
        String id; // unique course number
        String name;
        int weeklyDuration;
    }

    association [1] Faculty -> (head) Dean [1]; // each Faculty has one Dean
    association [*] Faculty -> (institutes) Institute [*]; // each Faculty has multiple Institutes
    association [1] Institute -> (staff) Employee [*]; // Institutes employ multiple Employees
    association [*] ResearchAssistant -> (projects) Project [*]; // RAs can have multiple Projects
    association [*] ResearchAssistant -> (courses) Course [*]; // RAs can teach multiple Courses
}
