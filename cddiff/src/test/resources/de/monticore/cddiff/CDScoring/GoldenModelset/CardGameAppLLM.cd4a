
classdiagram game {

class Game {
    UUID id;
    int maxPlayers = 4;
    Deck deck;
    ScoringTable scoringTable;
}

class Player {
    UUID id;
    String name;
}

class Deck {
    UUID id;
    int maxCards = 48;
    List<Card> cards;
}

class Card {
    UUID id;
    Suit suit;
    int height;
}

enum Suit {
    DIAMONDS,
    HEARTS,
    SPADES,
    CLUBS;
}

enum ComparisonResult {
    LOWER,
    EQUAL,
    HIGHER;
}

enum SoloType {
    TRUMP,
    JACK,
    QUEEN;
}

class ScoringTable {
    UUID id;
    List<Round> rounds;
}

class Round {
    UUID id;
    List<Player> winningPlayers;
    int pointValue;
    boolean isJackRound;
    boolean isSoloRound;
    boolean isMandatorySoloRound;
    Optional<SoloRound> soloRoundDetails; // Expanded solo-specific attributes
}

class SoloRound {
    SoloType type;
    Player soloPlayer; // Ensures a single solo player association for the round
}

// Associations
association [4] Game -> (hasPlayers) Player [*]; // Game has exactly 4 players
association [1] Game -> Deck [1];
association [1] Game -> ScoringTable [1];
association [*] Deck -> Card [*]; // Deck holds up to 48 cards
association [*] ScoringTable -> (hasRounds) Round [*];
association [1] Round -> (soloPlayedBy) SoloRound [1..*]; // Optional solo details

}
