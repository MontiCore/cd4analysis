
// Class Diagram for Transport Company

classdiagram TransportCompany {

class Employee {
    String name;
    int ssn;
}

class Planner extends Employee {
    String username;
    String password;
}

class Driver extends Employee {
}

class AdministrativeStaff extends Employee {
    String fieldOfActivity;
}

class Customer {
    String name;
    String billingAddress;
}

abstract class Vehicle {
    String licensePlateNumber;
    int mileage;
}

class RefrigeratedTruck extends Vehicle {}

class SmallVan extends Vehicle {}

class LoadingPlatform extends Vehicle {}

class BoxTruck extends Vehicle {}

class RepairShop {
    String name;
    String address;
}

class Repair {
    Employee employee;
    int duration;
    double cost;
}

class Order {
    String packageSize;
    String comment;
    Date startTime;
    Date endTime;
}

class PartnerCompany {
    String name;
    String address;
}

// Associations
association [*] Driver <-> (completed) Order [*];
association [*] Order <-> Customer [1];
association [*] Order <-> Planner [1];
association [*] Order <-> Vehicle [1];
association [1] Vehicle <-> (needs) Repair [0..*];
association [1] Repair <-> RepairShop [1];
association [*] Order <-> AdministrativeStaff [0..1];
association [*] AdministrativeStaff <-> PartnerCompany [0..*];

}
