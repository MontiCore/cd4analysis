
// CD4A class diagram for Transport Company

classdiagram transportCompany {

    class Employee {
        String name;
        String socialSecurityNumber;
    }

    class Planner extends Employee {
        String username;
        String password;
    }

    class AdministrativeStaff extends Employee {
        String fieldOfActivity;
        String username;
        String password;
    }

    class Customer {
        String name;
        String billingAddress;
    }

    class Vehicle {
        String licensePlateNumber;
        int mileage;
    }

    class RepairShop {
        String name;
        String address;
    }

    class Repair {
        RepairShop repairShop;
        Employee employee;
        int duration;
        double cost;
    }

    class Order {
        Customer customer;
        Vehicle vehicle;
        Planner planner;
        String comments;
        Date startTime;
        Date endTime;
        String pickupAddress;
        String deliveryAddress;
        PartnerCompany partnerCompany;
    }

    class PartnerCompany {
        String name;
        String address;
    }

    association [*] Employee -> (assignedTo) Order [*]; // Employees can be assigned to multiple orders
    association [*] Customer -> (places) Order [*]; // Customers can place multiple orders
    association [1] Planner -> (makes) Order [*]; // Each order is made by one planner
    association [*] Vehicle -> (usedIn) Repair [*]; // Vehicles can be used in multiple repairs
}
