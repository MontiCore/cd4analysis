
// CD4A Class Diagram for Tile-O Game

classdiagram tileO {

    class Game {
        Board board;
        List<Player> players;
        int currentPlayerIndex;
        void startGame();
        void nextTurn();
    }

    class Board {
        Tile[][] tiles;
        Tile hiddenTile;
        List<ActionTile> actionTiles;
        void setupBoard();
        void connectTiles(Tile tile1, Tile tile2);
    }

    class Tile {
        String color; // white or black
        boolean isHidden;
        boolean isActionTile;
        Tile left;
        Tile right;
        Tile top;
        Tile bottom;
        void visit();
    }

    class ActionTile extends Tile {
        int turnsToRegular;
        void executeAction(Player player);
    }

    class Player {
        String color; // unique color for each player
        PlayingPiece piece;
        void rollDie();
        void move(PlayingPiece piece, Tile destination);
    }

    class PlayingPiece {
        String color;
        Tile currentTile;
        void moveTo(Tile destination);
    }

    class Designer {
        void defineBoard(Board board);
        void defineActionCards(List<ActionCard> actionCards);
        void setHiddenTile(Tile hiddenTile);
        void setPlayerStarts(List<Tile> startPositions);
    }

    class ActionCard {
        String description; // e.g., roll the die for an extra turn, etc.
        void execute(Player player);
    }

    // Association indicating players can be one of 2-4
    association [2..4] Game -> (players) Player [1];
    association [*] Board -> (tiles) Tile [*];
}
