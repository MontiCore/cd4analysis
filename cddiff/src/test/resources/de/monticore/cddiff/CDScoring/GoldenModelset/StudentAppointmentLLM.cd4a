
classdiagram model {

class Person {
    String name;
    int age;
}

class Student extends Person {
    String studentId;
}

class TeachingAssistant extends Person {
    String employeeId;
}

enum CourseType {
    MANDATORY,
    ELECTIVE;
}

class Course {
    Optional<String> courseName;
    String courseCode;
    List<String> tags;
    CourseType type;
    int credits;
}

class Appointment {
    Date appointmentTime;
    String location;
}

// Associations
association [10..*] Student -> (enrolledIn) Course [*]; // A student is enrolled in one or more courses.
association [1..*] TeachingAssistant -> (teaches) Course [*]; // A TA teaches at least one course.

association [*] Student -> (hasAppointment) Appointment [*]; // A student can have multiple appointments.
association [*] TeachingAssistant -> (hasAppointment) Appointment [*]; // A TA can have multiple appointments.
association [1] Appointment -> (forCourse) Course [1]; // Each appointment is for one specific course.
association [1] Appointment -> (withAssistant) TeachingAssistant [1]; // Each appointment is with one specific TA.
}
