
// CD4A class diagram for a cruise management system
classdiagram cruise {

    class Provider {
        String name;
        String location;
    }

    class Cruise {
        String number;
        String name;
        Date startDate;
        Date endDate;
    }

    class Employee {
        String name;
        String socialSecurityNumber;
    }

    class Guest {
        String name;
        boolean isVIP;
    }

    class Ship {
        String name;
        int numberOfDecks;
        double length;
        int numberOfPassengers;
    }

    class Booking {
        String bookingNumber;
        Date bookingDate;
    }

    class TravelAgency {
        String name;
        String address;
    }

    class DestinationArea {
        String name;
        String seaName;
    }

    class Show {
        String title;
        Duration duration; // Assuming Duration is a predefined type
    }

    class Ticket {
        // Assuming Ticket might have more attributes
    }

    association [*] Provider -> Cruise [*];
    association [*] Cruise -> Employee [*];
    association [*] Cruise -> Guest [*];
    association [*] Cruise -> Ship [*];
    association [*] Cruise -> Booking [*];
    association [*] Cruise -> DestinationArea [1];
    association [*] Cruise -> Show [*];
    association [*] Guest <-> Ticket [*]; // A guest can have many tickets, but only one ticket per cruise
    association [*] Cruise <-> Ticket [*]; // Each ticket belongs to exactly one cruise
}

