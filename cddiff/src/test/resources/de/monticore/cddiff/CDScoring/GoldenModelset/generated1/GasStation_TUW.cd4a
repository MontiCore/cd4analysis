
classdiagram gas_station_chain {

    class GasStation {
        String id; // unique identifier
        String address;
        List<FuelPump> fuelPumps; // maximum of 12
        List<DailyPrice> dailyPrices; // archives daily fuel prices
    }

    class FuelPump {
        int number; // identifier for the fuel pump
        boolean isSelfService;
        List<Fuel> offeredFuels; // fuels offered at this pump
    }

    class Fuel {
        String name; // unique identifier for the fuel
        float octaneRating; // octane rating of the fuel
    }

    class DailyPrice {
        Date date; // date for the price
        Fuel fuel; // fuel to which the price applies
        GasStation gasStation; // gas station where the price applies
        float pricePerLiter; // price per liter of the fuel
    }

    class FuelPurchase {
        String id; // unique identifier for the purchase
        FuelPump fuelPump; // fuel pump where the purchase was made
        DailyPrice dailyPrice; // daily price for the bought fuel
        float litersDispensed; // number of liters dispensed
    }

    association [1..12] GasStation -> (fuelPump) FuelPump [*];
    association [*] FuelPump -> (offeredFuel) Fuel [*];
    association [*] GasStation -> (dailyPrice) DailyPrice [*];
    association [*] DailyPrice -> (appliedFuel) Fuel [1];
    association [1] FuelPurchase -> (purchasedAt) FuelPump [1];
    association [1] FuelPurchase -> (purchasedPrice) DailyPrice [1];
}
