
classdiagram GasStationChain {

class GasStation {
    String id;
    String address;
}

class FuelPump {
    int number;
    boolean selfService;
}

class Fuel {
    String name;
    float octaneRating;
}

class DailyPrice {
    Date date;
    float pricePerLiter;
}

class FuelPurchase {
    String id;
    int litersDispensed;
}

association [1] GasStation <-> FuelPump [0..12];
association [1] FuelPump <-> Fuel [1..*];
association [1] GasStation <-> DailyPrice [0..*];
association [1] DailyPrice <-> Fuel [1..*];
association [1] FuelPump <-> FuelPurchase [0..*];
association [1] DailyPrice <-> FuelPurchase [1..*];

}
