/* (c) Science Connect Research Database */

classdiagram EUScienceConnectLLM {

  // =========================
  // Core Domain Classes
  // =========================

  class Person {
    String personId;
    String phoneNumber;
    List<String> keywords;
  }

  class Institution {
    String institutionCode;
  }

  class ScientificArticle {
    String doi;
    String title;
  }

  class PeerReviewedPaper extends ScientificArticle {
    int citationCount;
  }

  class TechnicalReport extends ScientificArticle {}

  class Publisher {
    String name;
  }

  class Journal {
    String name;
    double impactFactor;
  }

  // =========================
  // Associations
  // =========================

  // Person works for an Institution
  association [*] Person -> (worksAt) Institution [1];

  // Author relationships (with position stored separately)
  class Authorship {
    int position;
  }
  association [1] Person -> (authored) Authorship [*];
  association [1] ScientificArticle -> (hasAuthor) Authorship [*];

  // Reviewer relationships (only for PeerReviewedPapers)
  association [*] Person -> (reviews) PeerReviewedPaper [*];

  // TechnicalReport published by one Institution
  association [1] Institution -> (publishedReports) TechnicalReport [*];

  // Publisher - Journal
  association [1] Publisher -> (journals) Journal [*];

  // Institution subscribes to Journals
  association [*] Institution -> (subscriptions) Journal [*];

  // Only PeerReviewedPapers are published in Journals
  association [1] Journal -> (papers) PeerReviewedPaper [*];
}
