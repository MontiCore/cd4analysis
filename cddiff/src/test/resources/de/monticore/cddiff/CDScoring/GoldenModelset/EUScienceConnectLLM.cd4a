
classdiagram ScienceConnect {

class Person {
    String personID; // Unique identifier
    String phoneNumber;
    List<String> researchKeywords;
}

class ResearchInstitution {
    String institutionCode; // Unique identifier
    String name;
}

class ScientificArticle {
    String DOI; // Document object identifier (unique)
    String title;
    List<AuthorPosition> authors; // Position for each author in the publication
}

class AuthorPosition {
    Person author;
    int position;
}

class PeerReviewedPaper extends ScientificArticle {
    int citationCount; // Number of citations
    List<Person> reviewers;
}

class TechnicalReport extends ScientificArticle {
    ResearchInstitution publishedBy; // Single institution publishing the report
}

class Publisher {
    String name; // Unique name
    List<Journal> journals;
}

class Journal {
    String title; // Journal name
    double impactFactor; // Scientific impact measure
    Publisher publisher;
}

enum ArticleType {
    PEER_REVIEWED_PAPER,
    TECHNICAL_REPORT;
}

// Associations
association [1] Person -> (worksFor) ResearchInstitution [1];
association [1..*] ScientificArticle -> (hasAuthorPosition) AuthorPosition [1..*];
association [1] PeerReviewedPaper -> (publishedIn) Journal [*];
association [1] Journal -> Publisher [1];
association [*] TechnicalReport -> (publishedBy) ResearchInstitution [1];

}
