
classdiagram BankManagement {

    class Customer {
        String firstName;
        String lastName;
    }

    class Bank {
        // class body
    }

    class Branch {
        // class body
    }

    class Account {
        int accountNumber;
        double balance;
    }

    class CheckingAccount extends Account {
        double overdraftLimit;
    }

    class SavingsAccount extends Account {}

    association [0..*] Bank -> Branch [*];
    association [1] Account -> (owner) Customer [1];
    association [1..5] Customer -> Account [*];
}
