
classdiagram BankManagementSystem {

    class Customer {
        String firstName;
        String lastName;
    }

    class Bank {
        // A bank consists of any number of branches
    }

    class Branch {
        // A branch can be part of the bank
    }

    class Account {
        int accountNumber;
        double balance;
    }

    class CheckingAccount extends Account {
        double overdraftLimit;
    }

    class SavingsAccount extends Account {}

    association [1..5] Customer -> (owns) Account [*];
    association [0..*] Bank -> Branch [*];
    association [1] Account -> (owner) Customer [1];
}
