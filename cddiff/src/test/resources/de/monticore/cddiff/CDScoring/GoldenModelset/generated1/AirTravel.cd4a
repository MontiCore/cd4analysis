
classdiagram AircraftManagementSystem {

class Aircraft {
    String name;
    String type;
    int yearOfManufacture;
    Date nextInspectionDate;
}

class Flight {
    String flightNumber;
    Date flightDate;
}

class Passenger {
    String name;
    String passportNumber;
}

class Ticket {
    String ticketNumber;
    float price;
    boolean upgradeDesired;
}

class PassengerAircraft extends Aircraft {
    int numberOfSeats;
}

class SeatCategory {
    String designation;
    boolean entertainmentProgram;
    int numberOfSeats;
}

class Airline {
    String name;
}

class FlightAttendant {
    String name;
    Date dateOfEmployment;
    boolean isChiefSteward;
}

class Pilot {
    String name;
    Date dateOfEmployment;
    String license;
}

class Airport {
    String name;
    String address;
    int numberOfRunways;
}

association [*] Aircraft -- Flight [*];
association [*] Flight -- Passenger [*];
association [1] Passenger -- Ticket [*];
association [1] PassengerAircraft -- SeatCategory [*];
association [1] Aircraft -- Airline [0..1];
association [*] Airline -- FlightAttendant [*];
association [*] Airline -- Pilot [*];
association [1] Flight -- (departureAirport) Airport [1];
association [1] Flight -> (destinationAirport) Airport [1];
association [1] Aircraft -- Airport [0..1];

association [*] FlightAttendant -- Flight [*];
association [1] Pilot -- Flight [1];

}
