
// CD4A Class Diagram
classdiagram AircraftSystem {

class Aircraft {
    String name;
    String type;
    int yearOfManufacture;
    DateTime nextInspection;
}

class Flight {
    int flightNumber;
    DateTime flightDate;
}

class Passenger {
    String name;
    String passportNumber;
}

class Ticket {
    int ticketNumber;
    double price;
    boolean upgradeDesired;
}

class PassengerAircraft extends Aircraft {
    int numberOfSeats;
}

class SeatCategory {
    String designation;
    boolean entertainmentProgramAvailable;
    int numberOfSeats;
}

class Airline {
    String name;
}

class FlightAttendant {
    String name;
    DateTime dateOfEmployment;
    boolean isChiefSteward;
}

class Pilot {
    String name;
    DateTime dateOfEmployment;
    String license;
}

class Airport {
    String name;
    String address;
    int numberOfRunways;
}


association [0..*] Passenger <-> Ticket [0..*];
association [1] Flight <-> Passenger [0..*];
association [1] Ticket <-> Passenger [0..1];
association [1] Flight <-> FlightAttendant [0..*];
association [1] Flight <-> Pilot [1]; // One pilot flies as captain
association [0..2] Flight <-> Pilot [0..2]; // Co-pilots
association [1] PassengerAircraft <-> SeatCategory [0..*];
association [1] Aircraft <-> Airline [0..1];
association [1] Aircraft <-> Airport [0..1];
association [1] Flight <-> (departureAirport) Airport [1];
association [1] Flight <-> (destinationAirport) Airport [1];

}
