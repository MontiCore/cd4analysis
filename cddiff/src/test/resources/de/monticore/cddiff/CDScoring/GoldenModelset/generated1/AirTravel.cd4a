
// CD4A Class Diagram for Aircraft Management System
classdiagram aircraftManagement {

    class Aircraft {
        String name;
        String type;
        int yearOfManufacture;
        String nextInspectionDate;
        Airport homeAirport;
    }

    class Flight {
        String flightNumber;
        String date;
        Airport departureAirport;
        Airport destinationAirport;
    }

    class Passenger {
        String name;
        String passportNumber;
    }

    class Ticket {
        String ticketNumber;
        double price;
        boolean upgradeDesired;
        SeatCategory seatCategory;
    }

    class PassengerAircraft extends Aircraft {
        int numberOfSeats;
    }

    class SeatCategory {
        String designation;
        boolean entertainmentProgram;
        int numberOfSeats;
    }

    class Airline {
        String name;
    }

    class FlightAttendant {
        String name;
        String dateOfEmployment;
        boolean isChiefSteward;
    }

    class Pilot {
        String name;
        String dateOfEmployment;
        String license;
    }

    class Airport {
        String name;
        String address;
        int numberOfRunways;
    }

    association [0..*] Flight -> Aircraft [1];
    association [0..*] Passenger -> Flight [0..*];
    association [0..*] Ticket -> Passenger [0..*];
    association [0..*] SeatCategory -> PassengerAircraft [*];
    association [0..*] FlightAttendant -> Airline [*];
    association [0..*] Pilot -> Airline [*];
}
