
classdiagram KinepolisCinemas {

class Cinema {
    String location;
}

class Theatre {
    int number;
}

class MovieCopy {
    String location;
}

class Show {
    Date startTime;
    boolean isPublished;
}

class Reservation {
    String creditCardInfo;
    Date reservationTime;
}

class Ticket {
    int seatNumber;
}

class Offer {
    Date expirationTime;
}

association [1] Cinema <-> Theatre [0..*];
association [1] Cinema <-> MovieCopy [1..*];
association [1] MovieCopy <-> Show [0..*];
association [1] Show <-> Reservation [0..*];
association [1] Show <-> Ticket [0..*];
association [1] Show <-> Offer [0..*];

}
