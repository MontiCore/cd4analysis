
classdiagram kinepolis {

    class Kinepolis {
        String name;
        List<Cinema> cinemas;
    }

    class Cinema {
        String location;
        List<Theatre> theatres;
        List<MovieCopy> movieCopies;
    }

    class Theatre {
        String name;
        List<Show> shows;
        int totalSeats;
        int availableSeats;
    }

    class MovieCopy {
        Movie movie;
        Cinema location;
    }

    class Movie {
        String title;
        String genre;
    }

    class Show {
        MovieCopy movieCopy;
        String startTime;
        String endTime;
        boolean isPublished;
        List<Reservation> reservations;
    }

    class Reservation {
        Customer customer;
        Show show;
        int seatNumber;
        Payment payment;
    }

    class Customer {
        String name;
        String email;
        String creditCardNumber;
    }

    class Payment {
        boolean isPaid;
        String paymentMethod; // e.g., credit card
        boolean isRefundable;
    }

    association [1..*] Kinepolis -> (owns) Cinema [*];
    association [1..*] Cinema -> (has) Theatre [*];
    association [1..*] Theatre -> (shows) Show [*];
    association [1..*] Show -> (has) Reservation [*];
    association [1] MovieCopy -> (isFor) Movie [1];
    association [1] MovieCopy -> (locatedIn) Cinema [1];
}
