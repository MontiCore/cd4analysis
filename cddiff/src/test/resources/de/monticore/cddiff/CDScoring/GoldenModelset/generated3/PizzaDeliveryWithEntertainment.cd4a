
classdiagram PizzaDeliveryApp {

class User {
    String name;
    String address;
    Date birthday;
    String userID;
}

class BusinessOwner extends User {
    String linkedInAccount;
}

class PizzaRestaurant {
    String zipCode;
    String address;
    String phoneNumber;
    String website;
}

class Pizza {
    String name;
    String crustStructure;
    double price;
}

class HungryCustomer extends User {
    String deliveryAddress;
}

class Order {
    String orderID;
    Date orderDate;
    String latestDeliveryTime;
    int numberOfPeople;
}

class EntertainmentOrder extends Order {
    String entertainmentType;
    int duration; // in minutes
}

class Entertainer {
    String stageName;
    String bio;
    double pricePer30Minutes;
}

association [1] BusinessOwner <-> PizzaRestaurant [*];
association [1] PizzaRestaurant <-> Pizza [*];
association [1] HungryCustomer <-> Order [*];
association [1] EntertainmentOrder <-> Entertainer [1];
association [*] Entertainer <-> PizzaRestaurant [*];
}
