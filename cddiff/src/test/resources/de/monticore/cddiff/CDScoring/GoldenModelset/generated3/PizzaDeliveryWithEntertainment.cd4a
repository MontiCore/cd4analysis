
// Class Diagram for Pizza Delivery with Entertainment App
classdiagram pizzaDelivery {

    class User {
        String userId; // uniquely identifiable
        String name;
        String birthday;
        String address;
    }

    class BusinessOwner extends User {
        String linkedInAccount;
    }

    class HungryCustomer extends User {
        String deliveryAddress;
    }

    class Entertainer extends User {
        String stageName;
        String bio;
        double pricePer30Minutes;
    }

    class PizzaRestaurant {
        String name; // e.g., Pizza Pronto
        String zipCode;
        String address;
        String phoneNumber;
        String website;
        String openingHours;
    }

    class Pizza {
        String name; // e.g., margarita, quattro stagioni
        String crustStructure; // e.g., classic Italian crust
        double price;
    }

    class Order {
        String orderId; // unique identifier for each order
        Date dateTime; // logs the date and time when the order was placed
        Date latestDeliveryTime;
        int numberOfPeople;
    }

    class EntertainmentOrder extends Order {
        String typeOfEntertainment; // type of entertainment requested
        int duration; // duration in minutes
    }

    enum Day {
        MONDAY,
        TUESDAY,
        WEDNESDAY,
        THURSDAY,
        FRIDAY,
        SATURDAY,
        SUNDAY;
    }

    association [0..*] BusinessOwner -> (owns) PizzaRestaurant [0..*];
    association [0..*] HungryCustomer -> (places) Order [0..*];
    association [0..*] Entertainer -> (worksFor) PizzaRestaurant [0..*];
    association [0..*] Entertainer -> (availability) Day [0..*]; // indicates availability by days
    association [0..*] PizzaRestaurant -> (offers) Pizza [0..*];
    association [0..*] Order -> (contains) Pizza [1..*]; // an order can be for one or more pizzas
    association [1] Order -> (fulfills) Entertainer [1]; // every entertainment order is fulfilled by exactly one entertainer
}
