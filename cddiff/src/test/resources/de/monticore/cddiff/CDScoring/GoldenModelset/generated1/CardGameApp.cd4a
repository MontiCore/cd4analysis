
// CD4A Model
classdiagram Game {

enum Suit {
    Diamonds,
    Hearts,
    Spades,
    Clubs;
}

enum SoloType {
    Trump,
    Jack,
    Queen;
}

class Card {
    String id;
    Suit suit;

    int compareHeight(Card otherCard);
}

class Deck {
    String id;
    Card[] cards; // up to 48 cards
}

class Round {
    String id;
    Player[] winningPlayers; // any number of winning players
    int pointValue;
}

class JackRound extends Round {
    // class body
}

class SoloRound extends Round {
    SoloType soloType;
    Player soloPlayer; // exactly one solo player
}

class MandatorySoloRound extends SoloRound {
    // class body
}

class ScoringTable {
    String id;
    Round[] rounds; // any number of rounds
}

class Player {
    String id;
}

}
