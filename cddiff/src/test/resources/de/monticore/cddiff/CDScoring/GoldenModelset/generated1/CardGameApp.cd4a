
// CD4A model for a game consisting of players, a deck of cards and a scoring table

classdiagram game {

    class Game {
        Player[] players; // exactly 4 players
        Deck deck;
        ScoringTable scoringTable;
    }

    class Deck {
        Card[] cards; // up to 48 cards
    }

    class Card {
        int id; // unique ID attribute
        Suit suit; // suit of the card
        ComparisonResult compareHeight(Card otherCard); // method for card height comparison
    }

    enum Suit {
        DIAMONDS,
        HEARTS,
        SPADES,
        CLUBS;
    }

    enum ComparisonResult {
        LOWER,
        EQUAL,
        HIGHER;
    }

    class ScoringTable {
        Round[] rounds; // any number of rounds
    }

    class Round {
        Player[] winningPlayers; // winning players for the round
        int pointValue; // point value of the round
        boolean isJackRound; // jack round flag
        boolean isSoloRound; // solo round flag
    }

    class SoloRound extends Round {
        SoloType soloType; // type of solo
        Player soloPlayer; // exactly one solo player
    }

    enum SoloType {
        TRUMP,
        JACK,
        QUEEN;
    }

}
