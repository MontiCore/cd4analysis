
// Class diagram for the Facepage social network
classdiagram Facepage {

class User {
    String id;  // unique identifier
    String name;
    String email;
    Date dateOfBirth;
}

class Account {
    String accountNumber;  // unique identifier generated by the database
}

class PersonalAccount extends Account {
    // Personal accounts can send or receive friend requests
}

class BusinessAccount extends Account {
    String companyName;
    float monthlyFee;  // amount paid by business users
}

class Page {
    String pageName;  // unique within each account
    int numberOfVisits;
}

class AdvertisementPage extends Page {
    float bounceRate;  // percentage of visitors that leave immediately
    float clickThroughRate;  // percentage of visitors that click a certain banner
    float conversionRate;  // percentage of visitors accomplishing the intended goal
}

// Association defining the relationship between accounts and pages
association [1] Account <-> Page [1..*];

// Association defining the relationship between personal accounts and other personal page privileges
association [0..*] PersonalAccount <-> Page [0..*];

association [1] BusinessAccount <-> AdvertisementPage [0..*];

}
