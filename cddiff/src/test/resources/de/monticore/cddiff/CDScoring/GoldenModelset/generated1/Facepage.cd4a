
classdiagram Facepage {

class User {
    String id; // unique identifier
    String name;
    String email;
    Date dateOfBirth;
}

class Account {
    String accountNumber; // unique identifier
}

class BusinessAccount extends Account {
    String companyName;
    double monthlyFee;
}

class PersonalAccount extends Account {}

class Page {
    String name; // must be unique per account
    int numberOfVisits;
}

class AdvertisementPage extends Page {
    double bounceRate;
    double clickThroughRate;
    double conversionRate;
}

association [1] User <-> Account [0..1];
association [1] Account <-> Page [*];
association [1] PersonalAccount <-> Page [*];
association [1] BusinessAccount <-> AdvertisementPage [*];

}
