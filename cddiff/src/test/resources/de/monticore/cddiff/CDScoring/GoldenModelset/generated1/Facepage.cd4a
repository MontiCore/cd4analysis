
// Class Diagram for Facepage social network site

classdiagram facepage {

    class User {
        String id; // Unique ID for the user
        String name;
        String email;
        Date dateOfBirth;
    }

    abstract class Account {
        String accountNumber; // Unique identifier generated by the database
        void createPage(String pageName);
    }

    class BusinessAccount extends Account {
        String companyName;
        double monthlyFee;
        
        void createAdvertisementPage(String pageName); // Business accounts can create advertisement pages
    }

    class PersonalAccount extends Account {
        void sendFriendRequest(User user); // Only personal accounts can send friend requests
        void receiveFriendRequest(User user);
        void grantPrivileges(Page page); // Grant privileges to other personal account pages
    }

    class Page {
        String pageName; // Must be unique for each account
        int numberOfVisits;
        Account administratedBy; // Each page must be administered by exactly one account
    }

    class AdvertisementPage extends Page {
        double bounceRate; // Percentage of visitors that leave immediately
        double clickThroughRate; // Percentage of visitors that click on a banner
        double conversionRate; // Percentage of visitors that achieve the intended goal
    }

    // Associations
    association [1] User -> (owns) Account [1]; // Each user can own one account
    association [1] Account -> (creates) Page [*]; // Each account can create several pages
    association [1] Account -> (administrates) Page [1]; // Each page is administrated by exactly one account
}
