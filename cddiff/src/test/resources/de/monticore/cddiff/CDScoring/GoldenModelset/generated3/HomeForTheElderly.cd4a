
classdiagram ElderlyHome {

class Inhabitant {
    String name;
    int registrationDate;
}

class Stay {
    String type;
    Date intakeDate;
    boolean isSuspended;
}

class Bed {
    String category;
    double price;
}

class Room {
    int roomNumber;
}

class Department {
    String departmentName;
}

class WaitingList {
    int position;
}

class Assessment {
    String needsForHelp;
}

class Invoice {
    double outstandingAmount;
    boolean isPaid;
}

class PaymentEvent {
    double amountPaid;
}

association [*] Department <-> Room [*];
association [*] Room <-> Bed [*];
association [*] Inhabitant <-> Bed [1];
association [1] Inhabitant <-> Stay [*];
association [1] Inhabitant <-> WaitingList [1];
association [1] Inhabitant <-> Assessment [1];
association [1] Stay <-> Invoice [1];
association [*] PaymentEvent <-> Invoice [1];

}
