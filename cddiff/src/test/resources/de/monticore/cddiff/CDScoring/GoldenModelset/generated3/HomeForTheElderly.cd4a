
// Class diagram for Home for the Elderly

classdiagram homeForElderly {

    class Home {
        List<Department> departments;
    }

    class Department {
        List<Room> rooms;
    }

    class Room {
        List<Bed> beds;
    }

    class Bed {
        String category;
        Price price;
    }

    enum StayType {
        RH, // Rest Home
        RNH, // Rest & Nursing Home
        SF;  // Service Flat
    }

    class Inhabitant {
        List<Stay> stays;
        void register();
        void assessAbilities();
        void acceptProposal(Stay stay);
        void refuseProposal();
        void reAssessAbilities();
    }

    class Stay {
        StayType type;
        Date intakeDate;
        Boolean proposalAccepted;
        void validateType();
        void invalidateProposal();
        void adjustStayType(StayType newType);
    }

    class Registration {
        void registerPerson();
        void assessNeeds();
        void addToWaitingList(Inhabitant inhabitant);
        void proposeBed(Inhabitant inhabitant);
    }

    class Invoice {
        Double outstandingAmount;
        Boolean isPaid;
        void registerPayment(Double amount);
        void modifyInvoice();
        void createCreditNote();
    }

    association [1..*] Home -> (departments) Department [*];
    association [1..*] Department -> (rooms) Room [*];
    association [1..*] Room -> (beds) Bed [*];
    association [*] Inhabitant -> (stays) Stay [*];
    association [1] Registration -> Inhabitant [*];
    association [1] Stay -> Inhabitant [1];
    association [1] Invoice -> Inhabitant [1];
}
