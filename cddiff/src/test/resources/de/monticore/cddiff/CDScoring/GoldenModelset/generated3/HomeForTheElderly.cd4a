
classdiagram ElderlyHome {

enum StayType {
    RestHome,
    RestAndNursingHome,
    ServiceFlat;
}

class Category {
    String name;
    double price;
}

class Bed {
    int bedNumber;
}

class Room {
    int roomNumber;
}

class Department {
    String name;
}

class Inhabitant {
    String name;
    String registrationDate;
}

class Stay {
    StayType type;
    String startDate;
    String endDate;
}

class Assessment {
    String abilities;
}

class Proposal {
    boolean isValid;
    String dateProposed;
}

class Invoice {
    double totalAmount;
    double outstandingAmount;
    boolean isPaid;
}

class PaymentEvent {
    double amount;
}

association [1] Department -> Room [*];
association [1] Room -> Bed [*];
association [*] Inhabitant <-> Bed [1];
association [*] Inhabitant -> Stay [*];
association [*] Inhabitant -> Assessment [0..1];
association [*] Inhabitant -> Proposal [0..1];
association [*] Stay -> Category [1];
association [1] Stay -> Invoice [0..*];
association [*] Invoice <-> PaymentEvent [0..*];
association [*] Category <-> Stay [0..*];

}
