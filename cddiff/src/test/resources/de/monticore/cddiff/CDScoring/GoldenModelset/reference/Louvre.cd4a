classdiagram Louvre {

class Collector {}

class Piece{
    String title;
    String description;
}

class Item{
    String description;
}

class Exhibition{
    String title;
    String stage;
}

class Location {}

class Room {}

class Employee{
    String level;
}


association [1] Collector <-> Piece [0..*];
association [0..*] Piece <-> Item [0..*];
association [1] Exhibition <-> Item [0..*];
association [1] Exhibition <-> (coordinator) Employee [0..*];
association [0..*] Exhibition <-> (assignedLocation) Location [0..1];
association RoomLocationAssignment [0..*] Location <-> Room [0..*];
association HasCoach [0..*] Employee <-> Employee [0..1];

}
