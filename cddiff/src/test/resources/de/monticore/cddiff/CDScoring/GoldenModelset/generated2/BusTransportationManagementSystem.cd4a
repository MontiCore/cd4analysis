
classdiagram BTMS {

class Driver {
    String name;
    String uniqueID;
    boolean isSickLeave;
}

class Bus {
    String licensePlate;
    boolean inRepairShop;
}

class BusRoute {
    int routeNumber; // range: 1..9999
}

class Shift {
    String shiftType; // e.g., morning, afternoon, night
}

class Schedule {
    Driver driver;
    Bus bus;
    Shift shift;
    Date date;
}

association [*] BusRoute <-> Bus [*];
association [*] BusRoute <-> Schedule [*];
association [*] Driver <-> Schedule [*];

}
