
// CD4A Model for Bus Transportation Management System (BTMS)
classdiagram btms {

    class Driver {
        String name;
        int id; // unique ID for the driver
        boolean isSick; // indicates if the driver is on sick leave
    }

    class Bus {
        String licencePlate; // unique licence plate number (up to 10 characters)
        boolean inRepair; // indicates if the bus is in the repair shop
    }

    class BusRoute {
        int routeNumber; // unique route number (maximum 9999)
    }

    class Shift {
        // morning, afternoon, night shifts will be treated as constants or enumerations
        static final String MORNING = "Morning";
        static final String AFTERNOON = "Afternoon";
        static final String NIGHT = "Night";
    }

    class Schedule {
        Date date; // for which the schedule is assigned
        Shift shift; // shift type assigned for a driver
    }

    // Associations
    association [*] BusRoute -> Bus [*]; // a route can have multiple buses assigned
    association [*] BusRoute -> Schedule [*]; // a route can have multiple schedules for drivers
    association [*] Schedule -> Driver [*]; // multiple drivers can be assigned
    association [*] Schedule -> Bus [*]; // multiple buses can be assigned

    // Overview of routes
    class Overview {
        void displayOverview();
    }
}
