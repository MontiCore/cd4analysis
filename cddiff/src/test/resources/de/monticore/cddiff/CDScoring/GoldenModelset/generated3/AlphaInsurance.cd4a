
classdiagram AlphaInsurance {

class Customer {
    String name;
    String contactInfo;
}

class Broker {
    String name;
    String registrationNumber;
}

class Policy {
    String type;
    double price;
}

class Contract {
    Date signingDate;
    String status;
}

class Claim {
    Date claimDate;
    String description;
}

class ClaimCase {
    String caseType;
    String status;
}

class Estimator {
    String name;
    String areaOfExpertise;
}

class CompensationDecision {
    double amount;
    String eligibleCosts;
}

class Invoice {
    Date invoiceDate;
    double amountDue;
    String frequency; // Monthly or Yearly
}

association [1] Customer <-> Broker [1];
association [1] Customer <-> Policy [0..*];
association [1] Customer <-> Contract [0..*];
association [1] Customer <-> Claim [0..*];
association [1] Claim <-> ClaimCase [0..*];
association [1] ClaimCase <-> Estimator [0..*];
association [1] ClaimCase <-> CompensationDecision [0..1];
association [1] Customer <-> Invoice [0..*];

}
