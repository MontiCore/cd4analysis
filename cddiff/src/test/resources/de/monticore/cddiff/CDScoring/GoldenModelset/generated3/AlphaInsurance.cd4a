
classdiagram insurance {

    class Customer {
        Broker assignedBroker;
        void requestInsurancePolicy(List<InsuranceType> types);
        void sendClaim(Claim claim);
    }

    class Broker {
        void assessProfile(Customer customer);
        void sendFileForAnalysis(Customer customer);
        List<Contract> createOffer(Customer customer);
    }

    class Contract {
        InsuranceType policyType;
        boolean isSigned;
        void signContract();
        void invoiceCustomer();
    }

    class Claim {
        List<ClaimCase> claimCases;
        void submitClaim();
    }

    class ClaimCase {
        List<EstimatorReport> reports;
        boolean isApproved;
        void assessClaim();
        void calculateCompensation();
    }

    class Estimator {
        void issueReport(ClaimCase claimCase);
    }

    class EstimatorReport {
        ClaimCase caseHandled;
        // This report is stored for legal purposes
    }

    enum InsuranceType {
        LIFE,
        HEALTH,
        AUTO,
        HOME;
    }

    association [1] Broker -> Customer [*]; // A broker can handle multiple customers
    association [1] Customer -> Contract [*]; // A customer can have multiple contracts
    association [1] Claim -> ClaimCase [*]; // A claim can have multiple claim cases
    association [*] ClaimCase -> EstimatorReport [*]; // A claim case can have multiple estimator reports
    association [1] ClaimCase -> Estimator [*]; // A claim case can be assessed by multiple estimators
}
