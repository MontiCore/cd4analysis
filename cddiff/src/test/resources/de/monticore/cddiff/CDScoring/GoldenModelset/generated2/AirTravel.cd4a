
classdiagram AircraftManagementSystem {

class Aircraft {
    String name;
    String type;
    int yearOfManufacture;
    Date nextInspectionDate;
}

class Flight {
    String flightNumber;
    Date date;
}

class Passenger {
    String name;
    String passportNumber;
}

class Ticket {
    String ticketNumber;
    float price;
    boolean upgradeDesired;
}

class PassengerAircraft extends Aircraft {
    int numberOfSeats;
}

class SeatCategory {
    String designation;
    boolean entertainmentProgram;
    int numberOfSeats;
}

class Airline {
    String name;
}

class FlightAttendant {
    String name;
    Date dateOfEmployment;
    boolean isChiefSteward;
}

class Pilot {
    String name;
    Date dateOfEmployment;
    String license;
}

class Airport {
    String name;
    String address;
    int numberOfRunways;
}

association [*] Aircraft -- Flight [*];
association [*] Flight -- Passenger [*];
association [1] Ticket -- SeatCategory [1];
association [1] PassengerAircraft -- SeatCategory [*];
association [1] Aircraft -- Airline [0..1];
association [*] Airline -- FlightAttendant [*];
association [1] Airline -- Pilot [*];
association [*] Flight -- FlightAttendant [*];
association [1] Flight -- Pilot [1];
association [1] Aircraft -- Airport [0..1];
association [1] Flight -- (departure) Airport [1];
association [1] Flight -> (destination) Airport [1];

}
