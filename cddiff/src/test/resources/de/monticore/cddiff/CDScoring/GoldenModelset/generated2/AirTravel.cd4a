
// CD4A Class Diagram for Aircraft and Flight Management System
classdiagram aircraftFlightManagement {

    class Aircraft {
        String name;
        String type;
        int yearOfManufacture;
        Date nextInspectionDate;
        Airline airline; // Association to Airline
        Airport homeAirport; // Association to Airport
        List<Flight> flights; // Association to Flight
    }

    class PassengerAircraft extends Aircraft {
        int numberOfSeats;
        List<SeatCategory> seatCategories; // Association to SeatCategory
    }

    class Flight {
        String flightNumber;
        Date date;
        Airport departureAirport; // Association to Airport
        Airport destinationAirport; // Association to Airport
        List<Passenger> passengers; // Association to Passenger
        List<FlightAttendant> flightAttendants; // Association to FlightAttendant
        Pilot captain; // Association to Pilot
        List<Pilot> coPilots; // Association to Pilot
    }

    class Passenger {
        String name;
        String passportNumber;
        List<Ticket> tickets; // Association to Ticket
    }

    class Ticket {
        String ticketNumber;
        double price;
        boolean upgradeDesired;
        SeatCategory seatCategory; // Association to SeatCategory
    }

    class SeatCategory {
        String designation;
        boolean entertainmentProgram;
        int numberOfSeats;
    }

    class Airline {
        String name;
        List<FlightAttendant> flightAttendants; // Association to FlightAttendant
        List<Pilot> pilots; // Association to Pilot
    }

    class FlightAttendant {
        String name;
        Date dateOfEmployment;
        boolean isChiefSteward; // true if chief stewardess, false if stewardess
    }

    class Pilot {
        String name;
        Date dateOfEmployment;
        String license;
    }

    class Airport {
        String name;
        String address;
        int numberOfRunways;
    }

    association [*] Aircraft <-> Flight [*];
    association [*] Flight <-> Passenger [*];
    association [*] Flight <-> FlightAttendant [*];
    association [1] Flight <-> Pilot [1]; // One pilot as a captain
    association [*] Pilot -> Flight [*]; // Co-pilots
    association [*] PassengerAircraft <-> SeatCategory [*];
    association [*] Airline <-> FlightAttendant [*];
    association [*] Airline <-> Pilot [*];
    association [*] Aircraft -> Airline [1];
    association [1] Aircraft -> Airport [1];
    association [1] Flight -> Airport [1]; // Departure Airport
    association [1] Flight -> Airport [1]; // Destination Airport
}
