
classdiagram school {

class School {
    String name;
}

class Person {
    String firstName;
    String lastName;
}

class Teacher extends Person {
    String email;
}

class Student extends Person {
}

class Principal extends Teacher {
    // Principal designation represented by association, only one per school
}

class Room {
    String name;
}

class Classroom extends Room {
    int capacity; // Capacity for classroom-specific details
}

class Gym extends Room {
    int sizeInSquareMeters; // Size specifically for gyms
}

class ClassGroup {
    String name; // Example: "5a"
}

// Associations
association attends [1] Student -> School [1];
association teaches [0..3] Teacher -> School [1];
association principalOf [1] Principal -> School [1];
association consistsOf [*] School -> Room [*];
association forms [10..31] Student -> (belongsTo) ClassGroup [1];
association assignedTo [1] ClassGroup -> (locatedIn) Classroom [1];
}
