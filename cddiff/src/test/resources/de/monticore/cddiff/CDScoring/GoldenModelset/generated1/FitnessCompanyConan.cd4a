 
classdiagram FitnessCompanyConan {

class Address {
    String street;
    String city;
    String zipCode;
}

class Room {
    int number;
    int maxCapacity;
}

class Center {
    String uniqueName;
    Address address;
}

class Person {
    String firstName;
    String familyName;
    Date birthDate;
}

class Trainer extends Person {
    String diploma;
}

class Session {
    Date date;
    String startingHour;
}

class GroupSession extends Session {
    String type;
}

class IndividualSession extends Session {}


association [1] Center <-> Room [*];
association [*] Center <-> (hosts) Session [*];
association [1] Session <-> (supervisedBy) Trainer [0..1];
association [*] Person <-> (participatesIn) Session [*];
association [*] Trainer <-> (supervises) GroupSession [0..*];
association [0..*] Person <-> (prospectsBy) Session [0..*];

}
