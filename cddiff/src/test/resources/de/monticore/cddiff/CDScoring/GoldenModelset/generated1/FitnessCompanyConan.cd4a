
classdiagram fitness {

    class Address {
        String street;
        String city;
        String postalCode;
    }

    class FitnessCenter {
        String name; // Unique name of the center
        Address address;
    }

    class Room {
        int number; // Unique number in the center
        int maxCapacity;
    }

    class Person {
        String firstName;
        String familyName;
        Date birthDate; // Unique combination with firstName and familyName
    }

    class Trainer extends Person {
        String diploma; // Recorded diploma of the trainer
    }

    class Session {
        Date date;
        String startingHour; // Starting hour of the session
    }

    class IndividualSession extends Session {
        // No additional attributes
    }

    class GroupSession extends Session {
        String type; // Type of the group session, e.g., aerobics
        Trainer trainer; // Requires exactly one trainer
    }

    association [1..*] FitnessCenter -> (rooms) Room [1..*]; // Each center has multiple rooms
    association [*] Room -> (sessions) Session [*]; // Each room can have multiple sessions
    association [1..*] Session -> (participants) Person [0..*]; // Each session can have multiple participants
    association [1] GroupSession -> (trainer) Trainer [1]; // Group session requires exactly one trainer
}
