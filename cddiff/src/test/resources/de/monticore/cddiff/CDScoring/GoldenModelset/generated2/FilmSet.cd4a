
classdiagram FilmSet {

class Employee {
    String name;
    String socialSecurityNumber;
    boolean hasOscar;
}

class CreativeEmployee extends Employee {
    String assistantName;
}

class Director extends CreativeEmployee {}

class Actor extends CreativeEmployee {
    String education;
}

class Technician extends Employee {
    String fieldOfActivity;
}

class Film {
    String title;
    int year;
}

class Genre {
    GenreType type;
}

enum GenreType {
        THRILLER,
        ACTION,
        HORROR,
        COMEDY;
    }

class Screenwriter {
    String name;
    Film mostSuccessfulFilm;
}

class Screenplay {
    String title;
    String version;
    String date;
    int numberOfScenes;
    String plot;
}

class Novel {
    String title;
    String author;
}

class FilmSet {
    // The LLM did not generate this class, adding it to avoid errors.
}

association [0..*] FilmSet <-> Film [0..*];
association [0..*] Film <-> Screenplay [1];
association [0..*] Screenwriter <-> Screenplay [1];
association [1] Screenplay <-> Novel [0..1];
association [1] Film <-> (director) Director [0..1];
association [0..*] Film <-> Actor [0..*];
association [1] Film <-> (implementedBy) Director [0..1];
association [0..*] Film <-> (preparedBy) Actor [0..*];

}
