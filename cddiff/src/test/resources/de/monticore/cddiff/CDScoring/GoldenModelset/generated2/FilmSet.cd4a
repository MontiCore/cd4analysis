
// CD4A class diagram for film production scenario
classdiagram filmProduction {

    class Employee {
        String name;
        String socialSecurityNumber;
        boolean hasOscar;
    }

    class CreativeEmployee extends Employee {
        // CreativeEmployee can inherit common properties of Employee
    }

    class Director extends CreativeEmployee {
        String assistantName;
    }

    class Actor extends CreativeEmployee {
        String education;
    }

    class Technician extends Employee {
        String fieldOfActivity;
    }

    class FilmSet {
        String location;
    }

    class Film {
        String title;
        int yearOfRelease;
    }

    enum Genre {
        THRILLER,
        ACTION,
        HORROR,
        COMEDY;
    }

    class Screenwriter {
        String name;
        Film mostSuccessfulFilm;
    }

    class Screenplay {
        String title;
        String version;
        Date date;
        int numberOfScenes;
        String plot;
    }

    class Novel {
        String title;
        String author;
    }

    // Associations
    association [*] FilmSet <-> Film [*];
    association [1] Screenwriter <-> Screenplay [*];
    association [1] Screenplay -> Film [1];
    association [1] Film <-> Screenplay [*];
    association [*] Film <-> Actor [*];
    association [1] Film -> Director [1];
    association [1] Actor -> Screenplay [1];
    association [1] Director -> Screenplay [1];
    
    // Indicating a screenplay can be based on either a Novel or a Concept (not defined in the description, hence not explicitly noted)
}
