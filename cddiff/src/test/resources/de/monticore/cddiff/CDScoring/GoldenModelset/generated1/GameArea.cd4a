
classdiagram GameArea {

class GameArea {
    String name;
}

class GameElement {
    protected long x;
    private long y;
}

class Shape extends GameElement {}

class Object extends GameElement {}

class Opponent extends GameElement {
    protected int lives;
    void kill();
}

class Boss extends Opponent {}

association [1..*] GameArea <-> GameElement [1..2];

association [*] Shape <-> Shape [*];

}
