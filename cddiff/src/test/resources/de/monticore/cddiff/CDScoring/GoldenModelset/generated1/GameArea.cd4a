
classdiagram gameArea {

    class GameArea {
        String name;
        // Association to GameElement
    }
    
    abstract class GameElement {
        protected long x;
        private long y;
    }

    class Shape extends GameElement {
        // Association to other shapes
    }

    class Object extends GameElement {
        // No additional attributes or methods
    }
    
    class Opponent extends GameElement {
        protected int lives;
        void kill();
    }

    class Boss extends Opponent {
        // Boss is a specific type of Opponent
    }

    association [1..*] GameArea -> (elements) GameElement [1..*];
    association [1] GameArea -> (boss) Boss [1];
    association [0..*] Shape <-> (connectedShapes) Shape [0..*];
}
