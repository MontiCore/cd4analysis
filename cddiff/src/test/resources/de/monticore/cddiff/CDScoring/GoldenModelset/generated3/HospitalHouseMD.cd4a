
// CD4A Model for HospitalHouseMD system

classdiagram hospital {

    class HospitalHouseMD {
        void assignDoctor(Patient patient, Doctor doctor);
        void approveDiagnosis(Doctor doctor, Diagnosis diagnosis);
    }

    class Patient {
        String name;
        boolean consentGiven;
        void signConsent();
        void retractConsent();
    }

    class Doctor {
        String name;
        void diagnose(Patient patient, Illness illness);
        void downgradeTreatment(Treatment treatment);
    }

    class Illness {
        String description;
        PriorityScore priorityScore;
    }

    class Treatment {
        Stage stage;
        void apply();
        void upgradeStage();
    }

    enum Stage {
        STAGE1,
        STAGE2,
        STAGE3;
    }

    enum PriorityScore {
        HIGH,
        LOW;
    }

    association [*] HospitalHouseMD -> (patients) Patient [*];
    association [*] HospitalHouseMD -> (doctors) Doctor [*];
    association [*] Patient -> (illnesses) Illness [*];
    association [*] Illness -> (treatments) Treatment [*];
    association [1] Treatment <-> Doctor [1]; // Each treatment is associated with one doctor
}
