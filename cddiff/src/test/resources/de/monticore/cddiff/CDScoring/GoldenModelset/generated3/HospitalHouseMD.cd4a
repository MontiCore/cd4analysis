
classdiagram HospitalHouseMD {

class Patient {
  String name;
  String consentForm;
}

class Doctor {
  String name;
}

class HeadDoctor extends Doctor {}

class Illness {
  String name;
  String priorityScore; // high or low
}

class Treatment {
  String name;
  int stage; // 1, 2, or 3
}

class Nurse {
  String name;
}

class Diagnosis {}

association [1..*] Patient <-> (assignedTo) Doctor [1..*];
association [1] HeadDoctor <-> (approves) Diagnosis [0..*];
association [1] Illness -- Treatment [1..*];
association [1..*] Treatment -- (requires) Nurse [1..*];
association [1..*] Illness -> Treatment [0..*];
}

