import java.util.List;
import java.util.Optional;
import java.util.Date;

classdiagram KineopolisLLM {
  class Kineopolis {
    List<Cinema> cinemas;
  }

  class Cinema {
    String town;
    List<Theatre> theatres;
    List<Copy> copies;
  }

  class Theatre {
    int number;
    int seatCount;
    List<Show> shows;
  }

  class Movie {
    String title;
    int durationMinutes;
  }

  class Copy {
    String copyId;
    Movie movie;
    Cinema location;
  }

  class Show {
    DateTime startTime;
    Copy copy;
    Theatre theatre;
    boolean isPublished;
    boolean isCancelled;
    List<SeatReservation> reservations;
    List<EntranceTicket> entranceTickets;
  }

  class SeatReservation {
    String reservationId;
    DateTime reservedAt;
    String seatNumber;
    boolean isCancelled;
    CreditCard payment;
    Optional<ReservationOffer> offer;
  }

  class CreditCard {
    String number;
    Date expiryDate;
    boolean isCharged;
  }

  class ReservationOffer {
    Show newShow;
    DateTime offeredAt;
    DateTime expiresAt;
    boolean isAccepted;
  }

  class EntranceTicket {
    String ticketId;
    String seatNumber;
    DateTime purchasedAt;
  }

  association [1] Kineopolis -> (owns) Cinema [*];
  association [1] Cinema -> (contains) Theatre [*];
  association [1] Cinema -> (holds) Copy [*];
  association [1] Copy -> (isCopyOf) Movie [1];
  association [1] Copy -> (usedIn) Show [*];
  association [1] Theatre -> (hosts) Show [*];
  association [1] Show -> (has) SeatReservation [*];
  association [1] Show -> (issues) EntranceTicket [*];
  association [1] SeatReservation -> (paidWith) CreditCard [1];
  association [0..1] SeatReservation -> (mayHave) ReservationOffer [1];
  association [1] ReservationOffer -> (alternativeShow) Show [1];

  class DateTime {} // fix DateTime not existing
}
