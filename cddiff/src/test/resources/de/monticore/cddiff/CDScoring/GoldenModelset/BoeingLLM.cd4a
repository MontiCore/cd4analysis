/* (c) CD4A Class Diagram */

classdiagram BoeingLLM {

  class AirlineCompany {
    String name;
    String country;
  }

  // Self-association to represent mother-daughter airline relationships
  association [0..1] AirlineCompany (mother) <-> (daughter) AirlineCompany [*];

  class Contract {
    String contractNumber;
    String deliveryConditions;
    String legalAspects;
  }

  class Acquisition {
    double price;
    Date deliveryDate;
    String optionsAndCustomizations;
  }

  class AircraftModel {
    String modelName;
    String version;
  }

  class Employee {
    String employeeId;
    String name;
  }

  // Associations
  association [1] AirlineCompany -> (contracts) Contract [*];
  association [1] Contract -> (acquisitions) Acquisition [*];
  association [1] Acquisition -> (aircraftModel) AircraftModel [1];

  // A contract always has one responsible salesperson,
  // but over time it may change (historical tracking not modeled here)
  association [1] Employee -> (managedContracts) Contract [*];

}
