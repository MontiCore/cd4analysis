
classdiagram boeingAircraftSales {

class AirlineCompany {
    String name;
    Optional<AirlineCompany> parentCompany; // Indicates mother-daughter relationship
}

class Contract {
    String contractId;
    String deliveryConditions;
    String legalDetails;
    List<Acquisition> acquisitions; // List of airplane acquisitions within the contract
}

class Acquisition {
    String acquisitionId;
    String airplaneModel;
    double negotiatedPrice;
    List<String> options; // Customizations chosen for the airplane
    Date deliveryDate;
}

class Salesperson {
    String employeeId;
    String name;
}

// Associations
association managesContract [1] Salesperson -> Contract [*]; // Salesperson manages many contracts
association hasAcquisition [1] Contract -> Acquisition [*];  // Contract consists of several acquisitions
association [0..*] AirlineCompany -> (relatedTo) AirlineCompany [0..*]; // Airlines may have mother-daughter relationships

}
