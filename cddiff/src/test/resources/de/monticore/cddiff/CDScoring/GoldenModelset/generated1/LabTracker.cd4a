
// CD4A Class Diagram for LabTracker Software
classdiagram labTracker {

    class Doctor {
        String practitionerNumber;
        String signature; // digital signature image
        String fullName;
        String address;
        String phoneNumber;
        Date validFrom; // date from which the requisition is valid
        
        Requisition createRequisition(Patient patient);
    }

    class Patient {
        String healthNumber; // alpha-numeric
        String firstName;
        String lastName;
        Date dateOfBirth;
        String address;
        String phoneNumber;

        Appointment bookAppointment(Requisition requisition, Lab lab);
    }

    class Requisition {
        Doctor doctor;
        Patient patient;
        List<Test> tests; // list of tests on the requisition
        RepetitionPattern repetitionPattern; // specifies repeat interval and number

        // doctor cannot prescribe tests for themselves, checks needed
    }

    class Test {
        String testName;
        Duration duration; // duration defined by lab network
        boolean requiresAppointment; // true if appointment is needed
        boolean walkInOnly; // true if only walk-in
        boolean sampleDropOffRequired; // true if only drop-off is needed
    }

    class Appointment {
        String confirmationNumber;
        Date date;
        Time startTime;
        Time endTime;
        Lab lab;

        void changeAppointment(); // changes the existing appointment
        void cancelAppointment(); // cancels the existing appointment
    }

    class Lab {
        String name;
        String registrationNumber;
        String address;
        BusinessHours businessHours; // each lab's business hours
        double cancellationFee; // fee determined by the lab
    }

    enum RepetitionPattern {
        WEEKLY,
        MONTHLY,
        EVERY_HALF_YEAR,
        YEARLY;
    }

    // Associations
    association [1] Doctor -> Requisition [*]; // one doctor can create multiple requisitions
    association [1] Patient -> Appointment [*]; // one patient can have multiple appointments
    association [*] Requisition -> Test [*]; // one requisition can include multiple tests
    association [1] Appointment -> Lab [1]; // each appointment is for one lab
}
