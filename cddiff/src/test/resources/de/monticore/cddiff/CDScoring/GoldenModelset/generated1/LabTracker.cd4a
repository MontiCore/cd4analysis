
classdiagram LabTracker {

class Doctor {
    int practitionerNumber;
    String fullName;
    String address;
    String phoneNumber;
    Image digitalSignature;
    Date requisitionValidFrom;
}

class Patient {
    String healthNumber;
    String firstName;
    String lastName;
    Date dateOfBirth;
    String address;
    String phoneNumber;
}

class Requisition {
    int id;
    List<Test> tests;
}

class Test {
    int id;
    Duration duration;
    boolean appointmentRequired;
    boolean walkInOnly;
    boolean sampleDropOff;
}

class Appointment {
    int confirmationNumber;
    Date date;
    Time startTime;
    Time endTime;
    String labName;
    String labRegistrationNumber;
    Fee changeCancellationFee;
}

class Lab {
    String address;
    String businessHours;
    Fee cancellationFee;
}

enum RepetitionInterval {
    Weekly,
    Monthly,
    EveryHalfYear,
    Yearly;
}

class RepeatedTest {
    int numberOfRepetitions;
    RepetitionInterval interval;
}

class TestGroup {
    String name;
}

association [1] Doctor -> Requisition [*];
association [1] Requisition -> Patient [1];
association [1] Requisition -> Test [*];
association [1] Test -> TestGroup [1];
association [1] Test -> Appointment [0..1];
association [1] Appointment -> Lab [1];

}
