
// CD4A Class Diagram for LabTracker Software
classdiagram LabTracker {

class Doctor {
    int practitionerNumber;
    String fullName;
    String address;
    String phoneNumber;
    Image digitalSignature;
}

class Patient {
    String healthNumber;
    String firstName;
    String lastName;
    Date dateOfBirth;
    String address;
    String phoneNumber;
}

class Requisition {
    Date validFrom;
}

class Test {
    int duration; // duration in minutes
}

class Appointment {
    int confirmationNumber;
    Date date;
    Time startTime;
    Time endTime;
}

class Lab {
    String address;
    String businessHours;
    double cancellationFee;
}

enum RepetitionInterval {
    Weekly,
    Monthly,
    HalfYear,
    Yearly;
}

class TestGroup {
    String groupName;
}

class Result {
    boolean isPositive;
    String report;
}

association [1] Doctor -> Requisition [*]; // A doctor can have multiple requisitions
association [1] Requisition -> Patient [1]; // Each requisition must have one patient
association [*] Requisition -- Test [*]; // A requisition can contain multiple tests, but all must be of the same group
association [1] Test -> TestGroup [1]; // Each test belongs to one test group
association [*] Appointment <-> Requisition [1]; // Requisitions requiring an appointment
association [1] Appointment -> Lab [1]; // Each appointment is scheduled at one lab
association [0..1] Lab -> Test [*]; // Labs offer multiple tests
association [1] Patient -> Appointment [*]; // A patient can have multiple appointments
association [1] Requisition -> Result [*]; // A requisition can have multiple results
association [1] Requisition -> Doctor [1]; // Requisition is prescribed by one doctor
association [1] Doctor <-> Doctor [*]; // A doctor can prescribe tests for other doctors, not themselves 

}
