
// CD4A Model for the Game
classdiagram game {

    class Game {
        Player[] players; // Contains 4 players
        Deck deck;
        ScoringTable scoringTable;
    }

    class Deck {
        Card[] cards; // Up to 48 cards
    }

    class Card {
        String id; // Unique ID
        Suit suit; // Suit of the card
        ComparisonResult compareHeight(Card other); // Comparison method for card height
    }

    enum Suit {
        DIAMONDS,
        HEARTS,
        SPADES,
        CLUBS;
    }

    class ScoringTable {
        Round[] rounds; // Any number of rounds
    }

    class Round {
        Player[] winningPlayers; // Winning players of the round
        int pointValue; // Point value of the round
    }

    class JackRound extends Round {
        // Additional attributes or methods for JackRound if needed
    }

    class SoloRound extends Round {
        Solo soloType; // Type of solo
        Player soloPlayer; // Exactly one solo player
    }

    enum Solo {
        TRUMP,
        JACK,
        QUEEN;
    }

    enum ComparisonResult {
        LOWER,
        EQUAL,
        HIGHER;
    }

    class Player {
        String id; // Unique ID
    }
}
