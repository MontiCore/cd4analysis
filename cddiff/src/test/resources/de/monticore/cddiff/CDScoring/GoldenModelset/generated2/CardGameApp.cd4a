}

abstract class GameObject {
    int uniqueID;
}

class Card extends GameObject {
    ComparisonResult compareHeight(Card otherCard);
}

enum ComparisonResult {
    Lower,
    Equal,
    Higher;
}

class Deck extends GameObject {
    Card[] cards; // up to 48 cards
}

class Player extends GameObject {
    // player attributes and methods
}

class ScoringTable extends GameObject {
    Round[] rounds;
}

abstract class Round extends GameObject {
    Player[] winningPlayers;
    int pointValue;
}

class JackRound extends Round {
    // jack round specific attributes and methods
}

class SoloRound extends Round {
    SoloType soloType;
    Player soloPlayer;
}

enum SoloType {
    Trump,
    Jack,
    Queen;
}

class MandatorySoloRound extends SoloRound {
    // mandatory solo round specific attributes and methods
}

