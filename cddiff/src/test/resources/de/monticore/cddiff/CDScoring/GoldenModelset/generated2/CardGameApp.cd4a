
// Class Diagram for a Card Game
classdiagram CardGame {

enum Suit {
    Diamonds,
    Hearts,
    Spades,
    Clubs;
}

// Class representing a Card
class Card {
    int uniqueId; // Unique identifier for each card
    Suit suit;
    
    // Comparison method for card height
    int compareHeight(Card otherCard);
}

// Class representing a Deck of Cards
class Deck {
    Card[] cards; // Up to 48 cards in the deck
}

// Class representing a Player
class Player {
    int uniqueId; // Unique identifier for each player
}

// Class representing a Round
class Round {
    Player[] winningPlayers; // Players who won the round
    int pointValue; // Points awarded for this round
}

// Class representing a Scoring Table
class ScoringTable {
    Round[] rounds; // Any number of rounds
}

// Class representing a Solo Round (inheritance)
class SoloRound extends Round {
    SoloType soloType; // Type of solo: trump, jack, or queen
    Player soloPlayer; // Exactly one solo player
}

// Class representing a Jack Round (inheritance)
class JackRound extends Round {
}

// Class representing a Mandatory Solo Round (inheritance)
class MandatorySoloRound extends SoloRound {
}

// Enumeration for Solo Types
enum SoloType {
    Trump,
    Jack,
    Queen;
}

// Association between Game, Player, Deck, and Scoring Table
class Game {
    Deck deck;
    Player[] players; // 4 players
    ScoringTable scoringTable;
}

association [4] Player <-> Game [1]; // 4 players in the game
association [1] Deck <-> Game [1]; // One deck for the game
association [1] ScoringTable <-> Game [1]; // One scoring table for the game

}
