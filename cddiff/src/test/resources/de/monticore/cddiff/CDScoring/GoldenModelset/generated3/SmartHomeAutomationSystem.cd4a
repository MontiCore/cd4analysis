
classdiagram SmartHomeAutomationSystem {

class SmartHome {
    String physicalAddress;
}

class Room {
    String name;
}

class SensorDevice {
    String deviceIdentifier;
    String type;
}

class ActuatorDevice {
    String deviceIdentifier;
    String type;
}

class SensorReading {
    double measuredValue;
    Date timestamp;
}

class ControlCommand {
    String commandType;
    Date timestamp;
    String status;
}

class ActivityLog {}

class AutomationRule {
    String precondition;
    String action;
    boolean isActive;
}

class Owner {}

class RuleTrigger {
    Date timestamp;
}

association [1] SmartHome <-> Room [0..*];
association [1] Room <-> SensorDevice [0..*];
association [1] Room <-> ActuatorDevice [0..*];
association [1] SensorDevice <-> SensorReading [0..*];
association [1] ActuatorDevice <-> ControlCommand [0..*];
association [1] SmartHome <-> ActivityLog [0..*];
association [1] Owner <-> AutomationRule [0..*];
association [1] AutomationRule <-> RuleTrigger [0..*];

}
