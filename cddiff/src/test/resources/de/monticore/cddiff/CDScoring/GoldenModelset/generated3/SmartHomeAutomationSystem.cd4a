
// Class diagram for Smart Home Automation System (SHAS)
classdiagram shas {

    class SmartHome {
        String address;
        List<Room> rooms;
        void updateInfrastructureMap();
    }

    class Room {
        String name;
        List<SensorDevice> sensorDevices;
        List<ActuatorDevice> actuatorDevices;
    }

    abstract class Device {
        String deviceId;
        boolean isActive;
    }

    class SensorDevice extends Device {
        List<SensorReading> readings;
        void activate();
        void deactivate();
    }

    class ActuatorDevice extends Device {
        List<ControlCommand> commands;
        void activate();
        void deactivate();
    }

    class SensorReading {
        double measuredValue;
        Date timestamp;
    }

    class ControlCommand {
        String commandName;
        Date timestamp;
        CommandStatus status; // ENUM
    }

    enum CommandStatus {
        REQUESTED,
        COMPLETED,
        FAILED;
    }

    class ActivityLog {
        List<LogEntry> entries;
        void logEntry(LogEntry entry);
    }

    class LogEntry {
        Date timestamp;
        String description;
    }

    class AutomationRule {
        BooleanExpression precondition;
        List<ControlCommand> action;
        boolean isActive;
        void activate();
        void deactivate();
        void edit();
    }

    interface BooleanExpression {
        boolean evaluate();
    }

    class RelationalTerm {
        // Represents atomic terms referring to rooms, sensors, actuators, etc.
        String termReference;
    }

    association [*] SmartHome -> (contains) Room [*];
    association [*] Room -> (contains) SensorDevice [*];
    association [*] Room -> (contains) ActuatorDevice [*];
    association [*] SensorDevice -> (generates) SensorReading [*];
    association [*] ActuatorDevice -> (issues) ControlCommand [*];
    association [*] SmartHome -> (logs) ActivityLog [1];
}
