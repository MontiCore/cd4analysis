
// CD4A Class Diagram for the Online Tutoring System (OTS)

classdiagram ots {

    class Person {
        String name;
        String emailAddress;
    }

    class Tutor extends Person {
        String bankAccount;
        void offerTutoring(String subject, String expertiseLevel, double hourlyPrice);
        void specifyAvailability(String availability);
    }

    class Student extends Person {
        void browseTutoringOffers(String subject);
        void makeTutoringRequest(Tutor tutor, String level, String suggestedDateTime);
    }

    class TutoringSession {
        Tutor tutor;
        Student student;
        String subject;
        String level;
        String dateTime;
        double price;
        void confirmSession();
        void cancelSession();
    }

    enum CancellationPolicy {
        STUDENT_CANCEL_BEFORE_24_HOURS,
        TUTOR_CANCEL_WITHIN_24_HOURS;
    }
    
    association [*] Tutor -> (offers) TutoringSession [*];
    association [*] Student -> (requests) TutoringSession [*];
    association [1] TutoringSession -> Tutor [1];
    association [1] TutoringSession -> Student [1];
}

