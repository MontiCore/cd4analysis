
classdiagram OTS {
    class User {
        String name;
        String email;
    }

    class Tutor extends User {
        String bankAccount;
        String weeklyAvailability; // e.g., "Thursdays from 10:00 to 11:30"
    }

    class Student extends User {
        // Additional attributes can be added if needed
    }

    class TutoringOffer {
        String subject;
        String levelOfExpertise; // e.g., "primary school level"
        float hourlyPrice;
    }

    class TutoringRequest {
        String targetDateTime; // e.g., "2023-10-05 10:00"
        String levelOfTutoring;
    }

    class TutoringSession {
        boolean cancelled;
        float price;
    }

    class Payment {
        String method; // e.g., "credit card" or "wire transfer"
    }

    class Award {
        String name; // e.g., "Tutor of the Month"
    }

    association [0..*] Tutor <-> TutoringOffer [0..*];
    association [0..*] Student <-> TutoringRequest [0..*];
    association [0..*] TutoringOffer <-> TutoringRequest [0..*];
    association [1..1] TutoringRequest <-> TutoringSession [0..1];
    association [1..1] TutoringSession <-> Payment [0..1];
    association [1..*] Tutor <-> Award [0..*];
}
