
// Class diagram for an aircraft management system
classdiagram aircraftManagement {

    class Aircraft {
        String name;
        String type;
        int yearOfManufacture;
        Date nextInspectionDate;
        
        void performFlight(Flight flight);
    }

    class PassengerAircraft extends Aircraft {
        int numberOfSeats;
        
        void addSeatCategory(SeatCategory category);
    }

    class Flight {
        String flightNumber;
        Date date;
        List<Passenger> passengers;
        Airport departureAirport;
        Airport destinationAirport;
        
        void assignPassenger(Passenger passenger);
    }

    class Passenger {
        String name;
        String passportNumber;
        List<Ticket> tickets;
        
        void bookTicket(Ticket ticket);
    }

    class Ticket {
        String ticketNumber;
        double price;
        boolean upgradeDesired;
        SeatCategory category;
    }

    class SeatCategory {
        String designation;
        boolean entertainmentProgram;
        int numberOfSeats;
    }

    class Airline {
        String name;
        List<FlightAttendant> flightAttendants;
        List<Pilot> pilots;
    }

    class FlightAttendant {
        String name;
        Date employmentDate;
        boolean isChiefSteward;
    }

    class Pilot {
        String name;
        Date employmentDate;
        String license;
    }

    class Airport {
        String name;
        String address;
        int numberOfRunways;
    }

    association [*] Aircraft -> (home) Airport [1];
    association [*] Flight -> (passengers) Passenger [*];
    association [*] Flight -> (departure) Airport [1];
    association [*] Flight -> (destination) Airport [1];
    association [*] PassengerAircraft -> (seatCategories) SeatCategory [*];
    association [*] Airline -> (flightAttendants) FlightAttendant [*];
    association [*] Airline -> (pilots) Pilot [*];
    association [1] Flight -> (pilot) Pilot [1];
    association [*] Flight -> (flightAttendants) FlightAttendant [*];
}
