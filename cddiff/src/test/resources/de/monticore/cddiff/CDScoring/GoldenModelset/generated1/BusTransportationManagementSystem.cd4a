
classdiagram btms {

    class Driver {
        String name;
        int id; // unique ID assigned to each driver
        boolean isSickLeave; // indicates driver's sick leave status
    }

    class Bus {
        String licencePlate; // unique licence plate number (up to 10 characters)
        boolean inRepair; // indicates if the bus is in the repair shop
    }

    class Route {
        int routeNumber; // unique route number (max 9999)
    }

    class Schedule {
        Date date; // date of the schedule
        List<Shift> shifts; // list of shifts assigned for the date
    }

    class Shift {
        String time; // time of the shift (morning, afternoon, night)
        Bus bus; // bus assigned to the shift
        Driver driver; // driver assigned to the shift
    }

    // Associations
    association [*] CityStaff -> (assigns) Bus [*]; // City staff can assign multiple buses
    association [*] CityStaff -> (assigns) Driver [*]; // City staff can assign multiple drivers
    association [*] Route -> (assignedBuses) Bus [*]; // Each route can have multiple buses assigned per day
    association [*] Route -> (schedules) Schedule [*]; // Each route can have multiple schedules
    association [1] Shift -> (assignedTo) Bus [1]; // Each shift is assigned to one bus
    association [1] Shift -> (assignedTo) Driver [1]; // Each shift is assigned to one driver

}
