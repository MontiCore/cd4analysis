
classdiagram BTMS {

class Driver {
    String name;
    int id;
}

class Bus {
    String licencePlate;
}

class BusRoute {
    int number;
}

class Schedule {
    boolean isDriverSick;
    boolean isBusInRepairShop;
}

class Shift {
    String type; // morning, afternoon, night
}

association [*] BusRoute <-> Bus [*];
association [*] Driver <-> Shift [*];
association [*] Driver -- Schedule [0..1];
association [*] Bus -- Schedule [0..1];
}
