
// CD4A class diagram for an Oil Company with Gas Stations and Customers

classdiagram oilCompany {

    class GasStation {
        List<Pump> pumps;
        void refuelCar(Customer customer, Pump pump);
        void refillPump(Pump pump);
        void generateDailyReport();
    }

    class Pump {
        GasolineType gasolineType;
        double level;
        boolean isBlocked;
        void startRefueling(Customer customer);
        void stopRefueling();
        void checkRefill();
        void refill(double quantity);
    }

    enum GasolineType {
        REGULAR,
        PREMIUM,
        DIESEL;
    }

    class Customer {
        String name;
        RefuelCard refuelCard;
        List<Invoice> invoices;
        void requestInvoice();
        void payInvoice(Invoice invoice);
        void receiveInvoice(Invoice invoice);
        void suspend();
        void reactivate();
    }

    class RefuelCard {
        Customer customer;
        boolean isBlocked;
    }

    class Invoice {
        List<RefuelTurn> refuelTurns;
        double discount;
        void addRefuelTurn(RefuelTurn refuelTurn);
        void send();
        void remind();
    }

    class RefuelTurn {
        Pump pump;
        double amount;
        String date;
    }

    association [*] GasStation -> (pumps) Pump [*]; 
    association [0..1] Customer -> RefuelCard [1]; 
    association [*] Customer -> (invoices) Invoice [*];
    association [*] Invoice -> (refuelTurns) RefuelTurn [*];
    association [*] Invoice -> (pumps) Pump [1];
}
