
classdiagram OilCompany {

class Customer {
    int custId;
    String custName;
    boolean isSuspended;

    int getCustId();
    void setCustId(int newCustId);
    void blockCard();
    void unblockCard();
}

class Invoice {
    int invoiceId;
    Date invoiceDate;
    double amountDue;
    double discount;

    int getInvoiceId();
    void setInvoiceId(int newInvoiceId);
}

class Payment {
    int paymentId;
    Date paymentDate;
    double amountPaid;

    int getPaymentId();
    void setPaymentId(int newPaymentId);
}

class GasStation {
    int stationId;
    String location;

    int getStationId();
    void setStationId(int newStationId);
}

class Pump {
    int pumpId;
    double gasolineLevel;
    double reorderLevel;
    boolean isBlocked;

    int getPumpId();
    void setPumpId(int newPumpId);
    void blockPump();
    void unblockPump();
}

class RefuelTurn {
    int turnId;
    Date turnDate;
    double quantity;

    int getTurnId();
    void setTurnId(int newTurnId);
}

class RefuelCard {
    // The LLM did not generate this class, adding it to avoid errors
}

association [0..*] Customer -- (holds) RefuelCard [1];
association [*] RefuelCard -- (has) Invoice [*];
association [*] Invoice -- (receivedBy) Customer [1];
association [*] Invoice -- (relatedTo) Payment [0..*];
association [*] GasStation -- (operates) Pump [*];
association [*] Pump -- (has) RefuelTurn [0..*];

}
