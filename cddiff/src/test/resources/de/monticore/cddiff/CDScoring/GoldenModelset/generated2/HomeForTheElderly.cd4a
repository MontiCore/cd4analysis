
// Class Diagram for Home for the Elderly
classdiagram HomeForElderly {

enum StayType {
    RestHome,
    RestAndNursingHome,
    ServiceFlat;
}

class Person {
    String name;
    String identificationData;
    Date registrationDate;
    StayType assessedStayType;
}

class Inhabitant extends Person {
    // An inhabitant can have multiple stays
}

class Room {
    int roomNumber;
}

class Bed {
    String category;  // corresponds to a category with a price
}

class Category {
    String name;  // e.g., Rest Home, Rest & Nursing Home, Service Flat
    double price;
}

class Department {
    String name;
    Room[] rooms;  // Each department consists of multiple rooms
}

class WaitingList {
    List<Person> persons;  // Persons queued for assessment and stay
}

class Stay {
    StayType type;
    Date intakeDate;
    boolean isValid;  // Indicates if the proposal is accepted
    double outstandingAmount;
}

class Invoice {
    double totalAmount;
    double remainingAmount;
    boolean isPaid;  // If the invoice has been paid or not
}

association [*] Department <-> Room [1..*]; // Departments have multiple rooms
association [1] Room <-> Bed [1..*]; // Each room has multiple beds
association [1] Bed <-> Category [1];  // Each bed belongs to a specific category
association [*] Person <-> Inhabitant [1]; // A person can become an inhabitant
association [1] Inhabitant <-> Stay [*]; // An inhabitant can have multiple stays
association [1] Person <-> WaitingList [0..1]; // Assessed persons are on a waiting list
association [1] Inhabitant <-> Invoice [0..*]; // Inhabitants can have multiple invoices

}
