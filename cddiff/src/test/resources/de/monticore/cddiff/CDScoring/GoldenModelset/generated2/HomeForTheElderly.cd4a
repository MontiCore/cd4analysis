
// Class Diagram for Home for the Elderly

classdiagram homeElderly {

    enum StayType {
        RH, // Rest Home
        RNH, // Rest & Nursing Home
        SF;  // Service Flat
    }

    class Home {
        List<Department> departments;
    }

    class Department {
        List<Room> rooms;
    }

    class Room {
        List<Bed> beds;
    }

    class Bed {
        Category category; // Each bed belongs to a particular category
    }

    class Category {
        double price; // Each category has a price
    }

    class Inhabitant {
        List<Stay> stays; // An inhabitant can have multiple stays
        Bed assignedBed;
        void register(); // Registration process
        void assessAbilities(); // Assessment of needs
    }

    class Stay {
        StayType type; // Type of stay assigned to the inhabitant
        Date intakeDate; // Date of effective stay
        boolean isActive; // Indicates if the stay is currently active
        void propose(); // Proposals made when a bed is free
        void acceptProposal(); // Accept proposal
        void refuseProposal(); // Refuse proposal
        void reassess(); // Re-assess after proposal acceptance
    }

    class Registration {
        void registerData(); // Register basic identification data
        void assessNeeds(); // Assess needs for basic activities
        void onWaitingList(); // Add inhabitant to waiting list
    }

    class Invoice {
        double outstandingAmount; // Outstanding amount of the invoice
        boolean isPaid; // Indicates if the invoice is paid
        void receivePayment(double amount); // Process payment
        void modifyInvoice(); // Modify invoice if complaints arise
    }

    association [*] Home -> (departments) Department [*];
    association [*] Department -> (rooms) Room [*];
    association [*] Room -> (beds) Bed [*];
    association [*] Inhabitant -> (stays) Stay [*];
    association [1] Bed -> Category [1]; // A bed belongs to a particular category
}
