
classdiagram ElderlyHome {

class Inhabitant {
    int id;
    String name;
}

class Stay {
    Date startDate;
    Date endDate;
    double amountDue;
    String status;  // e.g., "active", "suspended", "ended"
}

enum StayType {
    RH,    // Rest Home
    RNH,   // Rest & Nursing Home
    SF;     // Service Flat
}

class RegistrationProcess {
    Date registrationDate;
}

class Assessment {
    String needs;  // e.g., Eating, Dressing, Personal Care
}

class Room {
    int roomNumber;
}

class Bed {
    int bedNumber;
    Category category;
}

class Category {
    double price;
}

class Invoice {
    double outstandingAmount;
    String paymentStatus;  // e.g., "paid", "unpaid"
}

association [1] Inhabitant <-> Stay [*];
association [1] Stay <-> RegistrationProcess [1];
association [1] Inhabitant <-> Assessment [1];
association [1] Department <-> Room [*];
association [1] Room <-> Bed [*];
association [1] Bed <-> Category [1];
association [*] Stay <-> Invoice [*];

class Department {}

}
