
// CD4A Class Diagram for City Attractions and Tours
classdiagram cityAttractions {

    class City {
        String name;
        int inhabitants;
    }

    class Attraction {
        String name;
        String address;
    }

    class GuidedTour {
        int duration; // duration in minutes
        int number; // number of guided tours available
        Guide guide; // the guide for the tour
    }

    class Visitor {
        String name;
        double discount; // discount for certain tours
    }

    class Guide {
        String name; // name of the guide
    }

    association [*] City -> (attractions) Attraction [*]; // A city has multiple attractions
    association [1] Attraction -> (tours) GuidedTour [*]; // An attraction can offer multiple guided tours
    association [1] GuidedTour -> (guide) Guide [1]; // Each guided tour has one guide
    association [*] GuidedTour <-> (visitors) Visitor [*]; // Visitors can participate in guided tours, max of 20 visitors per tour
}
