
classdiagram CityAttractions {

    class City {
        String name;
        int inhabitants;
    }

    class Attraction {
        String name;
        String address;
    }

    class GuidedTour {
        int duration;
        int numberOfVisitors;
        double discountAmount; // for certain visitors
    }

    class Visitor {
        String name;
    }

    class Guide {
        String name;
    }

    association [1] City <-> Attraction [0..*];
    association [1] Attraction <-> GuidedTour [0..*];
    association [0..20] GuidedTour <-> Visitor [0..*]; // max 20 visitors per tour
    association [1] GuidedTour <-> Guide [1];

}
