
// Class Diagram for City Attractions
classdiagram CityAttractions {

class City {
    String name;
    int inhabitants;
}

class Attraction {
    String name;
    String address;
}

class GuidedTour {
    int duration;
    int number;
}

class Visitor {
    String name;
    double discount; // discount may be applicable for guided tours
}

class Guide {
    String name;
}

association [*] City -> Attraction [*];
association [*] Attraction -> GuidedTour [*];
association [0..*] GuidedTour -> Visitor [20]; // maximum of 20 visitors
association [1] GuidedTour -> Guide [1];

}
