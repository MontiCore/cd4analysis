
// Class Diagram for Celebrations Organization System
classdiagram CelebrationsOrganizationSystem {

    class Organizer {
        String firstName;
        String lastName;
        String email; // Used as username
        String postalAddress;
        String phoneNumber;
        String password;
    }

    class Event {
        DateTime startDateTime;
        DateTime endDateTime;
        String occasion;
        Location location; // Association with Location class
        String eventType; // Could be selected from a list or created new
    }

    class Location {
        String name;
        String address;
    }

    class Attendee {
        String firstName;
        String lastName;
        String email; // Used as username
        boolean willAttend; // True, Maybe, or False
    }

    class Task {
        String description;
        String status; // e.g., needs to be done, done, not applicable
    }

    class Invitation {
        boolean status; // Attending, Maybe, Not Attending
    }

    association [1] Organizer -> (organizes) Event [*];
    association [*] Event -> (includes) Attendee [*];
    association [*] Event -> (heldAt) Location [1];
    association [*] Event -> (has) Task [*];
    association [*] Attendee <-> (receives) Invitation [1];
    association [1] Organizer -> (manages) Task [*];
    association [1] Task -> (assignedTo) Attendee [*];
}
