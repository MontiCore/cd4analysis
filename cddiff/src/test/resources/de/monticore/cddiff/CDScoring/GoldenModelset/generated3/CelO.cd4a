
// Class Diagram for Celebrations Organization System
classdiagram celebration {

    class Organizer {
        String firstName;
        String lastName;
        String email; // also the username
        String postalAddress;
        String phoneNumber;
        String password;
        List<Event> events; // Events the organizer manages
        void inviteAttendee(String firstName, String lastName, String email);
        void viewInvitationStatus(Event event);
        void addTask(Task task);
    }

    class Attendee {
        String firstName;
        String lastName;
        String email; // username
        String password;
        AttendanceStatus attendanceStatus;
        List<Task> assignedTasks; // Tasks assigned by an organizer
        void createAccount(String email, String password);
        void indicateAttendance(AttendanceStatus status);
    }

    class Event {
        String eventType; // e.g., birthday party, graduation party
        Date startDateTime;
        Date endDateTime;
        String occasion;
        Location location;
        List<Task> checklist; // List of tasks for the event
        List<Attendee> attendees; // List of attendees
        void addTask(Task task);
    }

    class Location {
        String name;
        String address;
    }

    class Task {
        String description;
        TaskStatus status; // e.g., needs to be done, has been done, not applicable
        boolean isAssignedToAttendee;
        void markStatus(TaskStatus status);
    }

    enum TaskStatus {
        NEEDS_TO_BE_DONE,
        HAS_BEEN_DONE,
        NOT_APPLICABLE;
    }

    enum AttendanceStatus {
        WILL_ATTEND,
        MAYBE_ATTEND,
        CANNOT_ATTEND;
    }

    // Associations
    association [1] Organizer -> (manages) Event [*];
    association [1] Event -> (attendees) Attendee [*];
    association [*] Event -> (tasks) Task [*];
    association [1] Event -> (location) Location [1];
}
