
classdiagram EHome2020 {

class Apartment {
    String address;
    List<Room> rooms;
    Optional<String> emailAddress; // For receiving alert messages
}

class Room {
    String description; // e.g., "living room"
    List<Sensor> sensors;
}

class Sensor {
    String vendorId;
    String description; // e.g., "temperature radiator living room"
    String unit; // CELSIUS, WATT
    Room assignedRoom; // Association, defined below
    List<SensorValue> values;
    Optional<SensorValue> lastValue; // Direct access to the last measured value
    Optional<Float> threshold;
}

class TemperatureSensor extends Sensor {
    Float minValue;
    Float maxValue; // Valid value range
}

class PowerSensor extends Sensor {
    Float counterReading; // Total power consumption
}

class SensorValue {
    Float measuredValue; // Floating point number
    Timestamp timestamp; // DateTime of the measurement
}

class SensorController {
    List<Account> accounts; // Both inhabitants and admins
    Apartment apartment;
}

class Account {
    String username;
    String password;
    Boolean isAdmin; // Indicates whether the account has administrative rights
}

class EMonitor {
    // External system that checks sensor thresholds
}

// Enumerations
enum Unit {
    CELSIUS,
    WATT;
}

// Associations
association [*] Apartment -> Room [2..*]; // Apartment consists of at least two rooms
association [1] Room <- Sensor [*]; // Each sensor belongs to exactly one room
association managesSensors Account -> SensorController [1]; // Accounts log on to SensorController
association [1] SensorController -> Apartment [1]; // SensorController stores apartment information
association monitorsThreshold [1] EMonitor -> Sensor [*]; // EMonitor automatically checks sensor thresholds

}
