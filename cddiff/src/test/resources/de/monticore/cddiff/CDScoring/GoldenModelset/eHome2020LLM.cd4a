/* (c) E-Home-2020 CD4A Model */

classdiagram eHome2020LLM {

  // ===========================
  // Core System Components
  // ===========================
  class SensorController {
    String systemName;
  }

  class EMonitor {}

  association [1] EMonitor -> (monitoredController) SensorController [1];

  // ===========================
  // Apartment / Inhabitants
  // ===========================
  class Apartment {
    String address;
    Optional<String> email; // optional email for alerts
  }

  class Inhabitant {
    String username;
    String password;
    boolean isAdmin; // admin flag for configuration rights
  }

  association [1] Apartment -> (inhabitants) Inhabitant [*];
  association [1] SensorController -> (apartment) Apartment [1];

  // ===========================
  // Rooms and Sensors
  // ===========================
  class Room {
    String description;
  }

  association [1] Apartment -> (rooms) Room [2..*];

  abstract class Sensor {
    String vendorId;      // unique identifier
    String description;   // e.g. "temperature radiator living room"
    Unit unit;
  }

  class TemperatureSensor extends Sensor {
    double minValue;
    double maxValue;
  }

  class PowerSensor extends Sensor {
    double counterReading; // total power consumption
  }

  enum Unit {
    CELSIUS,
    WATT;
  }

  association [1] Room -> (sensors) Sensor [*];
  association [1] SensorController -> (sensors) Sensor [*];

  // ===========================
  // Thresholds & Values
  // ===========================
  class Threshold {
    double limit;
  }

  class SensorValue {
    DateTime timestamp;
    double value;
  }

  association [1] Sensor -> (threshold) Threshold [0..1];
  association [1] Sensor -> (values) SensorValue [*];

  // NOTE: "last value" of a sensor is conceptually the most recent SensorValue,
  // but is not explicitly modeled as a separate association.
}
