
classdiagram house {

    class House {
        String address;
        String buildingMaterial; // can be wood, brick, or concrete
        Basement basement;
        List<Company> companies;
    }

    class SemiDetachedHouse extends House {
        boolean hasOwnGarden;
        int numberOfWindows;
        Carport carport; // either a carport or a garage
        Garage garage; // can be null if there is a carport
    }

    class Basement {
        String size;
        String name;
    }

    class EarthBasement extends Basement {
        int humidityLevel;
    }

    class ConcreteBasement extends Basement {
        // no additional attributes
    }

    class Carport {
        boolean isDoubleCarport;
        boolean hasFlatRoof;
    }

    class Garage {
        boolean hasAutomaticDoor;
    }

    class Company {
        String name;
        String address;
        List<JobLog> jobLogs;
    }

    class JobLog {
        int hours;
        double agreedPrice;
    }

    association [1] House <-> (basement) Basement [0..1];
    association [*] House -> (companies) Company [0..*];
    association [*] Company -> (jobLogs) JobLog [0..*];
}
