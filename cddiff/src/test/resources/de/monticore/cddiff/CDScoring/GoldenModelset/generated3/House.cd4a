
classdiagram HouseSystem {

enum BasementType {
    Earth,
    Concrete;
}

class Address {
    String street;
    String city;
    String state;
    String zipCode;
}

class House {
    Address address;
    String buildingMaterial;
    Basement basement;
    boolean hasGarden;
    int numberOfWindows;
}

class Basement {
    String name;
    double size;
}

class EarthBasement extends Basement {
    double humidityLevel;
}

class ConcreteBasement extends Basement {}

class SemiDetachedHouse extends House {
    Carport carport;
}

class Carport {
    boolean isDouble;
    boolean hasFlatRoof;
}

class Garage {
    boolean hasAutomaticDoor;
}

class Company {
    String name;
    Address address;
}

class JobLog {
    double hours;
    double agreedPrice;
}

association [1] House <-> Address [1];
association [1] House <-> Basement [0..1];
association [1] House <-> Company [*];
association [1] Company <-> JobLog [*];

}
