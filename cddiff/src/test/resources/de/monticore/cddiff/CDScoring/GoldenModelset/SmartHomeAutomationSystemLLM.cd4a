 smart_home_automation_system {

class SmartHome {
    String physicalAddress;
    List<Room> rooms; // A smart home consists of several rooms.
    ActivityLog activityLog; // SHAS records sensor readings and control commands in an activity log.
}

class Room {
    String roomName;
    List<SensorDevice> sensorDevices; // Sensors within a room.
    List<ActuatorDevice> actuatorDevices; // Actuators within a room.
}

class Device {
    String deviceId; // Unique identifier for devices.
}

class SensorDevice extends Device {
    List<SensorReading> sensorReadings; // Periodic sensor readings recorded with value and timestamp.
}

class SensorReading {
    String measuredValue; // Value measured by the sensor.
    String timestamp; // Timestamp of the reading.
}

class ActuatorDevice extends Device {
    List<ControlCommand> controlCommands; // Commands sent to actuators with timestamp and status.
}

enum CommandStatus {
    REQUESTED,
    COMPLETED,
    FAILED;
}

class ControlCommand {
    String commandType; // The type of control (e.g., lockDoor, turnOnHeating).
    String timestamp; // Timestamp of when the command is issued.
    CommandStatus status; // The status of the command.
}

class ActivityLog {
    List<SensorReading> sensorReadings; // Consolidated sensor readings for a smart home.
    List<ControlCommand> controlCommands; // Consolidated actuator commands for a smart home.
}

class AutomationRule {
    String ruleName;
    String precondition; // Boolean expression constructed from relational terms and basic Boolean operators.
    List<ControlCommand> actions; // Sequence of control commands to be taken when the rule is triggered.
    Boolean isActive; // Indicates whether the rule is active or not.
}

// Associations
association contains [1] SmartHome -> Room [1..*];
association [1] Room -> Device [*]; // Each room contains multiple devices (both sensors and actuators).
association [*] Device -> (observedBy/controlledBy) ActivityLog [1];
association definedBy [*] AutomationRule -> SmartHome [1];
association [*] AutomationRule (dependsOn/conflictsWith) -> AutomationRule [*]; // Rules can depend on or conflict with others.
association triggered [1] AutomationRule -> ActivityLog [1]; // Records timestamp when a rule is triggered.

}
