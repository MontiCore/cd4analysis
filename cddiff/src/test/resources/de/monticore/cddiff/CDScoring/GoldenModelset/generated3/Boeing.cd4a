
classdiagram Boeing {

class Aircraft {
    String model;
    double negotiatedPrice;
    String optionsAndCustomizations;
    Date deliveryDate;
}

class Contract {
    String deliveryConditions;
    String legalAspects;
}

class Acquisition {
    Aircraft aircraft;
}

class Salesperson {
    String name;
}

class Airline {
    String name;
}

association [1] Salesperson <-> Contract [*];
association [1] Contract <-> Acquisition [*];
association [*] Airline <-> (parent) Airline [*];

}
