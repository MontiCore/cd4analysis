
// CD4A class diagram based on the description of Boeing's aircraft sales to airline companies

classdiagram aircraftSales {

    class AirlineCompany {
        String name;
        // other attributes related to airline company can be added
    }

    class Contract {
        String commonElements; // includes delivery conditions, legal aspects, etc.
        List<Acquisition> acquisitions;
        Salesperson salesperson;
    }

    class Acquisition {
        String model; // chosen model of airplane
        double negotiatedPrice; // negotiated price for airplane
        String options; // chosen options & customizations
        Date deliveryDate; // delivery date of the airplane
    }

    class Salesperson {
        String name;
        List<Contract> contracts; // salesperson can manage several contracts
    }

    class Employee {
        String name;
        // additional employee attributes can be defined
    }

    association [1] AirlineCompany <-> (parent) AirlineCompany [*]; // tracks mother-daughter relationships
    association [*] Contract -> Salesperson [1]; // each contract has one salesperson
    association [*] Contract -> Acquisition [*]; // each contract can consist of multiple acquisitions
}
