
// Class diagram for the House structure

classdiagram houseStructure {

    class House {
        String address;
        BuildingMaterial buildingMaterial;
        Basement basement;
        List<JobLog> jobLogs;
    }

    enum BuildingMaterial {
        WOOD,
        BRICK,
        CONCRETE;
    }

    class Basement {
        String name;
        double size;
    }

    class EarthBasement extends Basement {
        double humidityLevel;
    }

    class ConcreteBasement extends Basement {
        // additional properties for concrete basement can be added here
    }

    class SemiDetachedHouse extends House {
        boolean hasOwnGarden;
        int numberOfWindows;
        Carport carport;
        Garage garage; // can only have one of either carport or garage
    }

    class Carport {
        boolean isDoubleCarport;
        boolean hasFlatRoof;
    }

    class Garage {
        boolean hasAutomaticDoor;
    }

    class Company {
        String name;
        String address;
    }

    class JobLog {
        int hours;
        double agreedPrice;
    }

    association [*] House -> (jobLogs) JobLog [*];
    association [*] House -> (servicedBy) Company [*];
    association [1] House -> (basement) Basement [0..1];
    association [0..1] SemiDetachedHouse -> (carport) Carport [0..1];
    association [0..1] SemiDetachedHouse -> (garage) Garage [0..1];
}
