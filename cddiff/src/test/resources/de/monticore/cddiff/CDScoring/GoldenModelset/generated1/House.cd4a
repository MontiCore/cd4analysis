
classdiagram HouseManagement {

enum BuildingMaterial {
    Wood,
    Brick,
    Concrete;
}

class Address {
    String street;
    String city;
    String postalCode;
}

class House {
    Address address;
    BuildingMaterial material;
}

class Basement {
    String name;
    double size;
}

class EarthBasement extends Basement {
    double humidityLevel;
}

class ConcreteBasement extends Basement {}

class SemiDetachedHouse extends House {
    boolean hasGarden;
    int numberOfWindows;
    Carport carport;
    Garage garage;
}

class Carport {
    boolean isDoubleCarport;
    boolean hasFlatRoof;
}

class Garage {
    boolean hasAutomaticDoor;
}

class Company {
    String name;
    Address address;
}

class JobLog {
    double hours;
    double agreedPrice;
}

association [1] House <-> (has) Basement [0..1];
association [1] House <-> (servicedBy) Company [*];
association [1] Company <-> (conductsJob) JobLog [*];
association [0..1] SemiDetachedHouse <-> (has) Carport [0..1];
association [0..1] SemiDetachedHouse <-> (has) Garage [0..1];
}
