
classdiagram HouseManagement {

enum BasementType {
    Earth,
    Concrete;
}

class Address {
    String street;
    String city;
    String postalCode;
}

class House {
    Address address;
    String buildingMaterial;
}

class Basement {
    String name;
    double size;
    
    // for earth basements
    double humidityLevel;
}

class SemiDetachedHouse extends House {
    boolean hasGarden;
    int numberOfWindows;
    
    // either two carports or a garage
    Carport carport;
    Garage garage;
}

class Carport {
    boolean isDoubleCarport;
    boolean hasFlatRoof;
}

class Garage {
    boolean hasAutomaticDoor;
}

class Company {
    String name;
    Address address;
}

class JobLog {
    int hours;
    double agreedPrice;
}

association [0..1] House <-> Basement [0..1];
association [0..*] Company <-> House [*];
association [*] Company <-> JobLog [*];
association [*] House <-> JobLog [*];
}
