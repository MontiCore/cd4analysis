
classdiagram hospitalSystem {

    class Hospital {
        String name;
        String location;
    }

    class Examination {
        String type;
    }

    class TreatmentPlan {
        String problemDescription;
    }

    class Doctor {
        String name;
        String specialization;
    }

    class Patient {
        String name;
        int age;
    }

    class ActualTreatment {
        String description;
    }

    association [1] Hospital -> Examination [0..*];
    association [1] Hospital -> TreatmentPlan [0..*];
    association [1] TreatmentPlan -> Examination [1..*];
    association [1] Patient -> Doctor [1];
    association [1] Doctor -> ActualTreatment [0..*];
    association [1] Patient -> ActualTreatment [0..*];
    association [1] Doctor -> Hospital [1];

}
