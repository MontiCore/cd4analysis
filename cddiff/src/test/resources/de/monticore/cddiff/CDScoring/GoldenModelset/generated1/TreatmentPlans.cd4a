
classdiagram hospital {

    class Hospital {
        String name;
        List<ExaminationType> allowedExaminations;
        void applyForPermission(ExaminationType type);
    }

    enum ExaminationType {
        CARDIOLOGIC_TEST,
        ECHOGRAPHY,
        RADIOLOGY,
        SCANNER;
        // other types can be added here
    }

    class Examination {
        ExaminationType type;
        Patient patient;
        Doctor doctor;
        void perform();
    }

    class TreatmentPlan {
        ProblemType problem;
        List<ExaminationType> advisedExaminations;
    }

    class ActualTreatment {
        TreatmentPlan treatmentPlan; 
        List<Examination> examinations; 
        List<String> medicalActions; // free medical actions can be stored here
        void documentTreatment();
    }

    class Doctor {
        String name;
        Hospital hospital;
        void diagnose(Patient patient, ProblemType problem);
        ActualTreatment defineTreatment(TreatmentPlan plan);
    }

    class Patient {
        String name;
        List<Examination> examinations; // history of examinations
    }

    enum ProblemType {
        CARDIOLOGIC_PROBLEM,
        GASTRO_PROBLEM,
        NEURO_PROBLEM;
        // other problems can be added here
    }

    association [1] Hospital -> (allowedExaminations) ExaminationType [*];
    association [*] Hospital -> (examinations) Examination [*];
    association [*] Doctor -> (examinations) Examination [*];
    association [*] Doctor -> (treatmentPlans) TreatmentPlan [*];
    association [*] TreatmentPlan -> (advisedExaminations) ExaminationType [*];
    association [*] ActualTreatment -> (examinations) Examination [*];
}
