
// CD4A Class Diagram for Course Appointment System

classdiagram appointmentSystem {

    class Student {
        String name;
        String studentID;
        List<Course> registeredCourses;

        void requestAppointment(Course course, TeachingAssistant ta);
    }

    class TeachingAssistant {
        String name;
        String employeeID;
        List<Course> coursesTeaching;

        void assist(Student student);
    }

    class Course {
        String courseName;
        String courseCode;
        TeachingAssistant ta;

        // Course specific details can be added here
    }

    class Appointment {
        Student student;
        TeachingAssistant ta;
        Course course;
        Date appointmentTime;

        // Additional appointment details can be included here
    }

    association [*] Student -> (registeredFor) Course [*];
    association [*] TeachingAssistant -> (teaches) Course [*];
    association [1] Appointment -> (student) Student [1];
    association [1] Appointment -> (teachingAssistant) TeachingAssistant [1];
    association [1] Appointment -> (course) Course [1];
}
