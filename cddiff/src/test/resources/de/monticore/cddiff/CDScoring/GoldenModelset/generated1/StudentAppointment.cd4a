
classdiagram AppointmentSystem {

class Student {
    String name;
}

class Course {
    String courseName;
}

class TeachingAssistant {
    String name;
}

class Appointment {
    String appointmentTime;
}

association [1] Appointment -> Student [1];
association [1] Appointment -> TeachingAssistant [1];
association [1] Appointment -> Course [1];
association [1] Student <-> Course [0..*];
association [1] TeachingAssistant <-> Course [0..*];

}
