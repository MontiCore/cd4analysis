
classdiagram CourseAppointmentSystem {

class Student {
    String name;
}

class Course {
    String courseName;
}

class TeachingAssistant {
    String name;
}

class Appointment {
    String dateTime;
}

association [1] Course <-> Student [0..*];
association [1] Course <-> TeachingAssistant [0..*];
association [1] TeachingAssistant <-> Appointment [0..*];
association [1] Student <-> Appointment [0..*];

}
