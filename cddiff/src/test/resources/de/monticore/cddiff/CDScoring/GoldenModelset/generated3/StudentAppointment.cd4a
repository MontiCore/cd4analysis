
// Class diagram for managing student appointments with teaching assistants

classdiagram appointmentSystem {

    class Student {
        String name;
        String studentId;
        void requestAppointment(Course course, TeachingAssistant ta);
    }

    class TeachingAssistant {
        String name;
        String taId;
        void provideHelp(Course course);
    }

    class Course {
        String courseName;
        String courseCode;
        List<TeachingAssistant> teachingAssistants;
        List<Student> enrolledStudents;
    }

    class Appointment {
        Student student;
        TeachingAssistant teachingAssistant;
        Course course;
        Date appointmentDateTime;
    }

    association [*] Student -> (enrolledIn) Course [*]; // Students can enroll in multiple courses
    association [*] Course -> (has) TeachingAssistant [*]; // Course can have multiple TAs
    association [*] TeachingAssistant -> (providesHelpFor) Course [*]; // TAs can help in multiple courses
    association [1] Appointment -> (involves) Student [1]; // Each appointment involves one student
    association [1] Appointment -> (involves) TeachingAssistant [1]; // Each appointment involves one TA
    association [1] Appointment -> (for) Course [1]; // Each appointment is for one specific course
}
