classdiagram GasStation_TUWLLM {

  class GasStation {
    String id;
    String address;
  }

  class FuelPump {
    int number;
    boolean selfService;
  }

  class Fuel {
    String name; // unique
    int octaneRating;
  }

  class DailyPrice {
    Date date;
    double pricePerLiter;
  }

  class FuelPurchase {
    String id;
    double liters;
  }

  // Associations
  association [1] GasStation -> (fuelPumps) FuelPump [1..12];
  association [*] FuelPump -> (fuels) Fuel [*];
  association [1] GasStation -> (dailyPrices) DailyPrice [*];
  association [1] DailyPrice -> (fuel) Fuel [1];
  association [1] FuelPurchase -> (pump) FuelPump [1];
  association [1] FuelPurchase -> (fuel) Fuel [1];
  association [1] FuelPurchase -> (price) DailyPrice [1];

}
