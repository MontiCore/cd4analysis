
// CD4A Class Diagram for the Web Portal System
classdiagram webPortal {

    class WebPortal {
        String versionNumber;
        String url;
        List<Building> catalog; // Catalog of buildings
    }

    class Building {
        String uniqueID; // Unique identifier
        String name;
        EnergyClass energyClass; // Energy classes: A, B, C, D
        String address;
        int yearOfConstruction;
        User owner; // Building owner
        List<Entry> additionalEntries; // Additional entries for the building
        List<Image> images; // List of images for the building
        Image profilePhoto; // Profile photo
    }

    enum EnergyClass {
        A,
        B,
        C,
        D;
    }

    class Entry {
        String name;
        String text; // This can hold textual information
        Float numericValue; // This can hold a floating-point number
        String unit; // Freely definable text for the unit
        boolean isPublic; // Indicates if entry is publicly released
    }

    class Image {
        String fileName; // File name of the image
    }

    class User {
        String userName; // Unique user name
        String email; // Email address
        String password; // User password
        boolean isActive; // Indicates if the user is activated
        String adminIDCardNumber; // Only for administrators
    }

    class Administrator extends User {
        // Inherits all properties from User
        // Additional administrator-specific functions can be defined here
    }

    association [*] WebPortal -> (catalog) Building [*]; // Web portal has multiple buildings
    association [*] Building -> (owner) User [1]; // Building has one owner
    association [*] User -> (additionalEntries) Entry [*]; // User can manage additional entries
    association [*] Building -> (images) Image [*]; // Building can have multiple images
}
