
classdiagram WebPortal {

class WebPortal {
    String versionNumber;
    String urlAddress;
}

class Building {
    String uniqueID;
    String name;
    String energyClass;
    String address;
    int yearOfConstruction;
}

class User {
    String userName;
    String emailAddress;
    String password;
}

class Entry {
    String name;
    String additionalInfo;
}

class Image {
    String fileName;
    boolean isProfilePhoto;
}

class Administrator extends User {
    String idCardNumber;
}

association [1] WebPortal <-> Building [*];
association [1] Building <-> User [1];
association [*] Building <-> Entry [*];
association [*] Building <-> Image [*];
association [*] User <-> User [*]; // for comments and interactions

association [1] WebPortal <-> User [*];
association [1] User <-> Administrator [0..1];
}
