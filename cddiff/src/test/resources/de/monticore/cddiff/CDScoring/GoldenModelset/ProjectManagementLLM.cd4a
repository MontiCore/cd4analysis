 
classdiagram research_project_management {

class University {
    String name;
    List<ResearchGroup> researchGroups;
}

class Department {
    String name;
    Optional<University> university;
    List<ResearchGroup> researchGroups;
}

class ResearchGroup {
    String groupName;
    Department department;
    List<Researcher> researchers;
    List<WorkPackage> leadingWorkPackages;
}

class Researcher {
    String name;
    ResearchGroup currentGroup;
    List<Assignment> assignments;
}

class Project {
    String projectName;
    List<WorkPackage> workPackages;
}

class WorkPackage {
    String description;
    ResearchGroup leaderGroup;
    List<Assignment> teamMembers;
}

class Assignment {
    Researcher researcher;
    WorkPackage workPackage;
    Date assignmentStartDate;
    Date assignmentEndDate;
    ResearchGroup providedServiceFrom; // Tracks "service delivery"
}

// Associations
association [*] University -> Department [*];
association belongsTo [*] ResearchGroup -> Department [1];
association leads [1] ResearchGroup -> WorkPackage [*];
association teamMember [*] Researcher -> WorkPackage [*];
association hasAssignments [1] Researcher -> Assignment [*];
association traceableServiceFrom [1] Assignment -> ResearchGroup [1];

}
