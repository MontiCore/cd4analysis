/* (c) Research Project Management Model */

classdiagram ProjectManagementLLM {

  class University {
    String name;
  }

  class Department {
    String name;
  }

  class ResearchGroup {
    String name;
  }

  class Researcher {
    String name;
  }

  class Project {
    String title;
  }

  class WorkPackage {
    String title;
    String description;
  }

  // A University consists of multiple Departments
  association [1] University -> (departments) Department [*];

  // A Department consists of multiple ResearchGroups
  association [1] Department -> (researchGroups) ResearchGroup [*];

  // A ResearchGroup consists of multiple Researchers
  association [1] ResearchGroup -> (members) Researcher [*];

  // A Project consists of multiple WorkPackages
  association [1] Project -> (workPackages) WorkPackage [*];

  // Each WorkPackage has exactly one ResearchGroup as leader
  association [1] WorkPackage -> (leader) ResearchGroup [1];

  // Researchers can be assigned to any WorkPackage
  // This assignment represents "service delivery" between groups
  association [*] Researcher -> (assignments) WorkPackage [*];

}
