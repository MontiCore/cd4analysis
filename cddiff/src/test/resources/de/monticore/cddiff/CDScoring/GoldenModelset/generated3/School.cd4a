
// CD4A class diagram representation for the school scenario
classdiagram school {

    class School {
        String name;
        Teacher principal; // exactly one principal
    }

    class Person {
        String firstName;
        String lastName;
    }

    class Teacher extends Person {
        String email;
    }

    class Student extends Person {
        ClassGroup classGroup; // exactly one class group
    }

    class ClassGroup {
        String name;
        Student[] students; // between 10 and 31 students
        Classroom classroom; // assigned to exactly one classroom
    }

    class Room {
        String name;
    }

    class Classroom extends Room {
        int capacity;
    }

    class Gym extends Room {
        int sizeInSquareMeters;
    }

    association [1] School -> (principal) Teacher [1];
    association [1] Teacher -> (schools) School [0..3]; // a teacher can teach at a maximum of three schools
    association [1] Student -> (classGroup) ClassGroup [1]; // a student is always in exactly one class group
    association [1] ClassGroup -> (classroom) Classroom [1]; // a class group is assigned to exactly one classroom
    association [1] Classroom <-> ClassGroup [1]; // a classroom is assigned to exactly one class group
}
