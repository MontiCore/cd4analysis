
classdiagram School {

class School {
    String name;
}

abstract class Person {
    String firstName;
    String lastName;
}

class Teacher extends Person {
    String email;
}

class Student extends Person {
}

class Room {
    String name;
}

class Classroom extends Room {
    int capacity;
}

class OtherRoom extends Room {
    int sizeInSquareMeters;
}

class ClassGroup {
    String name;
}

association [1] Teacher <-> (teaches) School [0..3];
association [1] Teacher <-> (principalOf) School [0..1];
association [1] ClassGroup <-> (has) Classroom [1];
association [1] Classroom <-> (assignedTo) ClassGroup [1];
association [1] Student <-> ClassGroup [1];
association [1] Student <-> School [1];
association [1] School <-> (has) Teacher [1..*];
association [1] School <-> (has) Classroom [*];
}

