
// CD4A Class Diagram for Cruise Management System
classdiagram cruise {

    class Provider {
        String name;
        String location;
    }

    class Cruise {
        String number;
        String name;
        Date startDate;
        Date endDate;
    }

    class Employee {
        String name;
        String socialSecurityNumber;
    }

    class Guest {
        String name;
        boolean isVIP;
    }

    class Ship {
        String name;
        int numberOfDecks;
        double length;
        int numberOfPassengers;
    }

    class TravelAgency {
        String name;
        String address;
    }

    class Booking {
        String bookingNumber;
        Date bookingDate;
    }

    class Destination {
        String name;
        String seaName;
    }

    class Show {
        String title;
        int duration; // duration in minutes
    }

    class Ticket {
        // A ticket doesn't have specific attributes mentioned
    }

    association [*] Provider -> Cruise [*];
    association [*] Cruise -> Employee [*];
    association [*] Cruise -> Guest [*];
    association [*] Cruise -> Ship [1];
    association [*] TravelAgency -> Booking [*];
    association [1] Cruise -> Destination [1];
    association [*] Cruise -> Show [*];
    association [*] Guest <-> Cruise [*];
    association [*] Cruise -> Ticket [*];
    association [1] Guest <-> Ticket [*]; // A guest can have many tickets but only one per cruise
    
}
