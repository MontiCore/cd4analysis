
classdiagram SoberTaxi {

class SelfDrivingCab {
    String licensePlate;
}

class Owner {
    String name;
    String contactInfo;
}

class RideHailService {
    DateTime pickUpTime;
    DateTime dropOffTime;
    String pickUpLocation;
    String dropOffLocation;
    Duration rideDuration;
    double distance;
    int numberOfPassengers;
    double fee;
    String requestType; // "Sober App" or "Hand-Waving"
    String leadCustomerName;
}

class RideShareService {
    DateTime pickUpTime;
    DateTime dropOffTime;
    String pickUpLocation;
    String dropOffLocation;
    Duration rideDuration;
    double distance;
    List<String> customerNames;
    double negotiatedFee;
}

class Accident {
    Date accidentDate;
    String location;
    double damageAmount;
}

class SoberApp {
    String version;
}

class ImageRecognitionSystem {}


// Associations
association [1] SelfDrivingCab <-> Owner [0..*];
association [1] SelfDrivingCab <-> RideHailService [0..*];
association [1] SelfDrivingCab <-> RideShareService [0..*];
association [0..*] RideHailService <-> RideShareService [0..*];
association [0..*] SelfDrivingCab <-> Accident [0..*];
}
