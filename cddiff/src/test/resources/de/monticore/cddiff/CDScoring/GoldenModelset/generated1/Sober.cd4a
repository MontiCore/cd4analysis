
// Class Diagram for Sober Taxi Company

classdiagram soberTaxi {

    class Sober {
        Fleet fleet;
        void requestRideHail(Request request);
        void requestRideShare(Request request);
    }

    class Fleet {
        List<SelfDrivingCab> cabs;
        void addCab(SelfDrivingCab cab);
        void removeCab(SelfDrivingCab cab);
    }

    class SelfDrivingCab {
        String licensePlate;
        Owner owner;
        List<Ride> rides;
        List<Accident> accidents;
    }

    class Owner {
        String name;
        String contactInformation;
        List<SelfDrivingCab> ownedCabs;
    }

    class Ride {
        String pickUpLocation;
        String dropOffLocation;
        DateTime pickUpTime;
        DateTime dropOffTime;
        Duration rideDuration;
        Distance distance;
        List<Passenger> passengers;
        Fee fee;
        RequestType requestType;
    }

    class Passenger {
        String name;
    }

    enum RequestType {
        SoberApp,
        HandWaving;
    }

    class RideHail extends Ride {
        // ride-hail specific attributes, if any
        int maxPassengers = 6; // maximum number of passengers
    }

    class RideShare extends Ride {
        List<Passenger> allCustomers; // includes all passengers
        Fee negotiatedFee;
        int maxPassengers = 10; // maximum number of passengers
    }

    class Accident {
        DateTime date;
        String location;
        Amount damageAmount;
    }

    association [1] Sober -> (fleet) Fleet [*];
    association [*] Fleet -> (cabs) SelfDrivingCab [*];
    association [1] Owner -> (ownedCabs) SelfDrivingCab [*];
    association [*] SelfDrivingCab -> (rides) Ride [*];
    association [*] SelfDrivingCab -> (accidents) Accident [*];
    association [*] Ride -> (passengers) Passenger [*];
}
