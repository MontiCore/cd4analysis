
// CD4A Class Diagram for an oil company gas station system
classdiagram gasStationSystem {

    class OilCompany {
        List<GasStation> gasStations;
    }

    class GasStation {
        List<Pump> pumps;
        void produceDailyReport();
    }

    class Pump {
        GasolineType gasolineType;
        double currentLevel;
        double reorderingLevel;
        double criticalLevel;
        boolean isBlocked;

        void refuel();
        void block();
        void unblock();
    }

    class Customer {
        String name;
        CreditCard creditCard;
        RefuelCard refuelCard;
        List<Invoice> invoices;

        void payInvoice(Invoice invoice);
        void receiveInvoice(Invoice invoice);
        void suspend();
        void resume();
    }

    class Invoice {
        List<RefuelTurn> refuelTurns;
        double totalAmount;
        double discount;
        boolean isPaid;

        void createInvoice();
        void remindPayment();
    }

    class RefuelTurn {
        Pump pump;
        double amount;
        Date date;
    }

    class RefuelCard {
        boolean isBlocked;

        void issueCard();
        void blockCard();
        void unblockCard();
    }

    class CreditCard {
        void makePayment(double amount);
    }

    // Enumeration for types of gasoline
    enum GasolineType {
        REGULAR,
        PREMIUM,
        DIESEL;
    }

    // Associations
    association [*] OilCompany -> (gasStations) GasStation [*];
    association [*] GasStation -> (pumps) Pump [*];
    association [*] Customer -> (invoices) Invoice [*];
    association [*] Invoice -> (refuelTurns) RefuelTurn [*];
    association [1] Customer -> (refuelCard) RefuelCard [0..1];
    association [1] Customer -> (creditCard) CreditCard [0..1];
}


