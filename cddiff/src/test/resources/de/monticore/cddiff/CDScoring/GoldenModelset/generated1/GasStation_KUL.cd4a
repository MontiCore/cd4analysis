
classdiagram OilCompany {

class Customer {
    int custId;
    String custName;
    String refuelCardStatus;

    int getCustId();
    void setCustId(int newCustId);
    void suspend();
    void reinstate();
}

class Invoice {
    int invoiceId;
    DateTime invoiceDate;
    double totalAmount;
    double discount;

    int getInvoiceId();
    void setInvoiceId(int newInvoiceId);
    void addRefuelTurn(RefuelTurn turn);
}

class Payment {
    int paymentId;
    double paymentAmount;
    DateTime paymentDate;

    int getPaymentId();
    void setPaymentId(int newPaymentId);
}

class GasStation {
    int stationId;
    String location;

    int getStationId();
}

class Pump {
    int pumpId;
    double gasolineLevel;
    boolean isBlocked;

    int getPumpId();
    void setPumpId(int newPumpId);
    void refill(double quantity);
}

class RefuelTurn {
    int turnId;
    DateTime turnDate;
    double amount;

    int getTurnId();
    void setTurnId(int newTurnId);
}

association [1] Invoice -- (sentTo) Customer [1];
association [1] Payment -- (for) Invoice [1];
association [*] RefuelTurn -- (includedIn) Invoice [1];
association [*] GasStation -- (has) Pump [*];
association [1] Pump -- (usedBy) Customer [*];

}
