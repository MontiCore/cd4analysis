
// Class Diagram for Oil Company Gas Stations
classdiagram OilCompanyGasStations {

class Customer {
    String name;
    String contactInfo;
    boolean isSuspended;
}

class RefuelCard {
    String cardNumber;
    Customer customer; // card is associated with a specific customer
}

class Invoice {
    int invoiceNumber;
    Date invoiceDate;
    double totalAmount;
    boolean isPaid;
}

class Payment {
    int paymentId;
    Date paymentDate;
    double amount;
}

class GasStation {
    String name;
    String location;
}

class Pump {
    int pumpId;
    double gasolineLevel;
    boolean isBlocked;
}

class GasolineType {
    String typeName;
}

class RefuelTurn {
    double amount;
    Date refuelDate;
}

class Report {
    String reportDate;
    List<PumpStatus> pumpStatus; // list of pump statuses for the report
}

class PumpStatus {
    Pump pump;
    double currentLevel;
    double quantityToOrder;
}

association [1] Customer <-> RefuelCard [0..1]; // customer can have one card
association [1] RefuelCard <-> Invoice [*]; // card can generate multiple invoices
association [1] Invoice <-> Payment [*]; // invoice can have multiple payments
association [1] GasStation <-> Pump [*]; // gas station has multiple pumps
association [1] Pump <-> GasolineType [0..*]; // pump can contain different gasoline types
association [0..*] Pump <-> RefuelTurn [*]; // pumps can have multiple refuel turns
association [1] GasStation <-> Report [*]; // each gas station can produce multiple reports
association [0..1] Report <-> PumpStatus [*]; // report can include multiple pump statuses

}
