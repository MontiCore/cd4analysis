
classdiagram FilmSet {

class Employee {
    String name;
    String socialSecurityNumber;
}

class CreativeEmployee extends Employee {
    Boolean hasOscar;
}

class Director extends CreativeEmployee {
    String assistantName;
}

class Actor extends CreativeEmployee {
    String education;
}

class Technician extends Employee {
    String fieldOfActivity;
}

class FilmSet {
    String location;
}

class Film {
    String title;
    int yearOfRelease;
}

class Genre {
    Type type;
}

enum Type {
        THRILLER,
        ACTION,
        HORROR,
        COMEDY;
    }

class Screenwriter {
    String name;
    String mostSuccessfulFilm;
}

class Screenplay {
    String title;
    String version;
    String date;
    int numberOfScenes;
    String plot;
}

class Novel {
    String title;
    String author;
}

association [0..*] FilmSet <-> Film [0..*];
association [0..*] Film <-> Screenplay [1];
association [1] Screenplay <-> Screenwriter [1];
association [1] Screenplay <-> (basedOn) Novel [0..1];
association [0..*] Film <-> (actors) Actor [0..*];
association [1] Film <-> (director) Director [1];

}
