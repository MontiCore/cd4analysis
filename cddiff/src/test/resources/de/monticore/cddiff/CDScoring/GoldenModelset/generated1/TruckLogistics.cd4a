
// CD4A Model for Locations, Drivers, Vehicles, and Orders
classdiagram locations {

    class Location {
        String address;
    }

    class Driver {
        String firstName;
        String lastName;
        Order currentOrder; // Driver can have at most one order at a time
    }

    abstract class Vehicle {
        String vehicleNumber;
    }

    class Truck extends Vehicle {
        double weight;
    }

    class Car extends Vehicle {
        int numberOfSeats;
    }

    class Van extends Vehicle {
        // Van specific attributes can be added here
    }

    class Order {
        Location origin;
        Location destination;
        Driver assignedDriver; // At least one assigned driver
        Date executionDate; // Date of execution
    }

    association [*] Location -> (drivers) Driver [*]; // Locations can have multiple drivers
    association [*] Location -> (vehicles) Vehicle [*]; // Locations can have multiple vehicles
    association [1] Driver -> Vehicle [0..1]; // Vehicles assigned to up to one driver
    association [1] Driver -> Order [0..1]; // Driver can have at most one order
}
