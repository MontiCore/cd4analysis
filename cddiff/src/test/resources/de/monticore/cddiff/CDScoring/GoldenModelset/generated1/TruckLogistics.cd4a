
// CD4A Class Diagram for Location Management System
classdiagram LocationManagement {

    class Driver {
        String firstName;
        String lastName;
    }

    class Vehicle {
        String vehicleNumber;
    }

    class Truck extends Vehicle {
        double weight;
    }

    class Car extends Vehicle {
        int numberOfSeats;
    }

    class Van extends Vehicle {}

    class Location {
        String address;
    }

    class Order {
        Date executionDate;
        Location origin;
        Location destination;
    }

    association [1] Location <-> Driver [0..*]; // A location can have multiple drivers.
    association [1] Driver -> Vehicle [0..1]; // A driver can drive at most one vehicle at a time.
    association [1] Driver <-> Order [0..1]; // A driver can carry out at most one order at a time.
    association [1] Order -> Location [2]; // An order has one origin and one destination location.
}
