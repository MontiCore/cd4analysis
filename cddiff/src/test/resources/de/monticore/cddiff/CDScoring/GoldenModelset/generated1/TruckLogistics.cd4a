
classdiagram LocationManagement {
    class Driver {
        String firstName;
        String lastName;
    }

    class Vehicle {
        String vehicleNumber;
    }

    class Truck extends Vehicle {
        double weight;
    }

    class Car extends Vehicle {
        int numberOfSeats;
    }

    class Van extends Vehicle {
        // Van-specific attributes can be added here if needed.
    }

    class Location {
        String address;
    }

    class Order {
        Location origin;
        Location destination;
        Date executionDate;
    }

    association [1] Location -> (driver) Driver [*];
    association [1] Driver -> (assignedOrder) Order [0..1];
    association [1] Order -> Driver [1];
    association [1] Vehicle -> Driver [0..1];
}
