
// Class Diagram for the Musicmatic Streaming Service
classdiagram musicmatic {

    class Song {
        String title;
        int year;
        int length; // Length in seconds
        String genre;
        Artist artist; // Each song belongs to exactly one artist
    }

    class Artist {
        String name; // Unique identifier for artist
        Date dateOfBirth;
        String websiteURL; // URL to Wikipedia page or other info
    }

    class User {
        String id; // Unique ID for user
        String name;
        String address;
    }

    class RegularUser extends User {
        // Regular users can buy music
    }

    class BusinessUser extends User {
        String vatNumber; // VAT number for business users
        void uploadSong(Song song); // Business users can upload songs
    }

    class Album {
        List<Hit> hits; // Contains multiple hits
        void addHit(Hit hit);
        void removeHit(Hit hit);
    }

    class Single {
        Song song; // A single song
    }

    class Hit {
        Song song; // Each hit is a song
        int trackNumber; // Position in the album
    }

    association [1] Artist -> Song [*]; // Each artist can have multiple songs
    association [*] User -> Single [*]; // Users can buy multiple singles
    association [1] Album -> Hit [*]; // An album has multiple hits
    association [1] BusinessUser -> Song [1]; // Business users can upload a single song
    association [*] RegularUser <-> Album [*]; // Regular users can have multiple albums as suggestions
}
