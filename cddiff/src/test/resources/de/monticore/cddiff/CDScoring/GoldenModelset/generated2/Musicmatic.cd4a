
// CD4A Class Diagram for Musicmatic

classdiagram Musicmatic {

class Song {
    String title;
    int year;
    int length;
    String genre;
}

class Artist {
    String name; // unique identifier
    Date dateOfBirth;
    String websiteURL;
}

class User {
    String id; // unique identifier
    String name;
    String address;
}

class RegularUser extends User {
    // Regular users can buy music (no additional attributes defined)
}

class BusinessUser extends User {
    String vatNumber;
}

class Single extends Song {
    // Additional attributes can be defined if needed
}

class Hit extends Song {
    int trackNumber;
}

class Album {
    // Albums only contain hits (no attributes defined)
}

// Associations
association [1] Song -> Artist [1]; // A song belongs to exactly one artist
association [1] RegularUser <-> Single [*]; // Regular user can buy singles
association [0..*] RegularUser <-> Album [0..*]; // Regular users can own albums
association [1] BusinessUser <-> Single [1]; // Business users upload singles
association [1] Album <-> Hit [*]; // An album contains multiple hits
}
