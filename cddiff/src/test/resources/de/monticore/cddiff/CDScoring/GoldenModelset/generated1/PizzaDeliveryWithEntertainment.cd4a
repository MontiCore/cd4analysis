
classdiagram PizzaDeliveryWithEntertainment {

enum DayOfWeek {
    Monday,
    Tuesday,
    Wednesday,
    Thursday,
    Friday,
    Saturday,
    Sunday;
}

class User {
    String userId; // Unique identifier for each user
    String name;
    String address;
    String birthday;
}

class BusinessOwner extends User {
    String linkedInAccount;
}

class PizzaRestaurant {
    String name;
    String zipCode;
    String address;
    String phoneNumber;
    String website;
    String openingHours;
}

class Pizza {
    String name;
    String crustStructure;
    double price;
}

class HungryCustomer extends User {
    String deliveryAddress;
}

class Order {
    int orderId; // Unique order identifier
    Date orderDateTime; // Date and time when the order was placed
    Time latestDeliveryTime;
    int numberOfPeople;
}

class EntertainmentOrder extends Order {
    String entertainmentType; // Type of entertainment requested
    Duration duration; // Duration of entertainment
}

class Entertainer extends User {
    String stageName;
    String bio;
    double pricePer30Minutes;
}

association [1] BusinessOwner -> PizzaRestaurant [*]; 
association [1] PizzaRestaurant -> Pizza [*];
association [1] HungryCustomer -> Order [*];
association [1] Order -> Pizza [*];
association [1] EntertainmentOrder -> Entertainer [1];
association [1] Entertainer -> PizzaRestaurant [*];
association [*] Entertainer -> DayOfWeek [*]; // Availability of entertainer by day

}
