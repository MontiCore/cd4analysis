
classdiagram pizza_delivery {

    class User {
        String userId; // Unique identifier
        String name;
        String address;
        Date birthday;
    }

    class BusinessOwner extends User {
        String linkedinAccount;
    }

    class HungryCustomer extends User {
        String deliveryAddress;
    }

    class Entertainer extends User {
        String stageName;
        String bio;
        double pricePer30Minutes;
    }

    class PizzaRestaurant {
        String zipCode;
        String address;
        String phoneNumber;
        String website;
        String openingHours;
    }

    class Pizza {
        String name; // Unique within the context of a restaurant
        String crustStructure;
        double price;
    }

    class Order {
        String orderId; // Unique identifier
        Date dateTime;
        Date latestDeliveryTime;
        int numberOfPeople;
        boolean isEntertainmentOrder; // Indicates if the order includes entertainment
    }

    class EntertainmentOrder extends Order {
        String entertainmentType;
        Duration duration; // Duration of entertainment
    }

    association [1..*] BusinessOwner -> (owns) PizzaRestaurant [1..*];
    association [1..*] PizzaRestaurant -> (offers) Pizza [1..*];
    association [1..*] HungryCustomer -> (makes) Order [1..*];
    association [1] Order -> (fulfilledBy) Entertainer [1];
    association [1..*] Entertainer -> (worksWith) PizzaRestaurant [1..*];
}
