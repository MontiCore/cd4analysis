
// CD4A Class Diagram for E-Home-2020
classdiagram EHome2020 {

enum SensorUnit {
    CELSIUS,
    WATT;
}

class User {
    String username;
    String password;
}

class Apartment {
    String address;
}

class Room {
    String description;
}

class Sensor {
    String vendorId;
    String description;
    SensorUnit unit;
}

class TemperatureSensor extends Sensor {
    float minValue;
    float maxValue;
}

class PowerSensor extends Sensor {
    float totalConsumption;
}

class SensorValue {
    Date timestamp;
    float value;
}

class SensorController {
    Apartment apartment;
}

class EMonitor {
    void checkThresholds();
}

class Alert {
    String emailAddress;
}

class AdministrativeUser extends User {}

association [1] Apartment -- Room [2..*];
association [1] User -- Alert [0..1];
association [1] User -- (adminRights) AdministrativeUser [0..1];
association [1] SensorController -- Sensor [1..*];
association [1] Room -- Sensor [1..*];
association [1] Sensor -- (measuredValues) SensorValue [*];
association [1] SensorController -- (inhabitants) User [1..*];
association [1] EMonitor -- Sensor [*];

}
