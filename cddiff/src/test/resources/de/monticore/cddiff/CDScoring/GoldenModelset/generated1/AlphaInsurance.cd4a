
classdiagram insurance {

    class Customer {
        String name;
        String contactInfo;
        List<InsurancePolicy> policies;
        
        void sendClaim(Claim claim);
    }

    class Broker {
        String name;
        String registrationId;
        void assessProfile(Customer customer);
        void sendFileForAnalysis(Customer customer);
    }

    class InsurancePolicy {
        String type;
        double price;
        String paymentFrequency; // monthly or yearly
        void signContract(Customer customer);
    }

    class Claim {
        String claimId;
        String details;
        void submit();
    }

    class ClaimCase {
        String caseId;
        Claim claim;
        List<EstimatorReport> reports;
        boolean isApproved;
        
        void openCase(Claim claim);
        void assessClaim(EstimatorReport report);
    }

    class Estimator {
        String name;
        String areaOfExpertise;
        
        void assessClaim(ClaimCase claimCase);
    }

    class EstimatorReport {
        String reportId;
        String findings;
        double compensationAmount;
        
        void storeReport();
    }

    class CompensationDecision {
        ClaimCase claimCase;
        List<String> eligibleCosts;
        double totalCompensation;
        
        void registerDecision();
        void processPayment(Customer customer);
    }

    // Associations
    association [1] Broker -> Customer [1];
    association [*] Claim -> ClaimCase [1];
    association [*] Estimator -> ClaimCase [*];
    association [1] ClaimCase -> EstimatorReport [*];
    association [1] CompensationDecision -> ClaimCase [1];
}
