
// CD4A Class Diagram for Alpha Insurance
classdiagram AlphaInsurance {

class Customer {
    String name;
    String contactInfo;
}

class Broker {
    String name;
    String id;
}

class InsurancePolicy {
    String policyType;
    double price;
    String billingFrequency; // monthly or yearly
}

class Contract {
    Broker broker;
    Customer customer;
    InsurancePolicy insurancePolicy;
    Date signingDate;
}

class Claim {
    String claimId;
    Date claimDate;
    String description;
}

class ClaimCase {
    Claim claim;
    String status; // e.g., pending, approved, rejected
    // possibly more attributes related to claim cases
}

class Estimator {
    String name;
    String areaOfExpertise;
}

class CompensationDecision {
    String decisionId;
    double eligibleAmount;
}

class Report {
    String reportId;
    String content; // details of the estimator's report
}

class Payment {
    double amount;
    Date paymentDate;
}

class ClaimDocumentation {
    // Documentation related attributes
}


// Associations
association [1] Customer <-> (assignedTo) Broker [1];
association [1] Customer <-> (has) InsurancePolicy [1..*];
association [1] Broker <-> Contract [0..*];
association [1] Contract <-> Customer [0..1];
association [1] Claim <-> ClaimCase [1];
association [1] ClaimCase <-> Estimator [*];
association [1] ClaimCase <-> CompensationDecision [0..1];
association [1] CompensationDecision <-> Payment [0..1];
association [1] Estimator <-> Report [*];
association [*] Report <-> ClaimDocumentation [*];

}
