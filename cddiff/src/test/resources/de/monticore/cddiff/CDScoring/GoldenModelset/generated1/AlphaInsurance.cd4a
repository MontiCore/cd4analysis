
classdiagram AlphaInsurance {

class Customer {
    String name;
    String contactDetails;
}

class Broker {
    String name;
    String registrationId;
}

class InsurancePolicy {
    String type;
    double price;
    String paymentFrequency;
}

class Contract {
    String status;
    Date signingDate;
}

class Claim {
    String claimType;
    Date claimDate;
}

class ClaimCase {
    String status;
}

class Estimator {
    String name;
    String areaOfExpertise;
}

class CompensationDecision {
    double amount;
    String eligibleCosts;
}

class Report {
    String content;
    Date issueDate;
}

class Payment {
    double amount;
    Date paymentDate;
}

association [1] Broker <-> Customer [1];
association [1] Customer <-> InsurancePolicy [0..*];
association [1] Customer <-> Contract [0..1];
association [1] Customer <-> Claim [0..*];
association [1] Claim <-> ClaimCase [0..*];
association [1] ClaimCase <-> Estimator [0..*];
association [1] ClaimCase <-> CompensationDecision [0..1];
association [1] CompensationDecision <-> Payment [0..*];
association [1] ClaimCase <-> Report [0..*];
}
