
// CD4A Class Diagram

classdiagram TransportCompany {

class Employee {
    String name;
    int ssn;
}

class Planner extends Employee {
    String username;
    String password;
}

class AdministrativeStaff extends Employee {
    String fieldOfActivity;
}

class Customer {
    String name;
    String billingAddress;
}

abstract class Vehicle {
    String licensePlateNumber;
    int mileage;
}

class RefrigeratedTruck extends Vehicle {}
class SmallVan extends Vehicle {}
class LoadingPlatform extends Vehicle {}
class BoxTruck extends Vehicle {}

class RepairShop {
    String name;
    String address;
}

class Repair {
    Employee employee;
    int duration;
    double cost;
}

class Order {
    String additionalInfo;
    Date startTime;
    Date finishTime;
}

class PartnerCompany {
    String name;
    String address;
}

association [*] Employee <-> Order [*];
association [*] Customer <-> Order [*];
association [*] Vehicle <-> Order [*];
association [*] Planner <-> Order [*];
association [1] Order <-> (takes) RepairShop [0..1];
association [0..1] RepairShop <-> Repair [*];
association [*] PartnerCompany <-> Order [0..1];

}
