
classdiagram transportCompany {

    class Person {
        String name;
        String socialSecurityNumber;
    }

    class Employee extends Person {
        String username;
        String password;
    }

    class Planner extends Employee {
    }

    class AdministrativeStaff extends Employee {
        String fieldOfActivity;
    }

    class Customer {
        String name;
        String billingAddress;
    }

    class Vehicle {
        String licensePlateNumber;
        int mileage;
    }

    class RepairShop {
        String name;
        String address;
    }

    class Repair {
        RepairShop repairShop;
        Employee employee;
        int duration;  // duration of repair in hours or days
        double cost;   // cost of the repair
    }

    class Order {
        Customer customer;
        Vehicle vehicle;
        Planner planner;
        Driver driver;
        String pickupAddress;
        String deliveryAddress;
        String comments;
        Date startTime;
        Date finishTime;
    }

    class Driver extends Employee {
    }

    association [*] Driver -> Order [*];
    association [1..*] Employee -> Order [*];
    association [*] Planner -> Order [*];
    association [1] Customer -> Order [*];
    association [1] Vehicle -> Repair [*];
}
