
// Smart Home Automation System (SHAS) class diagram
classdiagram shas {

    class SmartHome {
        String address;
        List<Room> rooms;
    }

    class Room {
        String name;
        List<Device> devices;
    }

    abstract class Device {
        String deviceId; // Unique device identifier
    }

    class Sensor extends Device {
        List<SensorReading> readings;
        void activate();
        void deactivate();
    }

    class Actuator extends Device {
        List<ControlCommand> commands;
        void activate();
        void deactivate();
    }

    class SensorReading {
        double value; // Measured value
        Date timestamp; // Timestamp of reading
    }

    class ControlCommand {
        String command; // Command such as lockDoor or turnOnHeating
        Date timestamp; // Timestamp of command
        String status; // Status can be requested, completed, failed, etc.
    }

    class ActivityLog {
        List<SensorReading> sensorReadings;
        List<ControlCommand> controlCommands;
        List<RuleTrigger> ruleTriggers;
    }

    class AutomationRule {
        String precondition; // Boolean expression for rule
        List<ControlCommand> actions; // Sequence of control commands
        void create();
        void edit();
        void activate();
        void deactivate();
        boolean canEdit(); // Only deactivated rules can be edited
    }

    class RuleTrigger {
        Date timestamp; // Timestamp when rule was triggered
    }

    // Associations
    association [*] SmartHome -> (rooms) Room [*];
    association [*] Room -> (devices) Device [*];
    association [*] Device -> (readings) SensorReading [*];
    association [*] Device -> (commands) ControlCommand [*];
    association [*] ActivityLog -> (sensorReadings) SensorReading [*];
    association [*] ActivityLog -> (controlCommands) ControlCommand [*];
    association [*] ActivityLog -> (ruleTriggers) RuleTrigger [*];
    association [*] AutomationRule <-> ControlCommand [*]; // Actions can be sequences of control commands
}
