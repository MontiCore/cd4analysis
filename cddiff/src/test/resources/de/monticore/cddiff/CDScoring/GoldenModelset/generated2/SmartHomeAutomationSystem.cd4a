
classdiagram SmartHomeAutomationSystem {

class SmartHome {
    String address;
}

class Room {
    String name;
}

class Device {
    String deviceId;
}

class Sensor extends Device {
    double measurementValue;
    Date timestamp;
}

class Actuator extends Device {
    String command;
    String status;
    Date timestamp;
}

class ActivityLog {
    String logEntry;
}

class AutomationRule {
    String precondition;
    String action;
    Boolean isActive;
    Date lastTriggeredTimestamp;
}

association [1] SmartHome <-> Room [1..*];
association [1] Room <-> Sensor [0..*];
association [1] Room <-> Actuator [0..*];
association [1] SmartHome <-> ActivityLog [0..*];
association [1] SmartHome <-> AutomationRule [0..*];
association [0..*] AutomationRule <-> AutomationRule [0..*]; // for dependencies and conflicts

}
