
classdiagram LouvreManagementSystem {

class Museum {
    String name;
    List<Location> locations;
}

class Location {
    String name;
    Optional<String> description;
    List<Exhibition> exhibitions;
}

class Exhibition {
    String name;
    Date planningStartDate;
    Date openingDate;
    Employee coordinator;
    List<ExhibitionItem> items;
}

class ExhibitionItem {
    String name;
    Optional<String> description;
    List<RequestedPiece> requestedPieces;
}

class RequestedPiece {
    Piece sourcedPiece;
    Collector sourceCollector;
}

class Piece {
    String title;
    String artist;
    Optional<String> description;
    Optional<Date> creationDate;
}

class Collector {
    String name;
    Optional<String> contactInfo;
    List<Piece> ownedPieces;
}

class Employee {
    String name;
    String employeeId;
    Optional<String> role;
}

// Associations
association [1..*] Museum -> (spans) Location [*];
association [1..*] Location -> (hosts) Exhibition [*];
association [1] Exhibition -> (coordinatedBy) Employee [1];
association [*] Exhibition -> (includes) ExhibitionItem [*];
association [1] ExhibitionItem -> (requests) RequestedPiece [1..*];
association [1] RequestedPiece -> Piece [1];
association [1] RequestedPiece -> (from) Collector [1];
association [0..*] Collector -> Piece [*];
association [0..*] Employee (coachedBy) -> Employee [0..1]; // Junior employees have at most one coach
}
