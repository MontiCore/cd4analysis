classdiagram BuildingManagementLLM {
    class WebPortal {
        String version;
        String url;
    }
    class Building {
        String id;
        String name;
        char energyClass;
        String address;
        int yearOfConstruction;
    }
    class User {
        String username;
        String email;
        String password;
    }
    class Administrator extends User {
        String idCardNumber;
    }
    class AdditionalEntry {
        String name;
        Boolean isPublic;
    }
    class TextualEntry extends AdditionalEntry {
        String text;
    }
    class NumericEntry extends AdditionalEntry {
        float value;
        String unit;
    }
    class Image {
        String fileName;
    }
    class Comment {
        String content;
        User author;
    }

    association [1] WebPortal  -> (catalog) Building [*];
    association [1] Building -> (owner) User [1];
    association [1] Building -> (has) AdditionalEntry [*];
    association [1] Building -> (images) Image [*];
    association [1] Building -> (profilePhoto) Image [1];
    association [1] Building -> (receives) Comment [*];
    association [1] Comment -> (author) User [1];

}
