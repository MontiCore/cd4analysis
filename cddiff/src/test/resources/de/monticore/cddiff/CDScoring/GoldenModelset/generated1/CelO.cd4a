
// CD4A class diagram for Celebrations Organization System

classdiagram celebraciones {

    class Organizer {
        String firstName;
        String lastName;
        String email; // also used as username
        String postalAddress;
        String phoneNumber;
        String password;
        void inviteAttendee(Attendee attendee);
        void viewInvitationStatus(Event event);
    }

    class Attendee {
        String firstName;
        String lastName;
        String email; // used as username
        void respondToInvitation(Event event, Response status);
        void selectTask(Task task);
    }
    
    enum Response {
        ATTENDING,
        MAYBE,
        NOT_ATTENDING;
    }

    class Event {
        String eventType; // e.g., birthday party, graduation party, etc.
        DateTime startDateTime;
        DateTime endDateTime;
        String occasion;
        Location location;
        List<Task> checklist;
        void addTask(Task task);
        void showAttendeeTasks(List<Attendee> attendees);
    }

    class Location {
        String name;
        String address;
    }

    class Task {
        String description; 
        TaskStatus status; // e.g., NEEDS_DONE, DONE, NOT_APPLICABLE
        void setStatus(TaskStatus status);
    }

    enum TaskStatus {
        NEEDS_DONE,
        DONE,
        NOT_APPLICABLE;
    }

    association [1] Organizer -> (manages) Event [*];
    association [1..*] Organizer <-> Attendee [0..*]; // organizers can attend the event or just manage it
    association [1] Event -> (has) Task [*]; // event has multiple tasks
    association [1..*] Event -> (takesPlaceAt) Location [1]; // event takes place at one location
    association [*] Attendee -> (invitedTo) Event [*];
}
