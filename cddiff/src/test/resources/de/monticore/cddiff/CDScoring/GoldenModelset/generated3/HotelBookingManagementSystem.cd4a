
// CD4A Class Diagram for Hotel Booking Management System (HBMS)

classdiagram hbms {

    class Traveller {
        String name;
        BillingInformation billingInfo; // contains company name and address
        List<String> travelPreferences; // e.g. breakfast included, free wifi, etc.
        void register(String name, BillingInformation billingInfo, List<String> travelPreferences);
        void searchAccommodation(String city, Date arrivalDate, Date departureDate, int numRooms, RoomType roomType, int minRating, double maxCost, List<String> additionalPreferences);
        void createPreliminaryBooking(BookingInfo bookingInfo);
        void finalizeBooking(CreditCardInfo cardInfo);
    }

    class BillingInformation {
        String companyName;
        String address;
    }

    enum RoomType {
        SINGLE,
        DOUBLE,
        TWIN;
    }

    class BookingInfo {
        double price;
        String cityArea;
        int hotelRating;
        List<String> keyPreferences; // e.g. those travel preferences relevant to the booking
        String uniqueBookingId;
        void confirm();
        void cancel();
    }

    class CreditCardInfo {
        String cardNumber;
        String expiryDate;
        String ccv;
    }
    
    class Hotel {
        String name;
        Address address; // Represents the hotel's physical address
        HotelChain hotelChain; // optional association with a hotel chain
        List<RoomType> availableRoomTypes; // types of rooms available
        void announceAvailableRooms(RoomType roomType, Date period);
        void informFullyBooked(RoomType roomType);
        void sendConfirmation(BookingInfo bookingInfo);
        void sendCancellationOffer(BookingInfo bookingInfo);
    }

    class Address {
        String street;
        String city;
        String zipCode;
    }
    
    class HotelChain {
        String name;
        List<Hotel> hotels;
    }

    association [0..*] Traveller -> (pastBookings) BookingInfo [*];
    association [*] Hotel <-> HotelChain [0..1];
}
