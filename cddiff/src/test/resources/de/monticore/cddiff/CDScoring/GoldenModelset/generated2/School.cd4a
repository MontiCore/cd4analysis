
classdiagram School {

class School {
    String name;
}

abstract class Person {
    String firstName;
    String lastName;
}

class Teacher extends Person {
    String email;
}

class Student extends Person {
    // No additional attributes
}

class Room {
    String name;
}

class Classroom extends Room {
    int capacity;
}

class Gym extends Room {
    int sizeInSquareMeters;
}

class ClassGroup {
    String name;
}

association [1] School <-> (principal) Teacher [1];
association [*] Teacher <-> (teaches) School [0..3];
association [1] Student <-> (attends) School [1];
association [1] Student <-> (in) ClassGroup [1];
association [1] ClassGroup <-> (assignedTo) Classroom [1];
association [1] Classroom <-> (assignedTo) ClassGroup [1];

}
