
classdiagram school {

    class School {
        String name;
        Teacher principal; // Only one principal per school
    }

    class Person {
        String firstName;
        String lastName;
    }

    class Teacher extends Person {
        String email;
    }

    class Student extends Person {
        ClassGroup classGroup;
        School school; // Attends exactly one school
    }

    class ClassGroup {
        String name;
        List<Student> students; // Between 10 and 31 students
        Classroom classroom; // Assigned to exactly one classroom
    }

    class Room {
        String name;
    }

    class Classroom extends Room {
        int capacity; // Capacity of the classroom
    }

    class Gym extends Room {
        double size; // Size specification in square meters
    }

    association [1] School -> (principal) Teacher [1]; // Each school has exactly one principal
    association [1] Teacher <-> (teaches) School [0..3]; // Teacher can teach at a maximum of three schools
    association [1] Student -> (classGroup) ClassGroup [1]; // Each student is in exactly one class group
    association [1] ClassGroup <-> (classroom) Classroom [1]; // Class group is assigned to exactly one classroom
}

