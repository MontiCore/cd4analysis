
classdiagram CruiseSystem {

class Provider {
    String name;
    String location;
}

class Cruise {
    int number;
    String name;
    Date startDate;
    Date endDate;
}

class Employee {
    String name;
    String socialSecurityNumber;
}

class Guest {
    String name;
    boolean isVip;
}

class Ship {
    String name;
    int numberOfDecks;
    float length;
    int numberOfPassengers;
}

class TravelAgency {
    String name;
    String address;
}

class Booking {
    int bookingNumber;
    Date bookingDate;
}

class DestinationArea {
    String name;
    String seaName;
}

class Show {
    String title;
    int duration; // Duration in minutes
}

class Ticket {
    String ticketNumber; // Assumes ticket numbers are unique
}

// Associations
association organizes [1] Provider -> Cruise [*];
association requires [*] Cruise -> Employee [*];
association [*] Guest -> (participatesIn) Cruise [*];
association [1] Cruise -> Ship [*];
association bookedBy [1] Cruise -> TravelAgency [*];
association headsTo [1] Cruise -> DestinationArea [1];
association offers [1] Cruise -> Show [*];
association [1] Ticket -> Cruise [1];
association hasTickets [*] Guest -> Ticket [*];
association [1..1] Guest -> Ticket [1..*]; // Constraint: One ticket per cruise.
}
