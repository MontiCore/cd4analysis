
classdiagram Facepage {

class User {
    String id;
    String name;
    String email;
    Date dateOfBirth;
}

class Account {
    String accountNumber;
}

class BusinessAccount extends Account {
    String companyName;
    double monthlyFee;
}

class PersonalAccount extends Account {}

class Page {
    String name;
    int numberOfVisits;
}

class AdvertisementPage extends Page {
    double bounceRate;
    double clickThroughRate;
    double conversionRate;
}

association [0..1] User -> Account [1];
association [1] Account <-> Page [*];
association [0..*] BusinessAccount -> AdvertisementPage [*];
association [0..*] PersonalAccount -> Page [*];
}
