
// CD4A Class Diagram for the Facepage social network

classdiagram facepage {

    class User {
        String ID; // Unique identifier for a user
        String name;
        String email;
        Date dateOfBirth;
    }

    class Account {
        String accountNumber; // Automatically generated account number
        AccountType accountType; // Can be Business or Personal
        void createPage(Page page);
    }

    enum AccountType {
        PERSONAL,
        BUSINESS;
    }

    class PersonalAccount extends Account {
        void sendFriendRequest(User user);
        void receiveFriendRequest(User user);
    }

    class BusinessAccount extends Account {
        String companyName;
        double monthlyFee; // Fee for maintaining business account
        void createAdvertisementPage(AdvertisementPage page);
    }

    class Page {
        String pageName; // Must be unique within the account
        int numberOfVisits;
        Account account; // Page must be administrated by exactly one account
    }

    class AdvertisementPage extends Page {
        double bounceRate; // Percentage of visitors that leave immediately
        double clickThroughRate; // Percentage of visitors that click on a certain banner
        double conversionRate; // Percentage of visitors that accomplish the intended goal
    }

    association [1] Account -> (administrates) Page [*];
    association [1] User -> (owns) Account [*]; // One user can own multiple accounts but not of the same type
    association [*] PersonalAccount <-> Page [*]; // Personal accounts can have privileges on other personal accounts' pages
}
