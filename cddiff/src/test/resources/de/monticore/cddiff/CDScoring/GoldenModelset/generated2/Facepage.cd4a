
classdiagram Facepage {

class User {
    String id; // Unique user ID
    String name;
    String email;
    Date dateOfBirth;
}

class Account {
    String accountNumber; // Automatically generated by the system
}

class BusinessAccount extends Account {
    String companyName; // Name of the company
    float monthlyFee; // Monthly fee for business accounts
}

class PersonalAccount extends Account {
    // No additional attributes
}

class Page {
    String pageName; // Unique page name per account
    int numberOfVisits;
}

class AdvertisementPage extends Page {
    float bounceRate; // Percentage of visitors leaving immediately
    float clickThroughRate; // Percentage of visitors clicking on a banner
    float conversionRate; // Percentage of visitors achieving the intended goal
}

// Association that enforces the single account policy per user
association [1] User -> Account [1]; // Each user has exactly one account

// Association for pages created by accounts
association [1] Account -- Page [*]; // Each account can create multiple pages

// Association for permissions among personal accounts
association [0..*] PersonalAccount <-> Page [0..*]; // Personal accounts can be granted privileges to other pages

// Association that indicates each advertisement page is created by a business account
association [1] BusinessAccount -- AdvertisementPage [*]; // Business accounts can create multiple advertisement pages

}
