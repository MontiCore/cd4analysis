
// CD4A Model for HospitalHouseMD
classdiagram hospitalhousemd {

    class HospitalHouseMD {
        List<Patient> patients;
        List<Doctor> doctors;
        List<Illness> illnesses;
        void approveDiagnosis(Doctor doctor, Diagnosis diagnosis);
    }

    class Patient {
        String name;
        boolean consentGiven;
        void signConsent();
        void retractConsent();
    }

    class Doctor {
        String name;
        void diagnose(Patient patient);
    }

    class Diagnosis {
        String description;
        Doctor diagnosingDoctor;
        Illness illness;
    }

    class Illness {
        String name;
        PriorityScore priorityScore;
        void updatePriorityScore(PriorityScore newScore);
    }

    enum PriorityScore {
        HIGH,
        LOW;
    }

    class Treatment {
        TreatmentStage stage;
        void apply(Patient patient);
        void upgradeStage();
        void downgradeStage();
    }

    enum TreatmentStage {
        STAGE1,
        STAGE2,
        STAGE3;
    }

    // Association between classes
    association [*] HospitalHouseMD -> (patients) Patient [*];
    association [*] HospitalHouseMD -> (doctors) Doctor [*];
    association [*] HospitalHouseMD -> (illnesses) Illness [*];
    association [*] Patient -> (diagnoses) Diagnosis [*];
    association [*] Diagnosis -> (treatments) Treatment [*];
}
