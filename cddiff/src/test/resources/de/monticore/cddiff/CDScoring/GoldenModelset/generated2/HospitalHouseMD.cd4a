
classdiagram HospitalHouseMD {

class Patient {
    String name;
    String consentForm;
}

class Doctor {
    String name;
}

class Treatment {
    int stage;
    String description;
}

class Illness {
    String name;
    String priorityScore; // Possible values: "high", "low"
}

class Nurse {
    String name;
}

class Diagnosis {
    // The LLM did not generate this class, adding it to avoid errors
}

association [1..*] Patient <-> (assignedTo) Doctor [1..*];
association [1] Doctor <-> (approves) Diagnosis [1..*];
association [1..*] Diagnosis <-> Treatment [1..*];
association [1] Illness -- Treatment [0..*];
association [1..*] Treatment <-> (checkedBy) Nurse [0..*];

}
