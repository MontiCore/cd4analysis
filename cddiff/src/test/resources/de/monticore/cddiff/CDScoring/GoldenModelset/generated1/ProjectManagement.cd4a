
// CD4A Class Diagram for Research Project Management

classdiagram research_project_management {

    class University {
        List<Department> departments;
        List<ResearchGroup> researchGroups;
    }
    
    class Department {
        List<ResearchGroup> researchGroups;
    }

    class ResearchGroup {
        String name;
        List<Researcher> researchers;
        List<WorkPackage> workPackages;
    }

    class Researcher {
        String name;
        ResearchGroup researchGroup;

        void assignToWorkPackage(WorkPackage wp);
        void changeResearchGroup(ResearchGroup newGroup);
    }

    class WorkPackage {
        String title;
        ResearchGroup wpLeader;
        List<Researcher> teamMembers;

        void reassignTeamMembers();
    }

    association [*] University -> (departments) Department [*];
    association [*] Department -> (researchGroups) ResearchGroup [*];
    association [*] ResearchGroup -> (researchers) Researcher [*];
    association [*] ResearchGroup -> (workPackages) WorkPackage [*];
    association [*] WorkPackage -> (teamMembers) Researcher [*];
}
