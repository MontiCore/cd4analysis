
// CD4A class diagram for research project management in a university
classdiagram ResearchProjectManagement {
    
    class University {}

    class Department {}

    class ResearchGroup {
        // Each research group belongs to one department
    }

    class Researcher {
        // Each researcher belongs to exactly one research group
    }

    class Project {
        // A project is decomposed into Work Packages (WP)
    }
    
    class WorkPackage {
        // Each WP has one research group as leader
    }

    association [*] University -> Department [*];
    association [*] Department -> ResearchGroup [*];
    association [1] ResearchGroup -> Researcher [*];
    association [1] WorkPackage -> ResearchGroup [1]; // WP leader
    association [*] WorkPackage -> Researcher [*]; // Researchers can be assigned to any WP

    // Service delivery implication on assignments
    association [0..*] ResearchGroup <-> Researcher [*]; // Traceable service delivery from one group to another
}
