/* (c) Clothing Management System */

classdiagram ClothingCompanyLLM {

  class Product {
    String name;
    String description;
    double netPrice;
  }

  class Company {
    String name;
  }

  class Country {
    String name;
    double vatRate;
    String currency;
    double conversionRateToEuro;
  }

  class Representative {
    String firstName;
    String lastName;
    String socialSecurityNumber;
    String phoneNumber;
    String email;
  }

  class Customer {
    String name;
    String address;
    String phoneNumber;
    String email;
  }

  class Order {
    String orderId;
    int quantity;
    Date orderDate;
    Date deliveryDate;
  }

  // Associations
  association [1] Product -> (manufacturer) Company [1];
  association [*] Product -> (availableIn) Country [*]; // not every product is available in every country
  association [1] Representative -> (responsibleCountry) Country [1];
  association [*] Customer -> (resellsIn) Country [*];
  association [1] Order -> (product) Product [1];
  association [1] Order -> (customer) Customer [1];
  association [1] Order -> (placedBy) Representative [1];
}
