classdiagram clothingApp {

    // Class representing products
    class Product {
        String uniqueName;
        String description;
        double netPrice;
        String manufacturerName;
        String manufacturerCountry;
    }

    // Class representing countries, the VAT rate and currency information
    class Country {
        String name;
        double vatRate;
        String currency;
        double conversionRateToEuro;
    }

    // Association indicating in which country a product is available
    association isAvailableIn [*] Product -> Country [*];

    // Class representing representatives
    class Representative {
        String firstName;
        String lastName;
        String socialSecurityNumber;
        String telephoneNumber;
        String emailAddress;
    }

    // Association indicating the country a representative is responsible for
    association responsibleFor [1] Representative -> Country [1];

    // Class representing customer information
    class Customer {
        String name;
        String address;
        String telephoneNumber;
        String emailAddress;
        List<Country> resellingCountries;
    }

    // Class representing orders
    class Order {
        String orderId; // Unique identifier
        int orderQuantity;
        Date orderDate;
        Date deliveryDate;
    }

    // Associations tying orders, representatives, and products
    association placedBy [1] Order -> Representative [1];
    association refersTo [1] Order -> Product [1];
}