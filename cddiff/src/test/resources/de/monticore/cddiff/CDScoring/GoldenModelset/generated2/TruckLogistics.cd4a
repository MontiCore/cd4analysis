
classdiagram LocationManagement {
    class Driver {
        String firstName;
        String lastName;
    }

    class Location {
        String address;
    }

    class Order {
        Location origin;
        Location destination;
        Date executionDate;
    }

    class Vehicle {
        String vehicleNumber;
    }

    class Truck extends Vehicle {
        double weight;
    }

    class Car extends Vehicle {
        int numberOfSeats;
    }

    class Van extends Vehicle {}

    association [1] Location -> (driver) Driver [*];
    association [1] Order -> Location [2]; // origin and destination
    association [1] Driver -> (order) Order [0..1];
    association [0..1] Driver -> (drives) Vehicle [1];
    association [1] Vehicle -> (drivenBy) Driver [0..1];
}
