
classdiagram locations {

    class Location {
        String address;
    }

    class Driver {
        String firstName;
        String lastName;
    }

    class Vehicle {
        String vehicleNumber;
    }

    class Truck extends Vehicle {
        double weight;
    }

    class Car extends Vehicle {
        int numberOfSeats;
    }

    class Van extends Vehicle {
        // Van specific attributes can be added here if needed
    }

    class Order {
        Location origin;
        Location destination;
        Driver assignedDriver;
        Date executionDate;
    }

    association [1] Location -> (drivers) Driver [*];
    association [*] Location -> (vehicles) Vehicle [*];

    association [1] Driver -> (order) Order [1];
    association [1] Driver -> (vehicle) Vehicle [1];
}
