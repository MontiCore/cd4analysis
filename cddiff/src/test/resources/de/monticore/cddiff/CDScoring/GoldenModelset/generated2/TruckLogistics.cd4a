
// Class diagram for location management system
classdiagram LocationManagement {

    class Location {
        String address;
    }

    class Driver {
        String firstName;
        String lastName;
    }

    class Vehicle {
        String vehicleNumber;
    }

    class Truck extends Vehicle {
        double weight;
    }

    class Car extends Vehicle {
        int numberOfSeats;
    }

    class Van extends Vehicle {
        // properties specific to vans can be added here if necessary
    }

    class Order {
        Location origin;
        Location destination;
        Driver assignedDriver;
        Date executionDate;
    }

    association [1] Location <-> Driver [0..*]; // A location can have multiple drivers
    association [1] Location <-> Vehicle [0..*]; // A location can have multiple vehicles
    association [1] Driver <-> Order [0..1]; // A driver can have at most one active order
    association [1] Driver <-> Vehicle [0..1]; // A driver is assigned to at most one vehicle
    association [1] Order <-> Driver [1]; // An order must have at least one assigned driver
    association [1] Order <-> Location [1]; // An order has an origin and a destination location
}
