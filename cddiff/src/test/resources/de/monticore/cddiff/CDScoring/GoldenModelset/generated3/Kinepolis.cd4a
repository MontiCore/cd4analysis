
// Kinepolis Cinema Class Diagram
classdiagram KinepolisCinema {

class Cinema {
    String location;
}

class Theatre {
    int seatCount;
}

class Movie {
    String title;
}

class MovieCopy {
    // A copy of a movie located at a specific cinema
}

class Show {
    DateTime startTime;
    boolean isCancelled;
}

class Reservation {
    DateTime reservationTime;
    boolean isCancelled;
    String seatNumber;
    CreditCard creditCard;
}

class Ticket {
    String seatNumber;
    boolean isAnonymous;
}

class Offer {
    DateTime expirationTime;
}

class CreditCard {
    String cardNumber;
}

association [1] Cinema <-> Theatre [0..*];
association [1] Theatre <-> Show [0..*];
association [1] Movie <-> MovieCopy [0..*];
association [1] MovieCopy <-> Show [0..*];
association [1] Show <-> Reservation [0..*];
association [1] Show <-> Offer [0..1];
association [1] Show <-> Ticket [0..*];

}
