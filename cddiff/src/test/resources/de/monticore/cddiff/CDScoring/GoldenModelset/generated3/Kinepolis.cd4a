
// CD4A Class Diagram for Kinepolis Cinema System
classdiagram kinepolis {

    class Kinepolis {
        List<Cinema> cinemas;
    }

    class Cinema {
        List<Theatre> theatres;
        void transferMovieCopy(MovieCopy copy, Cinema newCinema);
    }

    class Theatre {
        List<Show> shows;
        int totalSeats;
        int availableSeats;
        void showAvailability();
    }

    class Show {
        MovieCopy movieCopy;
        Date startTime;
        List<Reservation> reservations;
        void publish();
        void cancel();
        void offerNewSeat(Reservation reservation);
    }

    class MovieCopy {
        Movie movie;
        Cinema cinema; // A copy only shown in the cinema it belongs to
    }

    class Reservation {
        CreditCard creditCard;
        boolean isCancelled;
        void makeReservation(Show show);
        void cancelReservation();
    }

    class Ticket {
        Show show;
        int seatNumber;
    }

    class CreditCard {
        String cardNumber;
        String expirationDate;
        void charge();
    }

    class Movie {
        // The LLM did not generate this class, adding it to avoid errors
    }

    association [*] Kinepolis -> (cinemas) Cinema [*];
    association [*] Cinema -> (theatres) Theatre [*];
    association [*] Theatre -> (shows) Show [*];
    association [*] Show -> (reservations) Reservation [*];
    association [1] MovieCopy -> Cinema [1];
}
