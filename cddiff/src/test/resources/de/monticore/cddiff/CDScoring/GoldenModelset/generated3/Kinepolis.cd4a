
classdiagram KinepolisCinemaSystem {

class Cinema {
    String name;
}

class Theatre {
    int number;
}

class MovieCopy {
    String movieTitle;
}

class Show {
    Date startTime;
    boolean isPublished;
    boolean isCancelled;
}

class Reservation {
    String customerName;
    String creditCard;
    boolean isCancelled;
}

class Ticket {
    String seatNumber;
    boolean isAnonymous;
}

association [1] Cinema <-> Theatre [1..*];
association [1] Cinema <-> MovieCopy [0..*];
association [1] MovieCopy <-> Show [1..*];
association [1] Show <-> Reservation [0..*];
association [1] Show <-> Ticket [0..*];
}
