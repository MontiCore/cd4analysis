
// CD4A Class Diagram for Helping Hands Store (H2S)

classdiagram helpingHandsStore {

    class H2S {
        String name;
        String city;
        List<Pickup> pickups;
        List<VolunteerDriver> volunteerDrivers;
        List<DistributionCenter> distributionCenters;
        void schedulePickup(PickupRequest request);
    }

    class PickupRequest {
        String residentName;
        String streetAddress;
        String phoneNumber;
        String emailAddress; // optional
        String itemDescription;
        Date pickupDate;
        Time pickupTime;
    }

    class Pickup {
        Vehicle vehicle;
        List<PickupRequest> scheduledRequests;
        void determineRoute();
        void executePickup();
    }

    class VolunteerDriver {
        String name;
        List<Day> availableDays;
        void indicateAvailability(List<Day> days);
    }

    class Vehicle {
        String vehicleId;
        double storageCapacity; // in cubic meters
        List<PickupRequest> currentItems;
    }

    class DistributionCenter {
        List<SecondHandArticle> articlesReceived;
        void examineArticle(SecondHandArticle article);
    }

    class SecondHandArticle {
        String description;
        String rfidTag;
        String category;
        void assignCategory(String category);
    }

    class FoodBank {
        List<NonPerishableFood> foodsReceived;
        void processFood(NonPerishableFood food);
    }

    class NonPerishableFood {
        String description;
        void dropOff();
    }

    class Client {
        String name;
        String address;
        List<String> requestedCategories;
        void indicateNeededCategories(List<String> categories);
    }

    association [*] H2S <-> (locations) DistributionCenter [*];
    association [*] DistributionCenter -> (receivedArticles) SecondHandArticle [*];
    association [*] DistributionCenter -> (receivedFoods) NonPerishableFood [*];
    association [1] VolunteerDriver -> (assignedPickup) Pickup [*];
    association [*] Pickup -> (pickupRequests) PickupRequest [*];
    
    // Enum for available days for VolunteerDriver
    enum Day {
        MONDAY,
        TUESDAY,
        WEDNESDAY,
        THURSDAY,
        FRIDAY;
    }
}
