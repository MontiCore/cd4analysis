
classdiagram HelpingHandsStore {

    class H2S {
        Location location;
        PickupService pickupService;
        DistributionCenter distributionCenter;
    }

    class Location {
        String cityName;
    }

    class PickupService {
        Resident resident;
        Vehicle vehicle;
        void schedulePickup(String dayOfWeek, Time pickupTime);
    }

    class Resident {
        String name;
        String streetAddress;
        String phoneNumber;
        String emailAddress;
        String descriptionOfItems;
    }

    class Vehicle {
        String vehicleID;
        int storageSpace;
        void determineRoute();
    }

    class VolunteerDriver {
        List<String> availableDays;
    }

    class DistributionCenter {
        Employee employee;
        List<Article> articlesReceived;
        void evaluateArticleQuality(Article article);
    }

    class Article {
        String description;
        RFIDDevice rfidDevice;
        Category category;
    }

    class RFIDDevice {}

    class Employee {
        void checkArticleDescription(Article article);
        void assignCategory(Article article);
        void callClient(Client client);
        void arrangeDelivery(Article article, Client client);
    }

    class Category {
        String name;
    }

    class Client {
        List<Category> preferredCategories;
        String homeAddress;
    }

    association [1] H2S -> (location) Location [1];
    association [1] H2S -> (pickupService) PickupService [1];
    association [1] H2S -> (distributionCenter) DistributionCenter [1];

    association [1] PickupService -> (resident) Resident [1];
    association [1] PickupService -> (vehicle) Vehicle [*];

    association [*] Vehicle -> (driver) VolunteerDriver [*];

    association [1] DistributionCenter -> (employee) Employee [1];
    association [*] DistributionCenter -> (articlesReceived) Article [*];

    association [1] Article -> (rfidDevice) RFIDDevice [1];
    association [1] Article -> (category) Category [1];

    association [1] Employee -> (checkArticleDescription) Article [*];
    association [1] Employee -> (arrangeDelivery) Article [*];
    association [*] Employee -> (callClient) Client [*];

    association [*] Client -> (preferredCategories) Category [*];
}
