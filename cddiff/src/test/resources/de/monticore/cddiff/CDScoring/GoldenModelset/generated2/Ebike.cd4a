
classdiagram ebike {

    class EBike {
        Frame frame;
        DriveSystem driveSystem;
        Controller controller;
        List<Wheel> wheels;
        Battery battery; // optional
    }

    class Frame {
        String material = "steel";
    }

    class DriveSystem {
        Motor motor;
    }

    class Motor {
    }

    class Wheel {
    }

    class Battery {
        double storedEnergy; // in Watt-hours (Wh)
    }

    enum ControllerState {
        On,
        Off,
        Charging;
    }

    abstract class Controller {
        ControllerState state;
        void controlBattery(Battery battery); // if connected
        void commandDriveSystem();
    }

    class BasicController extends Controller {
        void controlBattery(Battery battery);
        void commandDriveSystem();
    }

    class AdvancedController extends Controller {
        void controlBattery(Battery battery);
        void commandDriveSystem();
        Date estimateNextInspectionDate();
    }

    association [2] EBike -> (wheels) Wheel [2];
}
