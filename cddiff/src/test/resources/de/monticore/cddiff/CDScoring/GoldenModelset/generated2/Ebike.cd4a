
classdiagram EBikeSystem {

class EBike {
    Frame frame;
    DriveSystem driveSystem;
    Controller controller;
    Battery battery;
}

class Frame {
    String material; // should be "steel"
}

class DriveSystem {
    Motor motor;
}

class Controller {
    ControllerState state;
}

enum ControllerState {
    On,
    Off,
    Charging;
}

class Battery {
    double storedEnergy; // in Watt-hours (Wh)
}

class BasicController extends Controller {
    // class body
}

class AdvancedController extends Controller {
    Date estimateNextInspectionDate();
}

class Motor {
    // class body
}

association [*] EBike <-> Frame [1];
association [*] EBike <-> DriveSystem [1];
association [*] EBike <-> Controller [1];
association [0..1] EBike <-> Battery [1];
association [*] DriveSystem <-> Motor [1];

}
