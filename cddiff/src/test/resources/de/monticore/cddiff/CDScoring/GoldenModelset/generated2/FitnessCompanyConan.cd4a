
// Class Diagram for Fitness Company "Conan"
classdiagram ConanFitness {

class Address {
    String street;
    String city;
    String zipCode;
}

class Room {
    int roomNumber;
    int maxCapacity;
}

class FitnessCenter {
    String uniqueName; // e.g., Fitplaza, my6pack
    Address address;
}

abstract class Person {
    String firstName;
    String familyName;
    Date birthDate;
}

class Trainer extends Person {
    String diploma;
}

class Participant extends Person {
    // Inherits properties from Person
}

class Session {
    Date date;
    String startHour;
}

class IndividualSession extends Session {
    // No additional attributes, inherits from Session
}

class GroupSession extends Session {
    String type; // e.g., aerobics, bodystyling
}

// Associating Participants and Trainers with Sessions
association [1] Trainer <-> GroupSession [*]; // Each group session requires exactly one trainer
association [0..*] Participant <-> Session [*]; // Participants can be in individual or group sessions
association [1] FitnessCenter <-> Room [*]; // A center has one or more rooms
association [*] Room <-> Session [*]; // Sessions can be held in any room of a center

}
