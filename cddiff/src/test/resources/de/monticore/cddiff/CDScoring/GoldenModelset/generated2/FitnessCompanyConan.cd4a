
// CD4A class diagram for Fitness company "Conan"
classdiagram fitness {

    class Address {
        String street;
        String city;
        String postalCode;
    }

    class Center {
        String name; // Unique name of the center
        Address address; // Address of the center
        List<Room> rooms; // Rooms in the center
    }

    class Room {
        int number; // Unique number for each room in a center
        int maxCapacity; // Maximum capacity of the room
    }

    class Person {
        String firstName; // First name of the person
        String familyName; // Family name of the person
        Date birthDate; // Birth date of the person
    }

    class Trainer extends Person {
        String diploma; // Diploma of the trainer
    }

    class Session {
        Date date; // Date of the session
        Time startHour; // Starting hour of the session
    }

    class IndividualSession extends Session {
        // Individual sessions do not require a trainer
    }

    class GroupSession extends Session {
        String type; // Type of group session (e.g., aerobics, bodystyling)
        Trainer trainer; // Trainer supervising the group session
    }

    association [*] Center -> (rooms) Room [*]; // A center has multiple rooms
    association [*] Person -> (attends) Session [*]; // People can attend multiple sessions
    association [*] Trainer -> (supervises) GroupSession [*]; // Trainers can supervise multiple group sessions
    association [*] GroupSession -> Center [1]; // Each group session is held in one center
    association [*] IndividualSession -> Center [1]; // Each individual session is held in one center
}
