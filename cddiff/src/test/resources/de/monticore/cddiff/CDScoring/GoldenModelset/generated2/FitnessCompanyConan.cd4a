
// CD4A Model
classdiagram FitnessCenter {

class Person {
    String firstName;
    String familyName;
    Date birthDate;
}

class Trainer extends Person {
    String diploma;
}

class FitnessCenter {
    String uniqueName;
    Address address;
}

class Room {
    int roomNumber;
    int maxCapacity;
}

class Session {
    Date date;
    Time startHour;
}

class GroupSession extends Session {
    String type;
}

class IndividualSession extends Session {}

class Address {
    String street;
    String city;
    String postalCode;
}

association [1] FitnessCenter <-> Room [*];
association [1] FitnessCenter <-> (hosts) Session [*];
association [0..*] Person <-> (participatesIn) Session [*];
association [1] GroupSession <-> (supervisedBy) Trainer [1];
association [1] Session <-> (includes) Trainer [0..1];

}
