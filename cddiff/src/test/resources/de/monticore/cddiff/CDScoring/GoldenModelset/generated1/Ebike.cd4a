
classdiagram EBike {

class EBike {
    Frame frame;
    DriveSystem driveSystem;
    Controller controller;
    Battery battery;
}

class Frame {
    String material; // e.g., "steel"
}

class DriveSystem {
    Motor motor;
}

class Motor {
    // class body
}

class Battery {
    int storedEnergy; // in Watt-hours (Wh)
}

class Controller {
    ControllerState state;
}

enum ControllerState {
    On,
    Off,
    Charging;
}

class BasicController extends Controller {
    // class body
}

class AdvancedController extends Controller {
    Date estimateNextInspectionDate();
}

association [2] Frame -> Wheel [2];
association [1] EBike -> (controls) Controller [1];
association [1] Controller -> Battery [0..1];
association [1] Controller -> DriveSystem [1];

}
