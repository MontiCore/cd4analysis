
// CD4A Class Diagram for the EBike description
classdiagram ebike {

    class EBike {
        Frame frame;
        DriveSystem driveSystem;
        Controller controller;
        Battery battery;
    }

    class Frame {
        String material = "steel"; // Frame material
    }

    class DriveSystem {
        Motor motor;
    }

    class Motor {
        // Motor specifics can be added here
    }

    class Battery {
        int storedEnergy; // Measured in Watt-hours (Wh)
    }

    enum ControllerState {
        On,
        Off,
        Charging;
    }

    abstract class Controller {
        ControllerState state;

        // Controls the battery if connected
        void controlBattery(Battery battery);

        // Commands the drive system
        void commandDriveSystem(DriveSystem driveSystem);
    }

    class BasicController extends Controller {
        // Basic controller functionality
    }

    class AdvancedController extends Controller {
        // Advanced controller can estimate the next inspection date
        Date estimateNextInspectionDate();
    }

    association [1] EBike -> Frame [1];
    association [1] EBike -> DriveSystem [1];
    association [1] EBike -> Controller [1];
    association [0..1] EBike -> Battery [1];
}
