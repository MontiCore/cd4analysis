
// CD4A Class Diagram for the EBike system
classdiagram EBikeSystem {

    class EBike {
        Frame frame;
        DriveSystem driveSystem;
        Controller controller;
        Battery battery; // optional
    }

    class Frame {
        String material; // e.g., "steel"
    }

    class DriveSystem {
        Motor motor;
    }

    class Motor {
        // motor details can be added here
    }

    class Battery {
        double storedEnergy; // in Watt-hours (Wh)
    }

    enum ControllerState {
        ON,
        OFF,
        CHARGING;
    }

    class Controller {
        ControllerState state;
        // Method for commanding drive system
        void commandDriveSystem();
        // Method for controlling battery
        void controlBattery();
    }

    class BasicController extends Controller {
        // basic controller features
    }

    class AdvancedController extends Controller {
        // Method for estimating inspection date
        Date estimateNextInspection();
    }

    association [1] EBike -> Frame [1];
    association [1] EBike -> DriveSystem [1];
    association [1] EBike -> Controller [1];
    association [0..1] EBike -> Battery [1];
    association [1] DriveSystem -> Motor [1];

}
