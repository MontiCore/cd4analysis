
// CD4A Class Diagram for Kinepolis Cinema System
classdiagram kinepolis {

    class Kinepolis {
        List<Cinema> cinemas;
    }

    class Cinema {
        String location;
        List<Theatre> theatres;
        List<MovieCopy> movieCopies;

        void moveMovieCopy(MovieCopy movieCopy, Cinema targetCinema);
    }

    class Theatre {
        String name;
        List<Show> shows;

        int availableSeats;
        void displayAvailableSeats();
    }

    class MovieCopy {
        Movie movie;
    }

    class Show {
        MovieCopy movieCopy;
        DateTime startTime;
        List<Reservation> reservations;

        void publish();
        void cancel();
    }

    class Reservation {
        Show show;
        Customer customer;
        CreditCard creditCard;
        DateTime reservationTime;

        void cancel();
        boolean isCancelable();
    }

    class Customer {
        String name;
        List<Reservation> reservations;
        void acceptOffer();
        void declineOffer();
    }

    class CreditCard {
        String cardNumber;
        DateTime expirationDate;
        void charge();
        // Payment is finalized after the cancellation period expires
    }

    association [0..*] Kinepolis -> (owns) Cinema [*];
    association [1..*] Cinema -> (has) Theatre [*];
    association [1..*] Theatre -> (features) Show [*];
    association [1..*] Show -> (has) Reservation [*];
    association [0..*] Reservation -> (madeBy) Customer [1];
    association [1] Reservation -> (paidWith) CreditCard [1];
    association [1] MovieCopy -> (of) Movie [1];
    // A MovieCopy can be associated with multiple theatres in the same cinema
    association [1] MovieCopy -> (locatedIn) Cinema [1];

}
