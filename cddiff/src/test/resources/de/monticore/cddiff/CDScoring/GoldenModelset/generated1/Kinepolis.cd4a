
classdiagram KinepolisCinemas {

class Cinema {
    String location;
}

class Theatre {
    int numberOfSeats;
}

class Movie {
    String title;
}

class Copy {
    String id;
}

class Show {
    Date startTime;
    boolean isCancelled;
}

class Reservation {
    CreditCard creditCard;
    boolean isCancelled;
}

class Ticket {
    int seatNumber;
}

class Offer {
    boolean isAccepted;
}

class CreditCard {
    String cardNumber;
}

association [1] Cinema <-> Theatre [0..*];
association [1] Cinema <-> Copy [0..*];
association [1] Copy <-> Show [1..*];
association [1] Show <-> Reservation [0..*];
association [1] Show <-> Ticket [0..*];
association [1] Show <-> Offer [0..*];
}
