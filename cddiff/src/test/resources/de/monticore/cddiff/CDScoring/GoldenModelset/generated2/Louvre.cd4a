
// CD4A class diagram for the Louvre Museum exhibition management system
classdiagram louvre {

    class Museum {
        List<Location> locations;
        // method to manage locations and exhibitions
    }

    class Location {
        String name;
        List<Exhibition> exhibitions;
    }

    class Exhibition {
        String title;
        Employee coordinator;
        List<ExhibitionItem> desiredItems;
    }

    class ExhibitionItem {
        String description; // Description of the desired item
        List<Piece> sourcedPieces; // Pieces sourced for this exhibition item
    }

    class Piece {
        String identifier;  // Unique identifier for the artwork piece
        Collector collector; // The collector who owns the piece
    }

    class Employee {
        String name;
        Employee coach; // Senior employee assigned as coach
    }

    class Collector {
        String name;
        List<Piece> pieces; // Pieces held by the collector
    }

    association [*] Museum -> Location [*];
    association [*] Location -> Exhibition [*];
    association [*] Exhibition -> ExhibitionItem [*];
    association [*] ExhibitionItem -> Piece [*];
    association [*] Employee -> Employee [0..1];
    association [*] Collector -> Piece [*];
}
