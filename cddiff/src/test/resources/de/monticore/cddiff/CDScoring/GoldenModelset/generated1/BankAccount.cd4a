
classdiagram BankSystem {

    class Customer {
        String firstName;
        String lastName;
    }

    class Branch {}

    class Account {
        int accountNumber;
        double currentBalance;
    }

    class CheckingAccount extends Account {
        double overdraftLimit;
    }

    class SavingsAccount extends Account {}

    association [*] Bank -> Branch [*];
    association [1..5] Customer -> (owns) Account [*];
    association [1] Account -> (owner) Customer [1];

}
