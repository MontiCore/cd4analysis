
classdiagram BankManagement {

    class Customer {
        String firstName;
        String lastName;
    }

    class Bank {
        // A bank consists of multiple branches
    }

    class Branch {
        // Branch details can be added here
    }

    class Account {
        int accountNumber;
        double currentBalance;
    }

    class CheckingAccount extends Account {
        double overdraftLimit;
    }

    class SavingsAccount extends Account {}

    association [1..5] Customer -> (owner) Account [*];
    association [1] Account -> (owner) Customer [1];
    association [0..*] Bank -> Branch [*];
}
