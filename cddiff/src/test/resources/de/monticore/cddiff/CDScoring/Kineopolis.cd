classdiagram Kinepolis {
    class Cinema {
	    String Name;
	    String City;
    }
    class Theatre {
	    int Number;
    }
    class Movie {
	    String Title;
	    int durationMinutes;
    }
    class MovieCopy {
	    int Id;
    }
    class CopyLocation {
	    DateTime StartDate;
	    DateTime EndDate;
    }
    class Seat {
	    int SeatNumber;
    }
    class Show {
	    DateTime StartTime;
	    DateTime EndTime;
    }
    class Ticket {
      int TicketId;
      Float Price;
    }
    class Customer {
      String Name;
      int CustomerId;
    }
    class OnlineTicket {
      int OnlineTicketId;
      Float Price;
    }
    class AlternativeOffer {
      int AlternativeOfferId;
    }

    association [1..1] Cinema -- Theatre [0..*];
    association [1..1] Movie -- MovieCopy [0..*];
    association [1..1] Cinema -- CopyLocation [0..*];
    association [1..1] MovieCopy -- CopyLocation [0..*];
    association [1..1] Theatre -- Seat [0..*];
    association [1..1] Theatre -- Show [0..*];
    association [1..1] CopyLocation -- Show [0..*];
    association [1..1] Seat -- Ticket [0..*];
    association [1..1] Show -- Ticket [0..*];
    association [1..1] Customer -- OnlineTicket [0..*];
    association [1..1] Seat -- OnlineTicket [0..*];
    association [1..1] Show -- OnlineTicket [0..*];
    association [1..1] OnlineTicket -- AlternativeOffer [0..1];
    association [1..1] Seat -- AlternativeOffer [0..*];
    association [1..1] Show -- AlternativeOffer [0..*];

    class DateTime {} // fix DateTime not existing
}
