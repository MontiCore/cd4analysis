
// Class diagram for LabTracker software
classdiagram LabTracker {

class Doctor {
    int practitionerNumber;
    String fullName;
    String address;
    String phoneNumber;
    Image signature; // digital signature
    Date validFrom;
}

class Patient {
    String healthNumber; // alphanumeric
    String firstName;
    String lastName;
    Date dateOfBirth;
    String address;
    String phoneNumber;
}

class Requisition {
    int id;
    Date creationDate;
    Doctor doctor; // cannot prescribe for themselves
    Patient patient;
    List<Test> tests; // tests of the same group
    Repetition repetition; // may indicate repetition
}

class Test {
    String testName;
    int duration;
    boolean requiresAppointment;
    boolean allowsWalkIn;
}

class Appointment {
    int confirmationNumber;
    Date appointmentDate;
    Time startTime;
    Time endTime;
    Lab lab; // selected lab for the appointment
}

class Lab {
    String address;
    String registrationNumber;
    String businessHours; // does not change weekly
    double cancellationFee; // set by the lab
}

class Repetition {
    int numberOfRepetitions;
    Interval interval; // weekly, monthly, halfYear, yearly
}

enum Interval {
    Weekly,
    Monthly,
    HalfYear,
    Yearly;
}

association [1] Doctor <-> Requisition [*]; // doctor creates requisition
association [1] Patient <-> Requisition [*]; // patient is linked to requisition
association [*] Requisition <-> Test [*]; // requisition can have multiple tests
association [*] Patient <-> Appointment [1]; // patient can have one appointment at a time
association [1] Lab <-> Appointment [*]; // lab can have multiple appointments

}
