
// CD4A Model for LabTracker System

classdiagram LabTrackerApp {

class Doctor {
  int practitionerNumber;
  String fullName;
  String address;
  String phoneNumber;
  Image signature;
  Date validFrom;
}

class Patient {
  String healthNumber;
  String firstName;
  String lastName;
  Date dateOfBirth;
  String address;
  String phoneNumber;
}

class Requisition {
  int id;
  Date date;
  Doctor doctor;
  Patient patient;
  List<Test> tests;
  int repeatCount;
  Interval interval;
  Report report;
}

class Test {
  int id;
  String name;
  Duration duration;
  boolean requiresAppointment;
  boolean isWalkInOnly;
  boolean requiresSampleDropOff;
}

class Appointment {
  int confirmationNumber;
  Date date;
  Time startTime;
  Time endTime;
  Lab lab;
}

class Lab {
  String name;
  String registrationNumber;
  String address;
  BusinessHours businessHours;
  Fee cancellationFee;
}

class Report {
  String results; // negative or positive
}

enum Interval {
    Weekly,
    Monthly,
    SemiAnnually,
    Yearly;
}

association [1] Requisition -> Doctor [1];
association [1] Requisition -> Patient [1];
association [0..*] Requisition -> Test [1..*];
association [1] Appointment -> Requisition [1];
association [1] Appointment -> Lab [1];
association [1] Lab -> Report [*];

}
