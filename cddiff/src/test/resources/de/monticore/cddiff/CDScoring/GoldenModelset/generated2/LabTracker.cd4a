
// CD4A Class Diagram for LabTracker Software

classdiagram labtracker {

    class Doctor {
        String practitionerNumber;
        String signature; // digital signature as image
        String fullName;
        String address;
        String phoneNumber;
        Date requisitionStartDate;
        
        void prescribeTest(Test test, Patient patient);
    }

    class Patient {
        String healthNumber; // alphanumeric
        String firstName;
        String lastName;
        Date dateOfBirth;
        String address;
        String phoneNumber;
        
        void bookAppointment(Requisition requisition, Lab lab);
    }

    class Requisition {
        Doctor doctor;
        Patient patient;
        List<Test> tests; // Tests must belong to the same group
        Boolean isRepeat; // indicates if tests are to be repeated
        Integer repeatCount; // number of times to repeat
        Interval repeatInterval; // enum defined below

        void viewResults();
    }
    
    class Test {
        String testName;
        Integer duration; // defined by lab network
        Boolean requiresAppointment;
        Boolean walkInOnly;
        
        // For some tests like blood tests, duration covers multiple tests
        Boolean takesSameTime;
    }
    
    class Lab {
        String name;
        String address;
        String registrationNumber;
        List<Test> offeredTests; // All tests offered by this lab
        BusinessHours businessHours; // defined by lab

        void confirmAppointment(Appointment appointment);
        void changeAppointment(Appointment appointment);
        void cancelAppointment(Appointment appointment);
    }
    
    class Appointment {
        String confirmationNumber;
        Date date;
        Time startTime;
        Time endTime;
        Lab lab;
    }

    enum Interval {
        WEEKLY,
        MONTHLY,
        EVERY_HALF_YEAR,
        YEARLY;
    }

    class BusinessHours {
        Time startTime;
        Time endTime; // business hours are consistent every week
    }
    
    // Associations
    association [1] Requisition -> Patient [1]; // Each requisition is for one patient
    association [1] Requisition -> Doctor [1]; // Each requisition is made by one doctor
    association [*] Lab <-> Test [*]; // Labs offer multiple tests, tests can be offered by multiple labs
    association [1] Lab -> Appointment [*]; // Labs have multiple appointments
    association [1] Doctor -> Requisition [*]; // A doctor can create multiple requisitions
    association [*] Patient -> Appointment [*]; // A patient can have multiple appointments
}
