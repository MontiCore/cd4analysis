
classdiagram TeamSportsScoutingSystem {

class Player {
    String name;
    int age;
    String currentClub;
    List<PlayerAttribute> attributes;
}

class PlayerAttribute {
    String attributeName;
    String attributeValue;
}

enum Position {
    GK, // Goalkeeper
    LB, // Left Back
    CB, // Center Back
    RB, // Right Back
    etc;
}

class DesignatedPlayerProfile {
    Position targetPosition;
    List<PlayerAttribute> requiredAttributes;
}

class Scout {
    String name;
    String scoutId;
}

class HeadScout extends Scout {
    int teamSize;
}

class HeadCoach {
    String name;
    String coachId;
}

class ScoutingAssignment {
    Player playerUnderInvestigation;
    List<ScoutingReport> submittedReports;
}

class ScoutingReport {
    String pros;
    String cons;
    Recommendation recommendation;
}

enum Recommendation {
    KEY_PLAYER,
    FIRST_TEAM_PLAYER,
    RESERVE_TEAM_PLAYER,
    PROSPECTIVE_PLAYER,
    NOT_A_GOOD_SIGNING;
}

class Director {
    String name;
    String directorId;
}

// Associations
association [*] Scout -> (assignedTo) ScoutingAssignment [*];
association evaluates [1..*] HeadScout -> Player [*];
association [*] ScoutingAssignment -> Player [1];
association [1] ScoutingReport -> Player [1];
association movesToShortList [1] HeadCoach -> Player [*];
association submitsFinalRecommendation [1] HeadScout -> Player [*];
association [1] Director -> (makesOfferFor) Player [*];

}
