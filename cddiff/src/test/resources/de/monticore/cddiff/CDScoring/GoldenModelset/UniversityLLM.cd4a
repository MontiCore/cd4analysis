
classdiagram university {

class University {
    int totalEmployees;
}

class Faculty {
    String name;
}

class Institute {
    String name;
    String address;
}

class Dean extends Employee {
}

class Employee {
    String socialSecurityNumber;
    String name;
    String emailAddress;
}

class ResearchAssistant extends Employee {
    String fieldOfResearch;
}

class AdministrativeStaff extends Employee {
}

class Lecturer extends ResearchAssistant {
    // Lecturer is a specialized Research Assistant handling courses.
}

class Project {
    String name;
    Date startDate;
    Date endDate;
    int allocatedHours;
}

class Course {
    String id; // Unique identifier
    String name;
    int weeklyDurationHours;
}

// Associations
association [*] University -> Faculty [*];
association [*] Faculty -> Institute [*];
association [1] Faculty (headedBy) -> Dean [1];
association [1] Institute (employs) -> Employee [*];
association [1..*] Institute -> ResearchAssistant [*];
association involves [*] ResearchAssistant -> Project [*];
association teaches [*] Lecturer -> Course [*];

}
