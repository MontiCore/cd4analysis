/* (c) CD4A Class Diagram based on University Project Description */

classdiagram UniversityLLM {

  class University {
    int totalEmployees;
  }

  class Faculty {
    String name;
  }

  class Institute {
    String name;
    String address;
  }

  association [1] University -> (faculties) Faculty [*];
  association [1] Faculty -> (institutes) Institute [*];

  class Employee {
    String ssn;
    String name;
    String email;
  }

  // Each faculty is headed by a dean, who is an employee of the university.
  association [1] Faculty -> (dean) Employee [1];

  class ResearchStaff extends Employee {}

  class AdministrativeStaff extends Employee {}

  class ResearchAssistant extends ResearchStaff {
    String fieldOfResearch;
  }

  // Research assistants are assigned to at least one institute
  association [1..*] ResearchAssistant -> Institute [*];

  class Project {
    String name;
    Date startDate;
    Date endDate;
  }

  // RAs can be involved in projects for a certain number of hours
  association [*] ResearchAssistant -> (projects) Project [*];

  class Lecturer extends ResearchAssistant {}

  class Course {
    int id;
    String name;
    int weeklyHours;
  }

  // Some RAs (Lecturers) teach courses
  association [*] Lecturer -> (courses) Course [*];
}
