
classdiagram gameModel {

class GameArea {
    String name;
}

class GameElement {
    protected long x;
    private long y;
}

class Shape extends GameElement {
    // Shapes can be connected to other Shapes
}

class Object extends GameElement {
    // Objects are general game elements
}

class Opponent extends GameElement {
    protected int lives;
    boolean isKilled; // Attribute approximates the ability to be killed
}

class Boss extends Opponent {
    // Boss is a specific type of Opponent
}

// Associations
association [1..*] GameArea -> GameElement [*]; // GameArea must have at least one GameElement
association [1..2] GameArea -> (hasGamePieces) GameElement [*]; // GameArea contains one or two game pieces
association [1] GameArea -> Boss [1]; // GameArea has exactly one Boss
association [1] Shape -> (connectsTo) Shape [*];
}
