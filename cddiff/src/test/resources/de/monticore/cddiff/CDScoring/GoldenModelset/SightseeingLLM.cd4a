
classdiagram CityAttractions {

class City {
    String name;
    int inhabitants;
    List<Attraction> attractions;
}

class Attraction {
    String name;
    String address;
    List<GuidedTour> guidedTours;
}

class GuidedTour {
    int duration; // Duration in minutes
    String tourNumber;
    int maxVisitors = 20;
    Optional<Float> discountAmount; // Discount in percentage or specific value
    Guide guide;
    List<Visitor> participants;
}

class Guide extends Person {
    // A Guide inherits all attributes from Person (e.g., name)
}

class Visitor extends Person {
    Optional<Float> grantedDiscount; // Discount granted to the visitor
}

class Person {
    String name;
}

// Associations
association [*] City -> Attraction [*];
association [*] Attraction -> GuidedTour [*];
association [1] GuidedTour -> Guide [1];
association [*] GuidedTour -> Visitor [*];

}
