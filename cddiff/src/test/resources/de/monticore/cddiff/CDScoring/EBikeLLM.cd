classdiagram EBikeLLM {
    class EBike {
        Frame frame;
        DriveSystem driveSystem;
        Controller controller;
        Battery battery;
    }

    class Frame {
        String material;
    }

    class DriveSystem {
        Motor motor;
    }

    class Motor {}

    class Wheel {}

    class Battery {
        float storedEnergyWh;
    }

    abstract class Controller {
        ControllerState state;
        Battery battery;
        DriveSystem driveSystem;
    }

    class BasicController extends Controller{
    }

    class AdvancedController extends Controller {
    }

    enum ControllerState {
        On,
        Off,
        Charging;
    }

    association [1] EBike -> Frame [*];
    association [1] EBike -> DriveSystem [*];
    association [1] EBike -> Controller [*];
    association [1] EBike -> Wheel [2];
    association [1] EBike -- Battery [*];
    association [1] DriveSystem -> Motor [*];
    association [1] Controller -- Battery [*];
    association [1] Controller -> DriveSystem [*];

}
