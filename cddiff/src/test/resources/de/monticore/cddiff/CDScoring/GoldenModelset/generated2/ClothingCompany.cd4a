
classdiagram ClothingStore {

class Country {
    String name;
    double vatRate;
    String currency;
    double conversionRateToEuro;
}

class Product {
    String uniqueName;
    String description;
    double netPrice;
}

class Representative {
    String firstName;
    String lastName;
    String socialSecurityNumber;
    String telephoneNumber;
    String emailAddress;
}

class Customer {
    String name;
    String address;
    String telephoneNumber;
    String emailAddress;
}

class Order {
    String orderId;
    int quantity;
    Date orderDate;
    Date deliveryDate;
}

association [1] Country -- (products) Product [*];
association [1] Country -- (representatives) Representative [*];
association [1] Representative -- (customers) Customer [*];
association [1] Representative -- (orders) Order [*];
association [1] Order -- (product) Product [1];
association [1] Order -> (customer) Customer [1];

}
