
classdiagram clothingManagement {

    class Product {
        String uniqueName;
        String description;
        double netPrice;
        Manufacturer manufacturer;
        Country country;
        double grossPrice(); // calculated using VAT rate
    }

    class Manufacturer {
        String name;
        String country;
    }

    class Country {
        String name;
        double vatRate;
        String currency;
        double conversionRateToEuro;
        boolean isProductAvailable(Product product);
    }

    class Representative {
        String firstName;
        String lastName;
        String socialSecurityNumber;
        String telephoneNumber;
        String emailAddress;
        Country country; // Responsible for exactly one country
    }

    class Customer {
        String name;
        String address;
        String telephoneNumber;
        String emailAddress;
        List<Country> countries; // Countries where they resell goods
    }

    class Order {
        String orderId; // unique identifier
        Product product; // refers to exactly one product
        int orderQuantity;
        Date orderDate;
        Date desiredDeliveryDate;
    }

    association [1] Representative -> Country [1]; // Each representative is responsible for exactly one country
    association [*] Customer -> Country [*]; // Customers may operate in multiple countries
    association [1] Order -> Product [1]; // Each order refers to exactly one product
    association [*] Representative -> Order [*]; // Representatives place multiple orders
}
