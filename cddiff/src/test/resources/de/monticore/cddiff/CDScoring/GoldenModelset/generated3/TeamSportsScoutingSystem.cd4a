
// CD4A representation of the Team Sports Scouting System
classdiagram teamSportsScouting {

    class Employee {
        String name;
        String role; // Role can be HeadCoach, Director, or Scout
    }

    class HeadCoach extends Employee {
        void identifyPlayerProfile(PlayerProfile profile);
        void evaluateShortList(List<Player> players);
    }

    class Director extends Employee {
        void makeOffer(Player player);
    }

    class Scout extends Employee {
        void notePlayer(Player player);
        ScoutingReport submitScoutingReport(Player player);
    }

    class PlayerProfile {
        String position; // e.g., GK, LB
        List<Attribute> attributes;
    }

    class Attribute {
        String name;
        String value;
    }

    class Player {
        String name;
        PlayerProfile profile;
    }

    class ScoutingReport {
        List<String> pros;
        List<String> cons;
        Recommendation recommendation; // Recommendation is an enum type
    }

    enum Recommendation {
        KEY_PLAYER,
        FIRST_TEAM_PLAYER,
        RESERVE_TEAM_PLAYER,
        PROSPECTIVE_PLAYER,
        NOT_A_GOOD_SIGNING;
    }

    association [*] Scout -> (notedPlayers) Player [*];
    association [1] HeadCoach -> (designatedProfiles) PlayerProfile [*];
    association [*] HeadCoach -> (shortListedPlayers) Player [*];
    association [*] Scout -> (scoutingReports) ScoutingReport [*];
}
