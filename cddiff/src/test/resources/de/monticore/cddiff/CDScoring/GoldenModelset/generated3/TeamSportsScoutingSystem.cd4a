
classdiagram TeamSportsScoutingSystem {
    class Employee {
        String name;
    }

    class HeadCoach extends Employee {
        void identifyPlayerProfile();
    }

    class Director extends Employee {
        void makeOffer();
    }

    class Scout extends Employee {
        void notePlayer();
        void submitScoutingReport();
    }

    class PlayerProfile {
        String targetPosition;
        Attribute[] attributes;
    }

    class Attribute {
        String name;
        String value;
    }

    class LongList {
        PlayerProfile[] players;
    }

    class ScoutingAssignment {
        void evaluateLongList();
        void setupShortList();
    }

    class ScoutingReport {
        String pros;
        String cons;
        String recommendation; // e.g., key player, first team player, etc.
    }

    class ShortList {
        PlayerProfile[] players;
    }

    association [1] HeadCoach -> (targetProfile) PlayerProfile [*];
    association [*] Scout -> (notedPlayers) LongList [*];
    association [1] Scout -> (scoutingReport) ScoutingReport [*];
    association [1] ScoutingAssignment -> (evaluatedLongList) LongList [1];
    association [1] ScoutingAssignment -> (shortList) ShortList [1];
    association [1] Director -> (officialOffer) PlayerProfile [1];
}
