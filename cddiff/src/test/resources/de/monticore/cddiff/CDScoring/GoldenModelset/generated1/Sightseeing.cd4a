
classdiagram City {

class Attraction {
    String name;
    String address;
}

class GuidedTour {
    int duration;
    int numberOfVisitors;
    double discountAmount; // applicable for certain visitors
}

class Visitor {
    String name;
}

class Guide {
    String name;
}

class City {
    String name;
    int inhabitants;
}


association [*] City -> Attraction [*];
association [*] Attraction -> GuidedTour [*];
association [*] GuidedTour -> Guide [1];
association [*] GuidedTour <-> Visitor [0..20];

}
