
// CD4A class diagram for cities and attractions

classdiagram cityAttraction {

    class City {
        String name;
        int inhabitants;
    }

    class Attraction {
        String name;
        String address;
    }

    class GuidedTour {
        int duration; // duration in minutes
        int number; // number of visitors
        double discount; // amount of discount for certain visitors
    }

    class Visitor {
        String name;
    }

    class Guide {
        String name;
    }

    // Associations
    association [*] City -> (attractions) Attraction [*];
    association [*] Attraction -> (tours) GuidedTour [*];
    association [*] GuidedTour -> (visitors) Visitor [0..20]; // Max 20 visitors
    association [1] GuidedTour -> (guide) Guide [1]; // Each guided tour has one guide
}
