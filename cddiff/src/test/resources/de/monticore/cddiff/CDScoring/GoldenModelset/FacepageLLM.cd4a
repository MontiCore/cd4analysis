classdiagram FacepageLLM {

  class User {
    String id;
    String name;
    String email;
    Date dateOfBirth;
  }

  class Account {
    String accountNumber;
  }

  class BusinessAccount extends Account {
    String companyName;
    double monthlyFee;
  }

  class PersonalAccount extends Account {}

  class Page {
    String name;
    int numberOfVisits;
  }

  class AdvertisementPage extends Page {
    double bounceRate;
    double clickThroughRate;
    double conversionRate;
  }

  // Each User has exactly one Account
  association [1] User -> (account) Account [1];

  // Each Account can have several Pages, each Page belongs to exactly one Account
  association [1] Account -> (pages) Page [*];

  // Personal accounts can have privileges on other personal pages
  association privileges [*] PersonalAccount -> (privilegedPages) Page [*];

  // Only PersonalAccounts can send and receive friend requests
  association friendRequests [*] PersonalAccount <-> (friends) PersonalAccount [*];
}
