classdiagram facepage {

class User {
    String userId; // unique
    String name;
    String email;
    Date dateOfBirth;
}

class Account {
    String accountNumber; // unique
    String accountType; // BUSINESS or PERSONAL
}

class BusinessAccount extends Account {
    String companyName;
    double monthlyFee;
}

class PersonalAccount extends Account {
    boolean canSendFriendRequest;
}

class Page {
    String pageName; // unique per account
    int numberOfVisits;
}

class AdvertisementPage extends Page {
    double bounceRate;
    double clickThroughRate;
    double conversionRate;
}

// Associations
association [1] User -> (owns) Account [1];
association [1] Account -> (administers) Page [*];
association [*] PersonalAccount -> (hasPrivilegesOver) Page [*]; // For pages belonging to other PersonalAccounts
association [0..*] BusinessAccount -> AdvertisementPage [*]; // Only BusinessAccount can create AdvertisementPages

// Notes
// - A User cannot have more than one Account (Personal or Business).
// - Personal Accounts can send and receive friend requests, but Business Accounts cannot.
}
