
classdiagram School {

class School {
    String name;
}

class Person {
    String firstName;
    String lastName;
}

class Teacher extends Person {
    String email;
}

class Student extends Person {
    // No additional attributes
}

class Classroom {
    String name;
    int capacity;
}

class OtherRoom {
    String name;
    int sizeInSquareMeters;
}

class ClassGroup {
    String groupName;
}

association [1] Teacher <-> (principalOf) School [0..1];
association [*] Teacher <-> (teachesAt) School [0..3];
association [*] Student <-> (attends) School [1];
association [10..31] Student <-> (members) ClassGroup [*];
association [1] ClassGroup <-> (assignedTo) Classroom [1];
association [1] Classroom <-> (assignedTo) ClassGroup [1];
}
