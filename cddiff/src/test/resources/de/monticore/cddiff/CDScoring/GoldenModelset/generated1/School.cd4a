
classdiagram school {

    class School {
        String name;
        Teacher principal;
    }

    class Teacher {
        String firstName;
        String lastName;
        String email;
    }

    class Student {
        String firstName;
        String lastName;
    }

    class Room {
        String name;
    }

    class Classroom extends Room {
        int capacity;
    }

    class OtherRoom extends Room {
        int sizeInSquareMeters;
    }

    class ClassGroup {
        String name;
    }

    association [1] Classroom <-> ClassGroup [1];
    association [10..31] ClassGroup -> (studentGroup) Student [*];
    association [1] ClassGroup -> (assignedTo) Classroom [1];
    association [1] Student -> (attends) School [1];
    association [1] Student -> (inClass) ClassGroup [1];
    association [0..3] Teacher -> (teachesAt) School [1];
    association [1] School -> (principal) Teacher [1];
}
