
classdiagram UniversityStructure {

class University {
    int totalNumberOfEmployees;
}

class Faculty {
    String name;
}

class Institute {
    String name;
    String address;
}

class Employee {
    String socialSecurityNumber;
    String name;
    String email;
}

class ResearchAssistant extends Employee {
    String fieldOfResearch;
}

class Project {
    String name;
    Date startDate;
    Date endDate;
}

class Course {
    int id;
    String name;
    int weeklyDuration;
}

class Lecturer extends ResearchAssistant {}

association [1] University <-> Faculty [*];
association [1] Faculty <-> Institute [*];
association [1] Faculty <-> Employee [1];
association [1] Institute <-> ResearchAssistant [*];
association [*] ResearchAssistant <-> Project [*];
association [*] ResearchAssistant <-> Course [*];
}
