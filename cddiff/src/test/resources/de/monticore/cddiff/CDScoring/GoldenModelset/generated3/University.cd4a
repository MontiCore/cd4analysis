
// CD4A Class Diagram for a University Structure

classdiagram university {

    class University {
        String name;
        List<Faculty> faculties;
        int totalEmployees;
    }

    class Faculty {
        String name;
        Dean dean; // Association to Dean
        List<Institute> institutes;
    }

    class Institute {
        String name;
        String address;
    }

    class Employee {
        String socialSecurityNumber;
        String name;
        String email;
    }

    class ResearchStaff extends Employee {
        // Research Staff specific properties can be defined here
    }

    class AdministrativeStaff extends Employee {
        // Administrative Staff specific properties can be defined here
    }

    class ResearchAssistant extends ResearchStaff {
        String fieldOfResearch;
        List<Institute> institutes; // Association to at least one Institute
        List<Project> projects; // Association to projects
        List<Course> courses; // Association to courses
    }

    class Dean extends AdministrativeStaff {
        // Dean specific properties can be defined here
    }

    class Project {
        String name;
        Date startDate;
        Date endDate;
        int hoursAssigned; // Total hours assigned to the RA
    }

    class Course {
        String id; // Unique number
        String name;
        int weeklyDuration; // Duration in hours
    }

    // Associations
    association [*] University -> Faculty [*];
    association [*] Faculty -> Institute [*];
    association [1] Faculty -> Dean [1];
    association [*] ResearchAssistant -> Institute [*]; // RAs associated with institutes
    association [*] ResearchAssistant -> Project [*]; // RAs involved in projects
    association [*] ResearchAssistant -> Course [*]; // RAs teach courses
}
