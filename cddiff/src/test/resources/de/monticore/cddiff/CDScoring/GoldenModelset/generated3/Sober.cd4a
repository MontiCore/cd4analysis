
classdiagram SoberTaxi {

class TaxiCompany {}

class SelfDrivingCab {}

class Customer {}

class RideHailService {
    DateTime pickUpTime;
    DateTime dropOffTime;
    String pickUpLocation;
    String dropOffLocation;
    Duration rideDuration;
    double distance;
    int numberOfPassengers;
    double fee;
    String requestType; // Sober App or hand-waving
    String leadCustomerName;
}

class RideShareService {
    DateTime pickUpTime;
    DateTime dropOffTime;
    String pickUpLocation;
    String dropOffLocation;
    Duration rideDuration;
    double distance;
    int numberOfPassengers;
    double negotiatedFee;
    List<String> customerNames;
}

class CarOwner {}

class Accident {
    Date accidentDate;
    String location;
    double damageAmount;
}


association [1] TaxiCompany <-> SelfDrivingCab [0..*];
association [1] TaxiCompany <-> CarOwner [0..*];
association [0..*] RideHailService <-> Customer [1..6];
association [0..*] RideShareService <-> Customer [1..10];
association [1] SelfDrivingCab <-> Accident [0..*];

}
