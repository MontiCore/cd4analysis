
// Class diagram for the Sober Taxi Company
classdiagram SoberTaxi {

class SoberApp {
    // Information related to the app can be added here
}

enum ServiceType {
    RIDE_HAILING,
    RIDE_SHARING;
}

class TaxiService {
    ServiceType type;
}

class RideHailing extends TaxiService {
    Date pickupTime;
    Date dropoffTime;
    String pickupLocation;
    String dropoffLocation;
    Duration rideDuration;
    double distance;
    int numberOfPassengers;
    double fee;
    String requestType; // "App" or "Hand-waving"
    String leadCustomerName;
}

class RideSharing extends TaxiService {
    Date pickupTime;
    Date dropoffTime;
    String pickupLocation;
    String dropoffLocation;
    Duration rideDuration;
    double distance;
    List<String> customerNames;
    double negotiatedFee;
}

class Car {
    String ownerName;
    String licensePlate;
}

class Accident {
    Date accidentDate;
    String location;
    double damageAmount;
}

class SelfDrivingCab extends Car {}

class RegisteredCab extends Car {}

// Associations
association [1] SoberApp <-> TaxiService [0..*];
association [1] TaxiService <-> RideHailing [0..*];
association [1] TaxiService <-> RideSharing [0..*];
association [1] Car <-> Accident [0..*];
association [1] RegisteredCab <-> Car [0..1]; // Registered cab is a type of Car
association [1] SelfDrivingCab <-> Car [0..1]; // Self-driving cab is a type of Car

}
