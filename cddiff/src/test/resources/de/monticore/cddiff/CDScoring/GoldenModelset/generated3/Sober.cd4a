
// CD4A model for Sober's taxi service

classdiagram soberTaxi {

    class Sober {
        List<SoberCab> fleet;
        List<CarOwner> carOwners;
        void requestRideHail(RideHailRequest request);
        void requestRideShare(RideShareRequest request);
    }

    class SoberCab {
        String id;
        CarOwner owner; // Optional as it's a fleet car
        void recordAccident(Date date, String location, double damageAmount);
    }

    class CarOwner {
        String name;
        String contactInfo;
        List<SoberCab> registeredCabs;
    }

    class RideHailRequest {
        Date pickUpTime;
        Date dropOffTime;
        String pickUpLocation;
        String dropOffLocation;
        double rideDuration;
        double distance;
        int numberOfPassengers;
        double fee;
        String requestType; // "App" or "Hand-waving"
        String leadCustomerName;
    }

    class RideShareRequest {
        Date pickUpTime;
        Date dropOffTime;
        String pickUpLocation;
        String dropOffLocation;
        double rideDuration;
        double distance;
        List<String> customerNames;
        double negotiatedFee; // Flexible pricing
    }

    association [*] SoberCab -> CarOwner [0..1];
    association [*] Sober -> SoberCab [*];
    association [*] Sober -> CarOwner [*];
    association [*] SoberCab -> Accident [*];

    class Accident {
        Date date;
        String location;
        double damageAmount;
    }

}
