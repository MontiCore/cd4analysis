
// CD4A Class Diagram for the scientific research database system described

classdiagram researchDatabase {

    class Person {
        String personID; // Unique identifier for a person
        String phoneNumber;
        List<String> keywords; // Keywords identifying research topics
        Institution institution; // Reference to the institution the person works for
        Article authoredArticle; // Reference to the article authored by this person
        Article reviewedArticle; // Reference to the article reviewed by this person
    }

    class Institution {
        String institutionCode; // Unique identifier for an institution
        List<Article> technicalReports; // List of technical reports published by this institution
    }

    abstract class Article {
        String DOI; // Unique identifier for the article
        String title; // Title of the article
        List<Person> authors; // List of authors for the article
        List<Integer> authorPositions; // Positions of each author in the list
    }

    class PeerReviewedPaper extends Article {
        int citationCount; // Number of citations for the paper
        Person reviewer; // Reference to the reviewer of the paper
        Journal publishedIn; // Reference to the journal where the paper is published
    }

    class TechnicalReport extends Article {
        Institution publishedBy; // Reference to the institution that publishes the report
    }

    class Publisher {
        String name; // Name of the publisher
        List<Journal> journals; // List of journals published by the publisher
    }

    class Journal {
        String name; // Name of the journal
        double impactFactor; // Impact factor of the journal
        Publisher publisher; // Reference to the publisher of this journal
    }

    // Associations to represent relationships
    association [1] Person -> Institution [1]; // A person works for one institution
    association [1] Person -> Article [1]; // A person can author one article
    association [1] Person -> Article [1]; // A person can review one article
    association [*] Institution -> Article [*]; // An institution can publish multiple technical reports
    association [1] PeerReviewedPaper -> Journal [1]; // A peer-reviewed paper is published in one journal
    association [1] Publisher -> Journal [*]; // A publisher can publish multiple journals
}
