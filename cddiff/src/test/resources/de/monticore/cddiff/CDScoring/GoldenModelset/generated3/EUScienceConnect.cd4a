
classdiagram ScienceConnect {

    class Person {
        String personID;
        String phoneNumber;
        List<String> keywords;
        Institution institution;
    }

    class Institution {
        String institutionCode;
    }

    class Article {
        String DOI;
        String title;
        List<Author> authors;
    }

    class PeerReviewedPaper extends Article {
        int citationCount;
        Reviewer reviewer;
    }

    class TechnicalReport extends Article {
        Institution institution;
    }

    class Publisher {
        String name;
        List<Journal> journals;
    }

    class Journal {
        String name;
        float impactFactor;
    }

    class Author {
        int position;
    }

    class Reviewer {}

    association [1] Person -> (institution) Institution [1];
    association [1] Article -> (authors) Author [*];
    association [1] PeerReviewedPaper -> (reviewer) Reviewer [1];
    association [1] TechnicalReport -> (institution) Institution [1];
    association [1] Publisher -> (journals) Journal [*];
    association [1] Journal -> (papers) PeerReviewedPaper [*];

}
