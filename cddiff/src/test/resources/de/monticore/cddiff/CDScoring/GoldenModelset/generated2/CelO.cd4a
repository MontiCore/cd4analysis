
// Celebrations Organization System Class Diagram
classdiagram celO {

    class Organizer {
        String firstName;
        String lastName;
        String email; // also serves as username
        String postalAddress;
        String phoneNumber;
        String password;
        void inviteAttendee(Attendee attendee);
        void viewInvitationStatus(Event event);
        void addTask(Task task);
        void indicateTaskStatus(Task task, TaskStatus status);
        void createEvent(Event event);
    }

    class Attendee {
        String firstName;
        String lastName;
        String email; // serves as username
        String password;
        void confirmAttendance(Event event);
        void indicateTask(Task task);
    }

    class Event {
        String occasion;
        Location location;
        DateTime startDateTime;
        DateTime endDateTime;
        List<Organizer> organizers;
        List<Attendee> attendees;
        List<Task> tasks;
        void addOrganizer(Organizer organizer);
        void addAttendee(Attendee attendee);
        void createChecklist();
    }

    class Location {
        String name;
        String address;
    }

    class Task {
        String description;
        TaskStatus status; // e.g., needs to be done, has been done, not applicable
    }

    enum TaskStatus {
        NEEDS_TO_BE_DONE,
        HAS_BEEN_DONE,
        NOT_APPLICABLE;
    }

    association [1..*] Organizer -> Event [1];
    association [*] Event <-> Attendee [0..*];
    association [*] Event <-> Task [0..*];
}
