
// Celebrations Organization System class diagram
classdiagram CelebrationsOrganizationSystem {

    class Organizer {
        String firstName;
        String lastName;
        String email; // used as username
        String postalAddress;
        String phoneNumber;
        String password;
    }

    class Event {
        DateTime startDateTime;
        DateTime endDateTime;
        String occasion;
    }

    class Location {
        String name;
        String address;
    }

    class Attendee {
        String firstName;
        String lastName;
        String email; // used as username
        // Password only if creating an account
    }

    class Invitation {
        String status; // e.g., attending, maybe attending, cannot attend
    }

    class Task {
        String description;
        String status; // e.g., needs to be done, done, not applicable
    }

    association [1] Organizer -> Event [*]; // One organizer can manage multiple events
    association [1] Event -> Location [1]; // Each event has one location
    association [*] Event -> Attendee [*]; // Many attendees can attend an event
    association [1] Attendee -> Invitation [1]; // Each attendee has one invitation
    association [*] Event -> Task [*]; // Each event can have multiple tasks
    association [1] Organizer -> Task [*]; // Organizer can add tasks for events
    association [*] Task -> Attendee [*]; // Attendees can be assigned tasks for events

}
