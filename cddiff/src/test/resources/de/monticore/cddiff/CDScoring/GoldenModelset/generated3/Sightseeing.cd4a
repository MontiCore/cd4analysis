
// CD4A class diagram for City Attractions
classdiagram CityAttractions {

class City {
    String name;
    int inhabitants;
}

class Attraction {
    String name;
    String address;
}

class GuidedTour {
    int duration; // in minutes
    int number; // tour number
    double discount; // discount amount for certain visitors
    boolean hasDiscountFor(Visitor visitor); // method to check if a visitor has a discount
}

class Visitor {
    String name;
}

class Guide {
    String name;
}

// Association between entities
association [1..*] City <-> Attraction [0..*];
association [1] Attraction <-> GuidedTour [0..*];
association [1..20] GuidedTour <-> Visitor [0..*]; // maximum 20 visitors per guided tour
association [1] GuidedTour <-> Guide [1];

}
