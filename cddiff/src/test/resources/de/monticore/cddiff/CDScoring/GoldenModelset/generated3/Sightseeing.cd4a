
classdiagram cityAttractions {

    class City {
        String name;
        int inhabitants;
    }

    class Attraction {
        String name;
        String address;
    }

    class GuidedTour {
        int duration; // duration in minutes
        int number;   // tour number
        double discountAmount; // discount amount for certain visitors
    }

    class Visitor {
        String name;
        boolean isDiscounted; // indicates if the visitor is eligible for a discount
    }

    class Guide {
        String name;
    }

    association [*] City -> (attractions) Attraction [*];
    association [*] Attraction -> (tours) GuidedTour [*];
    association [*] GuidedTour -> (visitors) Visitor [0..20]; // max of 20 visitors
    association [1] GuidedTour -> (guide) Guide [1]; // each guided tour has one guide
}
