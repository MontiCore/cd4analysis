
classdiagram City {

class Attraction {
    String name;
    String address;
}

class GuidedTour {
    int duration;
    int numberOfVisitors;
    double discountAmount;
}

class Visitor {
    String name;
}

class Guide {
    String name;
}

class City {
    String name;
    int inhabitants;
}

association [*] City -> Attraction [*];
association [*] Attraction -> GuidedTour [*];
association [0..*] GuidedTour -> Guide [1];
association [0..20] GuidedTour <-> Visitor [*];

}
