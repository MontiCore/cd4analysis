
// CD4A Class Diagram for the European Union Cross-National Research Database

classdiagram ScienceConnectDatabase {

    class Person {
        String personID; // Unique identifier for each person
        String phoneNumber;
        String keywords; // Keywords for research topics
        Institution institution; // Reference to the institution the person works for
    }

    class Institution {
        String institutionCode; // Unique identifier for each institution
    }

    class ScientificArticle {
        String DOI; // Unique identifier for each article
        String title;
        List<AuthorPosition> authors; // List of authors with positions
    }

    class AuthorPosition {
        Person author; // The author of the article
        int position; // Position of the author in the list
    }

    class PeerReviewedPaper extends ScientificArticle {
        int citationCount; // Number of citations
        Person reviewer; // Reference to the reviewer
    }

    class TechnicalReport extends ScientificArticle {
        Institution publishedBy; // Reference to the institution that published the report
    }

    class Publisher {
        String name; // Name of the publisher
    }

    class Journal {
        String name; // Name of the journal
        float impactFactor; // Impact factor of the journal
    }

    association [1] Institution <-> (publishes) TechnicalReport [0..*]; 
    association [1] Institution <-> (employs) Person [0..*];
    association [1] Person -- (authored) ScientificArticle [0..1]; 
    association [1] Person <-> (reviewed) ScientificArticle [0..1];
    association [1] Publisher -- Journal [1..*]; 
    association [1] Journal <-> (publishes) PeerReviewedPaper [0..*];
}
