
// CD4A Class Diagram for EU Cross-National Research Database

classdiagram researchDatabase {

    class Person {
        String personID; // uniquely identifies a person
        String phoneNumber;
        List<String> keywords; // identifies research topics
        Institution institution; // works for

        Article authoredArticle; // author of an article
        Review reviewedArticle; // reviewer of a peer-reviewed article
    }

    class Institution {
        String institutionCode; // uniquely identifies an institution
        List<TechnicalReport> technicalReports; // publishes multiple technical reports
    }

    class Article {
        String DOI; // uniquely identifies a scientific article
        String title;
        List<AuthorPosition> authors; // stores authors with their positions
    }

    class PeerReviewedPaper extends Article {
        int citationCount; // citation count for peer-reviewed papers
        Review reviewer; // who reviewed the paper
    }

    class TechnicalReport extends Article {
        Institution publishedBy; // published by a single research institution
    }

    class Publisher {
        String name; // uniquely identifies a publisher
        List<Journal> journals; // can publish multiple journals
    }

    class Journal {
        String name; // journal name
        double impactFactor; // measures scientific impact
    }

    association [*] Person -> (worksFor) Institution [*];
    association [*] Institution -> (publishes) TechnicalReport [*];
    association [*] Article -> (has) AuthorPosition [*];
    association [1] PeerReviewedPaper -> (reviewedBy) Review [1];
    association [*] Publisher -> (publishes) Journal [*];
    association [*] Journal -> (publishedIn) PeerReviewedPaper [*];
}
