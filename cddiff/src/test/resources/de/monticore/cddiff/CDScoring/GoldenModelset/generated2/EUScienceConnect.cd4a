
classdiagram ScienceConnect {

    class Person {
        String personID;
        String phoneNumber;
        List<String> researchKeywords;
        Institution institution;
    }

    class Institution {
        String institutionCode;
        List<TechnicalReport> technicalReports;
    }

    class ScientificArticle {
        String DOI;
        String title;
        List<AuthorPosition> authors;
    }

    class PeerReviewedPaper extends ScientificArticle {
        int citationCount;
        Reviewer reviewer;
        Journal journal;
    }

    class TechnicalReport extends ScientificArticle {
        Institution publishedBy;
    }

    class AuthorPosition {
        Person author;
        int position;
    }

    class Reviewer {
        Person person;
    }

    class Publisher {
        String name;
        List<Journal> journals;
    }

    class Journal {
        String name;
        float impactFactor;
    }

    association [1] Person -> (institution) Institution [1];
    association [1] ScientificArticle -> (authors) AuthorPosition [*];
    association [1] PeerReviewedPaper -> (journal) Journal [1];
    association [1] Institution -> (technicalReports) TechnicalReport [*];
    association [1] Publisher -> (journals) Journal [*];
    
    association [1] PeerReviewedPaper -> (reviewer) Reviewer [1];

}
