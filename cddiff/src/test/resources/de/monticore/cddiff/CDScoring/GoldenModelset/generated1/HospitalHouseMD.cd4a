
// Class diagram for HospitalHouseMD
classdiagram HospitalHouseMD {

    class Patient {
        boolean consentGiven; // Indicates if the patient has signed consent
    }

    class Doctor {
        String name; // Name of the doctor
    }

    class HeadDoctor extends Doctor {
        // Specialization for head doctor, if needed
    }

    class Treatment {
        int stage; // Current stage of the treatment
    }

    class Illness {
        String name;
        PriorityScore priorityScore; // The priority score of the illness
    }

    enum PriorityScore {
        HIGH,
        LOW;
    }

    association [1..*] Patient -> (assignedTo) Doctor [*]; // Patients assigned to one or more doctors
    association [1] Doctor -> (approvedBy) HeadDoctor [*]; // Doctor's diagnosis approved by head doctor
    association [1] Illness -> (managedBy) Treatment [*]; // Illness can have one or more treatments
    association [0..*] Treatment -> (appliesTo) Patient [*]; // Treatments applied to patients
    
    // Upgrading treatment stages based on consent
    association [1..*] Treatment -> (requiresConsent) Patient [0..1]; // Upgrades require patient consent

}
