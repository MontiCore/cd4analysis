
classdiagram HospitalHouseMD {

class Patient {
  String name;
  String consentStatus;
}

class Doctor {
  String name;
}

class Diagnosis {
  String description;
}

class Treatment {
  String name;
  int stage;
}

class Illness {
  String name;
  String priorityScore;
}

class Nurse {
  String name;
}

class ConsentForm {
  boolean signed;
}

association [1..*] Patient <-> (assigned) Doctor [1..*];
association [1] Doctor <-> (makes) Diagnosis [1];
association [1] Diagnosis <-> (has) Treatment [0..*];
association [1] Illness <-> (causes) Treatment [0..*];
association [1..*] Treatment <-> (appliedFor) Illness [1];
association [1..*] Patient <-> (requires) Nurse [1..*];

}
