
// Class Diagram for HospitalHouseMD system

classdiagram hospital {
    
    class HospitalHouseMD {
        List<Patient> patients;
        List<Doctor> doctors;
        Database database; // Holds treatments for illnesses
        void approveDiagnosis(Doctor doctor, Diagnosis diagnosis);
    }

    class Patient {
        String name;
        boolean consentGiven; // Indicates if patient has signed consent
        void signConsent();
        void retractConsent();
    }

    class Doctor {
        String name;
        void makeDiagnosis(Patient patient, Illness illness);
        void downgradeTreatment(Treatment treatment);
    }

    class Diagnosis {
        Illness illness;
        Doctor doctor;
        // Additional attributes can be added as necessary
    }

    class Treatment {
        Stage stage;
        void apply(Patient patient);
        void upgradeStage(); // Upgrades treatment to a higher stage
        void downgradeStage(); // Downgrades treatment to a lower stage
    }

    enum Stage {
        STAGE_1,
        STAGE_2,
        STAGE_3;
    }

    class Illness {
        String name;
        PriorityScore priorityScore;
        List<Treatment> treatments; // Applied treatments for this illness
        void updatePriorityScore(PriorityScore newScore); // Updates priority score
    }

    enum PriorityScore {
        HIGH,
        LOW;
    }

    association [*] HospitalHouseMD -> (patients) Patient [*]; // Hospital has many Patients
    association [*] HospitalHouseMD -> (doctors) Doctor [*]; // Hospital has many Doctors
    association [*] Patient -> (diagnosis) Diagnosis [*]; // A Patient can have multiple Diagnoses
    association [*] Diagnosis -> (illness) Illness [1]; // Diagnosis is for one Illness
    association [*] Illness -> (treatments) Treatment [*]; // An Illness can have multiple Treatments
}

