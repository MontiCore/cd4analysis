
classdiagram EBike {

class EBike {
    Frame frame;
    DriveSystem driveSystem;
    Controller controller;
    Battery battery;
}

class Frame {
    String material;
}

class DriveSystem {
    Motor motor;
}

class Motor {
    // motor properties
}

class Battery {
    double storedEnergy; // in Watt-hours (Wh)
}

class Controller {
    State state;
}

enum State {
        On,
        Off,
        Charging;
    }

class BasicController extends Controller {
    // class body
}

class AdvancedController extends Controller {
    Date estimateNextInspectionDate();
}

association [1] EBike <-> (has) Frame [1];
association [1] EBike <-> (has) DriveSystem [1];
association [1] EBike <-> (has) Controller [1];
association [0..1] EBike <-> (has) Battery [1];

}
