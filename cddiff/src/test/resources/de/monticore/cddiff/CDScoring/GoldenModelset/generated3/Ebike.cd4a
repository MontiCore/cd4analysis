
// Class diagram for the EBike system
classdiagram EBikeSystem {

class EBike {
    Frame frame;
    DriveSystem driveSystem;
    Controller controller;
    Battery battery;
}

class Frame {
    String material; // "steel"
}

class DriveSystem {
    Motor motor;
}

class Motor {}

class Battery {
    double storedEnergy; // in Watt-hours (Wh)
}

enum ControllerState {
    On,
    Off,
    Charging;
}

// Base class for controllers
abstract class Controller {
    ControllerState state;
}

// Basic Controller class
class BasicController extends Controller {}

// Advanced Controller class with additional functionality
class AdvancedController extends Controller {
    Date estimateNextInspectionDate();
}

association [1] EBike -- Frame [1];
association [1] EBike -- DriveSystem [1];
association [1] EBike -- Controller [1];
association [0..1] EBike -- Battery [1];

}
