
classdiagram DestroyBlock {

class User {
    String username;
    String password;
}

class Player extends User {}

class Admin extends User {}

class Game {
    String name;
    HallOfFame hallOfFame;
    int maxLevels;
    int minSpeed;
    int speedIncreaseFactor;
    int maxPaddleLength;
    int minPaddleLength;
}

class Level {
    int levelNumber;
    boolean isRandom;
    int numberOfBlocks;
    Block[][] blockArrangement;
}

class Block {
    String color;
    int points; // between 1 and 1000
}

class HallOfFame {
    List<Player> players; // holds players with high scores
}

class Ball {
    int speed;
    String direction;
}

class Paddle {
    int length;
}

association [1] Game <-> Admin [1];
association [1] Game <-> Level [*];
association [1] Game <-> Player [*];
association [*] Level <-> Block [*];

}
