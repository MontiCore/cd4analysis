
// CD4A Class Diagram for Web Portal Structure

classdiagram webPortal {

    class WebPortal {
        String versionNumber;
        String url;
        List<Building> catalog;
    }

    class Building {
        String uniqueID;
        String name;
        EnergyClass energyClass; // Enum for energy class
        String address;
        int yearOfConstruction;
        User owner;
        List<Entry> additionalEntries;
        List<Image> images;
        Image profilePhoto;
    }

    enum EnergyClass {
        A,
        B,
        C,
        D;
    }

    class Entry {
        String name;
        String textValue; // Can be null if it's a number
        Float numberValue; // Can be null if it's text
        String unit; // Freely definable text, can be null
        boolean isPublic; // Indicates if the entry is released publicly
    }

    class Image {
        String fileName;
    }

    class User {
        String uniqueUserName;
        String emailAddress;
        String password;
        boolean isActive; // Indicates if the user account is activated
        List<Building> buildings;
        List<Comment> comments;
    }

    class Administrator extends User {
        String idCardNumber;
        void setupUserAccount(User user);
        void deleteComment(Comment comment);
    }

    class Comment {
        User user;
        Building building;
        String content;
    }

    association [1] WebPortal -> (catalog) Building [*];
    association [1] Building -> (owner) User [1];
    association [1] User -> (buildings) Building [*];
    association [*] Building -> (additionalEntries) Entry [*];
    association [1] Building -> (images) Image [*];
    association [1] User <-> (comments) Comment [*];
    association [1] User <-> (buildingComments) Comment [*];
}
