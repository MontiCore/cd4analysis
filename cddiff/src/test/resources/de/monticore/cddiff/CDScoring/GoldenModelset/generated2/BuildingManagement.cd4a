
classdiagram WebPortal {

enum EnergyClass {
    A,
    B,
    C,
    D;
}

class Building {
    String uniqueID;
    String name;
    EnergyClass energyClass;
    String address;
    int yearOfConstruction;
}

class AdditionalEntry {
    String name;
    String type; // "text" or "numberWithUnit"
}

class Image {
    String fileName;
}

class User {
    String userName;
    String email;
    String password;
}

class Visitor extends User {}

class Administrator extends User {
    String idCardNumber;
}

class Comment {
    String content;
}

association [1] Building <-> User [1]; // Owner-Builder association
association [*] Building <-> AdditionalEntry [*];
association [*] Building <-> Image [1]; // Profile photo is one of the images
association [*] User <-> Comment [0..*]; // Users can comment on buildings
association [*] Visitor <-> User [0..1]; // Visitors can register as users
}
