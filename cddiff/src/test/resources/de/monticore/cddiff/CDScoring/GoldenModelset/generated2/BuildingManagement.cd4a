
classdiagram WebPortal {

enum EnergyClass {
    A,
    B,
    C,
    D;
}

class User {
    String username;
    String emailAddress;
    String password;
}

class Visitor extends User {}

class Administrator extends User {
    String idCardNumber; // Admin-specific attribute
}

class WebPortal {
    String versionNumber;
    String urlAddress;
}

class Building {
    String uniqueID;
    String name;
    EnergyClass energyClass;
    String address;
    int yearOfConstruction;
    User owner; // reference to User as the owner
}

class AdditionalEntry {
    String name;
    Object value; // can be either textual information or a floating-point number
    String unit; // freely definable text for additional unit
    boolean isReleasedPublicly; // indicates if entry is released publicly
}

class Image {
    String fileName;
    boolean isProfilePhoto; // indicates if this is the profile photo
}

class Comment {
    String content; // text of the comment
    User commenter; // reference to the user who commented
}

class Search {
    // method to perform full-text search for buildings
}

association [1] WebPortal <-> Building [*];
association [1] Building <-> AdditionalEntry [*];
association [1] Building <-> Image [*];
association [1] User <-> Building [0..*]; // a user can own multiple buildings
association [1] User <-> Comment [*]; // a user can make multiple comments
association [1] Building <-> Comment [*]; // a building can have multiple comments
association [1] Administrator <-> User [*]; // Admin manages users

}
