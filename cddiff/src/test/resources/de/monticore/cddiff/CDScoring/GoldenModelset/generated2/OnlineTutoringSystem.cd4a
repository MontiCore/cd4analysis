
// Class diagram for an Online Tutoring System (OTS)
classdiagram ots {

    class Person {
        String name;
        String email;
    }
    
    class Tutor extends Person {
        String bankAccount;
        List<SubjectTutoring> offeredTutoring;
        List<Availability> weeklyAvailability;
        void offerTutoring(SubjectTutoring tutoring);
        void confirmSession(TutoringSession session);
        void cancelSession(TutoringSession session);
        void awardDiscount(Student student);
    }

    class Student extends Person {
        void browseTutoringOffers(String subject);
        void makeRequest(TutoringSessionRequest request);
    }

    class SubjectTutoring {
        String subject;
        String expertiseLevel; // e.g., primary, high school, university
        double hourlyPrice;
    }

    class Availability {
        String day; // e.g., Thursday
        String startTime; // e.g., 10:00
        String endTime; // e.g., 11:30
    }

    class TutoringSession {
        Tutor tutor;
        Student student;
        String date; // date of the session
        String time; // time of the session
        void scheduleFollowUp();
        void cancelSession();
        double getPrice();
    }

    class TutoringSessionRequest {
        Tutor tutor;
        String subject;
        String preferredDateTime; // the date and time suggested for the session
        String level; // level of tutoring requested
    }

    association [*] Tutor -> (offers) SubjectTutoring [*];
    association [*] Tutor -> (has) Availability [*];
    association [*] Student -> (makes) TutoringSessionRequest [*];
    association [*] TutoringSessionRequest -> (requests) TutoringSession [1];
    association [1] TutoringSession <- (isFor) Student [1];
    association [1] TutoringSession <- (isConductedBy) Tutor [1];
}
