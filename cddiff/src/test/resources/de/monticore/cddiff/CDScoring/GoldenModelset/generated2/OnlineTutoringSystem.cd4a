
classdiagram OTS {
    class Tutor {
        String name;
        String email;
        String bankAccount;
        Availability availability;
    }

    class Student {
        String name;
        String email;
    }

    class TutoringOffer {
        String subject;
        String levelOfExpertise;
        float hourlyPrice;
    }

    class TutoringRequest {
        Date targetDateTime;
        String levelOfTutoring;
    }

    class TutoringSession {
        Date dateTime;
        boolean cancelled;
        float price;
    }

    class Payment {
        String method; // e.g., credit card or wire transfer
        float amount;
    }

    class Award {
        String subject;
        Tutor bestTutor;
    }

    class Availability {
        String details; // e.g., "Thursdays from 10:00 to 11:30"
    }

    association [0..*] Tutor <-> TutoringOffer [0..*];
    association [0..*] Student <-> TutoringRequest [0..*];
    association [1..1] TutoringOffer <-> TutoringSession [0..*];
    association [1..1] TutoringSession <-> Payment [1..1];
    association [1..1] Tutor <-> Award [0..*];
}
