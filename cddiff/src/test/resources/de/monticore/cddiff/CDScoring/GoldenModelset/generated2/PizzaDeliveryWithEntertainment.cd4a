
classdiagram PizzaDeliveryWithEntertainment {

enum DayOfWeek {
    Monday,
    Tuesday,
    Wednesday,
    Thursday,
    Friday,
    Saturday,
    Sunday;
}

class User {
    String userId;
    String name;
    Date birthday;
    String address;
}

class BusinessOwner extends User {
    String linkedInAccount;
}

class PizzaRestaurant {
    String zipCode;
    String address;
    String phoneNumber;
    String website;
    String openingHours;
}

class Pizza {
    String name;
    String crustStructure;
    double price;
}

class Order {
    int orderId;
    Date orderDateTime;
    Date latestDeliveryTime;
    int numberOfPeople;
}

class EntertainmentOrder extends Order {
    String entertainmentType;
    int duration; // in minutes
}

class Entertainer extends User {
    String stageName;
    String bio;
    double pricePer30Minutes;
}

association [1] User <-> BusinessOwner [0..1];
association [1] BusinessOwner <-> PizzaRestaurant [*];
association [1] PizzaRestaurant <-> Pizza [*];
association [1] User <-> Order [*];
association [1] Order <-> Pizza [*];
association [1] EntertainmentOrder <-> Entertainer [1];
association [1] Entertainer <-> PizzaRestaurant [*];
association [1] Entertainer <-> DayOfWeek [*];

}
