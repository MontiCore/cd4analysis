
// CD4A class diagram for Pizza Delivery with Entertainment app
classdiagram pizzaDelivery {

    class User {
        String userId;  // unique identifier
        String name;
        String birthday;
        String address;
    }

    class BusinessOwner extends User {
        String linkedIn;
    }

    class HungryCustomer extends User {
        String deliveryAddress;
    }

    class Entertainer extends User {
        String stageName;
        String bio;
        double pricePer30Minutes;
    }

    class PizzaRestaurant {
        String name;
        String zipCode;
        String address;
        String phoneNumber;
        String website;
        String openingHours;
    }

    class Pizza {
        String name;
        String crustStructure;
        double price;
    }

    class Order {
        String orderId;  // unique identifier
        DateTime orderDateTime;
        DateTime latestDeliveryTime;
        int numberOfPeople;
        boolean isEntertainmentOrder;
        // For entertainment orders only
        String entertainmentType;
        Duration entertainmentDuration;  // duration of entertainment
    }

    class Availability {
        Day day; // Enum for days of the week (e.g., MONDAY, TUESDAY, etc.)
        boolean available;
    }

    enum Day {
        MONDAY,
        TUESDAY,
        WEDNESDAY,
        THURSDAY,
        FRIDAY,
        SATURDAY,
        SUNDAY;
    }

    association [1..*] PizzaRestaurant -> (owner) BusinessOwner [1];
    association [1..*] Order -> (customer) HungryCustomer [1];
    association [*] PizzaRestaurant -> (entertainer) Entertainer [*];
    association [*] Availability -> (entertainer) Entertainer [*];
    association [1..*] Pizza -> (restaurant) PizzaRestaurant [1];
    association [1..*] Pizza -> (order) Order [1];
}
