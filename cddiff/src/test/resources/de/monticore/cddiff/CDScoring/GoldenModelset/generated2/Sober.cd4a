
// Class diagram representing the Sober taxi service structure

classdiagram sober {

    class Sober {
        Fleet fleet;
        List<Customer> customers;
        void registerCar(Car car);
        void requestRideHail(RideHailRequest request);
        void requestRideShare(RideShareRequest request);
    }

    class Fleet {
        List<Car> selfDrivingCabs;
        List<Car> registeredCars;
    }

    class Car {
        String licensePlate;
        Owner owner; // reference to car owner
        List<Accident> accidents;
    }

    class Owner {
        String name;
        String contactInfo;
        List<Car> cars;
    }

    class Customer {
        String name;
        String contactInfo;
        List<RideHail> rideHails;
        List<RideShare> rideShares;
    }

    class RideHail {
        DateTime pickUpTime;
        String pickUpLocation;
        DateTime dropOffTime;
        String dropOffLocation;
        Duration rideDuration;
        double distance;
        int numberOfPassengers;
        double fee;
        RequestType requestType;
        Customer leadCustomer;
    }

    class RideShare {
        DateTime pickUpTime;
        String pickUpLocation;
        DateTime dropOffTime;
        String dropOffLocation;
        Duration rideDuration;
        double distance;
        List<Customer> customerList;
        double negotiatedFee;
    }

    class Accident {
        DateTime accidentDate;
        String accidentLocation;
        double damageAmount;
    }

    enum RequestType {
        SoberApp,
        HandWaving;
    }

    // Associations
    association [1] Sober -> (fleet) Fleet [1];
    association [*] Fleet -> (selfDrivingCabs) Car [*];
    association [*] Fleet -> (registeredCars) Car [*];
    association [0..*] Sober -> (customers) Customer [*];
    association [1] Owner -> (cars) Car [*];
    association [*] Customer -> (rideHails) RideHail [*];
    association [*] Customer -> (rideShares) RideShare [*];
    association [*] Car -> (accidents) Accident [*];
}
