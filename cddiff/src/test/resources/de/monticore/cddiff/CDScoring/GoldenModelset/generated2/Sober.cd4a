
// Class Diagram for Sober Taxi Company using self-driving cars
classdiagram SoberTaxi {

class SoberApp {
    // Represents the application used to hail taxis
}

class TaxiService {
    // Base class for different taxi services
}

class RideHailing extends TaxiService {
    Date pickupTime;
    Date dropoffTime;
    String pickupLocation;
    String dropoffLocation;
    int rideDuration; // in minutes
    double distance; // in kilometers
    int passengerCount;
    double fee;
    String requestType; // "Sober App" or "Hand-waving"
    String leadCustomerName;
}

class RideSharing extends TaxiService {
    Date pickupTime;
    Date dropoffTime;
    String pickupLocation;
    String dropoffLocation;
    int rideDuration; // in minutes
    double distance; // in kilometers
    int passengerCount;
    List<String> customerNames; // Names of all customers
    double negotiatedFee;
}

class SelfDrivingCab {
    String licensePlate;
    String model;
}

class RegisteredCar {
    String ownerName;
    String licensePlate;
}

class Accident {
    Date date;
    String location;
    double damageAmount;
}

association [1] SelfDrivingCab <-> RideHailing [0..*];
association [1] SelfDrivingCab <-> RideSharing [0..*];
association [0..*] RegisteredCar <-> RideHailing [0..*];
association [0..*] RegisteredCar <-> RideSharing [0..*];
association [1] SelfDrivingCab <-> Accident [0..*];

}
