
classdiagram SoberTaxiService {

class SoberApp {
    String estimatedWaitTime;
    String notification;
}

class SelfDrivingCar {
    String licensePlate;
    String model;
}

class CarOwner {
    String name;
    String contactInfo;
}

class RideHailService {
    DateTime pickupTime;
    DateTime dropoffTime;
    String pickupLocation;
    String dropoffLocation;
    Duration rideDuration;
    double distance;
    int numberOfPassengers;
    double fee;
    String requestType; // App or hand-waving
    String leadCustomerName;
}

class RideShareService {
    DateTime pickupTime;
    DateTime dropoffTime;
    String pickupLocation;
    String dropoffLocation;
    Duration rideDuration;
    double distance;
    List<String> customerNames;
    double negotiatedFee;
}

class Accident {
    Date accidentDate;
    String accidentLocation;
    double damageAmount;
}

class Fleet {
    List<SelfDrivingCar> cars;
}

association [1] SoberApp <-> RideHailService [0..*];
association [1] SoberApp <-> RideShareService [0..*];
association [1] SelfDrivingCar <-> CarOwner [1];
association [1] SelfDrivingCar <-> Accident [0..*];
association [1] Fleet <-> SelfDrivingCar [0..*];

}
