
// CD4A class diagram for managing appointments between Students and Teaching Assistants for Courses
classdiagram appointmentSystem {

    class Student {
        String name;
        String studentId;
        // Method to request an appointment
        void requestAppointment(Appointment appointment);
    }

    class TeachingAssistant {
        String name;
        String taId;
        // Method to provide help
        void provideHelp(Appointment appointment);
    }

    class Course {
        String courseId;
        String courseName;
        // Method to check if a student can register
        boolean canRegister(Student student);
    }

    class Appointment {
        Student student;
        TeachingAssistant teachingAssistant;
        Course course;
        // Method to schedule the appointment
        void schedule();
    }

    // Associations
    association [*] Student -> (appointments) Appointment [*];
    association [*] TeachingAssistant -> (appointments) Appointment [*];
    association [*] Course <-> (students) Student [*];
    association [*] Course <-> (teachingAssistants) TeachingAssistant [*];
}
