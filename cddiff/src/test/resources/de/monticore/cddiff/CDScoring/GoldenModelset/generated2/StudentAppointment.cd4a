
// Class Diagram for Appointment System for Teaching Assistants
classdiagram AppointmentSystem {

    class Student {
        String name;
        String studentId;
        // A student can only be associated with courses they are registered for.
    }

    class Course {
        String courseName;
        String courseCode;
        // Each course has a unique identifier and a name.
    }

    class TeachingAssistant {
        String name;
        String taId;
        // A TA can only assist in the courses they are teaching.
    }

    class Appointment {
        String appointmentId;
        String dateTime;
        // An appointment is specific to one course and one TA.
    }

    association [1] Student -> Course [*];  // A student can be registered in multiple courses
    association [1] TeachingAssistant -> Course [*];  // A TA can assist multiple courses
    association [1] Course -> Appointment [0..*];  // A course can have multiple appointments
    association [1] TeachingAssistant -> Appointment [0..*];  // A TA can have multiple appointments
    association [1] Student -> Appointment [0..*];  // A student can have multiple appointments
}
