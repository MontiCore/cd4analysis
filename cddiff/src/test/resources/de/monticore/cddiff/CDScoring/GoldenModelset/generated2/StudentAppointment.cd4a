
classdiagram Course_Appointment_System {

class Student {
    String name;
}

class Course {
    String courseName;
}

class TeachingAssistant {
    String name;
}

class Appointment {
    String dateTime;
}

association [1] Course <-> TeachingAssistant [0..*];
association [1] Course <-> Appointment [0..*];
association [1] Student <-> Course [1..*];
association [1] Student <-> Appointment [0..*];
association [1] TeachingAssistant <-> Appointment [0..*];

}
