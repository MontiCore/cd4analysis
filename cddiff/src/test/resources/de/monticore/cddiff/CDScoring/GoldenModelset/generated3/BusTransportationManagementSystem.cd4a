
classdiagram BTMS {

class Driver {
    String name;
    String uniqueID;
    boolean isSickLeave;
}

class Bus {
    String licencePlate;
    boolean inRepairShop;
}

class BusRoute {
    int routeNumber;
}

class Shift {
    String type; // morning, afternoon, night
}

class Assignment {
    // This can represent the assignment of a driver to a bus for a specific shift on a specific day
}

association [*] Bus <-> BusRoute [*];
association [*] Driver <-> Shift [*];
association [*] Driver <-> Assignment [*];
association [*] Bus <-> Assignment [*];

}
