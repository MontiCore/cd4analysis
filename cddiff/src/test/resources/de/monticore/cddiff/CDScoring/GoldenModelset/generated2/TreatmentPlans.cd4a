
classdiagram HospitalExamination {

    class Hospital {
        String name;
        String address;
    }

    class Doctor {
        String name;
    }

    class Patient {
        String name;
    }

    class Examination {
        String type;
    }

    class TreatmentPlan {
        String problem;
    }

    class ActualTreatment {
        // Can consist of both advised examinations and freely chosen medical actions
    }

    association [1] Hospital -- Doctor [*];
    association [1] Hospital -- Patient [*];
    association [1] Hospital <-> Examination [*]; // Hospitals have permissions for certain examinations
    association [1] TreatmentPlan -- Examination [*]; // Advised examinations per treatment plan
    association [1] TreatmentPlan <-> ActualTreatment [0..*]; // Actual treatments based on treatment plans
    association [1] Doctor -- ActualTreatment [*];
    association [1] Patient -- ActualTreatment [*];
    
}
