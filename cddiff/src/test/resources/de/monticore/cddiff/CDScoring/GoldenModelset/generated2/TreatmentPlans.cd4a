
classdiagram HospitalSystem {

    class Hospital {
        String name;
        String location;
        boolean hasPermissionForExamination;
    }

    class Examination {
        String type;
    }

    class TreatmentPlan {
        String problem;
        List<Examination> advisedExaminations;
    }

    class Doctor {
        String name;
        String licenseNumber;
    }

    class Patient {
        String name;
        String patientId;
    }

    class ActualTreatment {
        List<Examination> examinations;
        List<String> medicalActions;
    }

    association [1] Hospital -> Examination [0..*];
    association [1] TreatmentPlan -> Examination [*];
    association [1] Doctor -> Hospital [1];
    association [1] Patient -> Doctor [1];
    association [1] Doctor -> ActualTreatment [1];
    association [1] Patient -> ActualTreatment [1];

}
