
classdiagram hospital {

    class Examination {
        String type; // e.g., "cardiologic test", "echography", etc.
    }

    class Hospital {
        String name;
        List<Examination> permittedExaminations;
        void applyForPermission(Examination examination);
    }

    class TreatmentPlan {
        List<Examination> advisedExaminations;
        String problemType; // type of problem
    }

    class Doctor {
        String name;
        Hospital hospital;
        Treatment defineTreatment(Patient patient, String problemType);
    }

    class Patient {
        String name;
        Problem problem;
        Treatment treatment;
    }

    class Problem {
        String description;
    }

    class Treatment {
        List<Examination> actualExaminations;
        List<String> medicalActions; // additional chosen actions
    }

    association [1] Hospital -> (permittedExaminations) Examination [*];
    association [*] Hospital -> (treatmentPlans) TreatmentPlan [*];
    association [1] Doctor -> (affiliatedHospital) Hospital [1];
    association [1] Doctor -> (treatments) Treatment [*];
    association [1] Patient -> (problem) Problem [1];
    association [1] Patient -> (treatment) Treatment [1];
    association [1] Problem -> (treatmentPlan) TreatmentPlan [1];
}
