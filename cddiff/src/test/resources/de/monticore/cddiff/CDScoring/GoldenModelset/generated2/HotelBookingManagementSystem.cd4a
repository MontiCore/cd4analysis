
classdiagram HotelBookingManagementSystem {

class Traveller {
 String name;
 BillingInformation billingInfo;
 TravelPreferences preferences;
}

class BillingInformation {
 String companyName;
 String address;
 String creditCardInfo;
}

class TravelPreferences {
 boolean breakfast;
 boolean freeWifi;
 boolean frontDesk24_7;
}

class AccommodationSearch {
 String city;
 Date arrivalDate;
 Date departureDate;
 int roomCount;
 RoomType roomType;
 int minRating;
 float maxCostPerNight;
 TravelPreferences additionalPreferences;
}

enum RoomType {
 SINGLE,
 DOUBLE,
 TWIN;
}

class Booking {
 String bookingId;
 float price;
 String cityArea;
 int hotelRating;
 TravelPreferences keyPreferences;
 boolean confirmed;
 boolean prePaid;
 Date cancellationDeadline;
}

class Hotel {
 String name;
 String address;
 City city;
 HotelChain chain;
}

class City {
 String name;
}

class HotelChain {
 String name;
}

class Room {
 RoomType type;
 boolean fullyBooked;
}

class CompetitorOffer {
 Booking booking;
}

class PastBooking {
 Booking booking;
 int reliabilityRating;
}

association [0..*] Traveller <-> PastBooking [0..*];
association [0..1] Hotel <-> City [0..1];
association [0..1] Hotel <-> HotelChain [0..1];
association [0..*] Hotel <-> Room [0..*];
association [0..*] Traveller <-> Booking [0..*];
association [0..*] Booking <-> CompetitorOffer [0..*];

}
