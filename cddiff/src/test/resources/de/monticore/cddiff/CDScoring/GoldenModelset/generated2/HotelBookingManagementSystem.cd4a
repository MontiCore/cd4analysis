
// Class Diagram for Hotel Booking Management System (HBMS)

classdiagram hbs {

    class Traveller {
        String name;
        BillingInformation billingInfo; // includes company name and address
        List<TravelPreference> travelPreferences; // optional
        List<Booking> pastBookings;
        ReliabilityRating reliabilityRating;

        void register(String name, BillingInformation billingInfo);
        void searchAccommodation(String city, Date arrivalDate, Date departureDate, 
                                 int numberOfRooms, RoomType roomType, 
                                 int minRating, double budget, 
                                 List<TravelPreference> additionalPreferences);
        void finalizeBooking(Booking booking);
        void cancelBooking(Booking booking);
    }

    class BillingInformation {
        String companyName;
        String address;
        String creditCardInfo;
    }

    enum TravelPreference {
        BREAKFAST_INCLUDED,
        FREE_WIFI,
        FRONT_DESK_24_7;
        // additional preferences can be added
    }

    class Booking {
        double price;
        String cityArea;
        int hotelRating;
        List<TravelPreference> keyPreferences;
        String bookingIdentifier;
        boolean isPrePaid;
        Date cancellationDeadline;

        void confirm();
        void cancel();
    }

    class Hotel {
        String name;
        Address address; // includes city and address details
        HotelChain chain;
        List<RoomType> availableRooms;

        void announceAvailableRooms(List<RoomType> roomTypes, Date startDate, Date endDate);
        void informFullyBooked(RoomType roomType);
        void sendConfirmation(Booking booking);
    }

    class RoomType {
        String type; // e.g., single, double, twin
        int availability;
    }

    class Address {
        String street;
        String city;
        String postalCode;
    }

    class HotelChain {
        String name;
        List<Hotel> hotels;
    }
    
    class ReliabilityRating {
        double score;

        void calculate(List<Booking> pastBookings);
    }

    association [*] Traveller -> (pastBookings) Booking [*];
    association [*] Hotel -> (availableRooms) RoomType [*];
    association [*] HotelChain -> (hotels) Hotel [*];
}

