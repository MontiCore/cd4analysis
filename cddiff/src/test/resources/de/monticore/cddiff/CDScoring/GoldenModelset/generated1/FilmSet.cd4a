
classdiagram FilmSet {

class Employee {
    String name;
    String socialSecurityNumber;
    boolean hasOscar;
}

class CreativeEmployee extends Employee {
    String assistantName;
}

class Director extends CreativeEmployee {}

class Actor extends CreativeEmployee {
    String education;
}

class Technician extends Employee {
    String fieldOfActivity;
}

class FilmSet {
    Location location;
}

class Film {
    String title;
    int yearOfRelease;
}

class Genre {
    Type type;
}

enum Type {
        THRILLER,
        ACTION,
        HORROR,
        COMEDY;
    }

class Screenwriter {
    String name;
    Film mostSuccessfulFilm;
}

class Screenplay {
    String title;
    String version;
    Date date;
    int numberOfScenes;
    String plot;
}

class Novel {
    String title;
    String author;
}

association [0..*] FilmSet <-> Film [0..*];
association [1] Film <-> Screenplay [1];
association [1] Screenwriter <-> Screenplay [0..*];
association [1] Screenplay <-> Novel [0..1];
association [0..*] Film <-> Actor [0..*];
association [1] Film <-> Director [0..1];
}

