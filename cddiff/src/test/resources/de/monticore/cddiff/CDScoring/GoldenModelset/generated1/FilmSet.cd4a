
// CD4A class diagram for the film set structure

classdiagram filmSet {

    class Employee {
        String name;
        String socialSecurityNumber;
        boolean hasOscar;
    }

    class CreativeEmployee extends Employee {
        // Creative employees include directors and actors
    }

    class Director extends CreativeEmployee {
        String assistantName;
    }

    class Actor extends CreativeEmployee {
        String educationCompleted;
    }

    class Technician extends Employee {
        String fieldOfActivity;
    }

    enum Genre {
        THRILLER,
        ACTION,
        HORROR,
        COMEDY;
    }

    class FilmSet {
        String location;
    }

    class Film {
        String title;
        int yearOfRelease;
    }

    class Screenwriter {
        String name;
        Film mostSuccessfulFilm;
    }

    class Screenplay {
        String title;
        String version;
        String date;
        int numberOfScenes;
        String plot;
    }

    class Novel {
        String title;
        String author;
    }

    class Concept {
        String description;
    }

    association [*] FilmSet <-> Film [*];
    association [*] Film <-> Screenplay [1];
    association [*] Screenwriter <-> Screenplay [*];
    association [1] Actor -> (preparesFor) Screenplay [*];
    association [1] Director -> (implementsScreenplay) Screenplay [1];
    association [1] Screenplay -> (basedOn) Novel [1];
    association [1] Screenplay -> (basedOn) Concept [1];
}
