
// CD4A Class Diagram for Film Set Management System
classdiagram FilmSetManagement {

enum Genre {
    THRILLER,
    ACTION,
    HORROR,
    COMEDY;
}

class Employee {
    String name;
    String socialSecurityNumber;
}

class CreativeEmployee extends Employee {
    boolean hasOscar;
}

class Director extends CreativeEmployee {
    String assistantName;
}

class Actor extends CreativeEmployee {
    String education;
}

class Technician extends Employee {
    String fieldOfActivity;
}

class FilmSet {
    String location;
}

class Film {
    String title;
    int yearOfRelease;
}

class Screenwriter extends Employee {
    String mostSuccessfulFilm;
}

class Screenplay {
    String title;
    String version;
    Date date;
    int numberOfScenes;
    String plot;
}

class Novel {
    String title;
    String author;
}

association [1] FilmSet <-> Film [*];
association [*] Film <-> Screenplay [1];
association [1] Screenwriter <-> Screenplay [*];
association [1] Novel <-> Screenplay [0..1];
association [*] Film <-> Actor [*]; // Actors must prepare for their roles
association [1] Film <-> Director [1]; // Each film has one director
association [1] Screenplay -> (implementsScreenplay) Director [1]; // Director implements the screenplay
}
