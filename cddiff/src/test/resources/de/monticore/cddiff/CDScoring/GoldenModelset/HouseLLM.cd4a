
classdiagram housingModel {

class House {
    String address;
    String buildingMaterial; // Options: "Wood", "Brick", "Concrete"
    Optional<Basement> basement;
    List<Company> servicedBy; // Companies servicing this house
}

abstract class Basement {
    String name;
    double size; // Size in square meters
}

class EarthBasement extends Basement {
    double humidityLevel;
}

class ConcreteBasement extends Basement {}

class SemiDetachedHouse extends House {
    boolean hasOwnGarden;
    int numberOfWindows;
    GarageOrCarport parking;
}

abstract class GarageOrCarport {}

class Carport extends GarageOrCarport {
    boolean isDoubleCarport;
    boolean hasFlatRoof;
}

class Garage extends GarageOrCarport {
    boolean hasAutomaticGarageDoor;
}

class Company {
    String name;
    String address;
    List<JobLog> jobs; // Job logs for this company
}

class JobLog {
    double hoursWorked;
    double agreedPrice;
    House relatedHouse; // House where the job was performed
}

// Associations
association [1] House (servicedBy) -> Company [1..*];
association performsJob [*] Company -> JobLog [*];
association [0..1] House -> Basement [1];
association ofType [1] SemiDetachedHouse -> GarageOrCarport [2];
association performsJobAt [*] JobLog -> House [1];
}
