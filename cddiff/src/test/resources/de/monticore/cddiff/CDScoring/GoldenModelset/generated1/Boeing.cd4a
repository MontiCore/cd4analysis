
// CD4A class diagram for aircraft sales by Boeing to airlines
classdiagram boeingAircraftSales {

    class AirlineCompany {
        String name;
        List<Contract> contracts;
        List<AirlineCompany> daughterCompanies;
    }

    class Contract {
        AirlineCompany airline;
        List<Acquisition> acquisitions;
        DeliveryConditions deliveryConditions;
        LegalAspects legalAspects;
        Salesperson salesperson;
    }

    class Acquisition {
        String model;
        double negotiatedPrice;
        List<Option> options;
        Date deliveryDate;
    }

    class Salesperson {
        String name;
        List<Contract> contracts;
    }

    class DeliveryConditions {
        // attributes related to delivery conditions
    }

    class LegalAspects {
        // attributes related to legal aspects
    }

    class Option {
        String name;
        // other option-specific attributes
    }

    association [*] AirlineCompany -> (contracts) Contract [*];
    association [1] Contract -> (acquisitions) Acquisition [*];
    association [1] Contract -> (salesperson) Salesperson [1];
    association [*] AirlineCompany -> (daughterCompanies) AirlineCompany [*];
}
