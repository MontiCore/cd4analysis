
classdiagram Boeing {

class Aircraft {
    String model;
    double price;
    String options;
    Date deliveryDate;
}

class Airline {
    String name;
}

class Contract {
    String deliveryConditions;
    String legalAspects;
}

class Acquisition {
    Aircraft aircraft;
    double negotiatedPrice;
}

class Salesperson {
    String name;
}

association [1] Airline <-> Contract [*];
association [1] Contract <-> Acquisition [*];
association [1] Salesperson <-> Contract [*];
association [*] Airline (mother) <-> (daughter) Airline [*];
association [1] Contract <-> (manage) Salesperson [*];

}
