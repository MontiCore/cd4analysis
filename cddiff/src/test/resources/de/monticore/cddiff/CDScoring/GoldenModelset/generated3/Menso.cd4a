
// CD4A Class Diagram for De Lijn Bus Company

classdiagram DeLijnBusCompany {

enum ApprovalStatus {
    Approved,
    Refused,
    RevisionRequested;
}

class Trajectory {
    String id;
    ApprovalStatus approvalStatus;
    boolean isOperational;
    boolean isSuspended;
    boolean isCancelled;
}

class Line {
    String lineNumber;
}

class Bus {
    String busId;
    String lineNumber; // can be associated with multiple lines
}

class MENSO {
    double price;
    int discount;
    String validity; // Limit to one year
}

class Invoice {
    Date date;
    double totalAmount;
}

class Customer {
    String name;
    String homeAddress;
    String officeAddress;
    String workingHours;
}

class MENSOCard {
    String cardId;
}

class Trip {
    Date time;
    String line;
}

class Category {
    String categoryName;
    double pricePerTrip; // Price depends on the category
}

// Association between classes

association [1] Bus <-> Line [0..*]; 
association [1] Trajectory <-> Line [0..*]; // A line groups multiple trajectories
association [1] MENSOCard <-> Customer [1];
association [*] Customer <-> Trip [0..*]; // Customers register trips 
association [*] Trip <-> Invoice [0..*]; // Trips are used to generate invoices
association [*] Line <-> Category [1]; // Lines have a category
association [1] MENSOCard <-> (user) Customer [1]; // MENSO cards are issued to customers

}
