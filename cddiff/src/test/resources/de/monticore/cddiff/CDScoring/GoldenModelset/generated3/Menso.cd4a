
// Class Diagram for De Lijn's Bus Company Operations
classdiagram delijn {

    class BusCompany {
        List<Bus> busses;
        List<Trajectory> trajectories;
        void requestApproval(Trajectory trajectory);
        void assignBusToTrajectory(Bus bus, Trajectory trajectory);
    }

    class Bus {
        String lineNumber;
    }

    class Trajectory {
        String destination;
        boolean isApproved;
        void requestChange();
        void cancel();
    }

    class Line {
        List<Trajectory> overlappingTrajectories;
        String category;
    }

    class MENSO {
        String ticketID;
        Date validUntil;
        double price;
        void registerTrip(Date date, Time time, Line line);
        double calculateInvoice(List<Trip> trips);
    }

    class Customer {
        String homeAddress;
        String officeAddress;
        String workingHours;
        void subscribeToMENSO();
        void makePayment(double amount);
    }

    class Trip {
        Date date;
        Time time;
        Line line;
    }

    association [*] BusCompany -> (owns) Bus [*]; // A company has multiple buses
    association [*] BusCompany -> (has) Trajectory [*]; // A company has multiple trajectories
    association [*] BusCompany -> (has) Line [*]; // A company has multiple lines
    association [1] Customer -> (uses) MENSO [*]; // A customer can use multiple MENSO tickets
    association [*] MENSO -> (registered) Trip [*]; // A MENSO ticket can register multiple trips
}
