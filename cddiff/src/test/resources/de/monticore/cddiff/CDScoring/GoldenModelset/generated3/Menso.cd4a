
classdiagram DeLijnBusCompany {

class Bus {
    String lineNumber;
}

class Trajectory {
    boolean approved;
    boolean suspended;
    boolean cancelled;
}

class Line {
    String name;
}

class MENSO {
    int validityPeriod; // in months, valid for 12 months
    double discountRate; // up to 20%
}

class Trip {
    Date dateTime;
}

class Invoice {
    double amount;
}

class Customer {
    String homeAddress;
    String officeAddress;
    String workingHours;
}

association [0..*] Bus <-> Trajectory [0..*];
association [1] Line <-> Trajectory [0..*];

association [1] MENSO <-> Customer [1];
association [0..*] Trip <-> MENSO [1];
association [0..*] Invoice <-> Customer [0..*];

}
