
classdiagram TeamSportsScoutingSystem {
    class Employee {
        String name;
    }

    class HeadCoach extends Employee {
        void identifyPlayerProfile(String position, Attribute[] attributes);
    }

    class Director extends Employee {
        void makeOffer(Player player);
    }

    class Scout extends Employee {
        void submitScoutingReport(ScoutingReport report);
        void notePlayer(Player player);
    }

    class Player {
        String name;
        String position;
        Attribute[] attributes;
    }

    class ScoutingReport {
        String pros;
        String cons;
        String recommendation; // e.g., key player, first team player, etc.
    }

    class LongList {
        Player[] players;
    }

    class ShortList {
        Player[] players;
    }

    association [*] HeadCoach -> (targets) Player [*];
    association [*] Scout -> (longList) LongList [1];
    association [1] HeadScout -> (scoutingAssignment) ShortList [*];
    association [1] Scout -> (report) ScoutingReport [*];
    association [1] Director -> (offer) Player [*];
}
