
// CD4A Model for Team Sports Scouting System
classdiagram scoutingSystem {

    class Employee {
        String name;
        String role; // Roles can be Head Coach, Director, Scout
    }

    class HeadCoach extends Employee {
        void identifyPlayerProfile(String position, List<Attribute> attributes);
        void evaluateLongList(List<Player> longList);
    }

    class Director extends Employee {
        void makeOffer(Player player);
    }

    class Scout extends Employee {
        void notePlayer(Player player);
        void submitScoutingReport(Player player, List<String> pros, List<String> cons, Recommendation recommendation);
    }

    class Player {
        String name;
        String position; // e.g. GK, LB
        List<Attribute> attributes; // List of attributes (name and value)
    }

    class Attribute {
        String name;
        String value;
    }

    enum Recommendation {
        KEY_PLAYER,
        FIRST_TEAM_PLAYER,
        RESERVE_TEAM_PLAYER,
        PROSPECTIVE_PLAYER,
        NOT_GOOD_SIGNING;
    }

    class ScoutingReport {
        Player player;
        List<String> pros;
        List<String> cons;
        Recommendation recommendation;
    }

    association [*] HeadCoach -> (designatedProfiles) Player [*];
    association [*] Scout -> (longList) Player [*];
    association [1] Scout -> (scoutingReport) ScoutingReport [*];
    association [1] Director -> (offers) Player [*];
}
