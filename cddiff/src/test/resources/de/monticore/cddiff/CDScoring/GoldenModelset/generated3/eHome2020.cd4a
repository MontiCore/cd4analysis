
classdiagram EHome2020 {

enum SensorUnit {
    CELSIUS,
    WATT;
}

class User {
    String username;
    String password;
}

class Apartment {
    String address;
}

class Room {
    String description;
}

abstract class Sensor {
    String vendorId;
    String description;
    SensorUnit unit;
}

class TemperatureSensor extends Sensor {
    float minValue;
    float maxValue;
}

class PowerSensor extends Sensor {
    float counterReading;
}

class SensorController {
    Apartment apartment;
}

class SensorValue {
    Date timestamp;
    float value;
}

class EMonitor {
    void checkThresholds();
}

class Alert {
    String email;
}

association [1] User -- (apartment) Apartment [1];
association [1] Apartment -- (rooms) Room [2..*];
association [1] Apartment -- (sensors) Sensor [1..*];
association [1] SensorController -- (sensors) Sensor [*];
association [1] Sensor -- (values) SensorValue [*];
association [1] Sensor -- (lastValue) SensorValue [0..1];
association [1] EMonitor -- (monitors) Sensor [*];
association [1] Apartment -- (alert) Alert [0..1];
}
