
// CD4A Model for E-Home-2020 system
classdiagram ehome2020 {

    enum Unit {
        CELSIUS,
        WATT;
    }

    class Apartment {
        String address;
        List<Room> rooms; // association with Room
        String emailAddress; // for alert messages

        void addRoom(Room room);
        void removeRoom(Room room);
    }

    class Room {
        String description;

        void setDescription(String description);
    }

    class Sensor {
        String vendorId; // unique identifier
        String description;
        Unit unit;

        void queryValue();
        void setThreshold(float threshold);
    }

    class TemperatureSensor extends Sensor {
        float minValue; // valid range minimum
        float maxValue; // valid range maximum

        void queryValue();
    }

    class PowerSensor extends Sensor {
        float totalConsumption; // total power consumption

        void queryValue();
    }

    class SensorController {
        List<Sensor> sensors; // association with Sensor
        List<Inhabitant> inhabitants; // association with Inhabitant

        void reportSensorValue(Sensor sensor, float value);
        void configureSensor(Sensor sensor, Room room);
    }

    class Inhabitant {
        String username;
        String password;
        boolean isAdmin; // to determine administrative rights

        void logIn(String username, String password);
        void querySensorValue(Sensor sensor);
    }

    class EMonitor {
        void checkThreshold(Sensor sensor);
    }

    association [*] Apartment -> (rooms) Room [*]; // One apartment has multiple rooms
    association [*] Room -> (sensors) Sensor [*]; // One room can have multiple sensors
    association [1] SensorController <-> (sensors) Sensor [*]; // SensorController manages multiple sensors
    association [*] SensorController <-> (inhabitants) Inhabitant [*]; // SensorController has multiple inhabitants
}
