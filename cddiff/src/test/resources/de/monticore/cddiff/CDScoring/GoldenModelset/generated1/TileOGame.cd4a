
// CD4A class diagram for the Tile-O application

classdiagram tileO {

    class Game {
        Board board;
        List<Player> players;
        int currentPlayerIndex;
        void startGame();
        void rollDie();
        void movePiece(Player player, Tile targetTile);
        void checkForEndGame(Player player);
    }

    class Board {
        List<Tile> tiles;
        Tile hiddenTile;
        List<ConnectionPiece> connectionPieces;
        void layoutTiles();
        void placeHiddenTile(Tile tile);
        void placeActionTiles(List<Tile> actionTiles);
    }

    class Tile {
        String color; // color could be "white" or "black"
        boolean isHidden;
        boolean isActionTile;
        List<Tile> connections;
        void changeColor();
        void setAsActionTile(int turns);
    }

    class ConnectionPiece {
        Tile tileA;
        Tile tileB;
        void connectTiles(Tile tileA, Tile tileB);
    }

    class Player {
        String name;
        String color; // Different color for each player
        Tile currentTile;
        void rollDie();
        void performAction(ActionCard card);
    }

    class ActionCard {
        String instruction; // Description of the action
        void execute(Player player);
    }

    class Designer {
        Game game;
        void defineGame();
        void placeTilesOnBoard(List<Tile> tiles);
        void defineHiddenTile(Tile tile);
        void defineActionCards(List<ActionCard> actionCards);
    }

    association [1] Game -> (players) Player [2..4];
    association [1] Game -> Board [1];
    association [*] Board -> (tiles) Tile [*];
    association [*] Tile -> (connections) Tile [0..4]; // Up to one connection per side
    association [*] Board -> (sparePieces) ConnectionPiece [*];
}
