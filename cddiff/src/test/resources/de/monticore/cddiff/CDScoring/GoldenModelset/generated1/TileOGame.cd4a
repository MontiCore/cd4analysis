
classdiagram TileO {

    class Game {
        BoardGame boardGame;
        Player currentPlayer;
        void rollDie();
        void movePiece();
    }

    class BoardGame {
        Tile hiddenTile;
        List<Tile> tiles;
        List<ActionTile> actionTiles;
        List<Player> players;
        void defineBoard();
    }

    class Color {
        // The LLM did not generate this class, adding it to avoid errors
    }

    class Tile {
        Color color;
        Tile rightTile;
        Tile leftTile;
        Tile topTile;
        Tile bottomTile;
        boolean isVisited;
    }

    class ActionTile extends Tile {
        int turnsUntilRegular;
    }

    class Player {
        String name;
        PlayingPiece piece;
        void takeTurn();
    }

    class PlayingPiece {
        Color color;
    }

    class Die {
        int roll();
    }

    class Designer {
        void designGame();
        void defineHiddenTile();
        void defineStartingPositions();
        void defineActionTiles();
        void defineActionCardDeck();
    }

    class ActionCard {
        String instructions;
    }

    association [1] Game -> (boardGame) BoardGame [1];
    association [1] BoardGame -> (tiles) Tile [*];
    association [1] BoardGame -> (actionTiles) ActionTile [*];
    association [1] BoardGame -> (players) Player [2..4];
    association [1] Player -> (piece) PlayingPiece [1];
    association [1] Tile -> (rightTile) Tile [0..1];
    association [1] Tile -> (leftTile) Tile [0..1];
    association [1] Tile -> (topTile) Tile [0..1];
    association [1] Tile -> (bottomTile) Tile [0..1];

}
