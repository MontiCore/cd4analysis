
// Class Diagram for De Lijn's MENSO Bus Company System
classdiagram DeLijnBusCompany {

class Trajectory {
    String id; // Unique identifier for the trajectory
    boolean isApproved;
    boolean isSuspended;
    boolean isCancelled;
}

class Line {
    String lineNumber; // Line number for the bus
}

class Bus {
    String id; // Unique identifier for the bus
}

class MENSO {
    int validityInMonths; // Validity of the MENSO ticket
    double price; // Price of the trip (depends on line category)
}

class Invoice {
    Date date; // Date of the invoice
    double totalAmount; // Total amount to be invoiced
    double discount; // Discount applied up to 20%
}

class Customer {
    String homeAddress; // Home address of the customer
    String officeAddress; // Office address of the customer
    String workingHours; // Working hours of the customer
}

class Trip {
    DateTime timeStamp; // Time and date of the trip
    Line line; // Line for the trip
}

association [1] Bus <-> Trip [0..*]; // A bus can have many trips
association [1] Trajectory <-> Line [1]; // A trajectory corresponds to a line
association [1] Line <-> MENSO [1]; // A line is associated with MENSO
association [1] MENSO <-> Invoice [0..*]; // MENSO can generate multiple invoices
association [1] Customer <-> MENSO [1]; // A customer subscribes to one MENSO
association [1] Customer <-> Trip [0..*]; // A customer can have many trips
association [*] Trajectory <-> (approvalRequest) TownAuthority [0..*]; // Approval requests to town authorities
}
