
classdiagram bus_company {

    class BusCompany {
        String name;
        void requestApproval(Trajectory trajectory);
        void assignBusToTrajectory(Bus bus, Trajectory trajectory);
    }

    class Bus {
        String lineNumber;
    }

    class Trajectory {
        String destination;
        boolean approved;
        void requestApproval();
        void changeTrajectory();
        void suspend();
        void cancel();
    }

    class Line {
        String lineName;
        List<Trajectory> overlappingTrajectories;
    }

    class MENSO {
        double price;
        void registerTrip(Date time, String line);
        void issueInvoice(Customer customer);
    }

    class Customer {
        String homeAddress;
        String officeAddress;
        String workingHours;
        void subscribeToMENSO(MENSO menso);
    }

    class Invoice {
        double amount;
        void calculateDiscount();
    }

    association [1] BusCompany -> (operates) Bus [*];
    association [1] BusCompany -> (manages) Trajectory [*];
    association [*] Line -> (groups) Trajectory [*];
    association [*] MENSO <-> Invoice [*];
    association [1] Customer -> (uses) MENSO [*];
}
