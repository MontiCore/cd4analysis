
classdiagram DeLijnBusCompany {

class Bus {
    String lineNumber;
}

class Trajectory {
    boolean approved;
    boolean suspended;
    boolean cancelled;
}

class Line {
    String name;
}

class MENSOTicket {
    double price;
    int validDurationInMonths;
}

class Customer {
    String homeAddress;
    String officeAddress;
    String workingHours;
}

class Trip {
    Date time;
    Date date;
}

class Invoice {
    double totalAmount;
    double discount;
}

association [1] Bus <-> Trajectory [0..*];
association [1] Line <-> Trajectory [0..*];
association [1] MENSOTicket <-> Trip [0..*];
association [1] Customer <-> MENSOTicket [0..*];
association [1] Customer <-> Invoice [0..*];
association [1] Trip <-> Invoice [0..*];

}
