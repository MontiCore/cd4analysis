
classdiagram ScienceConnect {

    class Person {
        String personID;
        String phoneNumber;
        List<String> researchKeywords;
        Institution institution;
    }

    class Institution {
        String institutionCode;
        List<TechnicalReport> technicalReports;
    }

    class ScientificArticle {
        String DOI;
        String title;
        List<Author> authors;
    }

    class PeerReviewedPaper extends ScientificArticle {
        int citationCount;
        Reviewer reviewer;
    }

    class TechnicalReport extends ScientificArticle {
        Institution publishedBy;
    }

    class Publisher {
        String name;
        List<Journal> journals;
    }

    class Journal {
        String name;
        float impactFactor;
    }

    class Author {
        Person person;
        int position;
    }

    class Reviewer {
        Person person;
    }

    association [1] Person -> (institution) Institution [1];
    association [1] Institution -> (technicalReport) TechnicalReport [0..*];
    association [1] ScientificArticle -> (author) Author [1..*];
    association [1] PeerReviewedPaper -> (reviewer) Reviewer [1];
    association [1] TechnicalReport -> (publishedBy) Institution [1];
    association [1] Publisher -> (journal) Journal [1..*];
    association [1] Journal -> (publishedPaper) PeerReviewedPaper [0..*];
}
