
// Class Diagram for the cross-national research database
classdiagram researchDatabase {

    class Person {
        String personID;               // Unique identifier for a person
        String phoneNumber;            // Phone number of the person
        List<String> researchKeywords; // Keywords identifying research topics
        Institution institution;        // Institution the person works for
    }

    class Institution {
        String institutionCode;        // Unique identifier for an institution
        List<TechnicalReport> reports; // Technical reports published by this institution
    }

    class Article {
        String DOI;                    // Unique identifier for the article
        String title;                  // Title of the article
        List<AuthorPosition> authors;   // Authors of the article with their positions
    }

    enum AuthorPosition {
        FIRST_AUTHOR,
        CO_AUTHOR;
    }

    class PeerReviewedPaper extends Article {
        int citationCount;             // Citation count of the paper
        Person reviewer;               // Reviewer of the paper
        Journal journal;               // Journal where the paper is published
    }

    class TechnicalReport extends Article {
        Institution publishedBy;       // Institution that published the report
    }

    class Publisher {
        String name;                  // Name of the publisher
        List<Journal> journals;       // Journals published by the publisher
    }

    class Journal {
        String name;                  // Name of the journal
        float impactFactor;           // Impact factor of the journal
    }

    // Associations
    association [*] Person -> (worksFor) Institution [1];
    association [1] Article -> (authoredBy) Person [*];
    association [*] Institution -> (publishes) TechnicalReport [*];
    association [*] Publisher -> (publishes) Journal [*];
    association [1] Journal -> (features) PeerReviewedPaper [*];
}
