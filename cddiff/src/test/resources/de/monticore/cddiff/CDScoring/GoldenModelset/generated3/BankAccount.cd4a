
// CD4A Class Diagram for the Bank Management System
classdiagram BankManagement {

    class Bank {
        // A bank consists of multiple branches
    }

    class Branch {
        // A branch belongs to a bank
    }

    class Customer {
        String firstName;
        String lastName;
    }

    class Account {
        int accountNumber;
        double balance;
    }

    class CheckingAccount extends Account {
        double overdraftLimit;
    }

    class SavingsAccount extends Account {}

    association [1..*] Bank -> Branch [*];
    association [1..5] Customer -> Account [*];
    association [1] Account -> Customer [1];

}
