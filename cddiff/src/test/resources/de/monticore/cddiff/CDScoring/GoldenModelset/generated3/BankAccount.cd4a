
// Class Diagram for the Bank Management System
classdiagram bank {

    class Bank {
        String name;
        List<Branch> branches;
    }

    class Branch {
        String location;
        List<Customer> customers;
    }

    class Customer {
        String firstName;
        String lastName;
        List<Account> accounts;
    }

    abstract class Account {
        int accountNumber;
        double balance;
        Customer owner;
    }

    class CheckingAccount extends Account {
        double overdraftLimit;
    }

    class SavingsAccount extends Account {
        // No additional attributes
    }

    association [1..*] Bank -> (branches) Branch [0..*];
    association [1..*] Branch -> (customers) Customer [0..*];
    association [1..5] Customer -> (accounts) Account [1..*]; // At least one and at most five accounts
    association [1] Account -> (owner) Customer [1]; // Each account has one owner
}
