
classdiagram sober {

class Car {
    String licensePlate;
    String model;
    boolean isSelfDriving;
}

class RegisteredCar extends Car {
    String ownerName;
    String ownerContactDetails;
}

class SoberService {
    Date pickupTime;
    Date dropoffTime;
    String pickupLocation;
    String dropoffLocation;
    Duration rideDuration;
    double distance;
}

class RideHailing extends SoberService {
    int numberOfPassengers; // Maximum 6
    double fee;
    String leadCustomerName;
    String leadCustomerContact;
    RequestType requestType;
}

enum RequestType {
    SOBER_APP,
    HAND_WAVING;
}

class RideSharing extends SoberService {
    int numberOfPassengers; // Maximum 10
    double negotiatedFee;
    List<String> customerNames;
}

class Accident {
    Date accidentDate;
    String location;
    double damageAmount;
}

// Associations
association fleet [*] Car -> (operatedOrRegistered) RegisteredCar [*];
association providesService [1..*] Car -> SoberService [*];
association [*] RideHailing -> (includesAccidentDetails) Accident [*];
association [*] RideSharing -> (includesAccidentDetails) Accident [*];
association bookedRide [20..*] RideSharing -> (leadToPlantingTree) Customer [*];

}
