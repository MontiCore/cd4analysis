
classdiagram ots {

    class Person {
        String name;
        String email;
    }

    class Tutor extends Person {
        String bankAccount;
        List<TutoringOffer> offers;
        Availability availability; // Weekly availability
        void offerTutoring(TutoringOffer offer);
    }

    class Student extends Person {
        List<TutoringRequest> requests;
        void browseTutoringOffers(String subject);
        void makeTutoringRequest(TutoringOffer offer, String dateTime);
    }

    class TutoringOffer {
        String subject;
        String expertiseLevel; // e.g., primary school level, high school level, university level
        double hourlyPrice;
    }

    class TutoringRequest {
        TutoringOffer offer;
        String suggestedDateTime;
        boolean isConfirmed;
        void confirmSession();
        void proposeAlternativeDateTime(String newDateTime);
    }

    class TutoringSession {
        Tutor tutor;
        Student student;
        String dateTime;
        double price;
        boolean isCompleted;
        void cancelSession();
        void completeSession();
    }

    enum CancellationPolicy {
        STUDENT_LATE_CANCEL, // 75% refund applies
        TUTOR_LATE_CANCEL;   // 25% discount offered
    }

    class MonthlyAward {
        Tutor bestTutor;
        String subject;
    }

    association [*] Tutor -> (offers) TutoringOffer [*];
    association [*] Student -> (requests) TutoringRequest [*];
    association [*] TutoringOffer <-> TutoringRequest [*];
}
