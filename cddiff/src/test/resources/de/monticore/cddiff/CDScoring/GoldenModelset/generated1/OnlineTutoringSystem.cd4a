
// CD4A Class Diagram for Online Tutoring System (OTS)
classdiagram OnlineTutoringSystem {

    class User {
        String name;
        String email;
    }

    class Tutor extends User {
        String bankAccount;
        double hourlyPrice;
        String levelOfExpertise;
        String subject;
        String availability; // e.g., "Thursdays from 10:00 to 11:30"
    }

    class Student extends User {
        // Student specific details can be added here
    }

    class TutoringRequest {
        Date suggestedDateTime;
        String levelOfTutoring; // e.g., primary, high school, university
    }

    class TutoringSession {
        Date sessionTime;
        boolean cancelledByStudent;
        boolean cancelledByTutor;
        double sessionPrice;
    }

    class Payment {
        String paymentMethod; // e.g., credit card, wire transfer
        double amountPaid;
    }

    enum CancellationPolicy {
        STUDENT_CANCELLATION,
        TUTOR_CANCELLATION;
    }

    association [1] Tutor <-> (offers) TutoringRequest [*];
    association [1] Student <-> (makes) TutoringRequest [*];
    association [1] TutoringRequest <-> (resultsIn) TutoringSession [1];
    association [1] TutoringSession <-> (paidBy) Payment [1];

}
