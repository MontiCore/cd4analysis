
classdiagram OTS {
    class Tutor {
        String name;
        String email;
        String bankAccount;
        float hourlyPrice;
    }

    class Student {
        String name;
        String email;
    }

    class TutoringOffer {
        String subject;
        String expertiseLevel;
        String availability; // e.g. "Thursdays from 10:00 to 11:30"
    }

    class TutoringRequest {
        String subject;
        String level;
        Date targetDateTime;
    }

    class TutoringSession {
        Date scheduledTime;
        boolean isConfirmed;
        boolean isCancelled;
        float sessionPrice;
    }

    class Payment {
        String method; // e.g. credit card, wire transfer
        float amount;
    }

    class Award {
        String subject;
        String tutorName;
        String month;
    }

    // Association to allow tutor to also be a student
    association [0..*] Tutor <-> Student [0..*];
    association [0..*] Tutor <-> TutoringOffer [0..*];
    association [1..*] Student <-> TutoringRequest [0..*];
    association [1..*] TutoringRequest <-> TutoringSession [1..1];
    association [1..1] TutoringSession <-> Payment [1..1];
}
