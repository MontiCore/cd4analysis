
// CD4A Class Diagram for Gas Station Management System
classdiagram gasStationManagement {

    class GasStation {
        String id; // Unique ID
        String address; // Address of the gas station
        List<FuelPump> fuelPumps; // List of fuel pumps
        List<DailyPrice> dailyPrices; // List of daily prices
    }

    class FuelPump {
        int number; // Number of the fuel pump
        boolean isSelfService; // Whether it is a self-service pump
        List<Fuel> offeredFuels; // List of fuels offered
    }

    class Fuel {
        String name; // Unique name of the fuel
        float octaneRating; // Octane rating of the fuel
    }

    class DailyPrice {
        Date date; // Date of the price
        Fuel fuel; // Fuel to which it applies
        GasStation gasStation; // Gas station where the price applies
        float pricePerLiter; // Price per liter of the fuel
    }

    class FuelPurchase {
        String id; // Unique ID for the purchase
        FuelPump fuelPump; // The fuel pump where purchase occurred
        DailyPrice dailyPrice; // The daily price of the purchased fuel
        float litersDispensed; // Number of liters dispensed
    }

    association [1] GasStation -> (pumps) FuelPump [0..12]; // Each gas station has 0 to 12 fuel pumps
    association [*] GasStation -> (prices) DailyPrice [*]; // Each gas station archives all daily prices
    association [1] FuelPump -> (offered) Fuel [*]; // Each fuel pump offers multiple fuels
    association [*] DailyPrice -> Fuel [1]; // Each daily price applies to one fuel
    association [1] DailyPrice -> GasStation [1]; // Each daily price applies to one gas station
    association [1] FuelPurchase -> FuelPump [1]; // Each fuel purchase occurs at one fuel pump
    association [1] FuelPurchase -> DailyPrice [1]; // Each fuel purchase correlates with one daily price
}
