
classdiagram ElderlyHome {

class Person {
    String name;
    int age;
    Date registrationDate;
    List<String> abilities;
}

class Inhabitant extends Person {
    Date intakeDate;
}

class Department {
    String departmentName;
    List<Room> rooms;
}

class Room {
    String roomNumber;
    List<Bed> beds;
}

class Bed {
    String bedId;
    BedCategory category;
}

class BedCategory {
    String categoryName;
    double price;
}

enum StayType {
    RH,  // Rest Home
    RNH, // Rest & Nursing Home
    SF;  // Service Flat
}

class Stay {
    StayType type;
    Date startDate;
    Optional<Date> endDate;
    Optional<double> discount; // For discounts (e.g., SF while also in RNH)
}

class WaitingList {
    StayType type;
    List<Person> persons;
}

class Proposal {
    boolean accepted;
    boolean invalidated;
    Date proposalDate;
    Inhabitant person;
    Stay stay;
}

class Invoice {
    Stay stay;
    double totalAmount;
    double outstandingAmount;
    Date issuedDate;
    boolean isPaid;
    Optional<CreditNote> creditNote;
}

class CreditNote {
    double amount;
    Date issuedDate;
}

// Associations
association [*] Department -> Room [*];
association [1] Room -> Bed [*];
association [*] Bed (usedBy) -> Inhabitant [1];
association [*] WaitingList -> (waitingFor) Person [*];
association [1] Proposal (createdFor) -> Inhabitant [1];
association [1] Proposal -> (relatedStay) Stay [1];
association [*] Stay -> Inhabitant [1..*];
association [1] Invoice -> Stay [1];
association [1] CreditNote -> Invoice [1];

// Comments for clarity:
// - A Room contains multiple Beds, each bed has a specific category.
// - Stays can overlap (e.g., SF with RNH), and discounts can apply.
// - WaitingList holds persons awaiting a bed, categorized by StayType.
// - A Proposal comes from the WaitingList and links a Stay and Inhabitant.
// - Payments are not included as objects but represented by Invoice attributes.
// - Invoice updates occur upon payment or complaints.
}
