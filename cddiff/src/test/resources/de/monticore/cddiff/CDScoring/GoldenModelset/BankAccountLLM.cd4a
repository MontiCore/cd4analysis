
classdiagram BankSystem {

class Bank {
    String bankName;
    List<Branch> branches;
    List<Customer> customers;
}

class Branch {
    String branchName;
    String branchAddress;
}

class Customer {
    String firstName;
    String lastName;
    List<Account> accounts; // Minimum 1, maximum 5 accounts.
}

class Account {
    int accountNumber;
    double currentBalance;
}

class CurrentAccount extends Account {
    double overdraftLimit;
}

class SavingsAccount extends Account {
}

// Associations
association [0..*] Bank -> Branch [1..*];
association [1..*] Bank -> Customer [1..*];
association [1] Account (owner) -> Customer [*];

}
