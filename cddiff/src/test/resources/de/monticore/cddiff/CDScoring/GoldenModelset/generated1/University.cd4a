
// Class Diagram for University Structure
classdiagram university {

    class University {
        List<Faculty> faculties;
        int totalEmployees;
    }

    class Faculty {
        String name;
        Dean dean;
        List<Institute> institutes;
    }

    class Institute {
        String name;
        String address;
    }

    class Employee {
        String socialSecurityNumber;
        String name;
        String email;
    }

    class ResearchAssistant extends Employee {
        String fieldOfResearch;
        List<Institute> institutes;
        List<Project> projects;
        List<Course> courses; // RAs can teach courses
    }

    class AdministrativeStaff extends Employee {
        // Administrative specific attributes can be added later
    }

    class Dean extends Employee {
        // Dean specific attributes can be added later
    }

    class Project {
        String name;
        Date startDate;
        Date endDate;
        int hoursAssigned;
    }

    class Course {
        String id; // unique number
        String name;
        int weeklyDuration; // hours
    }

    association [1..*] University -> Faculty [1];
    association [1..*] Faculty -> Institute [*];
    association [1] Faculty -> Dean [1];
    association [1..*] ResearchAssistant -> Institute [*];
    association [1..*] ResearchAssistant -> Project [*];
    association [0..*] ResearchAssistant -> Course [*];
}
