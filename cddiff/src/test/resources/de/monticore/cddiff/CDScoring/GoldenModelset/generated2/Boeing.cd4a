
// Class Diagram for Boeing Aircraft Sales and Contracts
classdiagram boeing {

    class AirlineCompany {
        String name; // Name of the airline company
        AirlineCompany parent; // Parent company
        List<AirlineCompany> subsidiaries; // List of daughter companies
    }

    class Contract {
        AirlineCompany airlineCompany; // Associated airline company
        List<Acquisition> acquisitions; // List of acquisitions under this contract
        String deliveryConditions; // Common delivery conditions
        String legalAspects; // Common legal aspects
        Salesperson salesperson; // Assigned salesperson
    }

    class Acquisition {
        String airplaneModel; // Chosen model of airplane
        double negotiatedPrice; // Negotiated price for the airplane
        List<String> options; // List of chosen options and customizations
        String deliveryDate; // Delivery date for the airplane
    }

    class Salesperson {
        String name; // Name of the salesperson
        List<Contract> contracts; // List of contracts managed by this salesperson
    }

    // Associations
    association [*] AirlineCompany <-> (subsidiaries) AirlineCompany [*]; // Mother-daughter relationships
    association [*] Salesperson <-> Contract [*]; // Salesperson manages multiple contracts
    association [*] Contract <-> (acquisitions) Acquisition [*]; // Contract consists of multiple acquisitions
}
