
classdiagram Boeing {

class Aircraft {
    String model;
    double negotiatedPrice;
    String options;
    Date deliveryDate;
}

class SalesAgreement {
    String deliveryConditions;
    String legalAspects;
}

class Acquisition {
    SalesAgreement salesAgreement;
    Aircraft aircraft;
}

class Contract {
    SalesAgreement globalAgreement;
}

class Airline {
    String name;
}

class Salesperson {
    String name;
}

association [1] Salesperson <-> Contract [*];

association [1] Contract <-> Acquisition [*];

association [1] Airline <-> Acquisition [*];

association [1] Airline <-> (parent) Airline [0..1];

}
