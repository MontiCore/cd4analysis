
classdiagram musicmatic {

    class Song {
        String title;
        int year;
        int length;
        String genre;
        Artist artist;
    }

    class Artist {
        String name; // unique identifier
        String dateOfBirth;
        String websiteURL;
    }

    class User {
        String id; // unique identifier
        String name;
        String address;
    }

    class RegularUser extends User {
        void buyMusic(Song song);
        void makeSuggestion(Album album);
    }

    class BusinessUser extends User {
        String vatNumber;
        void uploadSong(Song song);
    }

    class Album {
        List<Hit> hits;
    }

    class Hit {
        Song song; // Individual hit
        int trackNumber; // Position in album
    }

    enum SongType {
        SINGLE,
        HIT;
    }

    association [1] Song -> Artist [1];
    association [*] RegularUser -> Song [*]; // can buy multiple songs
    association [1] Album -> Hit [*]; // an album can have multiple hits
    association [1] BusinessUser -> Song [1]; // can upload individual songs
}
