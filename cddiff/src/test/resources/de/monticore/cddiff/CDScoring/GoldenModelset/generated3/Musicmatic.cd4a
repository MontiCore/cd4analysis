
classdiagram Musicmatic {

class Song {
    String title;
    int year;
    int length;
    String genre;
}

class Artist {
    String name;
    String dateOfBirth;
    String websiteURL;
}

class User {
    String id;
    String name;
    String address;
}

class RegularUser extends User {}

class BusinessUser extends User {
    String vatNumber;
}

class Single extends Song {}

class Hit extends Song {
    int trackNumber;
}

class Album {
    String title;
}

association [1] Song <-> Artist [1];
association [*] User <-> Single [0..*];
association [*] User <-> Hit [0..*];
association [1] Album <-> Hit [0..*];
association [0..*] RegularUser <-> BusinessUser [0..*];

}
