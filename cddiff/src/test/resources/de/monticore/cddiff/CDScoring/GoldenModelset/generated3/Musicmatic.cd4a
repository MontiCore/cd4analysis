
// Class diagram for Musicmatic streaming platform

classdiagram MusicmaticLLM {

class Artist {
    String name; // unique identifier for artist
    DateTime dateOfBirth;
    String websiteUrl;
}

class Song {
    String title;
    int year;
    double length;
    String genre;
}

class User {
    String id; // unique identifier for user
    String name;
    String address;
}

class RegularUser extends User {}

class BusinessUser extends User {
    String vatNumber;
}

class Single extends Song {}

class Hit extends Song {
    int trackNumber; // position in the album
}

class Album {
    String title; // title of the album
}

association [1] Artist <-> Song [0..*]; // Each song belongs to one artist
association [1] User <-> Song [0..*]; // Users can buy multiple songs
association [1] BusinessUser <-> Single [0..*]; // Business users can upload singles
association [1] Album <-> Hit [0..*]; // An album consists of multiple hits
association [0..1] RegularUser <-> Album [0..*]; // Regular users can suggest albums

}
