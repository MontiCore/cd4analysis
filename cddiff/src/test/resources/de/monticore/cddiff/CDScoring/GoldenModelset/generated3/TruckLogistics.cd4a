
// Class Diagram for Locations, Drivers, Vehicles, and Orders
classdiagram locations {

    class Location {
        String address;
    }

    class Driver {
        String firstName;
        String lastName;
        // Each driver carries out a maximum of one order at a time
    }

    abstract class Vehicle {
        String vehicleNumber;
    }

    class Truck extends Vehicle {
        double weight;
    }

    class Car extends Vehicle {
        int numberOfSeats;
    }

    class Van extends Vehicle {
        // No additional attributes specified
    }

    class Order {
        Location origin;
        Location destination;
        Driver assignedDriver; // At least one assigned driver
        Date executionDate;
    }

    // Association: Each Location can have multiple Drivers
    association [*] Location -> (drivers) Driver [*];

    // Association: Each Driver can drive up to one Vehicle
    association [0..1] Driver -> (assignedVehicle) Vehicle [1];

    // Association: Each Order has exactly one Driver and two Locations
    association [1] Order -> (origin) Location [1];
    association [1] Order -> (destination) Location [1];
    association [1] Order -> (assignedDriver) Driver [1];

    // Association: Each Vehicle is driven by up to one Driver
    association [0..1] Vehicle -> (drivenBy) Driver [1];
}
