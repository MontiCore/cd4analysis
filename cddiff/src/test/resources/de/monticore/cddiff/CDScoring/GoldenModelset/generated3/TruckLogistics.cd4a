
classdiagram LocationManagement {
    class Driver {
        String firstName;
        String lastName;
    }

    class Location {
        String address;
    }

    class Vehicle {
        String vehicleNumber;
    }

    class Truck extends Vehicle {
        double weight;
    }

    class Car extends Vehicle {
        int numberOfSeats;
    }

    class Van extends Vehicle {
        // Additional attributes can be defined here if needed
    }

    class Order {
        String origin;
        String destination;
        String executionDate;
    }

    association [1] Location -> (driver) Driver [*];
    association [1] Location -> Vehicle [*];
    association [1] Order -> (driver) Driver [*];
    association [1] Driver -> (assigned) Order [0..1];
    association [1] Vehicle -> (assignedDriver) Driver [0..1];
    association [1] Order -> (origin) Location [1];
    association [1] Order -> (destination) Location [1];
}
