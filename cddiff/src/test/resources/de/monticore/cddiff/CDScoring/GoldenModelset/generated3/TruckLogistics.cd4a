
// CD4A Class Diagram for Location Management System
classdiagram LocationManagement {

    class Driver {
        String firstName;
        String lastName;
    }

    class Vehicle {
        String vehicleNumber;
    }

    class Truck extends Vehicle {
        double weight;
    }

    class Car extends Vehicle {
        int numberOfSeats;
    }

    class Van extends Vehicle {
        // Additional attributes for Van can be added here
    }

    class Location {
        String address;
    }

    class Order {
        String origin;
        String destination;
        Date executionDate;
    }

    association [1] Location -> Driver [0..*]; // A location can have multiple drivers
    association [1] Location -> Vehicle [0..*]; // A location can have multiple vehicles
    association [1] Driver -> Order [0..1]; // A driver can carry out a maximum of one order at a time
    association [1] Order -> Driver [1..*]; // An order must have at least one assigned driver
    association [1] Driver -> Vehicle [0..1]; // A driver can drive up to one vehicle
}
