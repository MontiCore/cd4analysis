
classdiagram FitnessCompany {

class FitnessCenter {
    String name; // Unique name
    String address;
    List<Room> rooms; // Association to Room
}

class Room {
    int number; // Unique within a FitnessCenter
    int maxCapacity;
}

class Session {
    String date;
    String startHour;
}

class GroupSession extends Session {
    String type; // Type like aerobics, bodystyling, etc.
}

class IndividualSession extends Session {
    // No additional attributes
}

class Person {
    String firstName;
    String lastName;
    String birthDate; // Unique identifier for Person
}

class Trainer extends Person {
    String diploma;
    // Trainer can also be a Person participating in other sessions
}

// Associations
association [1] FitnessCenter -> Room [1..*]; // A center has one or more rooms
association [1] Room -> Session [0..1]; // At most one session can start in a room at a given time
association [0..*] Person -> (participantIn) Session [*]; // People participating in sessions
association [1] Trainer -> (supervises) GroupSession [1]; // Group sessions are supervised by exactly one trainer

}
