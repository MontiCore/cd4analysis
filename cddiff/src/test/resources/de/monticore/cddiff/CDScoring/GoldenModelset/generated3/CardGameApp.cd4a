
classdiagram Game {

enum Suit {
    Diamonds,
    Hearts,
    Spades,
    Clubs;
}

class Card {
    int id;
    Suit suit;

    ComparisonResult compareHeight(Card otherCard);
}

class Deck {
    int id;
    Card[] cards; // Up to 48 cards
}

class ScoringTable {
    int id;
    Round[] rounds; // Any number of rounds
}

class Round {
    int id;
    Player[] winningPlayers;
    int pointValue;
}

abstract class SoloRound extends Round {
    String soloType; // trump, jack, or queen
    Player soloPlayer; // Exactly one solo player
}

class JackRound extends SoloRound {}

class MandatorySoloRound extends SoloRound {}

class Player {
    int id;
}

}
