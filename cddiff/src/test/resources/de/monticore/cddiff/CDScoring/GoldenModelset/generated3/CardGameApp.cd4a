
// Class diagram for a Game
classdiagram Game {

class Game {
        //comment: The LLM did not generated the class, added to avoid errors
}

enum Suit {
    Diamonds,
    Hearts,
    Spades,
    Clubs;
}

class Card {
    int id; // Unique ID for each card
    Suit suit;

    int compare(Card otherCard);
}

class Deck {
    List<Card> cards; // Up to 48 cards
}

class Player {
    int id; // Unique ID for each player
}

class ScoringTable {
    List<Round> rounds; // Any number of rounds
}

class Round {
    List<Player> winningPlayers; // Winning players of the round
    int pointValue; // Point value of the round
}

class JackRound extends Round {
    // Specific attributes/methods for jack round (if any)
}

class SoloRound extends Round {
    SoloType soloType; // Type of solo (trump, jack, queen)
    Player soloPlayer; // Exactly one solo player
}

enum SoloType {
    Trump,
    Jack,
    Queen;
}

association [4] Game <-> Player [4]; // A game consists of 4 players
association [1] Game <-> Deck [1]; // A game consists of a deck of cards
association [1] Game <-> ScoringTable [1]; // A game has a scoring table
association [*] ScoringTable <-> Round [*]; // Scoring table consists of any number of rounds
association [*] Round <-> Player [*]; // Each round has winning players

}
