
classdiagram game {

    class Game {
        Player[] players; // Exactly 4 players
        Deck deck; 
        ScoringTable scoringTable;
    }

    class Deck {
        Card[] cards; // Up to 48 cards
    }

    class Card {
        String id; // Unique identifier
        Suit suit;
        
        ComparisonResult compareHeight(Card otherCard);
    }

    enum Suit {
        DIAMONDS,
        HEARTS,
        SPADES,
        CLUBS;
    }

    class ScoringTable {
        Round[] rounds; // Any number of rounds
    }

    class Round {
        Player[] winningPlayers; // Can be multiple winning players
        int pointValue;
    }

    class JackRound extends Round {
        // Inherits all properties from Round
    }

    class SoloRound extends Round {
        SoloType soloType; // Type of solo
        Player soloPlayer; // Exactly one solo player
    }

    class MandatorySoloRound extends SoloRound {
        // Inherits all properties from SoloRound
    }

    enum SoloType {
        TRUMP,
        JACK,
        QUEEN;
    }

    class Player {
        String id; // Unique identifier
    }

    enum ComparisonResult {
        LOWER,
        EQUAL,
        HIGHER;
    }
}
