
classdiagram EBikeSystem {

class EBike {
    Frame frame;
    DriveSystem driveSystem;
    Controller controller;
    Optional<Battery> battery;
}

class Frame {
    String material = "steel";
    List<Wheel> wheels;
}

class Wheel {
    int size; // Could represent wheel size in inches
}

class DriveSystem {
    Motor motor;
}

class Motor {
    int power; // Power in watts
}

class Battery {
    int storedEnergy; // Energy stored in Watt-hours (Wh)
}

// Base Controller class
abstract class Controller {
    ControllerState state; // The state of the Controller (On, Off, Charging)
}

// Enum for ControllerState
enum ControllerState {
    ON,
    OFF,
    CHARGING;
}

// Specialized Controller classes
class BasicController extends Controller {
}

class AdvancedController extends Controller {
    Optional<Date> nextInspectionDate; // Estimated maintenance date
}

// Associations
association EBike (controls) -> Controller [1];
association Controller (command) -> Battery [0..1];
association Controller (command) -> DriveSystem [1];
association contains Frame -> Wheel [2];

}
