import java.lang.String;

classdiagram Banking {

  <<ref="Bank">> class SEPABank {
    <<ref="id">> String bic;
    <<ref="overallBalance", bind="Account=PrivateAccount">> double privateAccountsOverallBalance;
    <<ref="overallBalance", bind="Account=BusinessAccount">> double businessAccountsOverallBalance;
  }

  <<ref="Account">> class PrivateAccount {
    <<ref="id">> String iban;
  }

  <<ref="Account">> class BusinessAccount {
    <<ref="id">> String iban;
  }

  /*
   * NOTE: This is an alternative: We define all these versions of transaction manually. by default
   * the tool would generate all possible account types as attributes into the Transaction class.
   * which is not ideal as well!
   */

  <<ref="Transaction">> class PrivateAccountTransaction {
    PrivateAccount sourceAccount;
    PrivateAccount targetAccount;
  }

  <<ref="Transaction">> class BusinessAccountTransaction {
    BusinessAccount sourceAccount;
    BusinessAccount targetAccount;
  }

  <<ref="Transaction">> class PrivateToBusinessAccountTransaction {
    PrivateAccount sourceAccount;
    BusinessAccount targetAccount;
  }

  <<ref="Transaction">> class BusinessToPrivateAccountTransaction {
    BusinessAccount sourceAccount;
    PrivateAccount targetAccount;
  }
}