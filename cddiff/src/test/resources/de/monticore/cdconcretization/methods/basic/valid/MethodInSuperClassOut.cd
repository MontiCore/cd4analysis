classdiagram MethodInSuperClassConc {
  class AccountBase {
    void withdraw(int amount);
    void deposit(int amount);
    void transfer(int amount, AccountBase account);
    int getBalance();
  }

  class Account extends AccountBase {
    // The signature in AccountBase is not enough to serve as incarnation of the reference method
    void transfer(int amount, Account account);
  }
}
