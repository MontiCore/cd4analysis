/* (c) https://github.com/MontiCore/monticore */
classdiagram MyCD {

  <<getter, setter>>
  public class A {
    public int x;
    protected String y;
    final int finalX = 0;
  }

  <<builder, setter>>
  public class B extends MyCD2.MyCD2B {
    public int x;
    <<noGetter, noSetter>> public String pub; // Note: The builder decorator only works for methods with a setter!
  }

  <<observable, setter>>
  public class CanBeObserved {
    public String name;
    public int age;
  }


  association A <-> B;

  // Test BiDirectional association generation
  class A1;
  class A2;
  class A3;
  class A4;
  class A5;
  class A6;
  association [0..1] A<-> (a1) A1 [0..*] ;
  association [0..1] A<-> (a2) A2 [0..1] ;
  association [0..1] A<-> (a3) A3 [*]    ;
  association [*] A<-> (a4) A4 [0..*] ;
  association [*] A<-> (a5) A5 [0..1] ;
  association [*] A<-> (a6) A6 [*]    ;

  enum Cardinality {
    NORTH, WEST, SOUTH, EAST;
  }

  abstract class AbstractClass {
    void doX();
  }

  class AbstractClassIml extends AbstractClass {
    void doY();
  }



  public class ConfiguredFromCLI {
    // The build.gradle options
    public int x;
  }

  interface MyEmptyInterface { }

  interface MyInterface {
    abstract boolean doStuff();
    public abstract boolean doStuffInPublic();
  }

  abstract class MyInterfaceImpl implements MyInterface {
    // This class should be implicitly abstract!
  }

  // interfaces should be considered too!

  class XA1 {}
  class XA2 {}
  association XA1 -- XA2; // no association should be created
  association XA1 -> (a1) XA2 [*];
  association XA1 -> (a2) XA2 [*];
  association [*] XA1 (b1) <- XA2;
  association [*] XA1 (b2) <- XA2;


  <<needsTOP="TOP required: %s">>
  public class IncompleteA {
    public String name;
  }

  package MyInnerPackage {
    <<getter>>
    class ClassWithinInnerPackage {}
  }
  association A1 <-> MyInnerPackage.ClassWithinInnerPackage;
}
