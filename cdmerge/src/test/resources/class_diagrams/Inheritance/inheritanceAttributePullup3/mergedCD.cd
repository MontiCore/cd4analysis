package inheritanceAttributePullup3;

import java.util.Date;

classdiagram mergedCD {

	class Human{
		Date birthday;
	}
	class Person extends Human{
		String name;
		int persNumber;
	}

	class Student extends Person {
		int enrollmentNumber;
	}

	class Customer extends Person {
		String company;
	}

}

