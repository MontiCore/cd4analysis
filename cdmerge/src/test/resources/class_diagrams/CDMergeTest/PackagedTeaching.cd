classdiagram PackagedTeaching {
  package uni {
    class Professor{
      String name;
      String mail;
    }
    class Lecture {
      int credits;
    }
    class Student {
      long matrNr;
    }
    association [1] Professor (lecturer) <-> (holds) Lecture;
  }
  association attendance [*] uni.Lecture <- uni.Student;
}
