import java.lang.String;

classdiagram BankingCon {

  <<ref="Bank">> class SEPABank {
    <<ref="id">> String bic;
    <<ref="overallBalance">> double totalMoney; // money of all accounts together
  }

  <<ref="Account">> class BankAccount {
    <<ref="id">> String iban;
    double balance; // money in the account
  }

  class Customer {
    String name;
    String address;
    String phoneNumber;
  }

  // sends money from sourceAccount to targetAccount
  class Transaction {
    <<ref="BankingRef.Transaction.sourceAccount">>BankAccount sourceBankAccount;
    <<ref="BankingRef.Transaction.targetAccount">>BankAccount targetBankAccount;
    double amount;
  }

  association SEPABank (sEPABank) -> (bankAccount) BankAccount [*];
  association SEPABank (sEPABank) -> (customer) Customer [*];
  association [*] BankAccount (bankAccount) <-> (customer) Customer [*];
  association BankAccount (bankAccount) -> (transaction) Transaction [*] <<ordered>>;
}
