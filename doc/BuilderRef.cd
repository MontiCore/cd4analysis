classdiagram BuilderRef {
  class DataClass {
    anytype attribute;
  }

  <<forEach="DataClass">> class DataClassBuilder {
    <<forEach="DataClass.attribute">> anytype attribute;
    <<forEach="DataClass.attribute">> DataClassBuilder attribute(anytype attribute);
    DataClass build();
  }
}
