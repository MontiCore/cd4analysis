classdiagram CDNestedSealedClassesInvalid {
  // Modifiers Abstract and Final cannot be used in combination at inner class level
  abstract sealed class Shape1 permits Rectangle1;
  abstract final class Rectangle1 extends Shape1;

  /*
   * Super-class needs to be static in order for sub-classes to be static.
   * Not really an error that happens because of sealed/non-sealed, but it is here for
   * completion.
   */
  abstract sealed class Shape2 permits Rectangle2;
  static final class Rectangle2 extends Shape2;

  // Permits clause cannot be invoked without the sealed modifier
  class Shape3 permits Rectangle3;
  final class Rectangle3 extends Shape3;

  // final and sealed are mutually exclusive
  final sealed class Shape4 permits Rectangle4;
  final class Rectangle4 extends Shape4;

  // final and non-sealed are mutually exclusive
  sealed class Shape5 permits Rectangle5;
  final non-sealed class Rectangle5 extends Shape5;

  // sealed and non-sealed are mutually exclusive
  sealed class Shape6 permits Rectangle6;
  sealed non-sealed class Rectangle6 extends Shape6 permits Square6;
  final class Square6 extends Rectangle6;
}
