classdiagram SealedModifierCombinationsInvalid {
  // 0xCDC93: final, sealed, and non-sealed are mutually exclusive
  final sealed class A1;
  sealed class A2 permits B2;
  sealed non-sealed class B2 extends A2 permits C2;
  final class C2 extends B2;

  // 0xCDC94: abstract and final
  abstract final class A3;

  // 0xCDC95: final interface
  final interface I4;

  // 0xCDC96: permits without sealed
  class A5 permits B5;
  final class B5 extends A5;
  interface I6 permits B6;
  final class B6 implements I6;
}
