import java.util.Date;
import java.util.*;
public classdiagram MyOrganizer { 
  package MyOrganizer { 
    public enum Status { 
      PROCESSING,DONE,OPEN;

    } 
    public abstract class Asset { 
      public abstract void process();

    } 
    public abstract class Task extends Asset { 
      private String taskName;
      protected Status taskStatus;
      public abstract void process();
      public MyOrganizer.Project project;

    } 
    public abstract class Project extends Asset { 
      public String projectName;
      public double budget;
      public abstract void process();
      public Set<MyOrganizer.Task>tasks;

    } 
    public class Day { 
      public Date date;
      public MyOrganizer.Task tasks;

    } 
    public association public [1]Day(day)->(tasks)Task [1]public;
    public association public[*]Task(tasks)<->(project)Project [1]public;

  } 

} 
