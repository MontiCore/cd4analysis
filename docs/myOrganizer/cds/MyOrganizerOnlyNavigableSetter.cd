public classdiagram MyOrganizer { 
  package MyOrganizer { 
    public enum Status { 
      PROCESSING,DONE,OPEN;

    } 
    public abstract class Asset { 
      public void process();

    } 
    public class Task extends Asset { 
      protected String taskName;
